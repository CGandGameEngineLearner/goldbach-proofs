section

open Finset Set
open scoped BigOperators Topology

namespace ShortAPSmallConductorHighFrequency

open ShortAPSmoothedFactor ShortAPDyadicPartition ShortAPLogWeight

/-- The precise unweighted log-phase bound proved by the Vinogradov kernel. -/
def RawLogPhase : Prop :=
  ∃ C : ℝ, 1 ≤ C ∧ ∀ N H : ℕ,
    1 ≤ N → H ≤ N → ∀ a t lam : ℝ, a ∈ Set.Icc (0 : ℝ) 1 → 49 / 100 ≤ lam →
    (N : ℝ) ^ (2 / 3 : ℝ) ≤ (N : ℝ) / 2 → |t| = (N : ℝ) ^ lam →
    ‖∑ n ∈ range H, Complex.exp (Complex.I * ((t * Real.log ((N : ℝ) + a + n) : ℝ) : ℂ))‖ ≤
      (N : ℝ) * (C * (lam + 1) ^ 6 * (N : ℝ) ^ (-1 / ((10 ^ 15 : ℝ) * lam ^ 2))) +
        4 * (N : ℝ) ^ (2 / 3 : ℝ)

private theorem base_half {M : ℝ} (hM : 8 ≤ M) : M ^ (2 / 3 : ℝ) ≤ M / 2 := by
  have hM₀ : 0 < M := by linarith
  have h₈ : (8 : ℝ) ^ (1 / 3 : ℝ) = 2 := by
    rw [show (8 : ℝ) = (2 : ℝ) ^ (3 : ℕ) by norm_num, ← Real.rpow_natCast,
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    norm_num
  have hp : 2 ≤ M ^ (1 / 3 : ℝ) := by
    rw [← h₈]
    exact Real.rpow_le_rpow (by norm_num) hM (by norm_num)
  apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 2)).mpr
  calc
    _ ≤ M ^ (2 / 3 : ℝ) * M ^ (1 / 3 : ℝ) :=
      mul_le_mul_of_nonneg_left hp (by positivity)
    _ = _ := by rw [← Real.rpow_add hM₀]; norm_num

/-- Uniform power-saving on a bounded logarithmic frequency range. -/
theorem phase_block_of_raw (hraw : RawLogPhase) (Λ : ℝ) (hΛ : 1 ≤ Λ) :
    ∃ C δ : ℝ, 0 ≤ C ∧ 0 < δ ∧ δ ≤ 1 / 3 ∧ ∀ M H : ℕ, 8 ≤ M → H ≤ M →
      ∀ a t : ℝ, a ∈ Set.Icc (0 : ℝ) 1 → (M : ℝ) ^ (49 / 100 : ℝ) ≤ |t| →
        |t| ≤ (M : ℝ) ^ Λ →
      ‖∑ n ∈ range H, Complex.exp (Complex.I * ((t * Real.log ((M : ℝ) + a + n) : ℝ) : ℂ))‖ ≤
        C * (M : ℝ) ^ (1 - δ) := by
  obtain ⟨C, hC, hraw⟩ := hraw
  let δ := min ((1 / 3 : ℝ)) (1 / ((10 ^ 15 : ℝ) * Λ ^ 2))
  have hΛ₀ : 0 < Λ := zero_lt_one.trans_le hΛ
  have hδ₀ : 0 < δ := lt_min (by norm_num) (by positivity)
  have hδ₁ : δ ≤ 1 / 3 := min_le_left _ _
  refine ⟨C * (Λ + 1) ^ 6 + 4, δ, by positivity, hδ₀, hδ₁, ?_⟩
  intro M H hM hH a t ha htlo hthi
  have hM₁ : 1 < (M : ℝ) := by exact_mod_cast (show 1 < M by omega)
  have hM₀ : 0 < (M : ℝ) := zero_lt_one.trans hM₁
  have hL : 0 < Real.log (M : ℝ) := Real.log_pos hM₁
  have ht₀ : 0 < |t| := (Real.rpow_pos_of_pos hM₀ _).trans_le htlo
  let lam := Real.log |t| / Real.log (M : ℝ)
  have hlamlo : (49 / 100 : ℝ) ≤ lam := by
    apply (le_div_iff₀ hL).mpr
    simpa only [Real.log_rpow hM₀] using
      Real.log_le_log (Real.rpow_pos_of_pos hM₀ (49 / 100)) htlo
  have hlamhi : lam ≤ Λ := by
    apply (div_le_iff₀ hL).mpr
    simpa only [Real.log_rpow hM₀] using Real.log_le_log ht₀ hthi
  have hlam₀ : 0 < lam := (by norm_num : (0 : ℝ) < 49 / 100).trans_le hlamlo
  have hlog : |t| = (M : ℝ) ^ lam := by
    have he : Real.log |t| = Real.log ((M : ℝ) ^ lam) := by
      rw [Real.log_rpow hM₀]
      exact (div_mul_cancel₀ _ hL.ne').symm
    exact Real.log_injOn_pos ht₀ (Real.rpow_pos_of_pos hM₀ _) he
  have hδ : δ ≤ 1 / ((10 ^ 15 : ℝ) * lam ^ 2) := by
    apply (min_le_right _ _).trans
    exact one_div_le_one_div_of_le (by positivity)
      (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hlam₀.le hlamhi 2) (by positivity))
  calc
    _ ≤ _ := hraw M H (by omega) hH a t lam ha hlamlo (base_half (by exact_mod_cast hM)) hlog
    _ ≤ (M : ℝ) * (C * (Λ + 1) ^ 6 * (M : ℝ) ^ (-δ)) +
        4 * (M : ℝ) ^ (1 - δ) := by
      apply add_le_add
      · apply mul_le_mul_of_nonneg_left _ hM₀.le
        exact mul_le_mul
          (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) (by linarith) 6) (by linarith))
          (Real.rpow_le_rpow_of_exponent_le hM₁.le (by simpa only [neg_div] using neg_le_neg hδ))
          (by positivity) (by positivity)
      · exact mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hM₁.le (by linarith)) (by norm_num)
    _ = _ := by
      have h : (M : ℝ) * (M : ℝ) ^ (-δ) = (M : ℝ) ^ (1 - δ) := by
        rw [sub_eq_add_neg, Real.rpow_add hM₀, Real.rpow_one]
      rw [show (M : ℝ) * (C * (Λ + 1) ^ 6 * (M : ℝ) ^ (-δ)) =
        C * (Λ + 1) ^ 6 * ((M : ℝ) * (M : ℝ) ^ (-δ)) by ring, h]
      ring

private theorem norm_range_mul_le_of_prefix (f w : ℕ → ℂ) (H : ℕ) (P C D : ℝ)
    (hP : 0 ≤ P) (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hp : ∀ n ≤ H, ‖∑ i ∈ range n, f i‖ ≤ P) (hw : ∀ n, ‖w n‖ ≤ C)
    (hd : ∀ n, ‖w (n + 1) - w n‖ ≤ D) :
    ‖∑ i ∈ range H, w i * f i‖ ≤ (C + (H : ℝ) * D) * P := by
  have he := Finset.sum_range_by_parts w f H
  simp only [smul_eq_mul] at he
  rw [he]
  calc
    _ ≤ ‖w (H - 1) * ∑ i ∈ range H, f i‖ +
        ‖∑ n ∈ range (H - 1), (w (n + 1) - w n) * ∑ i ∈ range (n + 1), f i‖ :=
      norm_sub_le _ _
    _ ≤ C * P + ∑ _n ∈ range (H - 1), D * P := by
      apply add_le_add
      · rw [norm_mul]
        exact mul_le_mul (hw _) (hp H le_rfl) (norm_nonneg _) hC
      · apply (norm_sum_le _ _).trans
        apply sum_le_sum
        intro n hn
        rw [norm_mul]
        apply mul_le_mul (hd n) (hp _ _) (norm_nonneg _) hD
        have := mem_range.mp hn
        omega
    _ ≤ _ := by
      rw [sum_const, card_range, nsmul_eq_mul, add_mul, mul_assoc]
      exact add_le_add le_rfl (mul_le_mul_of_nonneg_right
        (by exact_mod_cast Nat.sub_le H 1) (mul_nonneg hD hP))

private noncomputable def normalizedWeight (g : ℝ → ℂ) (u : ℝ) : ℂ :=
  g u * ((u ^ (-1 / 2 : ℝ) : ℝ) : ℂ)

private theorem normalizedWeight_regular {g : ℝ → ℂ}
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (hs : ∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) :
    ∃ C D : ℝ, 0 ≤ C ∧ 0 ≤ D ∧ (∀ u, ‖normalizedWeight g u‖ ≤ C) ∧
      ∀ u v, ‖normalizedWeight g u - normalizedWeight g v‖ ≤ D * |u - v| := by
  let W := normalizedWeight g
  have hW₀ (u : ℝ) (hu : u ∉ Icc (1 : ℝ) 4) : W u = 0 := by
    simp [W, normalizedWeight, hs u hu]
  have hW : ContDiff ℝ (⊤ : ℕ∞) W := by
    rw [contDiff_iff_contDiffAt]
    intro u
    by_cases hu : u ∈ Icc (1 : ℝ) 4
    · have hu₀ : u ≠ 0 := (zero_lt_one.trans_le hu.1).ne'
      exact hg.contDiffAt.mul (Complex.ofRealCLM.contDiff.contDiffAt.comp u
        (Real.contDiffAt_rpow_const_of_ne hu₀))
    · apply (contDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
      filter_upwards [isClosed_Icc.isOpen_compl.mem_nhds hu] with v hv
      exact hW₀ v hv
  have hdW := hW.continuous_deriv (by simp)
  obtain ⟨C, hC⟩ := (isCompact_Icc (a := (1 : ℝ)) (b := 4)).exists_bound_of_continuousOn
    hW.continuous.continuousOn
  obtain ⟨D, hD⟩ := (isCompact_Icc (a := (1 : ℝ)) (b := 4)).exists_bound_of_continuousOn
    hdW.continuousOn
  refine ⟨max C 0, max D 0, le_max_right .., le_max_right .., ?_, ?_⟩
  · intro u
    by_cases hu : u ∈ Icc (1 : ℝ) 4
    · exact (hC u hu).trans (le_max_left ..)
    · change ‖W u‖ ≤ _
      rw [hW₀ u hu, norm_zero]
      exact le_max_right ..
  · intro u v
    have hbound (w : ℝ) : ‖deriv W w‖ ≤ max D 0 := by
      by_cases hw : w ∈ Icc (1 : ℝ) 4
      · exact (hD w hw).trans (le_max_left ..)
      · have he : (fun _ : ℝ => (0 : ℂ)) =ᶠ[𝓝 w] W := by
          filter_upwards [isClosed_Icc.isOpen_compl.mem_nhds hw] with y hy
          exact (hW₀ y hy).symm
        have hD₀ := he.deriv_eq
        rw [deriv_const] at hD₀
        rw [← hD₀, norm_zero]
        exact le_max_right ..
    simpa only [Real.norm_eq_abs] using
      (Convex.norm_image_sub_le_of_norm_deriv_le
        (fun w _ => hW.differentiable (by simp) w) (fun w _ => hbound w) convex_univ
        (mem_univ v) (mem_univ u))

private theorem sum_blocks (q lo hi : ℕ) (hq : 0 < q) (f : ℕ → ℂ) :
    (∑ n ∈ Ico (q * lo) (q * hi), f n) = ∑ m ∈ Ico lo hi, ∑ r ∈ range q, f (q * m + r) := by
  rw [← Finset.sum_product' (Ico lo hi) (range q)]
  symm
  have hqr (m r : ℕ) (hr : r < q) : (q * m + r) / q = m := by
    rw [Nat.mul_add_div hq, Nat.div_eq_of_lt hr, add_zero]
  refine Finset.sum_bij (fun p _ => q * p.1 + p.2) ?_ ?_ ?_ (fun _ _ => rfl)
  · rintro ⟨m, r⟩ hp
    obtain ⟨hm, hr⟩ := Finset.mem_product.mp hp
    obtain ⟨hm₁, hm₂⟩ := Finset.mem_Ico.mp hm
    have hrq := Finset.mem_range.mp hr
    refine Finset.mem_Ico.mpr ⟨?_, ?_⟩
    · exact (Nat.mul_le_mul_left q hm₁).trans (Nat.le_add_right _ _)
    · calc
        _ < q * (m + 1) := by rw [Nat.mul_succ]; exact Nat.add_lt_add_left hrq _
        _ ≤ _ := Nat.mul_le_mul_left q (Nat.succ_le_of_lt hm₂)
  · rintro ⟨m, r⟩ hp ⟨m', r'⟩ hp' h
    have hr := Finset.mem_range.mp (Finset.mem_product.mp hp).2
    have hr' := Finset.mem_range.mp (Finset.mem_product.mp hp').2
    change q * m + r = q * m' + r' at h
    have hm : m = m' := by
      have h' := congrArg (fun n : ℕ => n / q) h
      rwa [hqr m r hr, hqr m' r' hr'] at h'
    subst m'
    exact Prod.ext rfl (Nat.add_left_cancel h)
  · intro n hn
    obtain ⟨hn₁, hn₂⟩ := Finset.mem_Ico.mp hn
    have hlo : lo ≤ n / q := (Nat.le_div_iff_mul_le hq).mpr (by simpa [Nat.mul_comm] using hn₁)
    have hhi : n / q < hi := (Nat.div_lt_iff_lt_mul hq).mpr (by simpa [Nat.mul_comm] using hn₂)
    exact ⟨(n / q, n % q), Finset.mem_product.mpr
        ⟨Finset.mem_Ico.mpr ⟨hlo, hhi⟩, Finset.mem_range.mpr (Nat.mod_lt _ hq)⟩,
      Nat.div_add_mod n q⟩

private noncomputable def logPhase (t u : ℝ) : ℂ :=
  Complex.exp (Complex.I * ((t * Real.log u : ℝ) : ℂ))

private theorem logPhase_mul {q u : ℝ} (hq : 0 < q) (hu : 0 < u) (t : ℝ) :
    logPhase t (q * u) = logPhase t q * logPhase t u := by
  unfold logPhase
  rw [← Complex.exp_add, Real.log_mul hq.ne' hu.ne']
  push_cast
  ring_nf

private theorem norm_logPhase (t u : ℝ) : ‖logPhase t u‖ = 1 :=
  Complex.norm_exp_I_mul_ofReal _

private theorem critical_term (N t : ℝ) (n : ℕ) (hN : 0 < N) (hn : 0 < n) :
    ((n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I))⁻¹ =
      (((N ^ (-1 / 2 : ℝ) : ℝ) : ℂ) * ((((n : ℝ) / N) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) *
        logPhase (-t) (n : ℝ) := by
  have hn₀ : 0 < (n : ℝ) := by exact_mod_cast hn
  have hbase : (n : ℂ) ≠ 0 := by exact_mod_cast hn.ne'
  have hsplit : (n : ℝ) ^ (-1 / 2 : ℝ) =
      N ^ (-1 / 2 : ℝ) * ((n : ℝ) / N) ^ (-1 / 2 : ℝ) := by
    rw [Real.div_rpow hn₀.le hN.le]
    field_simp [ne_of_gt (Real.rpow_pos_of_pos hN _)]
  have hneg : -(1 / 2 + (t : ℂ) * Complex.I : ℂ) =
      ((-1 / 2 : ℝ) : ℂ) + Complex.I * ((-t : ℝ) : ℂ) := by
    push_cast
    ring
  rw [← Complex.cpow_neg, hneg, Complex.cpow_add _ _ hbase, ← Complex.ofReal_natCast,
    ← Complex.ofReal_cpow hn₀.le, hsplit, Complex.ofReal_mul,
    Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hn₀.ne'),
    ← Complex.ofReal_log hn₀.le, logPhase]
  congr 2
  push_cast
  ring

private theorem high_block_sum
    (W : ℝ → ℂ) (C D P δ Λ : ℝ) (hC : 0 ≤ C) (hD : 0 ≤ D) (hP : 0 ≤ P)
    (hw : ∀ u, ‖W u‖ ≤ C) (hd : ∀ u v, ‖W u - W v‖ ≤ D * |u - v|)
    (hphase : ∀ M H : ℕ, 8 ≤ M → H ≤ M → ∀ a t : ℝ, a ∈ Set.Icc (0 : ℝ) 1 →
      (M : ℝ) ^ (49 / 100 : ℝ) ≤ |t| → |t| ≤ (M : ℝ) ^ Λ →
      ‖∑ n ∈ range H, logPhase t ((M : ℝ) + a + n)‖ ≤ P * (M : ℝ) ^ (1 - δ))
    (M A q r : ℕ) (hMA : A ≤ M) (hA : 8 ≤ A) (hq : 0 < q) (hr : r < q)
    (N t : ℝ) (hN : 0 < N) (hqA : (q : ℝ) * (A : ℝ) ≤ N)
    (ht₁ : (M : ℝ) ^ (49 / 100 : ℝ) ≤ |t|) (ht₂ : |t| ≤ (M : ℝ) ^ Λ) :
    ‖∑ n ∈ range A, W ((q * (M + n) + r : ℕ) / N) *
      logPhase t (q * (M + n) + r : ℕ)‖ ≤
      (C + D) * (P * (M : ℝ) ^ (1 - δ)) := by
  let a : ℝ := (r : ℝ) / q
  let w (n : ℕ) := W ((q * (M + n) + r : ℕ) / N)
  let f (n : ℕ) := logPhase t ((M : ℝ) + a + n)
  have hq₀ : 0 < (q : ℝ) := by exact_mod_cast hq
  have hM₀ : 0 < (M : ℝ) := by exact_mod_cast (show 0 < M by omega)
  have ha : a ∈ Set.Icc (0 : ℝ) 1 := ⟨by dsimp only [a]; positivity,
    (div_le_one hq₀).mpr (by exact_mod_cast hr.le)⟩
  have hfactor (n : ℕ) : logPhase t (q * (M + n) + r : ℕ) =
      logPhase t q * f n := by
    have he : ((q * (M + n) + r : ℕ) : ℝ) = (q : ℝ) * ((M : ℝ) + a + n) := by
      dsimp only [a]
      push_cast
      field_simp
      ring
    rw [he, logPhase_mul hq₀ (by linarith [ha.1, Nat.cast_nonneg (α := ℝ) n])]
  have hdiff (n : ℕ) : ‖w (n + 1) - w n‖ ≤ D * ((q : ℝ) / N) := by
    dsimp only [w]
    apply (hd _ _).trans
    have he : ((q * (M + (n + 1)) + r : ℕ) : ℝ) / N -
        ((q * (M + n) + r : ℕ) : ℝ) / N = (q : ℝ) / N := by
      push_cast
      ring
    rw [he, abs_of_nonneg (by positivity)]
  have hab := norm_range_mul_le_of_prefix f w A (P * (M : ℝ) ^ (1 - δ))
    C (D * ((q : ℝ) / N)) (by positivity) hC (by positivity)
    (fun n hn => hphase M n (hA.trans hMA) (hn.trans hMA) a t ha ht₁ ht₂)
    (fun n => hw _) hdiff
  have hqAN : (A : ℝ) * ((q : ℝ) / N) ≤ 1 := by
    rw [← mul_div_assoc]
    exact (div_le_one hN).mpr (by simpa only [mul_comm] using hqA)
  have hweight : (A : ℝ) * (D * ((q : ℝ) / N)) ≤ D := by
    have hh := mul_le_mul_of_nonneg_left hqAN hD
    simpa only [mul_one, mul_left_comm] using hh
  simp_rw [hfactor]
  have hsum : (∑ n ∈ range A, w n * (logPhase t q * f n)) =
      logPhase t q * (∑ n ∈ range A, w n * f n) := by
    rw [mul_sum]
    apply sum_congr rfl
    intro n _
    ring
  rw [show (∑ n ∈ range A, W ((q * (M + n) + r : ℕ) / N) * (logPhase t q * f n)) =
    ∑ n ∈ range A, w n * (logPhase t q * f n) from rfl, hsum, norm_mul, norm_logPhase, one_mul]
  exact hab.trans (mul_le_mul_of_nonneg_right (add_le_add le_rfl hweight) (by positivity))

/-- The actual smooth, unlogged factor in the high-frequency range. The
length parameter is the number of integers per conductor class. -/
theorem unweighted_high_frequency (Λ : ℝ) (hΛ : 1 ≤ Λ) {g : ℝ → ℂ}
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (hs : ∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) :
    ∃ K δ : ℝ, 0 ≤ K ∧ 0 < δ ∧ δ ≤ 1 / 3 ∧
      ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 0 < q → ∀ N t : ℝ, 1 ≤ N →
        let A := ⌊N / (q : ℝ)⌋₊
        8 ≤ A → (5 * (A : ℝ)) ^ (49 / 100 : ℝ) ≤ |t| → |t| ≤ (A : ℝ) ^ Λ →
        ‖weightSum g 0 N (fun n => χ (n : ZMod q) / (n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I))‖ ≤
          K * Real.sqrt N * (A : ℝ) ^ (-δ) := by
  obtain ⟨P, δ, hP, hδ, hδ₁, hphase⟩ := phase_block_of_raw
    (show RawLogPhase from ShortAPVinogradovKernel.OAI.V2.V1ro) Λ hΛ
  obtain ⟨C, D, hC, hD, hw, hd⟩ := normalizedWeight_regular hg hs
  let K₀ := (C + D) * (P * (4 : ℝ) ^ (1 - δ))
  let K := 4 * K₀
  have hK₀ : 0 ≤ K₀ := by dsimp only [K₀]; positivity
  refine ⟨K, δ, by dsimp only [K]; positivity, hδ, hδ₁, ?_⟩
  intro q χ hq N t hN A hA ht₁ ht₂
  have hN₀ : 0 < N := zero_lt_one.trans_le hN
  have hq₀ : 0 < (q : ℝ) := by exact_mod_cast hq
  have hA₀ : 0 < A := by omega
  have hAr : (0 : ℝ) < A := by exact_mod_cast hA₀
  have hqA : (q : ℝ) * (A : ℝ) ≤ N := by
    rw [mul_comm]
    exact (le_div_iff₀ hq₀).mp (Nat.floor_le (by positivity : 0 ≤ N / (q : ℝ)))
  have hq5 : 4 * N < (q : ℝ) * (5 * (A : ℝ)) := by
    have hh := Nat.lt_floor_add_one (N / (q : ℝ))
    change N / (q : ℝ) < (A : ℝ) + 1 at hh
    have hh' := (div_lt_iff₀ hq₀).mp hh
    have hA4 : 4 ≤ (A : ℝ) := by exact_mod_cast (show 4 ≤ A by omega)
    nlinarith [mul_nonneg hq₀.le (sub_nonneg.mpr hA4)]
  let W := normalizedWeight g
  let f (n : ℕ) : ℂ := W ((n : ℝ) / N) * χ (n : ZMod q) * logPhase (-t) (n : ℝ)
  let U := Finset.Ico (q * A) (q * (5 * A))
  let S := Finset.Icc 1 ⌊4 * N⌋₊
  have hsupp (n : ℕ) (hn : f n ≠ 0) : n ∈ S ∧ n ∈ U := by
    have hg' : (n : ℝ) / N ∈ Set.Icc (1 : ℝ) 4 := by
      by_contra hh
      exact hn (by simp [f, W, normalizedWeight, hs _ hh])
    have hn₁ : N ≤ (n : ℝ) := by simpa only [one_mul] using (le_div_iff₀ hN₀).mp hg'.1
    have hn₂ : (n : ℝ) ≤ 4 * N := (div_le_iff₀ hN₀).mp hg'.2
    refine ⟨Finset.mem_Icc.mpr ⟨by exact_mod_cast hN.trans hn₁, Nat.le_floor hn₂⟩,
      Finset.mem_Ico.mpr ⟨?_, ?_⟩⟩
    · exact_mod_cast hqA.trans hn₁
    · exact_mod_cast hn₂.trans_lt hq5
  have hextend : (∑ n ∈ S, f n) = ∑ n ∈ U, f n := by
    calc
      _ = ∑ n ∈ S ∩ U, f n :=
        (Finset.sum_subset Finset.inter_subset_left fun n _ hn => by
          by_contra h
          exact hn (Finset.mem_inter.mpr (hsupp n h))).symm
      _ = _ := Finset.sum_subset Finset.inter_subset_right fun n _ hn => by
        by_contra h
        exact hn (Finset.mem_inter.mpr (hsupp n h))
  have hχ (m r : ℕ) : χ ((q * m + r : ℕ) : ZMod q) = χ (r : ZMod q) := by
    simp [Nat.cast_add, Nat.cast_mul]
  have hsum_r (r : ℕ) (hr : r ∈ range q) :
      ‖∑ m ∈ Ico A (5 * A), f (q * m + r)‖ ≤ K * (A : ℝ) ^ (1 - δ) := by
    let e (m : ℕ) := W ((q * m + r : ℕ) / N) * logPhase (-t) (q * m + r : ℕ)
    have he : (∑ m ∈ Ico A (5 * A), f (q * m + r)) =
        χ (r : ZMod q) * ∑ m ∈ Ico A (5 * A), e m := by
      rw [mul_sum]
      apply sum_congr rfl
      intro m _
      dsimp only [f, e]
      rw [hχ]
      ring
    rw [he, norm_mul]
    refine (mul_le_of_le_one_left (norm_nonneg _) (χ.norm_le_one _)).trans ?_
    have hblock (j : ℕ) (hj : j ∈ Finset.Ico 1 5) :
        ‖∑ n ∈ range A, e (A * j + n)‖ ≤ K₀ * (A : ℝ) ^ (1 - δ) := by
      let M := A * j
      obtain ⟨hj₁, hj₂⟩ := Finset.mem_Ico.mp hj
      have hMA : A ≤ M := by dsimp only [M]; simpa using Nat.mul_le_mul_left A hj₁
      have hM4 : (M : ℝ) ≤ 4 * (A : ℝ) := by
        have h := Nat.mul_le_mul_left A (show j ≤ 4 by omega)
        have hh : (A : ℝ) * (j : ℝ) ≤ (A : ℝ) * 4 := by exact_mod_cast h
        simpa only [M, Nat.cast_mul, mul_comm] using hh
      have htlo : (M : ℝ) ^ (49 / 100 : ℝ) ≤ |-t| := by
        rw [abs_neg]
        exact (Real.rpow_le_rpow (Nat.cast_nonneg _) (by linarith) (by norm_num)).trans ht₁
      have hthi : |-t| ≤ (M : ℝ) ^ Λ := by
        rw [abs_neg]
        exact ht₂.trans (Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast hMA) (by linarith))
      have hbnd := high_block_sum W C D P δ Λ hC hD hP hw hd
        (by simpa only [logPhase] using hphase) M A q r hMA hA hq (mem_range.mp hr) N (-t)
        hN₀ hqA htlo hthi
      refine hbnd.trans ?_
      calc
        _ ≤ (C + D) * (P * (4 * (A : ℝ)) ^ (1 - δ)) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (Nat.cast_nonneg _) hM4 (by linarith)) hP)
            (add_nonneg hC hD)
        _ = _ := by rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 4) hAr.le]; dsimp only [K₀]; ring
    have hdecomp : (∑ m ∈ Ico A (5 * A), e m) =
        ∑ j ∈ Ico 1 5, ∑ n ∈ range A, e (A * j + n) := by
      rw [show 5 * A = A * 5 from Nat.mul_comm _ _]
      simpa only [mul_one] using sum_blocks A 1 5 hA₀ e
    rw [hdecomp]
    calc
      _ ≤ ∑ j ∈ Ico 1 5, ‖∑ n ∈ range A, e (A * j + n)‖ := norm_sum_le _ _
      _ ≤ ∑ _j ∈ Ico 1 5, K₀ * (A : ℝ) ^ (1 - δ) := sum_le_sum hblock
      _ = _ := by simp [K]; ring
  have hunscaled : ‖∑ n ∈ S, f n‖ ≤ (q : ℝ) * (K * (A : ℝ) ^ (1 - δ)) := by
    rw [hextend]
    change ‖∑ n ∈ Ico (q * A) (q * (5 * A)), f n‖ ≤ _
    rw [sum_blocks q A (5 * A) hq, sum_comm]
    calc
      _ ≤ ∑ r ∈ range q, ‖∑ m ∈ Ico A (5 * A), f (q * m + r)‖ := norm_sum_le _ _
      _ ≤ ∑ _r ∈ range q, K * (A : ℝ) ^ (1 - δ) := sum_le_sum hsum_r
      _ = _ := by simp
  have hsum : weightSum g 0 N (fun n => χ (n : ZMod q) / (n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I)) =
      ((N ^ (-1 / 2 : ℝ) : ℝ) : ℂ) * ∑ n ∈ S, f n := by
    rw [weightSum, mul_sum]
    apply sum_congr rfl
    intro n hn
    simp only [pow_zero, one_mul]
    rw [div_eq_mul_inv (χ (n : ZMod q)), critical_term N t n hN₀ (Finset.mem_Icc.mp hn).1]
    dsimp only [f, W, normalizedWeight]
    ring
  rw [hsum, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ N ^ (-1 / 2 : ℝ) * ((q : ℝ) * (K * (A : ℝ) ^ (1 - δ))) :=
      mul_le_mul_of_nonneg_left hunscaled (by positivity)
    _ = K * (N ^ (-1 / 2 : ℝ) * ((q : ℝ) * (A : ℝ))) * (A : ℝ) ^ (-δ) := by
      rw [show 1 - δ = 1 + -δ by ring, Real.rpow_add hAr, Real.rpow_one]
      ring
    _ ≤ K * (N ^ (-1 / 2 : ℝ) * N) * (A : ℝ) ^ (-δ) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hqA (by positivity)) (by dsimp only [K]; positivity)) (by positivity)
    _ = _ := by
      have hNpow : N ^ (-1 / 2 : ℝ) * N = Real.sqrt N := by
        rw [Real.sqrt_eq_rpow, show (1 / 2 : ℝ) = -1 / 2 + 1 by ring,
          Real.rpow_add hN₀, Real.rpow_one]
      rw [hNpow]

/-- The high-frequency estimate for the actual log or zeta slot. -/
theorem box_high_frequency (Λ : ℝ) (hΛ : 1 ≤ Λ) :
    ∃ K δ : ℝ, 0 ≤ K ∧ 0 < δ ∧ δ ≤ 1 / 3 ∧
      ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 0 < q → ∀ (t : ℝ) (H j i b : ℕ),
        i < j + 1 → 1 ≤ scale b →
        let A := ⌊scale b / (q : ℝ)⌋₊
        8 ≤ A → (5 * (A : ℝ)) ^ (49 / 100 : ℝ) ≤ |t| → |t| ≤ (A : ℝ) ^ Λ →
        ‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ ≤
          K * (Real.log (2 * scale b)) ^ logDegree i * Real.sqrt (scale b) * (A : ℝ) ^ (-δ) := by
  obtain ⟨K₀, δ₀, hK₀, hδ₀, hδ₀', h₀⟩ := unweighted_high_frequency Λ hΛ
    smoothCutoff_smooth smoothCutoff_zero
  obtain ⟨K₁, δ₁, hK₁, hδ₁, hδ₁', h₁⟩ := unweighted_high_frequency Λ hΛ
    (withLog_smooth smoothCutoff smoothCutoff_smooth smoothCutoff_zero)
    (fun u hu => by simp [withLog, smoothCutoff_zero u hu])
  let δ := min δ₀ δ₁
  let K := K₀ + K₁ / Real.log 2
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hK : 0 ≤ K := by dsimp only [K]; positivity
  refine ⟨K, δ, hK, lt_min hδ₀ hδ₁, (min_le_left _ _).trans hδ₀', ?_⟩
  intro q χ hq t H j i b hi hb A hA ht₁ ht₂
  let N := scale b
  let L := Real.log (2 * N)
  let a (n : ℕ) := χ (n : ZMod q) / (n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I)
  let R := Real.sqrt N * (A : ℝ) ^ (-δ)
  have hN : 0 < N := scale_pos b
  have hA₁ : 1 ≤ (A : ℝ) := by exact_mod_cast (show 1 ≤ A by omega)
  have hL : Real.log 2 ≤ L := Real.log_le_log (by norm_num) (by dsimp only [N]; linarith)
  have hL₀ : 0 ≤ L := hlog2.le.trans hL
  have hh₀ : ‖weightSum smoothCutoff 0 N a‖ ≤ K₀ * R := by
    refine (h₀ χ hq N t hb hA ht₁ ht₂).trans ?_
    dsimp only [R]
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hA₁
        (neg_le_neg (min_le_left δ₀ δ₁))) (Real.sqrt_nonneg N)) hK₀
  have hh₁ : ‖weightSum (withLog smoothCutoff) 0 N a‖ ≤ K₁ * R := by
    refine (h₁ χ hq N t hb hA ht₁ ht₂).trans ?_
    dsimp only [R]
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hA₁
        (neg_le_neg (min_le_right δ₀ δ₁))) (Real.sqrt_nonneg N)) hK₁
  have hbox : boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I) =
      weightSum smoothCutoff (logDegree i) N a := by
    rw [boxPolynomial_eq hi, weightSum]
    apply sum_congr rfl
    intro n _
    dsimp only [a]
    ring
  rw [hbox]
  by_cases hi₀ : i = 0
  · have hr : logDegree i = 1 := by simp [logDegree, hi₀]
    rw [hr, pow_one, weightSum_succ smoothCutoff 0 hN]
    calc
      _ ≤ ‖(Real.log N : ℂ) * weightSum smoothCutoff 0 N a‖ +
        ‖weightSum (withLog smoothCutoff) 0 N a‖ := norm_add_le _ _
      _ ≤ L * (K₀ * R) + K₁ * R := by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.log_nonneg hb)]
        exact add_le_add (mul_le_mul (Real.log_le_log hN (by linarith)) hh₀ (norm_nonneg _) hL₀) hh₁
      _ ≤ L * (K₀ * R) + (K₁ / Real.log 2) * L * R := by
        have he : K₁ ≤ K₁ / Real.log 2 * L := by
          calc
            K₁ = (K₁ / Real.log 2) * Real.log 2 := (div_mul_cancel₀ _ hlog2.ne').symm
            _ ≤ _ := mul_le_mul_of_nonneg_left hL (by positivity)
        exact add_le_add le_rfl (mul_le_mul_of_nonneg_right he (by dsimp only [R]; positivity))
      _ = _ := by dsimp only [K, R, L, N]; ring
  · have hr : logDegree i = 0 := by simp [logDegree, hi₀]
    rw [hr, pow_zero, mul_one]
    apply hh₀.trans
    rw [mul_assoc]
    exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_right (by positivity : 0 ≤ K₁ / Real.log 2))
      (by dsimp only [R]; positivity)

/-- On the complement of the subquadratic window with `η = 1/2`,
the per-residue frequency satisfies the hypotheses of the Vinogradov estimate. -/
theorem high_window_arithmetic (ε x N t : ℝ) (q : ℕ)
    (hε : 0 < ε) (hx : 1 ≤ x) (hN : 64 ≤ N) (hq : 0 < q)
    (hxN : x ^ ε ≤ N) (hqsmall : (q : ℝ) ≤ x ^ (ε / 4))
    (ht : |t| ≤ x) (hhigh : N ^ (3 / 2 : ℝ) < (q : ℝ) * max 2 |t|) :
    let A := ⌊N / (q : ℝ)⌋₊
    8 ≤ A ∧ N ^ (1 / 2 : ℝ) ≤ (A : ℝ) ∧
      (5 * (A : ℝ)) ^ (49 / 100 : ℝ) ≤ |t| ∧ |t| ≤ (A : ℝ) ^ max 1 (2 / ε) := by
  let A := ⌊N / (q : ℝ)⌋₊
  have hx₀ : 0 < x := zero_lt_one.trans_le hx
  have hN₁ : 1 ≤ N := by linarith
  have hN₀ : 0 < N := by linarith
  have hq₀ : 0 < (q : ℝ) := by exact_mod_cast hq
  have hq₁ : 1 ≤ (q : ℝ) := by exact_mod_cast hq
  have hqN : (q : ℝ) ≤ N ^ (1 / 4 : ℝ) := by
    refine hqsmall.trans ?_
    rw [show ε / 4 = ε * (1 / 4) by ring, Real.rpow_mul hx₀.le]
    exact Real.rpow_le_rpow (by positivity) hxN (by norm_num)
  have hNqr : N ^ (3 / 4 : ℝ) ≤ N / (q : ℝ) := by
    apply (le_div_iff₀ hq₀).mpr
    calc
      _ ≤ N ^ (3 / 4 : ℝ) * N ^ (1 / 4 : ℝ) :=
        mul_le_mul_of_nonneg_left hqN (by positivity)
      _ = _ := by rw [← Real.rpow_add hN₀]; norm_num
  have hN8 : 8 ≤ N ^ (1 / 2 : ℝ) := by
    rw [← Real.sqrt_eq_rpow, Real.le_sqrt (by norm_num) hN₀.le]
    norm_num
    linarith
  have hNq₂ : 2 ≤ N ^ (1 / 4 : ℝ) := by
    have he : (16 : ℝ) ^ (1 / 4 : ℝ) = 2 := by
      rw [show (16 : ℝ) = (2 : ℝ) ^ (4 : ℕ) by norm_num, ← Real.rpow_natCast,
        ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
      norm_num
    rw [← he]
    exact Real.rpow_le_rpow (by norm_num) (by linarith) (by norm_num)
  have hNq₃ : 2 * N ^ (1 / 2 : ℝ) ≤ N ^ (3 / 4 : ℝ) := by
    calc
      _ ≤ N ^ (1 / 4 : ℝ) * N ^ (1 / 2 : ℝ) := mul_le_mul_of_nonneg_right hNq₂ (by positivity)
      _ = _ := by rw [← Real.rpow_add hN₀]; norm_num
  have hAlo : N ^ (1 / 2 : ℝ) ≤ (A : ℝ) := by
    have hf := Nat.lt_floor_add_one (N / (q : ℝ))
    change N / (q : ℝ) < (A : ℝ) + 1 at hf
    linarith
  have hA8 : 8 ≤ A := by exact_mod_cast hN8.trans hAlo
  have hAhi : (A : ℝ) ≤ N :=
    (Nat.floor_le (by positivity : 0 ≤ N / (q : ℝ))).trans (div_le_self hN₀.le hq₁)
  have ht_lower : N < |t| := by
    by_contra hn
    have hmax : max 2 |t| ≤ N := max_le (by linarith) (le_of_not_gt hn)
    have he : (q : ℝ) * max 2 |t| ≤ N ^ (3 / 2 : ℝ) := by
      calc
        _ ≤ N ^ (1 / 4 : ℝ) * N := mul_le_mul hqN hmax (by positivity) (by positivity)
        _ = N ^ (1 / 4 + 1 : ℝ) := by rw [Real.rpow_add hN₀, Real.rpow_one]
        _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hN₁ (by norm_num)
    exact (not_le_of_gt hhigh) he
  have hlow : (5 * (A : ℝ)) ^ (49 / 100 : ℝ) ≤ |t| := by
    calc
      _ ≤ (5 * N) ^ (49 / 100 : ℝ) :=
        Real.rpow_le_rpow (by positivity) (mul_le_mul_of_nonneg_left hAhi (by norm_num)) (by norm_num)
      _ ≤ (5 * N) ^ (1 / 2 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by linarith) (by norm_num)
      _ = Real.sqrt (5 * N) := (Real.sqrt_eq_rpow _).symm
      _ ≤ N := (Real.sqrt_le_iff).mpr ⟨hN₀.le, by nlinarith⟩
      _ ≤ _ := ht_lower.le
  have hu : |t| ≤ (A : ℝ) ^ max 1 (2 / ε) := by
    have hx' : x ≤ N ^ (1 / ε) := by
      have h := Real.rpow_le_rpow (Real.rpow_nonneg hx₀.le ε) hxN (by positivity : 0 ≤ (1 : ℝ) / ε)
      rw [← Real.rpow_mul hx₀.le, mul_one_div_cancel hε.ne', Real.rpow_one] at h
      exact h
    refine (ht.trans hx').trans ?_
    calc
      _ = (N ^ (1 / 2 : ℝ)) ^ (2 / ε) := by
        rw [← Real.rpow_mul hN₀.le]
        congr 1
        ring
      _ ≤ (A : ℝ) ^ (2 / ε) := Real.rpow_le_rpow (by positivity) hAlo (by positivity)
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast (show 1 ≤ A by omega)) (le_max_right _ _)
  exact ⟨hA8, hAlo, hlow, hu⟩

private theorem eventual_logpow_bound {a c : ℝ} (ha : 0 < a) (hc : 0 < c)
    (k : ℕ) (hk : 0 < k) :
    ∀ᶠ x : ℝ in Filter.atTop, Real.log x ^ k ≤ c * x ^ a := by
  let β := a / (k : ℝ)
  let d := c ^ ((1 : ℝ) / (k : ℝ))
  have hk' : 0 < (k : ℝ) := by exact_mod_cast hk
  have hβ : 0 < β := div_pos ha hk'
  have hd : 0 < d := Real.rpow_pos_of_pos hc _
  have h := (isLittleO_log_rpow_atTop hβ).def hd
  filter_upwards [Filter.eventually_ge_atTop (1 : ℝ), h] with x hx hx'
  have hx₀ : 0 < x := zero_lt_one.trans_le hx
  have hL : 0 ≤ Real.log x := Real.log_nonneg hx
  have hb : Real.log x ≤ d * x ^ β := by
    simpa only [Real.norm_of_nonneg hL, Real.norm_of_nonneg (Real.rpow_nonneg hx₀.le _)] using hx'
  calc
    _ ≤ (d * x ^ β) ^ k := pow_le_pow_left₀ hL hb _
    _ = _ := by
      rw [mul_pow]
      have hpow (y e : ℝ) (hy : 0 ≤ y) : (y ^ e) ^ k = y ^ (e * (k : ℝ)) := by
        rw [Real.rpow_mul hy, Real.rpow_natCast]
      rw [hpow c _ hc.le, hpow x _ hx₀.le]
      dsimp only [d, β]
      rw [div_mul_cancel₀ _ hk'.ne', div_mul_cancel₀ _ hk'.ne', Real.rpow_one]

/-- The high-frequency complement supplies the normalized active-box
cap, for a polylogarithmic conductor and a long smooth zeta/log slot. -/
theorem box_high_active_cap_eventually (ε : ℝ) (hε : 0 < ε) (U p : ℕ) :
    ∀ᶠ x : ℝ in Filter.atTop,
      ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 0 < q → (q : ℝ) ≤ 2 * Real.log x ^ U →
      ∀ (t : ℝ) (H j i b : ℕ), i < j + 1 → x ^ ε ≤ scale b → scale b ≤ 4 * x →
        |t| ≤ x → (scale b) ^ (3 / 2 : ℝ) < (q : ℝ) * max 2 |t| →
        (‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ + 1) *
          Real.log x ^ p ≤ Real.sqrt (scale b) := by
  let Λ := max 1 (2 / ε)
  obtain ⟨K, δ, hK, hδ, hδ', hbox⟩ := box_high_frequency Λ (le_max_left _ _)
  let α := ε * δ / 2
  let c := (4 * K + 1)⁻¹
  have hα : 0 < α := by dsimp only [α]; positivity
  have hc : 0 < c := by dsimp only [c]; positivity
  have hlarge : ∀ᶠ x : ℝ in Filter.atTop, 64 ≤ x ^ ε :=
    (tendsto_rpow_atTop hε).eventually_ge_atTop _
  filter_upwards [Filter.eventually_ge_atTop (3 : ℝ), hlarge,
    eventual_logpow_bound (show 0 < ε / 4 by positivity) (show (0 : ℝ) < 1 / 2 by norm_num)
      (U + 1) (Nat.succ_pos _),
    eventual_logpow_bound hα hc (p + 1) (Nat.succ_pos _)] with x hx hx64 hqdiff hxlog
  intro q χ hq hqsmall t H j i b hi hxN hNhi ht hhigh
  let N := scale b
  let A := ⌊N / (q : ℝ)⌋₊
  let L := Real.log x
  let F := boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)
  have hx₁ : 1 ≤ x := by linarith
  have hx₀ : 0 < x := by linarith
  have hL : 1 ≤ L := ((Real.lt_log_iff_exp_lt hx₀).mpr (Real.exp_one_lt_three.trans_le hx)).le
  have hN64 : 64 ≤ N := hx64.trans hxN
  have hN₁ : 1 ≤ N := by linarith
  have hN₀ : 0 < N := by linarith
  have hqsmall' : (q : ℝ) ≤ x ^ (ε / 4) := by
    refine hqsmall.trans ?_
    calc
      _ ≤ 2 * L ^ (U + 1) :=
        mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hL (Nat.le_succ _)) (by norm_num)
      _ ≤ 2 * (1 / 2 * x ^ (ε / 4)) := mul_le_mul_of_nonneg_left hqdiff (by norm_num)
      _ = _ := by ring
  obtain ⟨hA₈, hAlo, hflt, hfut⟩ := high_window_arithmetic ε x N t q hε hx₁ hN64 hq hxN hqsmall' ht hhigh
  have hF := hbox χ hq t H j i b hi hN₁ hA₈ hflt hfut
  have hlog_hi : Real.log (2 * N) ≤ 4 * L := by
    have hx4 : (8 : ℝ) ≤ x ^ (3 : ℕ) :=
      (by norm_num : (8 : ℝ) ≤ (3 : ℝ) ^ (3 : ℕ)).trans
        (pow_le_pow_left₀ (by norm_num) hx 3)
    have hNx : 2 * N ≤ x ^ (4 : ℕ) := by
      calc
        _ ≤ 8 * x := by linarith
        _ ≤ x ^ (3 : ℕ) * x := mul_le_mul_of_nonneg_right hx4 hx₀.le
        _ = _ := by ring
    have he := Real.log_le_log (show 0 < 2 * N by positivity) hNx
    rw [← Real.rpow_natCast, Real.log_rpow hx₀] at he
    exact he
  have hlog₀ : 0 ≤ Real.log (2 * N) := Real.log_nonneg (by linarith)
  have hlog_r : Real.log (2 * N) ^ logDegree i ≤ 4 * L := by
    have he : logDegree i = 0 ∨ logDegree i = 1 := by have := logDegree_le_one i; omega
    rcases he with he | he <;> rw [he]
    · simp only [pow_zero]; linarith
    · simpa only [pow_one] using hlog_hi
  have hAx : x ^ (ε / 2) ≤ (A : ℝ) := by
    rw [show ε / 2 = ε * (1 / 2) by ring, Real.rpow_mul hx₀.le]
    exact (Real.rpow_le_rpow (Real.rpow_nonneg hx₀.le _) hxN (by norm_num)).trans hAlo
  have hAinv : (A : ℝ) ^ (-δ) ≤ x ^ (-α) := by
    refine (Real.rpow_le_rpow_of_nonpos (Real.rpow_pos_of_pos hx₀ _) hAx
      (neg_nonpos.mpr hδ.le)).trans_eq ?_
    rw [← Real.rpow_mul hx₀.le]
    congr 1
    dsimp only [α]
    ring
  have hxsqrt : x ^ α ≤ Real.sqrt N := by
    rw [Real.sqrt_eq_rpow]
    calc
      _ ≤ x ^ (ε / 2) := Real.rpow_le_rpow_of_exponent_le hx₁
        (by dsimp only [α]; nlinarith)
      _ = (x ^ ε) ^ (1 / 2 : ℝ) := by rw [← Real.rpow_mul hx₀.le]; congr 1; ring
      _ ≤ _ := Real.rpow_le_rpow (Real.rpow_nonneg hx₀.le _) hxN (by norm_num)
  have hF' : ‖F‖ ≤ 4 * K * L * Real.sqrt N * x ^ (-α) := by
    calc
      _ ≤ K * Real.log (2 * N) ^ logDegree i * Real.sqrt N * (A : ℝ) ^ (-δ) := hF
      _ ≤ K * (4 * L) * Real.sqrt N * x ^ (-α) := by
        apply mul_le_mul _ hAinv (by positivity) (by positivity)
        exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hlog_r hK) (by positivity)
      _ = _ := by ring
  have hLp : L ^ p ≤ L ^ (p + 1) := pow_le_pow_right₀ hL (Nat.le_succ _)
  have hcancel : x ^ (-α) * x ^ α = 1 := by
    rw [← Real.rpow_add hx₀, neg_add_cancel, Real.rpow_zero]
  change (‖F‖ + 1) * L ^ p ≤ Real.sqrt N
  calc
    _ ≤ (4 * K * L * Real.sqrt N * x ^ (-α) + 1) * L ^ p :=
      mul_le_mul_of_nonneg_right (add_le_add hF' le_rfl) (by positivity)
    _ = (4 * K * Real.sqrt N * x ^ (-α)) * L ^ (p + 1) + L ^ p := by
      rw [pow_succ]
      ring
    _ ≤ (4 * K * Real.sqrt N * x ^ (-α)) * (c * x ^ α) + c * x ^ α :=
      add_le_add (mul_le_mul_of_nonneg_left hxlog (by positivity)) (hLp.trans hxlog)
    _ = 4 * K * Real.sqrt N * c * (x ^ (-α) * x ^ α) + c * x ^ α := by ring
    _ ≤ 4 * K * Real.sqrt N * c + c * Real.sqrt N := by
      rw [hcancel, mul_one]
      exact add_le_add le_rfl (mul_le_mul_of_nonneg_left hxsqrt hc.le)
    _ = _ := by
      have hcancel' : (4 * K + 1) * c = 1 := mul_inv_cancel₀ (by positivity)
      calc
        _ = ((4 * K + 1) * c) * Real.sqrt N := by ring
        _ = _ := by rw [hcancel', one_mul]

/-- Full frequency range for both actual smooth slots, under the long-box
and polylogarithmic conductor restrictions in (4.8). No estimate on a
Dirichlet polynomial occurs as a premise. -/
theorem box_active_cap_eventually (ε : ℝ) (hε : 0 < ε) (U p : ℕ) :
    ∀ᶠ x : ℝ in Filter.atTop,
      ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive →
      (q : ℝ) ≤ 2 * Real.log x ^ U →
      ∀ (t : ℝ) (H j i b : ℕ), i < j + 1 → x ^ ε ≤ scale b → scale b ≤ 4 * x →
        |t| ≤ x →
        (‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ + 1) *
          Real.log x ^ p ≤ Real.sqrt (scale b) := by
  filter_upwards
    [ShortAPSmallConductorSmooth.box_subquadratic_active_cap_eventually (1 / 2) ε
      (by norm_num) (by norm_num) hε p, box_high_active_cap_eventually ε hε U p] with x hlow hhigh
  intro q χ hq hχ hqsmall t H j i b hi hxN hNhi ht
  by_cases h : (q : ℝ) * max 2 |t| ≤ (scale b) ^ (3 / 2 : ℝ)
  · apply hlow χ hq hχ t H j i b hi hxN
    rw [show (2 - 1 / 2 : ℝ) = 3 / 2 by norm_num]
    exact h
  · exact hhigh χ (zero_lt_one.trans hq) hqsmall t H j i b hi hxN hNhi ht (lt_of_not_ge h)

end ShortAPSmallConductorHighFrequency

end

