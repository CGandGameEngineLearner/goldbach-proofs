      _ = _ := by simp [pow_two]; ring
  calc
    _ = ‖((M₁*M₂:ℕ):ℂ)*S‖ := by rw [norm_mul,Complex.norm_natCast]
    _ = ‖T+(((M₁*M₂:ℕ):ℂ)*S-T)‖ := by congr 1; ring
    _ ≤ ‖T‖+‖((M₁*M₂:ℕ):ℂ)*S-T‖ := norm_add_le _ _
    _ = ‖T‖+‖T-((M₁*M₂:ℕ):ℂ)*S‖ := by rw [norm_sub_rev]
    _ ≤ _ := add_le_add hT herror
end V2
