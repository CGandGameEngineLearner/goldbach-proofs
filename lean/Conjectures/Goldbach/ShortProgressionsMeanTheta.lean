theorem V1ii (k M₁ M₂ : ℕ) (t : ℝ) {z : ℝ}
    (hz : 0<z) (hM : ((M₁*M₂:ℕ):ℝ)≤z/2) :
    ‖∑ b : Fin M₂,∑ a : Fin M₁,
      Complex.exp (Complex.I*((t*Real.log (z+(a.val+1)*(b.val+1)):ℝ):ℂ))‖≤
      ‖∑ b : Fin M₂,Vk k M₁
        (Vo (V1p t z)
          (fun j => (((b.val+1)^(j.val+1):ℕ):ℤ)))‖+
        ((M₁*M₂:ℕ):ℝ)*(2*|t| * (((M₁*M₂:ℕ):ℝ)/z)^(k+1)) := by
  let U := ∑ b : Fin M₂,∑ a : Fin M₁,
    Complex.exp (Complex.I*((t*Real.log (z+(a.val+1)*(b.val+1)):ℝ):ℂ))
