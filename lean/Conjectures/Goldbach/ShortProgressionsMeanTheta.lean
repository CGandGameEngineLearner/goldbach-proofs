  nlinarith
theorem Vmy : ∃ R₀ : ℕ, ∀ k : ℕ, 2≤k →
    ∀ M : ℕ, 1≤M → ∀ γ : Fin k → ℝ, (∀ j,γ j≠0) →
    ‖∑ b : Fin M,Vk k M
