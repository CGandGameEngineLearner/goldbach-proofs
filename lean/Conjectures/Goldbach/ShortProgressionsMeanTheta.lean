theorem Vgy (s : ℂ) (hs : s ∈ V2q) :
    ‖V3o s‖ ≤ 1 + ‖1 / (s - 1)‖ + ‖s‖ / s.re := by
  set g : ℝ → ℝ := fun u => u ^ (-s.re - 1)
