section

namespace ShortAP
open ArithmeticFunction
noncomputable section

theorem twisted_weight_replacement {q : ℕ} (χ : DirichletCharacter ℂ q)
    {X h y : ℝ} (hy : 0 ≤ y) (hh : 0 ≤ h) (hX : y+h ≤ X) :
    let s := Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊
    ‖(∑ n ∈ s, ((if n.Prime then Real.log (n : ℝ) else 0 : ℝ) : ℂ) * χ (n : ZMod q)) -
      (∑ n ∈ s, (vonMangoldt n : ℂ) * χ (n : ZMod q))‖ ≤ powerCover X h y := by
  classical
  let s := Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊
  let w (n : ℕ) : ℝ := if n.Prime then Real.log n else 0
  have hnon (n : ℕ) : 0 ≤ vonMangoldt n - w n := by
    by_cases hp : n.Prime <;> simp [w,hp,vonMangoldt_apply_prime, vonMangoldt_nonneg]
  have hsum := abs_psiAP_sub_theta_le (q := 1) 0 hy hh hX
  have he : (∑ n ∈ s, (vonMangoldt n - w n)) ≤ powerCover X h y := by
    rw [Finset.sum_sub_distrib]
    apply (le_abs_self _).trans
    have hz (k : ℕ) : (k : ZMod 1) = 0 := Subsingleton.elim ..
    simpa [psiAP,theta,s,w,hz] using hsum
  dsimp only
  rw [← Finset.sum_sub_distrib]
  apply (norm_sum_le _ _).trans
  apply le_trans _ he
  apply Finset.sum_le_sum
  intro n _
  change ‖(w n : ℂ) * χ (n : ZMod q) - (vonMangoldt n : ℂ) * χ (n : ZMod q)‖ ≤ _
  rw [← sub_mul, norm_mul, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
    abs_sub_comm, abs_of_nonneg (hnon n)]
  exact mul_le_of_le_one_right (hnon n) (χ.norm_le_one _)

open scoped Classical in
def hbFiniteMean {k : ℕ} (q : ℕ) [NeZero q] (X h : ℝ) (s : Finset ℕ) : ℝ :=
  (∑ χ : DirichletCharacter ℂ q, ‖(∑ j ∈ Finset.range k,
    ((-1 : ℂ)^j * (k.choose (j+1) : ℂ)) * ∑ n ∈ s,
      ((∏ i ∈ Finset.range (2*(j+1)), ShortAPHeathBrown.factor
          (ShortAPHeathBrown.rangeCutoff X k) j i) n : ℂ) * χ (n : ZMod q)) -
        (if χ = 1 then (h : ℂ) else 0)‖) / (q.totient : ℝ)

def hbCharacterMean {k : ℕ} (q : ℕ) [NeZero q] (X y h : ℝ) : ℝ :=
  hbFiniteMean (k := k) q X h (ShortAPHeathBrown.shortWindow y (y+h))

/-- Direct link from the paper's exact character-twisted Heath--Brown identity
to the maximal prime error in the frozen statement, before smoothing. -/
theorem err_le_hbCharacterMean {q k : ℕ} [NeZero q] (hk : 0 < k)
    {X h y : ℝ} (hy : 0 ≤ y) (hh : 0 ≤ h) (hX : y+h ≤ X) :
    err q h y ≤ hbCharacterMean (k := k) q X y h + powerCover X h y := by
  classical
  let s := Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊
  let A (χ : DirichletCharacter ℂ q) := ∑ n ∈ s,
    ((if n.Prime then Real.log (n : ℝ) else 0 : ℝ) : ℂ) * χ (n : ZMod q)
  let B (χ : DirichletCharacter ℂ q) := ∑ n ∈ s, (vonMangoldt n : ℂ) * χ (n : ZMod q)
  let P (χ : DirichletCharacter ℂ q) : ℂ := if χ = 1 then h else 0
  have hsame : s = ShortAPHeathBrown.shortWindow y (y+h) := by
    ext n
    rw [ShortAPHeathBrown.mem_shortWindow, ← mem_window hy hh]
  have hB (χ : DirichletCharacter ℂ q) := ShortAPHeathBrown.heathBrown_short_window
    (y := y) (by linarith : 0 ≤ X) hX hk χ
  have hnorm (χ : DirichletCharacter ℂ q) :
      ‖A χ - P χ‖ ≤ ‖B χ - P χ‖ + powerCover X h y := by
    have h := dist_triangle (A χ) (B χ) (P χ)
    simp only [dist_eq_norm] at h
    rw [add_comm] at h
    exact h.trans (add_le_add_right (twisted_weight_replacement χ hy hh hX) _)
  have hφ : 0 < (q.totient : ℝ) := by exact_mod_cast Nat.totient_pos.mpr (NeZero.pos q)
  apply (err_le_twisted_mean q y h).trans
  change (∑ χ, ‖A χ - P χ‖) / (q.totient : ℝ) ≤ _
  have hmass : (∑ χ : DirichletCharacter ℂ q, ‖B χ - P χ‖) / (q.totient : ℝ) =
      hbCharacterMean (k := k) q X y h := by
    unfold hbCharacterMean hbFiniteMean
    simp only [B,P,hsame,hB]
  rw [← hmass, div_add' _ _ _ hφ.ne']
  apply div_le_div_of_nonneg_right _ hφ.le
  have hh' := Finset.sum_le_sum (s := Finset.univ) (fun χ _ => hnorm χ)
  simpa [Finset.sum_add_distrib, nsmul_eq_mul, ← Nat.card_eq_fintype_card,
    DirichletCharacter.card_eq_totient_of_hasEnoughRootsOfUnity, mul_comm] using hh'

def hbMeanSum (k Q : ℕ) (X h : ℝ) (p : ℕ × ℕ) : ℝ :=
  ∑ q ∈ Finset.Icc 1 Q, if hq : q = 0 then 0 else
    letI : NeZero q := ⟨hq⟩
    hbFiniteMean (k := k) q X h (Finset.Icc (p.1+1) p.2)

/-- The full averaging and both endpoint floors from the frozen statement are retained. -/
theorem integral_err_le_integral_hbMeanSum {k : ℕ} (hk : 0 < k) {x h : ℝ} (Q : ℕ)
    (hx : 0 ≤ x) (hh : 0 ≤ h) (hhx : h ≤ x) :
    (∫ y in x..2*x, ∑ q ∈ Finset.Icc 1 Q, err q h y) ≤
    (∫ y in x..2*x, hbMeanSum k Q (3*x) h (⌊y⌋₊,⌊y+h⌋₊)) +
      (Q : ℝ) * h * (Chebyshev.psi (3*x) - Chebyshev.theta (3*x)) := by
  have hxx : x ≤ 2*x := by linarith
  have hθ := intervalIntegrable_errSum Q h x (2*x) hxx
  have hHB := intervalIntegrable_floorPair (hbMeanSum k Q (3*x) h) h x (2*x) hxx
  have hP : IntervalIntegrable (fun y => (Q : ℝ) * powerCover (3*x) h y)
      MeasureTheory.volume x (2*x) := ((integrable_powerCover _ _).const_mul _).intervalIntegrable
  apply le_trans _ (add_le_add_right (integral_powerCover_moduli (Q := Q) hx hh) _)
  rw [← intervalIntegral.integral_add hHB hP]
  apply intervalIntegral.integral_mono_on hxx hθ (hHB.add hP)
  intro y hy
  have hy0 := hx.trans hy.1
  have hsame : ShortAPHeathBrown.shortWindow y (y+h) = Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊ := by
    ext n; rw [ShortAPHeathBrown.mem_shortWindow, mem_window hy0 hh]
  unfold hbMeanSum
  have hsum := Finset.sum_le_sum (s := Finset.Icc 1 Q) (fun q hq => by
    have hn : q ≠ 0 := by have := (Finset.mem_Icc.mp hq).1; omega
    have : NeZero q := ⟨hn⟩
    have H := err_le_hbCharacterMean (q := q) hk hy0 hh (by linarith [hy.2] : y+h ≤ 3*x)
    exact show err q h y ≤ (if Hq : q = 0 then 0 else
      letI : NeZero q := ⟨Hq⟩; hbFiniteMean (k := k) q (3*x) h (Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊)) +
        powerCover (3*x) h y from by simpa [hn,hbCharacterMean,hsame] using H)
  simpa [Finset.sum_add_distrib, Nat.card_Icc, nsmul_eq_mul] using hsum

/-- Sufficient analytic input on the four-term Heath--Brown decomposition.
The subtraction of h occurs only on the principal character, before its norm. -/
def HBMeanUpper : Prop := ∃ C : ℝ, 0 < C ∧ ∀ᶠ x : ℝ in Filter.atTop,
  ∀ t : ℝ, 5/8 ≤ t → t ≤ 1 → ∀ Q : ℕ, 1 ≤ Q →
  (Q : ℝ)^2 ≤ x^t / x^((1-t)/3+(1:ℝ)/16) →
  (∫ y in x..2*x, hbMeanSum 4 Q (3*x) (x^t) (⌊y⌋₊,⌊y+x^t⌋₊)) ≤
    C * (x^t*x) / (Real.log x)^18

theorem upperBranch_of_HBMeanUpper (H : HBMeanUpper) : UpperBranch 18 (1/16) := by
  obtain ⟨C,hC,h⟩ := H
  obtain ⟨K,hK,hk⟩ := power_error_absorbed
  obtain ⟨b,hb⟩ := Filter.eventually_atTop.1 (h.and hk)
  obtain ⟨N,hN⟩ := exists_nat_ge b
  refine ⟨C+K, by linarith, N, ?_⟩
  intro x t hxN hx _ ht ht' Q hQ hsize
  obtain ⟨h₁,h₂⟩ := hb x (hN.trans hxN)
  have hp := integral_err_le_integral_hbMeanSum (k := 4) (by decide) Q
    (by linarith : 0 ≤ x) (Real.rpow_nonneg (by linarith : 0 ≤ x) t)
    (by simpa using Real.rpow_le_rpow_of_exponent_le hx ht')
  exact hp.trans ((add_le_add (h₁ t ht ht' Q hQ hsize) (h₂ t Q ht' hsize)).trans_eq (by ring))

end
end ShortAP

end

