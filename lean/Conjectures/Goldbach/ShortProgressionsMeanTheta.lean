    rw [Real.div_rpow (by positivity : 0≤2*x) hR.le,
      Real.mul_rpow (by norm_num : (0:ℝ)≤2) hx.le,
      Real.rpow_add hx,Real.rpow_natCast,Real.rpow_sub hR]
    field_simp
