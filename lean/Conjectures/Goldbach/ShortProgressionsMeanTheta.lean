    rw [Real.mul_rpow (by norm_num : (0:ℝ)≤2) (Real.rpow_nonneg hx.le _),
      ← Real.rpow_mul hx.le]
    have htwo : (2:ℝ)^e*2^(a-e)=2^a := by
      rw [← Real.rpow_add (by norm_num : (0:ℝ)<2)]
      congr 1
      ring
