namespace ShortAPDualMoment
open MeasureTheory ShortAPLogWeight ShortAPCriticalMain
noncomputable section

def moment {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ) : ℝ :=
  ∫ u : ℝ, ‖poly χ (t+u) M‖^2/(1+u^2)

private theorem integrable_moment {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ) :
    Integrable (fun u : ℝ => ‖poly χ (t+u) M‖^2/(1+u^2)) := by
  have hc : Continuous (fun u : ℝ => poly χ (t+u) M) := by
    unfold poly
    apply continuous_finsetSum
    intro n hn
    have h : (n:ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)
    apply continuous_const.div
    · unfold point; fun_prop (disch := assumption)
    · exact fun _ => Complex.cpow_ne_zero_iff.mpr (Or.inl h)
  apply (integrable_inv_one_add_sq.const_mul ((M:ℝ)^2)).mono'
    (((hc.norm.pow 2).div (by fun_prop) (fun u => by positivity)).aestronglyMeasurable)
  filter_upwards with u
  change ‖‖poly χ (t+u) M‖^2 / (1+u^2)‖ ≤ M^2 * (1+u^2)⁻¹
  rw [Real.norm_of_nonneg (div_nonneg (sq_nonneg _) (by positivity)), div_eq_mul_inv]
  apply mul_le_mul_of_nonneg_right _ (by positivity)
  apply pow_le_pow_left₀ (norm_nonneg _)
  apply (norm_sum_le _ _).trans
  calc
    _ ≤ ∑ _n ∈ Finset.Icc 1 M, (1:ℝ) := by
      apply Finset.sum_le_sum
      intro n hn
      have hn' : 1 ≤ n := (Finset.mem_Icc.mp hn).1
      rw [norm_div,Complex.norm_natCast_cpow_of_pos hn']
      simp only [point, Complex.add_re, Complex.mul_I_re, Complex.ofReal_im, neg_zero, add_zero]
      apply (div_le_one (Real.rpow_pos_of_pos (by exact_mod_cast hn') _)).2
      exact (χ.norm_le_one _).trans (Real.one_le_rpow (by exact_mod_cast hn') (by norm_num))
    _ = _ := by simp [Nat.card_Icc]

/-- Cauchy--Schwarz in the measure du/(1+u²), for the actual shortened
polynomial. Its total mass π is independent of the frequency and conductor. -/
theorem dualMass_sq_le {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ) :
    (dualMass χ t M)^2 ≤ Real.pi * moment χ t M := by
  let f (u : ℝ) := ‖poly χ (t+u) M‖
  let b := dualMass χ t M / Real.pi
  have h0 := integrable_inv_one_add_sq
  have h1 := poly_cauchy_integrable χ t M
  have h2 := integrable_moment χ t M
  have H : 0 ≤ (∫ u : ℝ, f u ^ 2 / (1+u^2) - (2*b)*(f u/(1+u^2)) +
      b^2 * (1+u^2)⁻¹) := by
    apply integral_nonneg
    intro u
    calc 0 ≤ (f u-b)^2/(1+u^2) := by positivity
         _ = _ := by ring
  change Integrable (fun u => f u ^ 2 / (1+u^2)) at h2
  change Integrable (fun u => f u / (1+u^2)) at h1
  have hsub : Integrable (fun u => f u ^ 2 / (1+u^2) - (2*b)*(f u/(1+u^2))) :=
    h2.sub (h1.const_mul (2*b))
  rw [integral_add hsub (h0.const_mul (b^2)),
    integral_sub h2 (h1.const_mul (2*b)), integral_const_mul, integral_const_mul,
    integral_univ_inv_one_add_sq] at H
  change 0 ≤ moment χ t M - (2*b)*dualMass χ t M + b^2*Real.pi at H
  have hb : b * Real.pi = dualMass χ t M := div_mul_cancel₀ _ Real.pi_pos.ne'
  have hp := mul_nonneg H Real.pi_pos.le
  nlinarith only [hp, hb, show b*b*Real.pi^2 = (dualMass χ t M)^2 by rw [← hb]; ring,
    show b*dualMass χ t M*Real.pi = (dualMass χ t M)^2 by rw [← hb]; ring]

end
end ShortAPDualMoment

end

