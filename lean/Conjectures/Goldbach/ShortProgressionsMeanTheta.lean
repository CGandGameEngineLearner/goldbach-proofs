namespace ShortAPLongFactorEnergy

open Filter MeasureTheory Set ShortAPFactorSampling ShortAPComplementSampling
open ShortAPCriticalMain ShortAPDualSplit ShortAPSmoothedFactor ShortAPDyadicPartition
open scoped BigOperators Interval

noncomputable section

abbrev AF := ArithmeticFunction ℂ

private def phaseCoeff (M : ℕ) (u : ℝ) : AF :=
  ⟨fun n => if 1 ≤ n ∧ n ≤ M then (n:ℂ)^(-((u:ℂ)*Complex.I)) else 0, by simp⟩

private theorem phaseCoeff_support (M : ℕ) (u : ℝ) (n : ℕ) (hn : M < n) :
    phaseCoeff M u n = 0 := by
  simp [phaseCoeff, not_le_of_gt hn]

private theorem phaseCoeff_bound (M : ℕ) (u : ℝ) (n : ℕ) (hn : 1 ≤ n) :
    ‖phaseCoeff M u n‖ ≤ 1 := by
  by_cases h : n ≤ M
  · change ‖if 1 ≤ n ∧ n ≤ M then (n:ℂ)^(-((u:ℂ)*Complex.I)) else 0‖ ≤ 1
    rw [ite_eq_left ⟨hn,h⟩, Complex.norm_natCast_cpow_of_pos hn]
    simp [Complex.mul_re]
  · rw [phaseCoeff_support M u n (lt_of_not_ge h), norm_zero]
    exact zero_le_one

/-- Absorb the frequency translation of the shortened factor into coefficients
independent of the character and the unshifted frequency. -/
private theorem phaseCoeff_factor (M : ℕ) (u t : ℝ) {q : ℕ} (χ : DirichletCharacter ℂ q) :
    factor M (phaseCoeff M u) χ (point t) = poly χ (t+u) M := by
  apply Finset.sum_congr rfl
  intro n hn
  have hn0 : (n:ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)
  have hz : point (t+u) = point t+((u:ℂ)*Complex.I) := by
    unfold point
    push_cast
    ring
  change phaseCoeff M u n * χ (n:ZMod q)/(n:ℂ)^(point t) =
    χ (n:ZMod q)/(n:ℂ)^(point (t+u))
  simp only [phaseCoeff,ArithmeticFunction.coe_mk,ite_eq_left (Finset.mem_Icc.mp hn)]
  rw [hz,Complex.cpow_add _ _ hn0,Complex.cpow_neg]
  ring

private theorem continuous_factor (N : ℕ) (f : AF) {q : ℕ} (χ : DirichletCharacter ℂ q) :
    Continuous (fun t : ℝ => factor N f χ (point t)) := by
  unfold factor
  refine continuous_finsetSum _ (fun n hn => ?_)
  have hn0 : (n:ℂ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)
  have h : Continuous (fun t : ℝ => point t) := by unfold point; fun_prop
  have hp := h.const_cpow (Or.inl hn0)
  exact continuous_const.div hp (fun _ => Complex.cpow_ne_zero_iff.mpr (Or.inl hn0))

private theorem continuous_poly (M : ℕ) {q : ℕ} (χ : DirichletCharacter ℂ q) :
    Continuous (fun t : ℝ => poly χ t M) := by
  have h := continuous_factor M (phaseCoeff M 0) χ
  convert h using 1
  funext t
  simpa only [add_zero] using (phaseCoeff_factor M 0 t χ).symm

private theorem norm_factor_le_coeff_sum (N : ℕ) (f : AF) {q : ℕ} (χ : DirichletCharacter ℂ q)
    (t : ℝ) : ‖factor N f χ (point t)‖ ≤ ∑ n ∈ Finset.Icc 1 N, ‖f n‖ := by
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun n hn => ?_)
  have hn₁ := (Finset.mem_Icc.mp hn).1
  have hR : (point t).re = 1/2 := by simp [point]
  have hden : 1 ≤ ‖(n:ℂ)^(point t)‖ := by
    rw [Complex.norm_natCast_cpow_of_pos hn₁,hR]
    exact Real.one_le_rpow (by exact_mod_cast hn₁) (by norm_num)
  rw [norm_div,norm_mul]
  exact (div_le_self (mul_nonneg (norm_nonneg _) (norm_nonneg _)) hden).trans
    (mul_le_of_le_one_right (norm_nonneg _) (χ.norm_le_one _))

private theorem norm_poly_le_length (M : ℕ) {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) :
    ‖poly χ t M‖ ≤ M := by
  rw [← show factor M (phaseCoeff M 0) χ (point t) = poly χ t M by
    simpa only [add_zero] using phaseCoeff_factor M 0 t χ]
  refine (norm_factor_le_coeff_sum M (phaseCoeff M 0) χ t).trans ?_
  calc
    _ ≤ ∑ _n ∈ Finset.Icc 1 M, (1:ℝ) :=
      Finset.sum_le_sum fun n hn => phaseCoeff_bound M 0 n (Finset.mem_Icc.mp hn).1
    _ = _ := by simp [Nat.card_Icc]

/-- Lemma 3.1 on a critical-line polynomial, with its divisor-coefficient
energy evaluated. The interval is a set interval and the characters may
be restricted to any finite subfamily. -/
theorem critical_hybrid {A Q m r : ℕ} (hQ : 1 ≤ Q) {T : ℝ} (hT : 1 ≤ T)
    (I : Finset ShortAP.CharIndex) (hI : I ⊆ ShortAP.primitiveFamily Q)
    (f : AF) (hf : ∀ n ∈ Finset.Icc 1 A,
      ‖f n‖ ≤ ((ArithmeticFunction.zeta^m) n:ℝ)*(Real.log n)^r) :
    (∑ χ ∈ I, ∫ t in Icc (-T) T, ‖factor A f χ.2 (point t)‖^2) ≤
      ((8*Real.pi)*(Real.pi+1))*((Q:ℝ)^2*T+A) *
        ((Real.log A)^r)^2 * (1+Real.log A)^(m*m) := by
  let a : ℕ → ℂ := f
  let c := ShortAPLargeValues.criticalCoeff a
  have hf' : ∀ n ∈ Finset.Icc 1 A,
      ‖a n‖ ≤ ((ArithmeticFunction.zeta^m) n:ℝ)*(Real.log n)^(r:ℝ) := by
    intro n hn
    rw [Real.rpow_natCast]
    exact hf n hn
  have hE := ShortAPDivisor.critical_divisor_energy A m (r:ℝ) (Nat.cast_nonneg _) a hf'
  rw [Real.rpow_natCast] at hE
  have hHybrid := ShortAP.hybrid_character_mean_square A Q T hQ hT c
  have hEval (χ : ShortAP.CharIndex) (t : ℝ) :
      factor A f χ.2 (point t) =
        ∑ n ∈ Finset.Icc 1 A, c n * χ.2 (n:ZMod χ.1)/(n:ℂ)^((t:ℂ)*Complex.I) := by
    apply Finset.sum_congr rfl
    intro n hn
    have hn0 : (n:ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)
    unfold c ShortAPLargeValues.criticalCoeff point
    rw [Complex.cpow_add _ _ hn0]
    ring
  have h0 : 0 ≤ (8*Real.pi)*(Real.pi+1)*((Q:ℝ)^2*T+A) := by
    have ht0 : 0 ≤ T := by linarith
    positivity
  calc
    _ ≤ ∑ χ ∈ ShortAP.primitiveFamily Q, ∫ t in Icc (-T) T, ‖factor A f χ.2 (point t)‖^2 :=
      Finset.sum_le_sum_of_subset_of_nonneg hI fun _ _ _ => integral_nonneg fun _ => sq_nonneg _
    _ = ∑ q ∈ Finset.Icc 1 Q, ∑ χ ∈ ShortAP.primitiveChars q, ∫ t in -T..T,
          ‖∑ n ∈ Finset.Icc 1 A, c n * χ (n:ZMod q)/(n:ℂ)^((t:ℂ)*Complex.I)‖^2 := by
      simp only [hEval, ShortAP.primitiveFamily, Finset.sum_sigma, integral_Icc_eq_integral_Ioc,
        intervalIntegral.integral_of_le (show -T ≤ T by linarith)]
    _ ≤ _ := hHybrid
    _ = ((8*Real.pi)*(Real.pi+1))*((Q:ℝ)^2*T+A) *
        (∑ n ∈ Finset.Icc 1 A, ‖a n‖^2/(n:ℝ)) := by
      simp only [c,ShortAPLargeValues.norm_criticalCoeff_sq]
    _ ≤ _ := (mul_le_mul_of_nonneg_left hE h0).trans_eq (by ring)

/-- For a fixed frequency translation, one shortened factor and the genuine
complementary factors form a single finite Dirichlet polynomial. -/
theorem shifted_product_hybrid {ι : Type*} [DecidableEq ι] {s : Finset ι} {j : ι}
    (hj : j ∈ s) (N d : ι → ℕ) (f : ι → AF) {Q : ℕ} (hQ : 1 ≤ Q) {T : ℝ} (hT : 1 ≤ T)
    (I : Finset ShortAP.CharIndex) (hI : I ⊆ ShortAP.primitiveFamily Q)
    (hSupport : ∀ i ∈ s.erase j, ∀ n > N i, f i n = 0)
    (hCoeff : ∀ i ∈ s.erase j, ∀ n : ℕ, 1 ≤ n → ‖f i n‖ ≤ (Real.log n)^d i)
    (M : ℕ) (u : ℝ) :
    let A := M * ∏ i ∈ s.erase j, N i
    let r := ∑ i ∈ s.erase j, d i
    (∑ χ ∈ I, ∫ t in Icc (-T) T,
      ‖poly χ.2 (t+u) M * (∏ i ∈ s.erase j, factor (N i) (f i) χ.2 (point t))‖^2) ≤
      ((8*Real.pi)*(Real.pi+1))*((Q:ℝ)^2*T+A) *
        ((Real.log A)^r)^2 * (1+Real.log A)^(s.card*s.card) := by
  intro A r
  let N' := Function.update N j M
  let f' := Function.update f j (phaseCoeff M u)
  let d' := Function.update d j 0
  have hA : ∏ i ∈ s, N' i = A := by
    dsimp only [N',A]
    rw [Finset.prod_update_of_mem hj,Finset.sdiff_singleton_eq_erase]
  have hr : ∑ i ∈ s, d' i = r := by
    dsimp only [d',r]
    rw [Finset.sum_update_of_mem hj,Finset.sdiff_singleton_eq_erase,zero_add]
  have hs' : ∀ i ∈ s, ∀ n > N' i, f' i n = 0 := by
    intro i hi n hn
    by_cases h : i = j
    · subst i
      simpa only [f',Function.update_self] using phaseCoeff_support M u n (by simpa [N'] using hn)
    · have hh : i ∈ s.erase j := Finset.mem_erase.mpr ⟨h,hi⟩
      simpa only [f', Function.update_of_ne h] using hSupport i hh n
        (by simpa only [N',Function.update_of_ne h] using hn)
  have hc' : ∀ i ∈ s, ∀ n : ℕ, 1 ≤ n → ‖f' i n‖ ≤ (Real.log n)^d' i := by
    intro i hi n hn
    by_cases h : i = j
    · subst i
      simpa [f',d'] using phaseCoeff_bound M u n hn
    · simpa only [f', d', Function.update_of_ne h] using hCoeff i (Finset.mem_erase.mpr ⟨h,hi⟩) n hn
  let a := ∏ i ∈ s, f' i
  have hBudget (n : ℕ) (_hn : n ∈ Finset.Icc 1 A) :
      ‖a n‖ ≤ ((ArithmeticFunction.zeta^s.card) n:ℝ)*(Real.log n)^r := by
    rw [← hr]
    exact convolution_product_coeff s f' d' hc' n
  have hEval (χ : ShortAP.CharIndex) (t : ℝ) :
      factor A a χ.2 (point t) = poly χ.2 (t+u) M *
        (∏ i ∈ s.erase j, factor (N i) (f i) χ.2 (point t)) := by
    rw [← hA]
    unfold a
    rw [factor_convolution_product s N' f' χ.2 (point t) hs',
      ← Finset.mul_prod_erase s (fun i => factor (N' i) (f' i) χ.2 (point t)) hj]
    have hhead : factor (N' j) (f' j) χ.2 (point t) = poly χ.2 (t+u) M := by
      simpa [N',f'] using phaseCoeff_factor M u t χ.2
    rw [hhead]
    congr 1
    exact Finset.prod_congr rfl fun i hi => by
      simp only [N',f',Function.update_of_ne (Finset.mem_erase.mp hi).1]
  simpa only [hEval] using critical_hybrid hQ hT I hI a hBudget

set_option maxHeartbeats 900000 in
/-- The actual shortened long-factor moment, after multiplying by the
complement and integrating over any measurable subsets of the band.
The two-dimensional kernel is verified integrable before interchanging. -/
theorem shortened_product_moment (δ : ℝ) (hδ : 0 < δ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ {ι : Type} [DecidableEq ι] (s : Finset ι) {j : ι}
      (hj : j ∈ s) (N d : ι → ℕ) (f : ι → AF) {Q : ℕ} (hQ : 1 ≤ Q) {T Q₀ : ℝ}
      (hT : 1 ≤ T) (I : Finset ShortAP.CharIndex) (hI : I ⊆ ShortAP.primitiveFamily Q)
      (hPrim : ∀ χ ∈ I, 1 < χ.1 ∧ χ.2.IsPrimitive ∧ (χ.1:ℝ) ≤ Q₀)
      (H k i b : ℕ) (hi : i < k+1) (hb : 1 ≤ scale b)
      (hSupport : ∀ l ∈ s.erase j, ∀ n > N l, f l n = 0)
      (hCoeff : ∀ l ∈ s.erase j, ∀ n : ℕ, 1 ≤ n → ‖f l n‖ ≤ (Real.log n)^d l)
      (P : ShortAP.CharIndex → Set ℝ) (hP : ∀ χ ∈ I, MeasurableSet (P χ))
      (hBand : ∀ χ ∈ I, P χ ⊆ Icc (-(2*T)) (2*T)),
      let M := dualCutoff δ Q₀ (2*T) (scale b)
      let A := M * ∏ l ∈ s.erase j, N l
      let r := ∑ l ∈ s.erase j, d l
      (∑ χ ∈ I, ∫ t in P χ, ‖boxPolynomial H k i b χ.2 (point t) *
        (∏ l ∈ s.erase j, factor (N l) (f l) χ.2 (point t))‖^2) ≤
        K*((Q:ℝ)^2*(2*T)+A) * (Real.log (2*scale b))^(2*logDegree i) *
          ((Real.log A)^r)^2*(1+Real.log A)^(s.card*s.card) := by
  obtain ⟨K,hK,hShort⟩ := ShortAPShortenedBox.shortened_box_second_moment δ hδ
  let C := (8*Real.pi)*(Real.pi+1)
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  refine ⟨K*C*Real.pi,mul_nonneg (mul_nonneg hK hC) Real.pi_pos.le,?_⟩
  intro ι _ s j hj N d f Q hQ T Q₀ hT I hI hPrim H k i b hi hb hSupport hCoeff P hP hBand M A r
  let B := Icc (-(2*T)) (2*T)
  let μ : Measure ℝ := volume.restrict B
  let G (χ : ShortAP.CharIndex) (t : ℝ) :=
    ∏ l ∈ s.erase j, factor (N l) (f l) χ.2 (point t)
  let F (χ : ShortAP.CharIndex) (t u : ℝ) :=
    ‖poly χ.2 (t+u) M * G χ t‖^2/(1+u^2)
  let L := (Real.log (2*scale b))^(2*logDegree i)
  let R := C*((Q:ℝ)^2*(2*T)+A) * ((Real.log A)^r)^2*(1+Real.log A)^(s.card*s.card)
  have hL : 0 ≤ L := pow_nonneg (Real.log_nonneg (by linarith)) _
  have ht2 : 2 ≤ 2*T := by linarith
  have hμ : volume B ≠ ⊤ := measure_Icc_lt_top.ne
  have hF (χ : ShortAP.CharIndex) : Integrable (Function.uncurry (F χ)) (μ.prod volume) := by
    let V : ℝ := ∏ l ∈ s.erase j, ∑ n ∈ Finset.Icc 1 (N l), ‖f l n‖
    let D := ((M:ℝ)*V)^2
    have hG (t : ℝ) : ‖G χ t‖ ≤ V := by
      dsimp only [G,V]
      rw [norm_prod]
      exact Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _)
        fun l _ => norm_factor_le_coeff_sum (N l) (f l) χ.2 t
    have hContG : Continuous (G χ) :=
      continuous_finsetProd _ (fun l _ => continuous_factor (N l) (f l) χ.2)
    have hCont : Continuous (Function.uncurry (F χ)) := by
      have hp : Continuous (fun w : ℝ×ℝ => poly χ.2 (w.1+w.2) M) :=
        (continuous_poly M χ.2).comp (continuous_fst.add continuous_snd)
      have hg : Continuous (fun w : ℝ×ℝ => G χ w.1) := hContG.comp continuous_fst
      exact ((hp.mul hg).norm.pow 2).div (by fun_prop) (fun w => by positivity)
    have hConst : Integrable (fun _ : ℝ => D) μ := integrableOn_const hμ
    refine (hConst.mul_prod integrable_inv_one_add_sq).mono' hCont.aestronglyMeasurable ?_
    filter_upwards with w
    change ‖‖poly χ.2 (w.1+w.2) M * G χ w.1‖^2/(1+w.2^2)‖ ≤ D*(1+w.2^2)⁻¹
    rw [Real.norm_of_nonneg (by positivity),div_eq_mul_inv]
    apply mul_le_mul_of_nonneg_right _ (by positivity)
    rw [norm_mul]
    exact pow_le_pow_left₀ (by positivity)
      (mul_le_mul (norm_poly_le_length M χ.2 _) (hG _) (norm_nonneg _) (Nat.cast_nonneg _)) 2
  have hFact (χ : ShortAP.CharIndex) (t : ℝ) :
      (∫ u : ℝ, F χ t u) = ‖G χ t‖^2 * ShortAPDualMoment.moment χ.2 t M := by
    unfold ShortAPDualMoment.moment
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with u
    dsimp only [F]
    rw [norm_mul,mul_pow]
    ring
  have hPoint (χ : ShortAP.CharIndex) (hχ : χ ∈ I) (t : ℝ) (ht : t ∈ P χ) :
      ‖boxPolynomial H k i b χ.2 (point t) * G χ t‖^2 ≤ K*L*(∫ u : ℝ, F χ t u) := by
    have h := hBand χ hχ ht
    have ht' : |t| ≤ 2*T := abs_le.mpr h
    obtain ⟨hq,hpr,hq₀⟩ := hPrim χ hχ
    have hs := hShort χ.2 hq hpr Q₀ (2*T) t hq₀ ht2 ht' H k i b hi hb
    rw [norm_mul,mul_pow,hFact]
    exact (mul_le_mul_of_nonneg_right hs (sq_nonneg _)).trans_eq (by
      change (K*L*ShortAPDualMoment.moment χ.2 t M)*‖G χ t‖^2 = _
      ring)
  have hOuter (χ : ShortAP.CharIndex) :
      IntegrableOn (fun t => K*L*(∫ u : ℝ, F χ t u)) B :=
    (hF χ).integral_prod_left.const_mul (K*L)
  have hSum :
      (∑ χ ∈ I, ∫ t in P χ, ‖boxPolynomial H k i b χ.2 (point t) * G χ t‖^2) ≤
      K*L*(∑ χ ∈ I, ∫ t in B, ∫ u : ℝ, F χ t u) := by
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun χ hχ => ?_
    calc
      _ ≤ ∫ t in P χ, K*L*(∫ u : ℝ, F χ t u) := by
        apply integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => sq_nonneg _)
          ((hOuter χ).mono_set (hBand χ hχ))
        filter_upwards [ae_restrict_mem (hP χ hχ)] with t ht
        exact hPoint χ hχ t ht
      _ ≤ ∫ t in B, K*L*(∫ u : ℝ, F χ t u) := setIntegral_mono_set (hOuter χ)
        (Filter.Eventually.of_forall fun t => mul_nonneg (mul_nonneg hK hL)
          (integral_nonneg fun u => div_nonneg (sq_nonneg _) (by positivity)))
        (Filter.Eventually.of_forall (hBand χ hχ))
      _ = _ := integral_const_mul _ _
  have hFixed (u : ℝ) : (∑ χ ∈ I, ∫ t in B, F χ t u) ≤ R*(1+u^2)⁻¹ := by
    simp only [F,div_eq_mul_inv,integral_mul_const,← Finset.sum_mul]
    exact mul_le_mul_of_nonneg_right (shifted_product_hybrid hj N d f hQ
      (by linarith : 1 ≤ 2*T) I hI hSupport hCoeff M u) (by positivity)
  have hIntegrated : (∑ χ ∈ I, ∫ t in B, ∫ u : ℝ, F χ t u) ≤ R*Real.pi := calc
    _ = ∑ χ ∈ I, ∫ u : ℝ, ∫ t in B, F χ t u := Finset.sum_congr rfl fun χ _ =>
      integral_integral_swap (hF χ)
    _ = ∫ u : ℝ, ∑ χ ∈ I, ∫ t in B, F χ t u :=
      (integral_finsetSum _ fun χ _ => (hF χ).integral_prod_right).symm
    _ ≤ ∫ u : ℝ, R*(1+u^2)⁻¹ := by
      apply integral_mono_of_nonneg (Filter.Eventually.of_forall fun u =>
        Finset.sum_nonneg fun χ _ => integral_nonneg fun _ => div_nonneg (sq_nonneg _) (by positivity))
        (integrable_inv_one_add_sq.const_mul R) (Filter.Eventually.of_forall hFixed)
    _ = _ := by rw [integral_const_mul,integral_univ_inv_one_add_sq]
  exact (hSum.trans (mul_le_mul_of_nonneg_left hIntegrated (mul_nonneg hK hL))).trans_eq (by
    change K*L*(R*Real.pi) = (K*C*Real.pi)*((Q:ℝ)^2*(2*T)+A)*L*
      ((Real.log A)^r)^2*(1+Real.log A)^(s.card*s.card)
    unfold R
    ring)

def extraExponent : ℝ := 2/31

def longLengthConstant (c C : ℝ) : ℝ :=
  (4:ℝ)^((33:ℝ)/31) * lengthConstant c C

private theorem longLengthConstant_ge_one {c C : ℝ} (hc : 1 ≤ c) (hC : 1 ≤ C) :
    1 ≤ longLengthConstant c C :=
  one_le_mul_of_one_le_of_one_le (Real.one_le_rpow (by norm_num) (by norm_num))
    (lengthConstant_ge_one hc hC)

/-- The actual support after the long smooth factor is shortened. -/
theorem shortened_product_length {ι : Type*} [DecidableEq ι] {s : Finset ι} {j : ι}
    (hj : j ∈ s) (hs : s.card ≤ 8) (N : ι → ℕ) (Y : ι → ℝ)
    {x c C D T L : ℝ} (hc : 1 ≤ c) (hD : 1 ≤ D) (hT : 1 ≤ T) (hL : 1 ≤ L)
    (hY : ∀ i ∈ s, (1:ℝ)/4 ≤ Y i) (hN : ∀ i ∈ s, (N i:ℝ) ≤ c*Y i)
    (hProd : ∏ i ∈ s, Y i ≤ C*x)
    (hlong : (D*T)^((33:ℝ)/64)*L^256 ≤ Y j) :
    ((dualCutoff extraExponent (2*D) (2*T) (Y j) * ∏ i ∈ s.erase j, N i : ℕ):ℝ)*L^256 ≤
      longLengthConstant c C*x := by
  let M := dualCutoff extraExponent (2*D) (2*T) (Y j)
  have hYj : 0 < Y j := by linarith [hY j hj]
  have hDT : 1 ≤ D*T := one_le_mul_of_one_le_of_one_le hD hT
  have hFloor : (M:ℝ) ≤ max 1 ((4*(D*T)/Y j)^((33:ℝ)/31)) := by
    dsimp only [M]
    rw [dualCutoff_eq_floor_max,show (2*D)*(2*T) = 4*(D*T) by ring,
      show (1:ℝ)+extraExponent = 33/31 by norm_num [extraExponent] ]
    exact Nat.floor_le (zero_le_one.trans (le_max_left _ _))
  have hM : (M:ℝ)*L^256 ≤ (4:ℝ)^((33:ℝ)/31)*Y j :=
    (mul_le_mul_of_nonneg_right hFloor (pow_nonneg (zero_le_one.trans hL) _)).trans
      (ShortAPFourthSection.shortening_support hDT hYj hL hlong)
  have hCompl := complement_support_limit (a := s.erase j) hj (by intro _ h; exact h) hs N Y hc hY hN hProd
  have h4 : 0 ≤ (4:ℝ)^((33:ℝ)/31) := Real.rpow_nonneg (by norm_num) _
  rw [Nat.cast_mul]
  calc
    _ = ((M:ℝ)*L^256) * ((∏ i ∈ s.erase j, N i : ℕ):ℝ) := by ring
    _ ≤ ((4:ℝ)^((33:ℝ)/31)*Y j) * ((∏ i ∈ s.erase j, N i : ℕ):ℝ) :=
      mul_le_mul_of_nonneg_right hM (Nat.cast_nonneg _)
    _ ≤ ((4:ℝ)^((33:ℝ)/31)*Y j) * (lengthConstant c C*(x/Y j)) :=
      mul_le_mul_of_nonneg_left hCompl (mul_nonneg h4 hYj.le)
    _ = longLengthConstant c C*((x/Y j)*Y j) := by unfold longLengthConstant; ring
    _ = _ := by rw [div_mul_cancel₀ _ hYj.ne']

private theorem long_log_budget {x Y A B : ℝ} {m r d : ℕ}
    (hx : 0 < x) (hL : 1 ≤ Real.log x) (hY : 1 ≤ Y) (hA : 1 ≤ A) (hB : 1 ≤ B)
    (hYs : Y ≤ B*x) (hAs : A ≤ B*x) (hm : m ≤ 8) (hd : d+r ≤ 1) :
    (Real.log (2*Y))^(2*d)*((Real.log A)^r)^2*(1+Real.log A)^(m*m) ≤
      (2+Real.log (2*B))^66*(Real.log x)^66 := by
  let g := 2+Real.log (2*B)
  have hBp : 0 < B := zero_lt_one.trans_le hB
  have hLg : 0 ≤ Real.log (2*B) := Real.log_nonneg (by linarith)
  have hg : 1 ≤ g := by dsimp only [g]; linarith
  have htop : 1+Real.log (2*B)+Real.log x ≤ g*Real.log x := by
    dsimp only [g]
    nlinarith only [mul_nonneg (show 0 ≤ 1+Real.log (2*B) by linarith) (sub_nonneg.mpr hL)]
  have hLog (z : ℝ) (hz : 0 < z) (hzs : z ≤ (2*B)*x) :
      Real.log z ≤ Real.log (2*B)+Real.log x := by
    rw [← Real.log_mul (by positivity : (2*B) ≠ 0) hx.ne']
    exact Real.log_le_log hz hzs
  have h₁ : Real.log (2*Y) ≤ g*Real.log x :=
    (hLog _ (by linarith) (by linarith only [hYs])).trans (by linarith only [htop])
  have h₂₀ : Real.log A ≤ Real.log (2*B)+Real.log x := hLog _ (by linarith) (by
    linarith only [hAs,mul_nonneg (zero_le_one.trans hB) hx.le])
  have h₂ : Real.log A ≤ g*Real.log x := by linarith only [h₂₀,htop]
  have h₃ : 1+Real.log A ≤ g*Real.log x := by linarith only [h₂₀,htop]
  have hLg' : 1 ≤ g*Real.log x := one_le_mul_of_one_le_of_one_le hg hL
  have hEp : 2*d+r*2+m*m ≤ 66 := by
    have := Nat.mul_le_mul hm hm
    omega
  have hA₀ : 0 ≤ Real.log A := Real.log_nonneg hA
  have hC₀ : 0 ≤ Real.log (2*Y) := Real.log_nonneg (by linarith)
  calc
    _ ≤ (g*Real.log x)^(2*d)*((g*Real.log x)^r)^2*(g*Real.log x)^(m*m) := by
      exact mul_le_mul
        (mul_le_mul (pow_le_pow_left₀ hC₀ h₁ _) (pow_le_pow_left₀ (pow_nonneg hA₀ _) (pow_le_pow_left₀ hA₀ h₂ _) _)
          (sq_nonneg _) (pow_nonneg (zero_le_one.trans hLg') _))
        (pow_le_pow_left₀ (by linarith) h₃ _) (pow_nonneg (by linarith) _)
        (mul_nonneg (pow_nonneg (zero_le_one.trans hLg') _) (sq_nonneg _))
    _ = (g*Real.log x)^(2*d+r*2+m*m) := by rw [← pow_mul, ← pow_add, ← pow_add]
    _ ≤ (g*Real.log x)^66 := pow_le_pow_right₀ hLg' hEp
    _ = _ := by rw [mul_pow]

set_option maxRecDepth 4096 in
set_option maxHeartbeats 1000000 in
/-- The genuine long smooth-factor branch of (4.9), in the moderate-height
range. The complement, the shortening and the hybrid sieve are all applied
to the actual polynomials; no pointwise or mean-square input is assumed. -/
theorem actual_long_factor_energy {c C : ℝ} (hc : 1 ≤ c) (hC : 1 ≤ C) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ᶠ x : ℝ in atTop, ∀ {ι : Type} [DecidableEq ι]
      (s : Finset ι) {j : ι} (hj : j ∈ s) (hs : s.card ≤ 8)
      (N d : ι → ℕ) (Y : ι → ℝ) (f : ι → AF)
      {Q : ℕ} (hQ : 1 ≤ Q) {D T β : ℝ} (hD : 1 ≤ D) (hT : 1 ≤ T) (hQD : (Q:ℝ) ≤ 2*D)
      (hβ : (1:ℝ)/32 ≤ β) (hHeight : D^2*T*x^β ≤ x*(Real.log x)^120)
      (I : Finset ShortAP.CharIndex) (hI : I ⊆ ShortAP.primitiveFamily Q)
      (hNonprincipal : ∀ χ ∈ I, 1 < χ.1)
      (H k i b : ℕ) (hi : i < k+1) (hb : Y j = scale b)
      (hY : ∀ l ∈ s, (1:ℝ)/4 ≤ Y l) (hN : ∀ l ∈ s, 1 ≤ N l ∧ (N l:ℝ) ≤ c*Y l)
      (hProd : ∏ l ∈ s, Y l ≤ C*x)
      (hLong : (D*T)^((33:ℝ)/64)*(Real.log x)^256 ≤ Y j)
      (hDegree : logDegree i + (∑ l ∈ s.erase j, d l) ≤ 1)
      (hSupport : ∀ l ∈ s.erase j, ∀ n > N l, f l n = 0)
      (hCoeff : ∀ l ∈ s.erase j, ∀ n : ℕ, 1 ≤ n → ‖f l n‖ ≤ (Real.log n)^d l)
      (P : ShortAP.CharIndex → Set ℝ) (hP : ∀ χ ∈ I, MeasurableSet (P χ))
      (hBand : ∀ χ ∈ I, P χ ⊆ Icc (-(2*T)) (2*T)),
      (∑ χ ∈ I, ∫ t in P χ, ‖boxPolynomial H k i b χ.2 (point t) *
        (∏ l ∈ s.erase j, factor (N l) (f l) χ.2 (point t))‖^2) *
        (Real.log x)^77 ≤ K*x := by
  obtain ⟨K,hK,hMoment⟩ := shortened_product_moment extraExponent (by norm_num [extraExponent])
  let B := longLengthConstant c C
  let g := 2+Real.log (2*B)
  have hB : 1 ≤ B := longLengthConstant_ge_one hc hC
  have hg : 0 ≤ g := by
    dsimp only [g]
    exact add_nonneg (by norm_num) (Real.log_nonneg (by linarith))
  refine ⟨K*g^66*(8+B),mul_nonneg (mul_nonneg hK (pow_nonneg hg _)) (by linarith),?_⟩
  have ho := (isLittleO_log_rpow_rpow_atTop ((263:ℕ):ℝ) (by norm_num : (0:ℝ)<1/32)).bound
    (by norm_num : (0:ℝ)<1)
  filter_upwards [eventually_ge_atTop (Real.exp 1),ho] with x hx hxLog
  intro ι _ s j hj hs N d Y f Q hQ D T β hD hT hQD hβ hHeight I hI hNonprincipal
    H k i b hi hb hY hN hProd hLong hDegree hSupport hCoeff P hP hBand
  let L := Real.log x
  have hL : 1 ≤ L := by
    dsimp only [L]
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hx
  have hLp : 0 < L := zero_lt_one.trans_le hL
  have hx0 : 0 < x := (Real.exp_pos _).trans_le hx
  have hx1 : 1 ≤ x := (Real.one_le_exp (by norm_num : (0:ℝ)≤1)).trans hx
  have hDT : 1 ≤ D*T := one_le_mul_of_one_le_of_one_le hD hT
  have hScale : 1 ≤ scale b := by
    have h := one_le_mul_of_one_le_of_one_le (Real.one_le_rpow hDT (by norm_num : (0:ℝ) ≤ 33/64))
      (one_le_pow₀ (n := 256) hL)
    exact h.trans (hLong.trans_eq hb)
  have hPrim (χ : ShortAP.CharIndex) (hχ : χ ∈ I) :
      1 < χ.1 ∧ χ.2.IsPrimitive ∧ (χ.1:ℝ) ≤ 2*D := by
    have hh := Finset.mem_sigma.mp (hI hχ)
    have hq : 1 < χ.1 := hNonprincipal χ hχ
    have hq0 : χ.1 ≠ 0 := by omega
    have hqQ : (χ.1:ℝ) ≤ Q := by exact_mod_cast (Finset.mem_Icc.mp hh.1).2
    have hp : χ.2.IsPrimitive := by
      simpa [ShortAP.primitiveChars,hq0] using hh.2
    exact ⟨hq,hp,hqQ.trans hQD⟩
  let M := dualCutoff extraExponent (2*D) (2*T) (scale b)
  let A := M*∏ l ∈ s.erase j, N l
  let r := ∑ l ∈ s.erase j, d l
  have hA : 1 ≤ A := one_le_mul_of_one_le_of_one_le (one_le_dualCutoff ..)
    (Finset.one_le_prod₀ fun l hl => (hN l (Finset.erase_subset _ _ hl)).1)
  have hA₁ : (1:ℝ) ≤ A := by exact_mod_cast hA
  have hA256 : (A:ℝ)*L^256 ≤ B*x := by
    have h := shortened_product_length hj hs N Y hc hD hT hL hY
      (fun l hl => (hN l hl).2) hProd hLong
    simpa only [A,M,hb,B] using h
  have hAmax : (A:ℝ) ≤ B*x := (le_mul_of_one_le_right (zero_le_one.trans hA₁)
    (one_le_pow₀ hL)).trans hA256
  have hSmax : scale b ≤ B*x := by
    have h := complement_support_limit (a := ∅) hj (by simp) hs N Y hc hY
      (fun l hl => (hN l hl).2) hProd
    simp only [Finset.prod_empty,Nat.cast_one,hb,← mul_div_assoc] at h
    have h' := (le_div_iff₀ (zero_lt_one.trans_le hScale)).mp h
    rw [one_mul] at h'
    refine h'.trans (mul_le_mul_of_nonneg_right ?_ hx0.le)
    exact le_mul_of_one_le_left (zero_le_one.trans (lengthConstant_ge_one hc hC))
      (Real.one_le_rpow (by norm_num) (by norm_num))
  have hBudget := long_log_budget hx0 hL hScale hA₁ hB hSmax hAmax hs hDegree
  have hAbs : L^263 ≤ x^((1:ℝ)/32) := by
    have hl : 0 ≤ Real.log x := hLp.le
    have hLeft : 0 ≤ (Real.log x)^((263:ℕ):ℝ) := Real.rpow_nonneg hl _
    have hRight : 0 ≤ x^((1:ℝ)/32) := Real.rpow_nonneg hx0.le _
    simp only [Real.norm_eq_abs,abs_of_nonneg hLeft,abs_of_nonneg hRight,one_mul] at hxLog
    rw [Real.rpow_natCast] at hxLog
    exact hxLog
  have hH143 : (D^2*T)*L^143 ≤ x := by
    apply (le_of_mul_le_mul_right · (pow_pos hLp 120))
    calc
      _ = (D^2*T)*L^263 := by rw [mul_assoc, ← pow_add]
      _ ≤ (D^2*T)*x^β := mul_le_mul_of_nonneg_left
        (hAbs.trans (Real.rpow_le_rpow_of_exponent_le hx1 hβ))
        (mul_nonneg (sq_nonneg _) (zero_le_one.trans hT))
      _ ≤ _ := hHeight
  have hLength : ((Q:ℝ)^2*(2*T)+A)*L^143 ≤ (8+B)*x := by
    have hQsq := pow_le_pow_left₀ (Nat.cast_nonneg (α:=ℝ) Q) hQD 2
    have hqT : (Q:ℝ)^2*(2*T) ≤ 8*(D^2*T) :=
      (mul_le_mul_of_nonneg_right hQsq (by linarith)).trans_eq (by ring)
    have hqT' : (Q:ℝ)^2*(2*T)*L^143 ≤ 8*x :=
      (mul_le_mul_of_nonneg_right hqT (pow_nonneg hLp.le _)).trans
        (by rw [mul_assoc]; exact mul_le_mul_of_nonneg_left hH143 (by norm_num))
    have hA' : (A:ℝ)*L^143 ≤ B*x :=
      (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hL (by decide : 143 ≤ 256))
        (zero_le_one.trans hA₁)).trans hA256
    rw [add_mul,add_mul]
    exact add_le_add hqT' hA'
  have hE := hMoment s hj N d f hQ hT I hI hPrim H k i b hi hScale hSupport hCoeff P hP hBand
  let J := (Q:ℝ)^2*(2*T)+A
  have hJ : 0 ≤ J := add_nonneg
    (mul_nonneg (sq_nonneg _) (mul_nonneg (by norm_num) (zero_le_one.trans hT))) (Nat.cast_nonneg _)
  calc
    _ ≤ (K*J*(Real.log (2*scale b))^(2*logDegree i) *
        ((Real.log A)^r)^2*(1+Real.log A)^(s.card*s.card))*L^77 :=
      mul_le_mul_of_nonneg_right hE (pow_nonneg hLp.le _)
    _ ≤ (K*J*(g^66*L^66))*L^77 := by
      apply mul_le_mul_of_nonneg_right _ (pow_nonneg hLp.le _)
      calc
        _ = (K*J)*((Real.log (2*scale b))^(2*logDegree i)*
          ((Real.log A)^r)^2*(1+Real.log A)^(s.card*s.card)) := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_left hBudget (mul_nonneg hK hJ)
    _ = (K*g^66)*(J*L^143) := by ring
    _ ≤ _ := (mul_le_mul_of_nonneg_left hLength (mul_nonneg hK (pow_nonneg hg _))).trans_eq (by ring)

end
end ShortAPLongFactorEnergy

