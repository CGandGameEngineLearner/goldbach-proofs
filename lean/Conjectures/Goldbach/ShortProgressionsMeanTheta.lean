lemma V12o {k : ℕ} (m : Fin k → ℤ)
    (α : Fin k → AddCircle (1:ℝ)) : ‖V5 m α‖=1 := by
  simp [V5,norm_prod,fourier_apply]
theorem Vbv (s k N : ℕ) :
    (∫ α, ‖Vk k N α‖^(2*s) ∂Va k) =
