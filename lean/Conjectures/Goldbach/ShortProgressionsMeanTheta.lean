section

/-!
# Finite/dual-tail recombination for Lemma 3.3

The split and the logarithmic-weight lifting are independent of the estimates
that produce the dual series identity and its head and tail bounds.
-/

open MeasureTheory
open scoped BigOperators

namespace ShortAPDualSplit

open ShortAPLogWeight

noncomputable section

/-- Split off the terms `1,…,M` of an absolutely convergent dual series.
Only convergence of the tail is needed; the zeroth term is exactly zero. -/
theorem tsum_eq_head_add_tail (b : ℕ → ℂ) (hzero : b 0 = 0) (M : ℕ)
    (hTail : Summable (fun j : ℕ => ‖b (j + M + 1)‖)) :
    (∑' n : ℕ, b n) = (∑ n ∈ Finset.Icc 1 M, b n) + ∑' j : ℕ, b (j + M + 1) := by
  have hTail' : Summable (fun j : ℕ => b (j + (M + 1))) :=
    summable_norm_iff.mp (by simpa only [Nat.add_assoc] using hTail)
  have hb : Summable b := (summable_nat_add_iff (M + 1)).1 hTail'
  have hHead : ∑ n ∈ Finset.range (M + 1), b n = ∑ n ∈ Finset.Icc 1 M, b n := by
    rw [← Finset.sum_range_add_sum_Ico b (show 1 ≤ M + 1 by omega),
      Finset.Ico_add_one_right_eq_Icc, Finset.sum_range_one, hzero, zero_add]
  simpa only [hHead, ← Nat.add_assoc] using (hb.sum_add_tsum_nat_add (M + 1)).symm

theorem norm_mul_tsum_le_head_add_tail (b : ℕ → ℂ) (hzero : b 0 = 0) (M : ℕ)
    (hTail : Summable (fun j : ℕ => ‖b (j + M + 1)‖)) (w : ℂ) :
    ‖w * ∑' n : ℕ, b n‖ ≤ ‖w‖ * ‖∑ n ∈ Finset.Icc 1 M, b n‖ +
      ‖w‖ * ‖∑' j : ℕ, b (j + M + 1)‖ := by
  rw [tsum_eq_head_add_tail b hzero M hTail, mul_add]
  simpa only [norm_mul] using norm_add_le
    (w * (∑ n ∈ Finset.Icc 1 M, b n)) (w * (∑' j : ℕ, b (j + M + 1)))

/-- The normalization constant in the recombination is absolute. A uniform
bounded tail need not decay in `M`, because the `n=1` coefficient is retained. -/
theorem absorb_split_error :
    ∃ K : ℝ, 0 < K ∧ ∀ {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ),
      1 ≤ M → ∀ (b : ℕ → ℂ), b 0 = 0 →
      Summable (fun j : ℕ => ‖b (j + M + 1)‖) →
      ∀ (z w : ℂ) (A D : ℝ), 0 ≤ D → z = w * (∑' n : ℕ, b n) →
      ‖w‖ * ‖∑ n ∈ Finset.Icc 1 M, b n‖ ≤ A * dualMass χ t M →
      ‖w‖ * ‖∑' j : ℕ, b (j + M + 1)‖ ≤ D →
      ‖z‖ ≤ (A + D * K) * dualMass χ t M := by
  obtain ⟨K, hK, hAbsorb⟩ := absorb_bounded_remainder
  refine ⟨K, hK, ?_⟩
  intro q χ t M hM b hzero hsum z w A D hD hz hHead hTail
  apply hAbsorb χ t M hM z A D 1 hD le_rfl
  rw [mul_one, hz]
  exact (norm_mul_tsum_le_head_add_tail b hzero M hsum w).trans (add_le_add hHead hTail)

/-- The integer cutoff for the shorter polynomial in Lemma 3.3. -/
def dualCutoff (δ Q T N : ℝ) : ℕ := max 1 ⌊(Q * T / N) ^ (1 + δ)⌋₊

theorem one_le_dualCutoff (δ Q T N : ℝ) : 1 ≤ dualCutoff δ Q T N := le_max_left _ _

theorem dualCutoff_eq_floor_max (δ Q T N : ℝ) :
    dualCutoff δ Q T N = ⌊max 1 ((Q * T / N) ^ (1 + δ))⌋₊ := by
  let L : ℝ := (Q * T / N) ^ (1 + δ)
  change max 1 ⌊L⌋₊ = ⌊max 1 L⌋₊
  rcases le_total L 1 with h | h
  · have h' : ⌊L⌋₊ ≤ 1 := by simpa using Nat.floor_mono h
    simp [max_eq_left h, max_eq_left h']
  · have h' : 1 ≤ ⌊L⌋₊ := by simpa using Nat.floor_mono h
    rw [max_eq_right h', max_eq_right h]

/-- The actual critical-line coefficients before inserting the smooth weight. -/
def criticalCoeff {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (n : ℕ) : ℂ :=
  χ (n : ZMod q) / (n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I)

private theorem weightSum_eq_explicit {q : ℕ} (χ : DirichletCharacter ℂ q) (t N : ℝ)
    (g : ℝ → ℂ) (r : ℕ) :
    weightSum g r N (criticalCoeff χ t) =
      ∑ n ∈ Finset.Icc 1 ⌊4 * N⌋₊,
        (Real.log n : ℂ) ^ r * g ((n : ℝ) / N) * χ (n : ZMod q) /
          (n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I) := by
  simp only [weightSum, criticalCoeff, mul_div_assoc]

/-- The precise uniform estimate to be established for the unweighted smooth
sum. No claim of the analytic bound is built into this predicate. -/
def UniformUnweightedShortening (δ : ℝ) : Prop :=
  ∀ g : ℝ → ℂ, ContDiff ℝ (⊤ : ℕ∞) g →
    (∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) → ∃ C : ℝ, 0 ≤ C ∧
    ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive →
    ∀ Q T t N : ℝ, (q : ℝ) ≤ Q → 2 ≤ T → |t| ≤ T → 1 ≤ N →
      ‖∑ n ∈ Finset.Icc 1 ⌊4 * N⌋₊, g ((n : ℝ) / N) * χ (n : ZMod q) /
        (n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I)‖ ≤ C * dualMass χ t (dualCutoff δ Q T N)

private structure DirichletParameters where
  q : ℕ
  χ : DirichletCharacter ℂ q
  Q : ℝ
  T : ℝ
  t : ℝ
  N : ℝ
  hq : 1 < q
  hprim : χ.IsPrimitive
  hQ : (q : ℝ) ≤ Q
  hT : 2 ≤ T
  ht : |t| ≤ T
  hN : 1 ≤ N

/-- Promote the actual uniform unweighted estimate to any fixed logarithmic
power. The constant depends on `δ`, `r` and `g`, not on `q,Q,T,t,N` or `χ`. -/
theorem lift_uniform_shortening (δ : ℝ) (H : UniformUnweightedShortening δ) (r : ℕ)
    (g : ℝ → ℂ) (hg : ContDiff ℝ (⊤ : ℕ∞) g) (hs : ∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) :
    ∃ C : ℝ, 0 ≤ C ∧
    ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive →
    ∀ Q T t N : ℝ, (q : ℝ) ≤ Q → 2 ≤ T → |t| ≤ T → 1 ≤ N →
      ‖∑ n ∈ Finset.Icc 1 ⌊4 * N⌋₊,
        (Real.log n : ℂ) ^ r * g ((n : ℝ) / N) * χ (n : ZMod q) /
          (n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I)‖ ≤
      C * (Real.log (2 * N)) ^ r * dualMass χ t (dualCutoff δ Q T N) := by
  let B (d : DirichletParameters) := dualMass d.χ d.t (dualCutoff δ d.Q d.T d.N)
  have hB (d : DirichletParameters) : 0 ≤ B d := by
    unfold B dualMass
    exact integral_nonneg fun _ => div_nonneg (norm_nonneg _) (by positivity)
  have H' (f : ℝ → ℂ) (hf : ContDiff ℝ (⊤ : ℕ∞) f)
      (hfs : ∀ u ∉ Set.Icc (1 : ℝ) 4, f u = 0) : ∃ C : ℝ, 0 ≤ C ∧
      ∀ d : DirichletParameters, ‖weightSum f 0 d.N (criticalCoeff d.χ d.t)‖ ≤ C * B d := by
    obtain ⟨C, hC, h⟩ := H f hf hfs
    refine ⟨C, hC, fun d => ?_⟩
    simpa only [weightSum_eq_explicit, pow_zero, one_mul] using
      h d.χ d.hq d.hprim d.Q d.T d.t d.N d.hQ d.hT d.ht d.hN
  obtain ⟨C, hC, h⟩ := lift_log_power DirichletParameters.N
    (fun d => criticalCoeff d.χ d.t) B DirichletParameters.hN hB H' r g hg hs
  refine ⟨C, hC, ?_⟩
  intro q χ hq hp Q T t N hQ hT ht hN
  rw [← weightSum_eq_explicit]
  exact h ⟨q, χ, Q, T, t, N, hq, hp, hQ, hT, ht, hN⟩

end
end ShortAPDualSplit

end

