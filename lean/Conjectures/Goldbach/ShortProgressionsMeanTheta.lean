/-! The finite conductor partition adapts the two finset identities of
`DyadicMixedB4ConductorPartition` in B13BilateralVaughanReduction.lean
(goldbach-proofs 9e15333e527bef0fb439636fd9c07b40ab2617eb, Apache-2.0).
The prime window here is unchanged on induction as soon as its lower endpoint is ≥ q. -/

namespace ShortAP
open Finset
open scoped Classical
noncomputable section

private theorem sum_at_primitive_conductor {A : Type*} [AddCommMonoid A] {q d : ℕ}
    [NeZero q] (hd : d ∣ q) (F : DirichletCharacter ℂ q → A) :
    (∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q => χ.conductor = d), F χ) =
      ∑ ψ ∈ primitiveChars d, F (DirichletCharacter.changeLevel hd ψ) := by
  classical
  have hd0 : d ≠ 0 := by intro h; exact NeZero.ne q (Nat.eq_zero_of_zero_dvd (h ▸ hd))
  have : NeZero d := ⟨hd0⟩
  simp only [primitiveChars, dite_eq_right hd0]
  symm
  apply sum_bij (fun ψ _ => DirichletCharacter.changeLevel hd ψ)
  · intro ψ hp
    exact mem_filter.mpr ⟨mem_univ _, (DirichletCharacter.conductor_changeLevel ψ hd).trans
      (show ψ.IsPrimitive from (mem_filter.mp hp).2)⟩
  · intro χ _ ψ _ h
    exact DirichletCharacter.changeLevel_injective hd h
  · intro χ hp
    have he := (mem_filter.mp hp).2
    subst d
    exact ⟨χ.primitiveCharacter, mem_filter.mpr ⟨mem_univ _, χ.primitiveCharacter_isPrimitive⟩,
      χ.changeLevel_primitiveCharacter⟩
  · intro _ _; rfl

theorem sum_primitive_conductors {A : Type*} [AddCommMonoid A] {q : ℕ} [NeZero q]
    (F : DirichletCharacter ℂ q → A) : (∑ χ, F χ) =
      ∑ d ∈ q.divisors.attach, ∑ ψ ∈ primitiveChars d.1,
        F (DirichletCharacter.changeLevel (Nat.mem_divisors.mp d.2).1 ψ) := by
  classical
  have hm (χ : DirichletCharacter ℂ q) (_ : χ ∈ (univ : Finset (DirichletCharacter ℂ q))) :
      χ.conductor ∈ q.divisors := Nat.mem_divisors.mpr ⟨χ.conductor_dvd_level, NeZero.ne q⟩
  calc
    _ = ∑ d ∈ q.divisors, ∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q => χ.conductor = d),
        F χ := (sum_fiberwise_of_maps_to hm F).symm
    _ = ∑ d ∈ q.divisors.attach, ∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q =>
        χ.conductor = d.1), F χ := (sum_attach _ _).symm
    _ = _ := sum_congr rfl fun d _ => sum_at_primitive_conductor (Nat.mem_divisors.mp d.2).1 F

def centeredPrimeSum {q : ℕ} (χ : DirichletCharacter ℂ q) (y h : ℝ) : ℂ :=
  (∑ k ∈ Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊,
    ((if k.Prime then Real.log (k : ℝ) else 0 : ℝ) : ℂ) * χ (k : ZMod q)) -
    (if χ = 1 then (h : ℂ) else 0)

theorem centeredPrimeSum_changeLevel {d q : ℕ} [NeZero q] (hd : d ∣ q)
    (χ : DirichletCharacter ℂ d) {h y : ℝ} (hq : (q : ℝ) ≤ y) (hh : 0 ≤ h) :
    centeredPrimeSum (DirichletCharacter.changeLevel hd χ) y h = centeredPrimeSum χ y h := by
  classical
  have hone : DirichletCharacter.changeLevel hd χ = 1 ↔ χ = 1 := by
    rw [← map_one (DirichletCharacter.changeLevel (R := ℂ) hd)]
    exact (DirichletCharacter.changeLevel_injective hd).eq_iff
  unfold centeredPrimeSum
  simp only [hone]
  congr 1
  apply Finset.sum_congr rfl
  intro p hp
  by_cases hpr : p.Prime
  · have hpy := ((mem_window ((Nat.cast_nonneg q).trans hq) hh p).1 hp).1
    have hqp : q < p := by exact_mod_cast (hq.trans_lt hpy)
    have hcop := hpr.coprime_iff_not_dvd.mpr
      (fun hdvd => (Nat.not_le_of_gt hqp) (Nat.le_of_dvd (NeZero.pos q) hdvd))
    have he := χ.changeLevel_eq_cast_of_dvd' hd (Nat.isCoprime_iff_coprime.mpr hcop)
    simpa only [Int.cast_natCast] using congrArg
      (fun z : ℂ => ((if p.Prime then Real.log (p : ℝ) else 0 : ℝ) : ℂ) * z) he
  · simp [hpr]

/-- No imprimitive-character error is paid for prime weights at q ≤ y. -/
theorem err_le_primitive_conductor_mean {q : ℕ} [NeZero q] {h y : ℝ}
    (hq : (q : ℝ) ≤ y) (hh : 0 ≤ h) :
    err q h y ≤ (∑ d ∈ q.divisors.attach, ∑ ψ ∈ primitiveChars d.1,
      ‖centeredPrimeSum ψ y h‖) / (q.totient : ℝ) := by
  apply (err_le_twisted_mean q y h).trans_eq
  have H := sum_primitive_conductors (q := q) (fun χ => ‖centeredPrimeSum χ y h‖)
  simp only [centeredPrimeSum_changeLevel _ _ hq hh] at H
  rw [← H]
  congr 1
  apply Finset.sum_congr rfl
  intro χ _
  by_cases hp : χ = 1 <;> simp [centeredPrimeSum, hp]

end
end ShortAP

end

section

/-! The reciprocal-totient bound below is adapted from muxkin, goldbach-proofs PR 1708
(c56bb450d43259dd871d29020d53facb6e5de557, Apache-2.0), as ported in
PacketRemainingRationalShell.lean. -/
namespace ShortAP
open Finset
noncomputable section

private theorem inv_totient_le_pairs (q : ℕ) (hq : 0 < q) :
    1 / (q.totient : ℝ) ≤ ∑ ab ∈ q.divisorsAntidiagonal, ((ab.1:ℝ)⁻¹ * (ab.2:ℝ)⁻¹) := by
  have hφ := Nat.totient_pos.mpr hq
  have hcount : q ≤ q.divisors.card * q.totient := by
    calc
      _ = ∑ d ∈ q.divisors, d.totient := (Nat.sum_totient q).symm
      _ ≤ ∑ _ ∈ q.divisors, q.totient := sum_le_sum (fun d hd =>
        Nat.le_of_dvd hφ (Nat.totient_dvd_of_dvd (Nat.dvd_of_mem_divisors hd)))
      _ = _ := by simp
  calc
    _ ≤ (q.divisors.card : ℝ) / q := (div_le_div_iff₀ (by exact_mod_cast hφ) (by exact_mod_cast hq)).mpr
      (by rw [one_mul]; exact_mod_cast hcount)
    _ = ∑ _ ∈ q.divisorsAntidiagonal, (q:ℝ)⁻¹ := by
      rw [Nat.sum_divisorsAntidiagonal (fun _ _ => (q:ℝ)⁻¹)]; simp [div_eq_mul_inv]
    _ = _ := by
      apply sum_congr rfl
      intro ab hab
      rw [← (Nat.mem_divisorsAntidiagonal.mp hab).1, Nat.cast_mul, mul_inv]

/-- A finite reciprocal-totient bound with constant one. -/
theorem sum_inv_totient_le (Q : ℕ) :
    (∑ q ∈ Icc 1 Q, 1 / (q.totient : ℝ)) ≤ (1 + Real.log Q)^2 := by
  let S := Icc 1 Q
  let w := fun ab : ℕ × ℕ => (ab.1:ℝ)⁻¹ * (ab.2:ℝ)⁻¹
  have hf (q : ℕ) (hq : q ∈ S) :
      q.divisorsAntidiagonal = (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2=q) := by
    obtain ⟨hq0,hqQ⟩ := mem_Icc.mp hq
    ext ab
    constructor
    · intro hab
      have hf := Nat.fst_mem_divisors_of_mem_antidiagonal hab
      have hs := Nat.snd_mem_divisors_of_mem_antidiagonal hab
      have hm (a : ℕ) (ha : a ∈ q.divisors) : a ∈ S :=
        mem_Icc.mpr ⟨Nat.pos_of_mem_divisors ha,(Nat.le_of_dvd hq0 (Nat.dvd_of_mem_divisors ha)).trans hqQ⟩
      exact mem_filter.mpr ⟨mem_product.mpr ⟨hm _ hf,hm _ hs⟩,(Nat.mem_divisorsAntidiagonal.mp hab).1⟩
    · intro hab
      exact Nat.mem_divisorsAntidiagonal.mpr ⟨(mem_filter.mp hab).2,by omega⟩
  have hsum : (∑ i ∈ S, (i:ℝ)⁻¹) ≤ 1+Real.log Q := by
    simpa only [S,harmonic_eq_sum_Icc,Rat.cast_sum,Rat.cast_inv,Rat.cast_natCast] using harmonic_le_one_add_log Q
  calc
    _ ≤ ∑ q ∈ S, ∑ ab ∈ q.divisorsAntidiagonal, w ab :=
      sum_le_sum (fun q hq => inv_totient_le_pairs q (mem_Icc.mp hq).1)
    _ = ∑ q ∈ S, ∑ ab ∈ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2=q), w ab :=
      sum_congr rfl (fun q hq => by rw [hf q hq])
    _ = ∑ ab ∈ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2 ∈ S), w ab :=
      sum_fiberwise_eq_sum_filter _ _ _ _
    _ ≤ ∑ ab ∈ S ×ˢ S, w ab := sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun _ _ _ => by dsimp [w]; positivity)
    _ = (∑ i ∈ S, (i:ℝ)⁻¹)^2 := by rw [sq,sum_product,sum_mul_sum]
    _ ≤ _ := pow_le_pow_left₀ (sum_nonneg fun _ _ => by positivity) hsum 2

/-- Summing the multiplicities of a primitive conductor costs at most two
powers of the logarithm, uniformly also for the principal conductor. -/
theorem sum_conductor_weights (Q : ℕ) (F : ℕ → ℝ) (hF : ∀ d, 0 ≤ F d) :
    (∑ q ∈ Icc 1 Q, (∑ d ∈ q.divisors, F d) / (q.totient : ℝ)) ≤
      (∑ d ∈ Icc 1 Q, F d / (d.totient : ℝ)) * (1 + Real.log Q)^2 := by
  classical
  let S := Icc 1 Q
  let w (p : ℕ × ℕ) := (F p.1 / (p.1.totient : ℝ)) * (1 / (p.2.totient : ℝ))
  have hw (p : ℕ × ℕ) : 0 ≤ w p :=
    mul_nonneg (div_nonneg (hF _) (Nat.cast_nonneg _)) (by positivity)
  have hsub (q : ℕ) (hq : q ∈ S) :
      q.divisorsAntidiagonal ⊆ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2=q) := by
    intro ab hab
    have hm (d : ℕ) (hd : d ∈ q.divisors) : d ∈ S :=
      mem_Icc.mpr ⟨Nat.pos_of_mem_divisors hd,
        (Nat.le_of_dvd (mem_Icc.mp hq).1 (Nat.dvd_of_mem_divisors hd)).trans (mem_Icc.mp hq).2⟩
    exact mem_filter.mpr ⟨mem_product.mpr ⟨hm _ (Nat.fst_mem_divisors_of_mem_antidiagonal hab),
      hm _ (Nat.snd_mem_divisors_of_mem_antidiagonal hab)⟩,(Nat.mem_divisorsAntidiagonal.mp hab).1⟩
  have hterm (q : ℕ) (hq : q ∈ S) :
      (∑ d ∈ q.divisors, F d) / (q.totient : ℝ) ≤ ∑ p ∈ q.divisorsAntidiagonal, w p := by
    rw [Finset.sum_div]
    have he := Nat.sum_divisorsAntidiagonal (fun d _ => F d / (q.totient : ℝ)) (n := q)
    rw [← he]
    apply sum_le_sum
    intro p hp
    have h1 := Nat.pos_of_mem_divisors (Nat.fst_mem_divisors_of_mem_antidiagonal hp)
    have h2 := Nat.pos_of_mem_divisors (Nat.snd_mem_divisors_of_mem_antidiagonal hp)
    have h3 : 0 < (p.1.totient : ℝ) * (p.2.totient : ℝ) := by
      exact_mod_cast Nat.mul_pos (Nat.totient_pos.mpr h1) (Nat.totient_pos.mpr h2)
    have hφ := Nat.totient_super_multiplicative p.1 p.2
    rw [(Nat.mem_divisorsAntidiagonal.mp hp).1] at hφ
    calc F p.1 / (q.totient : ℝ) ≤ F p.1 / ((p.1.totient : ℝ) * (p.2.totient : ℝ)) :=
           div_le_div_of_nonneg_left (hF _) h3 (by exact_mod_cast hφ)
         _ = w p := by simp [w, div_eq_mul_inv, mul_comm, mul_assoc]
  calc
    _ ≤ ∑ q ∈ S, ∑ p ∈ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2=q), w p :=
      sum_le_sum fun q hq => (hterm q hq).trans
        (sum_le_sum_of_subset_of_nonneg (hsub q hq) fun p _ _ => hw p)
    _ = ∑ p ∈ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2 ∈ S), w p :=
      sum_fiberwise_eq_sum_filter _ _ _ _
    _ ≤ ∑ p ∈ S ×ˢ S, w p := sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun p _ _ => hw p
    _ = (∑ d ∈ S, F d / (d.totient : ℝ)) * (∑ d ∈ S, 1/(d.totient : ℝ)) := by
      rw [sum_product, sum_mul_sum]
    _ ≤ _ := mul_le_mul_of_nonneg_left (sum_inv_totient_le _)
      (sum_nonneg fun d _ => div_nonneg (hF _) (Nat.cast_nonneg _))

end
end ShortAP

end

section

namespace ShortAP
open Finset
noncomputable section

def primitiveErrorMass (d : ℕ) (y h : ℝ) : ℝ :=
  ∑ ψ ∈ primitiveChars d, ‖centeredPrimeSum ψ y h‖

/-- Replacing all progressions by primitive twists and charging their multiples
costs at most a logarithm squared, with no y-dependent or conductor-dependent constant. -/
theorem sum_err_le_primitive_mean (Q : ℕ) {h y : ℝ} (hQ : (Q : ℝ) ≤ y) (hh : 0 ≤ h) :
    (∑ q ∈ Icc 1 Q, err q h y) ≤
      (∑ d ∈ Icc 1 Q, primitiveErrorMass d y h / (d.totient : ℝ)) * (1+Real.log Q)^2 := by
  classical
  apply le_trans _ (sum_conductor_weights Q (fun d => primitiveErrorMass d y h)
    (fun _ => sum_nonneg fun _ _ => norm_nonneg _))
  apply sum_le_sum
  intro q hq
  have : NeZero q := ⟨by have := (mem_Icc.mp hq).1; omega⟩
  have hqy : (q : ℝ) ≤ y := (Nat.cast_le.mpr (mem_Icc.mp hq).2).trans hQ
  have H := err_le_primitive_conductor_mean (q := q) hqy hh
  convert H using 1
  exact congrArg (fun u : ℝ => u / q.totient)
    (Finset.sum_attach q.divisors (fun d => primitiveErrorMass d y h)).symm

theorem frozen_sum_err_le_primitive_mean {x t y : ℝ} (hx : 1 ≤ x) (ht : t ≤ 1)
    (hy : x ≤ y) (Q : ℕ) (hQ : 1 ≤ Q)
    (hsize : (Q : ℝ)^2 * x^((1-t)/3+(1:ℝ)/16) ≤ x^t) :
    (∑ q ∈ Icc 1 Q, err q (x^t) y) ≤
      (∑ d ∈ Icc 1 Q, primitiveErrorMass d y (x^t) / (d.totient : ℝ)) *
        (1+Real.log Q)^2 := by
  have hx0 : 0 ≤ x := by linarith
  have hQ' : 1 ≤ (Q : ℝ) := by exact_mod_cast hQ
  have hpow : 1 ≤ x^((1-t)/3+(1:ℝ)/16) := Real.one_le_rpow hx (by linarith)
  have hqx : (Q:ℝ) ≤ x := calc
    _ ≤ (Q:ℝ)^2 := by nlinarith [sq_nonneg ((Q:ℝ)-1)]
    _ ≤ (Q:ℝ)^2*x^((1-t)/3+(1:ℝ)/16) := le_mul_of_one_le_right (sq_nonneg _) hpow
    _ ≤ x^t := hsize
    _ ≤ x := by simpa using Real.rpow_le_rpow_of_exponent_le hx ht
  exact sum_err_le_primitive_mean Q (hqx.trans hy) (Real.rpow_nonneg hx0 _)

end
end ShortAP

