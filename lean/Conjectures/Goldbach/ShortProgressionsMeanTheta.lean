section

open MeasureTheory Set Finset
open scoped BigOperators

namespace ShortAPSmallConductorSmooth

open ShortAPSmoothedFactor ShortAPDualSplit ShortAPDyadicPartition ShortAPLogWeight

private theorem inv_sqrt_succ (n : ℕ) :
    (Real.sqrt ((n : ℝ) + 1))⁻¹ ≤ 2 * (Real.sqrt ((n : ℝ) + 1) - Real.sqrt n) := by
  have ha : 0 < Real.sqrt ((n : ℝ) + 1) := Real.sqrt_pos.mpr (by positivity)
  have hb : 0 ≤ Real.sqrt (n : ℝ) := Real.sqrt_nonneg _
  have hab : Real.sqrt (n : ℝ) ≤ Real.sqrt ((n : ℝ) + 1) :=
    Real.sqrt_le_sqrt (by linarith)
  have h₁ := Real.sq_sqrt (show 0 ≤ (n : ℝ) + 1 by positivity)
  have h₂ := Real.sq_sqrt (show 0 ≤ (n : ℝ) by positivity)
  rw [← one_div, div_le_iff₀ ha]
  calc
    (1 : ℝ) = (Real.sqrt ((n : ℝ) + 1) + Real.sqrt n) *
        (Real.sqrt ((n : ℝ) + 1) - Real.sqrt n) := by nlinarith
    _ ≤ (2 * Real.sqrt ((n : ℝ) + 1)) *
        (Real.sqrt ((n : ℝ) + 1) - Real.sqrt n) :=
      mul_le_mul_of_nonneg_right (by linarith) (sub_nonneg.mpr hab)
    _ = _ := by ring

private theorem sum_inv_sqrt (M : ℕ) :
    (∑ n ∈ Finset.Icc 1 M, (Real.sqrt (n : ℝ))⁻¹) ≤ 2 * Real.sqrt M := by
  induction M with
  | zero => simp
  | succ n ih =>
      rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ n + 1)]
      have h := inv_sqrt_succ n
      rw [Nat.cast_succ]
      linarith

/-- The dual mass in Lemma 3.3 is bounded trivially by its square-root
length, with explicit constant `2π`, uniformly in character and height. -/
theorem dualMass_le_sqrt {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ) :
    dualMass χ t M ≤ (2 * Real.pi) * Real.sqrt M := by
  let P (u : ℝ) : ℂ := ∑ n ∈ Finset.Icc 1 M, χ (n : ZMod q) /
    (n : ℂ) ^ (1 / 2 + ((t + u : ℝ) : ℂ) * Complex.I)
  have hP (u : ℝ) : ‖P u‖ ≤ 2 * Real.sqrt M := by
    apply (norm_sum_le _ _).trans
    apply le_trans _ (sum_inv_sqrt M)
    apply Finset.sum_le_sum
    intro n hn
    have hpos : 0 < n := (Finset.mem_Icc.mp hn).1
    have hr : (1 / 2 + ((t + u : ℝ) : ℂ) * Complex.I : ℂ).re = (1 / 2 : ℝ) := by
      norm_num
    rw [norm_div, Complex.norm_natCast_cpow_of_pos hpos, hr, ← Real.sqrt_eq_rpow, ← one_div]
    exact div_le_div_of_nonneg_right (χ.norm_le_one _) (Real.sqrt_nonneg _)
  change (∫ u : ℝ, ‖P u‖ / (1 + u ^ 2)) ≤ _
  calc
    _ ≤ ∫ u : ℝ, (2 * Real.sqrt M) * (1 + u ^ 2)⁻¹ := by
      apply integral_mono_of_nonneg
      · exact Filter.Eventually.of_forall (fun u => div_nonneg (norm_nonneg _) (by positivity))
      · exact integrable_inv_one_add_sq.const_mul _
      · exact Filter.Eventually.of_forall fun u => by
          change ‖P u‖ / (1 + u ^ 2) ≤ (2 * Real.sqrt M) * (1 + u ^ 2)⁻¹
          rw [div_eq_mul_inv]
          exact mul_le_mul_of_nonneg_right (hP u) (by positivity)
    _ = _ := by rw [integral_const_mul, integral_univ_inv_one_add_sq]; ring

private theorem cutoff_le_of_subquadratic (η Q T N : ℝ)
    (hη₀ : 0 < η) (hη₁ : η ≤ 1) (hQ : 0 ≤ Q) (hT : 0 ≤ T)
    (hN : 1 ≤ N) (hfreq : Q * T ≤ N ^ (2 - η)) :
    (dualCutoff (η / 2) Q T N : ℝ) ≤ N ^ (1 - η / 2) := by
  have hN₀ : 0 < N := zero_lt_one.trans_le hN
  have hR : 0 ≤ Q * T / N := by positivity
  have hR' : Q * T / N ≤ N ^ (1 - η) := by
    refine (div_le_div_of_nonneg_right hfreq hN₀.le).trans_eq ?_
    have hr := Real.rpow_sub hN₀ (2 - η) 1
    rw [Real.rpow_one, show 2 - η - 1 = 1 - η by ring] at hr
    exact hr.symm
  have hP : (Q * T / N) ^ (1 + η / 2) ≤ N ^ (1 - η / 2) := by
    calc
      _ ≤ (N ^ (1 - η)) ^ (1 + η / 2) := Real.rpow_le_rpow hR hR' (by positivity)
      _ = N ^ ((1 - η) * (1 + η / 2)) := (Real.rpow_mul hN₀.le _ _).symm
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hN (by nlinarith [sq_nonneg η])
  rw [dualCutoff, Nat.cast_max, Nat.cast_one]
  exact max_le (Real.one_le_rpow hN (by linarith))
    ((Nat.floor_le (Real.rpow_nonneg hR _)).trans hP)

/-- Power saving for the actual smooth zeta/log factor under the explicit
subquadratic-frequency condition `q·max(2,|t|) ≤ N^(2-η)`.
For the logarithmic factor there is one extra factor of `log(2N)`. -/
theorem box_subquadratic_power_saving (η : ℝ) (hη₀ : 0 < η) (hη₁ : η ≤ 1) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive →
    ∀ (t : ℝ) (H j i b : ℕ), i < j + 1 → 1 ≤ scale b →
      (q : ℝ) * max 2 |t| ≤ (scale b) ^ (2 - η) →
      ‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ ≤
        K * (Real.log (2 * scale b)) ^ logDegree i * (scale b) ^ (1 / 2 - η / 4) := by
  obtain ⟨C, hC, hshort⟩ := smooth_box_shortening (η / 2)
    (ShortAPShortening.unweighted (η / 2) (by positivity))
  refine ⟨C * (2 * Real.pi), by positivity, ?_⟩
  intro q χ hq hp t H j i b hi hb hfreq
  let N := scale b
  let T := max (2 : ℝ) |t|
  let M := dualCutoff (η / 2) (q : ℝ) T N
  let L := Real.log (2 * N)
  have hL : 0 ≤ L := by dsimp only [L]; exact Real.log_nonneg (by linarith)
  have hT : 2 ≤ T := le_max_left _ _
  have hshort' := hshort χ hq hp (q : ℝ) T t le_rfl hT (le_max_right _ _) H j i b hi hb
  have hm : (M : ℝ) ≤ N ^ (1 - η / 2) :=
    cutoff_le_of_subquadratic η q T N hη₀ hη₁ (Nat.cast_nonneg _) (by positivity) hb hfreq
  have hs : Real.sqrt M ≤ N ^ (1 / 2 - η / 4) := by
    refine (Real.sqrt_le_sqrt hm).trans_eq ?_
    rw [Real.sqrt_eq_rpow, ← Real.rpow_mul (scale_pos b).le]
    congr 1
    ring
  calc
    _ ≤ C * L ^ logDegree i * dualMass χ t M := hshort'
    _ ≤ C * L ^ logDegree i * ((2 * Real.pi) * Real.sqrt M) :=
      mul_le_mul_of_nonneg_left (dualMass_le_sqrt χ t M) (by positivity)
    _ ≤ C * L ^ logDegree i * ((2 * Real.pi) * N ^ (1 / 2 - η / 4)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hs (by positivity)) (by positivity)
    _ = _ := by dsimp only [L, N]; ring

private theorem logpow_le_rpow (ε : ℝ) (hε : 0 < ε) (p : ℕ) (hp : 0 < p) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ N : ℝ, 1 ≤ N → (Real.log (2 * N)) ^ p ≤ D * N ^ ε := by
  let α := ε / (p : ℝ)
  have hα : 0 < α := div_pos hε (by exact_mod_cast hp)
  refine ⟨(2 : ℝ) ^ ε / α ^ p, by positivity, fun N hN => ?_⟩
  have hN₀ : 0 < N := zero_lt_one.trans_le hN
  have hx : 0 < 2 * N := by positivity
  have hL : 0 ≤ Real.log (2 * N) := Real.log_nonneg (by linarith)
  have hlo : Real.log (2 * N) ≤ (2 * N) ^ α / α := by
    apply (le_div_iff₀ hα).mpr
    have h := Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hx α)
    rw [Real.log_rpow hx] at h
    linarith
  have he : α * (p : ℝ) = ε := div_mul_cancel₀ _ (by exact_mod_cast hp.ne')
  calc
    _ ≤ ((2 * N) ^ α / α) ^ p := pow_le_pow_left₀ hL hlo _
    _ = (2 * N) ^ ε / α ^ p := by
      rw [div_pow, ← Real.rpow_natCast, ← Real.rpow_mul hx.le, he]
    _ = _ := by rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 2) hN₀.le]; ring

/-- Any fixed log-saving for the actual zeta/log factor, uniformly over
the subquadratic-frequency region. The coefficient and frequency bounds
are not assumed; they come from the proven smooth shortening lemma. -/
theorem box_subquadratic_log_saving (η : ℝ) (hη₀ : 0 < η) (hη₁ : η ≤ 1) (B : ℕ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive →
    ∀ (t : ℝ) (H j i b : ℕ), i < j + 1 → 2 ≤ scale b →
      (q : ℝ) * max 2 |t| ≤ (scale b) ^ (2 - η) →
      ‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ ≤
        K * Real.sqrt (scale b) / (Real.log (2 * scale b)) ^ B := by
  obtain ⟨K, hK, hs⟩ := box_subquadratic_power_saving η hη₀ hη₁
  obtain ⟨D, hD, hlog⟩ := logpow_le_rpow (η / 4) (by positivity) (B + 1) (Nat.succ_pos _)
  refine ⟨K * D, by positivity, ?_⟩
  intro q χ hq hp t H j i b hi hb hfreq
  let N := scale b
  let L := Real.log (2 * N)
  have hN : 1 ≤ N := (by norm_num : (1 : ℝ) ≤ 2).trans hb
  have hN₀ : 0 < N := scale_pos b
  have hL : 1 < L := (Real.lt_log_iff_exp_lt (by positivity)).mpr
    (Real.exp_one_lt_three.trans (by dsimp only [N]; linarith))
  have hd : logDegree i + B ≤ B + 1 := by
    have := logDegree_le_one i
    omega
  have hpow : L ^ (logDegree i + B) ≤ D * N ^ (η / 4) :=
    (pow_le_pow_right₀ hL.le hd).trans (hlog N hN)
  have hmerge : N ^ (1 / 2 - η / 4) * N ^ (η / 4) = Real.sqrt N := by
    rw [← Real.rpow_add hN₀, Real.sqrt_eq_rpow]
    congr 1
    ring
  change ‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ ≤
    K * D * Real.sqrt N / L ^ B
  apply (le_div_iff₀ (by positivity)).mpr
  calc
    _ ≤ (K * L ^ logDegree i * N ^ (1 / 2 - η / 4)) * L ^ B :=
      mul_le_mul_of_nonneg_right (hs χ hq hp t H j i b hi hN hfreq) (by positivity)
    _ = (K * N ^ (1 / 2 - η / 4)) * L ^ (logDegree i + B) := by rw [pow_add]; ring
    _ ≤ (K * N ^ (1 / 2 - η / 4)) * (D * N ^ (η / 4)) :=
      mul_le_mul_of_nonneg_left hpow (by positivity)
    _ = _ := by rw [← hmerge]; ring

/-- Normalized active-box cap, including the `+1`. A lower bound
`N ≥ x^ε` suffices; no upper comparison between `N` and `x` is needed. -/
theorem box_subquadratic_active_cap_eventually (η ε : ℝ) (hη₀ : 0 < η) (hη₁ : η ≤ 1)
    (hε : 0 < ε) (p : ℕ) :
    ∀ᶠ x : ℝ in Filter.atTop,
      ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive →
      ∀ (t : ℝ) (H j i b : ℕ), i < j + 1 → x ^ ε ≤ scale b →
        (q : ℝ) * max 2 |t| ≤ (scale b) ^ (2 - η) →
        (‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ + 1) *
          Real.log x ^ p ≤ Real.sqrt (scale b) := by
  obtain ⟨K, hK, hs⟩ := box_subquadratic_power_saving η hη₀ hη₁
  let γ := η / 8
  have hγ : 0 < γ := by dsimp only [γ]; positivity
  obtain ⟨D, hD, hlog⟩ := logpow_le_rpow γ hγ (p + 1) (Nat.succ_pos _)
  let C := ((K + 1) * D) / ε ^ p
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  have hev₂ : ∀ᶠ x : ℝ in Filter.atTop, 2 ≤ x ^ ε :=
    (tendsto_rpow_atTop hε).eventually_ge_atTop _
  have hevC : ∀ᶠ x : ℝ in Filter.atTop, C ≤ x ^ (ε * γ) :=
    (tendsto_rpow_atTop (mul_pos hε hγ)).eventually_ge_atTop _
  filter_upwards [Filter.eventually_ge_atTop (2 : ℝ), hev₂, hevC] with x hx hx₂ hxC
  intro q χ hq hp t H j i b hi hNx hfreq
  let N := scale b
  let L := Real.log (2 * N)
  let A := N ^ (1 / 2 - η / 4)
  let F := boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)
  have hF : ‖F‖ ≤ K * L ^ logDegree i * A :=
    hs χ hq hp t H j i b hi ((by norm_num : (1 : ℝ) ≤ 2).trans (hx₂.trans hNx)) hfreq
  have hN₂ : 2 ≤ N := hx₂.trans hNx
  have hN : 1 ≤ N := (by norm_num : (1 : ℝ) ≤ 2).trans hN₂
  have hN₀ : 0 < N := zero_lt_one.trans_le hN
  have hx₀ : 0 < x := by linarith
  have hL : 1 < L := (Real.lt_log_iff_exp_lt (by positivity)).mpr
    (Real.exp_one_lt_three.trans (by linarith))
  have hLp : Real.log x ^ p ≤ L ^ p / ε ^ p := by
    have h : Real.log x ≤ L / ε := by
      apply (le_div_iff₀ hε).mpr
      calc
        _ = Real.log (x ^ ε) := by rw [Real.log_rpow hx₀]; ring
        _ ≤ Real.log N := Real.log_le_log (Real.rpow_pos_of_pos hx₀ _) hNx
        _ ≤ L := Real.log_le_log hN₀ (by linarith)
    simpa only [div_pow] using pow_le_pow_left₀ (Real.log_nonneg (by linarith)) h p
  have hdeg : logDegree i + p ≤ p + 1 := by
    have := logDegree_le_one i
    omega
  have hLr : L ^ (logDegree i + p) ≤ D * N ^ γ :=
    (pow_le_pow_right₀ hL.le hdeg).trans (hlog N hN)
  have hLonly : L ^ p ≤ D * N ^ γ :=
    (pow_le_pow_right₀ hL.le (Nat.le_succ p)).trans (hlog N hN)
  have hmerge : A * N ^ γ = N ^ (1 / 2 - γ) := by
    dsimp only [A, γ]
    rw [← Real.rpow_add hN₀]
    congr 1
    ring
  have hgrow : C ≤ N ^ γ := by
    refine hxC.trans ?_
    rw [Real.rpow_mul hx₀.le]
    exact Real.rpow_le_rpow (Real.rpow_nonneg hx₀.le _) hNx hγ.le
  calc
    _ ≤ (‖F‖ + 1) * (L ^ p / ε ^ p) :=
      mul_le_mul_of_nonneg_left hLp (by positivity)
    _ ≤ (K * L ^ logDegree i * A + 1) * (L ^ p / ε ^ p) :=
      mul_le_mul_of_nonneg_right (add_le_add hF le_rfl) (by positivity)
    _ = (K * A * L ^ (logDegree i + p) + L ^ p) / ε ^ p := by rw [pow_add]; ring
    _ ≤ (K * A * (D * N ^ γ) + D * N ^ γ) / ε ^ p :=
      div_le_div_of_nonneg_right
        (add_le_add (mul_le_mul_of_nonneg_left hLr (by dsimp only [A]; positivity)) hLonly)
        (by positivity)
    _ = (K * D * (A * N ^ γ) + D * N ^ γ) / ε ^ p := by ring
    _ = (K * D * N ^ (1 / 2 - γ) + D * N ^ γ) / ε ^ p := by rw [hmerge]
    _ ≤ (K * D * N ^ (1 / 2 - γ) + D * N ^ (1 / 2 - γ)) / ε ^ p := by
      apply div_le_div_of_nonneg_right _ (by positivity)
      exact add_le_add le_rfl (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hN
        (by dsimp only [γ]; linarith)) hD)
    _ = C * N ^ (1 / 2 - γ) := by dsimp only [C]; ring
    _ ≤ N ^ γ * N ^ (1 / 2 - γ) :=
      mul_le_mul_of_nonneg_right hgrow (by positivity)
    _ = _ := by
      rw [← Real.rpow_add hN₀, Real.sqrt_eq_rpow]
      congr 1
      ring

end ShortAPSmallConductorSmooth

