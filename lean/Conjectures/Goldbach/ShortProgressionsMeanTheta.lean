    _ ≤ 1 + ‖1 / (s - 1)‖ + ‖s‖ / s.re := by simp [one_div]
set_option maxHeartbeats 1000000 in
theorem Vrl :
    AnalyticOn ℂ V3o V2q := by
  intro s hs
  have hconst : AnalyticAt ℂ (fun _ : ℂ => (1 : ℂ)) s := analyticAt_const
  have hid : AnalyticAt ℂ (fun z : ℂ => z) s := analyticAt_id
