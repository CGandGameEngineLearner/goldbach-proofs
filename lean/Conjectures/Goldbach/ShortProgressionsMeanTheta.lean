    _ ≤ R^a*x^k*(2*x/R)^e :=
      mul_le_mul_of_nonneg_left (Real.rpow_le_rpow hQ hRQ he) hbase
    _ = 2^e*x^((k:ℝ)+e)*R^(a-e) := hfirst
    _ ≤ 2^e*x^((k:ℝ)+e)*(2*x^(1/(k:ℝ)))^(a-e) := by
      apply mul_le_mul_of_nonneg_left (Real.rpow_le_rpow hR.le hRx (sub_nonneg.mpr hae))
