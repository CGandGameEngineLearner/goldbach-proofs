  have hnonneg : 0≤∑ b∈B,‖P b‖^r := sum_nonneg (fun _ _ => by positivity)
  have hexpand : ((∑ b∈B,‖P b‖^r:ℝ):ℂ)=∑ x : Fin r → Fin M,
