    obtain ⟨hx,hy⟩ := mem_product.mp hxy
    obtain ⟨i,hi,hxi,hyi⟩ := hcover xy.1 hx xy.2 hy hf
    exact mem_biUnion.mpr ⟨i,hi,mem_filter.mpr ⟨mem_product.mpr ⟨hxi,hyi⟩,hf⟩⟩
