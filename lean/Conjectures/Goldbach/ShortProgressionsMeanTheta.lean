private lemma V23l (s : ℂ) (N : ℕ) (hN : 1 ≤ N) :
    Va5 s N = (N : ℂ) ^ (1 - s) + s * ∫ u in (1 : ℝ)..N, (Nat.floor u : ℂ) * (u : ℂ) ^ (-s - 1) := by
