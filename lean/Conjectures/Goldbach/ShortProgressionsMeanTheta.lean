    exact_mod_cast (card_eq_sum_card_image f F).symm
  have henergy : (∑ c∈F.image f,((F.filter (fun a => f a=c)).card:ℝ)^2)=
      (Vj F f:ℝ) := by
    simp only [Vj,Nat.cast_sum,Nat.cast_pow]
