theorem V4c (f : ℂ → ℂ)
    (S : Finset ℂ) (s : ℂ) : AnalyticAt ℂ (Vs f S) s := by
  exact S.analyticAt_fun_prod fun z _ => (analyticAt_id.sub analyticAt_const).pow _
set_option maxHeartbeats 1000000 in
