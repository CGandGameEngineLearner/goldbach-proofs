/-!
# Sampling and the first large-values bound for short progressions

This is the continuous-to-discrete part of Koukoulopoulos, *Primes in short
arithmetic progressions* (arXiv:1405.6592), §3, Lemmas 3.1–3.2. The sampling lemma below is stated for an arbitrary continuous mean-square input;
ShortAP.primitive_mean_input supplies it for the primitive character family. The stronger
Huxley branch of Lemma 3.2 is not included.

The midpoint argument follows `split_window_length_mul_le` in the local
`goldbach-short-progressions/lean/Conjectures/Goldbach/SobolevGallagherWindow.lean`.
Disjoint half-open windows are summed directly by finite additivity.
-/

open Finset MeasureTheory Set
open scoped BigOperators RealInnerProductSpace Function

namespace ShortAPLargeValues

noncomputable section

/-- Distinct times are separated by at least one, separately for each character. -/
def WellSpaced {ι : Type*} (S : ι → Finset ℝ) : Prop :=
  ∀ i, ∀ u ∈ S i, ∀ v ∈ S i, u ≠ v → 1 ≤ |u - v|

private theorem endpoint_integral_bounds {g d : ℝ → ℝ}
    (hd : ∀ t, HasDerivAt g (d t) t) (hc : Continuous d)
    {a b : ℝ} (hab : a ≤ b) :
    (b - a) * g a ≤ (∫ t in a..b, g t) + (b - a) * ∫ t in a..b, |d t| ∧
    (b - a) * g b ≤ (∫ t in a..b, g t) + (b - a) * ∫ t in a..b, |d t| := by
  let V : ℝ := ∫ t in a..b, |d t|
  have hg : Continuous g := Differentiable.continuous (fun t => (hd t).differentiableAt)
  have variation (u v : ℝ) (hau : a ≤ u) (huv : u ≤ v) (hvb : v ≤ b) :
      |g v - g u| ≤ V := by
    rw [← intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hd t)
      (hc.intervalIntegrable u v)]
    exact (intervalIntegral.abs_integral_le_integral_abs huv).trans
      (intervalIntegral.integral_mono_interval hau huv hvb
        (Filter.Eventually.of_forall fun _ => abs_nonneg _) (hc.abs.intervalIntegrable a b))
  have avg (c : ℝ) (hp : ∀ t ∈ Set.Icc a b, c ≤ g t + V) :
      (b - a) * c ≤ (∫ t in a..b, g t) + (b - a) * V := by
    have h := intervalIntegral.integral_mono_on hab
      (continuous_const.intervalIntegrable a b : IntervalIntegrable (fun _ => c) volume a b)
      ((hg.add continuous_const).intervalIntegrable a b) hp
    change (∫ t in a..b, c) ≤ ∫ t in a..b, g t + V at h
    rwa [intervalIntegral.integral_const,
      intervalIntegral.integral_add (hg.intervalIntegrable a b)
        (continuous_const.intervalIntegrable a b : IntervalIntegrable (fun _ => V) volume a b),
      intervalIntegral.integral_const, smul_eq_mul, smul_eq_mul] at h
  exact ⟨avg (g a) (fun t ht => by
    have h := (abs_le.mp (variation a t le_rfl ht.1 ht.2)).1
    linarith), avg (g b) (fun t ht => by
    have h := (abs_le.mp (variation t b ht.1 ht.2 le_rfl)).2
    linarith)⟩

/-- The unit-width Gallagher window at one point, with the exact midpoint factor. -/
theorem norm_sq_le_unit_window {f d : ℝ → ℂ} (hd : ∀ t, HasDerivAt f (d t) t)
    (hc : Continuous d) (x : ℝ) :
    ‖f x‖ ^ 2 ≤ (∫ t in (x - 1 / 2)..(x + 1 / 2), ‖f t‖ ^ 2) +
      ∫ t in (x - 1 / 2)..(x + 1 / 2), ‖f t‖ * ‖d t‖ := by
  let g (t : ℝ) := ‖f t‖ ^ 2
  let dg (t : ℝ) := 2 * inner ℝ (f t) (d t)
  let p (t : ℝ) := ‖f t‖ * ‖d t‖
  let a := x - 1 / 2
  let b := x + 1 / 2
  have hf : Continuous f := Differentiable.continuous (fun t => (hd t).differentiableAt)
  have hg : Continuous g := hf.norm.pow 2
  have hgd (t : ℝ) : HasDerivAt g (dg t) t := (hd t).norm_sq
  have hgdc : Continuous dg := continuous_const.mul (hf.inner hc)
  have hp : Continuous p := hf.norm.mul hc.norm
  have hax : a ≤ x := by dsimp [a]; linarith
  have hxb : x ≤ b := by dsimp [b]; linarith
  have hl := (endpoint_integral_bounds hgd hgdc hax).2
  have hr := (endpoint_integral_bounds hgd hgdc hxb).1
  have ha : x - a = 1 / 2 := by dsimp [a]; ring
  have hb : b - x = 1 / 2 := by dsimp [b]; ring
  rw [ha] at hl
  rw [hb] at hr
  have hadd (w : ℝ → ℝ) (hw : Continuous w) :
      (∫ t in a..x, w t) + (∫ t in x..b, w t) = ∫ t in a..b, w t :=
    intervalIntegral.integral_add_adjacent_intervals (hw.intervalIntegrable a x)
      (hw.intervalIntegrable x b)
  have hlocal : g x ≤ (∫ t in a..b, g t) + 1 / 2 * ∫ t in a..b, |dg t| := by
    rw [← hadd g hg, ← hadd (fun t => |dg t|) hgdc.abs]
    linarith
  have hvar : (∫ t in a..b, |dg t|) ≤ 2 * ∫ t in a..b, p t := by
    rw [← intervalIntegral.integral_const_mul]
    exact intervalIntegral.integral_mono (hax.trans hxb) (hgdc.abs.intervalIntegrable a b)
      ((continuous_const.mul hp).intervalIntegrable a b) (fun t => by
        change |2 * inner ℝ (f t) (d t)| ≤ 2 * (‖f t‖ * ‖d t‖)
        rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
        exact mul_le_mul_of_nonneg_left (abs_real_inner_le_norm _ _) (by norm_num))
  change g x ≤ (∫ t in a..b, g t) + ∫ t in a..b, p t
  linarith

/-- The unit windows around distinct centers are disjoint even at gap exactly one. -/
theorem sum_unit_windows_le (S : Finset ℝ) {w : ℝ → ℝ} (hw : Continuous w)
    (hw0 : ∀ t, 0 ≤ w t) {a b : ℝ} (hab : a ≤ b)
    (hsep : ∀ x ∈ S, ∀ y ∈ S, x ≠ y → 1 ≤ |x - y|)
    (hbound : ∀ t ∈ S, a ≤ t - 1 / 2 ∧ t + 1 / 2 ≤ b) :
    (∑ x ∈ S, ∫ t in (x - 1 / 2)..(x + 1 / 2), w t) ≤ ∫ t in a..b, w t := by
  let W (x : ℝ) := Set.Ioc (x - 1 / 2) (x + 1 / 2)
  have hpair : Set.Pairwise (↑S : Set ℝ) (Disjoint on W) := by
    intro x hx y hy hxy
    have h := hsep x hx y hy hxy
    rcases lt_or_gt_of_ne hxy with hlt | hgt
    · rw [abs_of_neg (sub_neg.mpr hlt)] at h
      exact Ioc_disjoint_Ioc_of_le (show x + 1 / 2 ≤ y - 1 / 2 by linarith)
    · rw [abs_of_pos (sub_pos.mpr hgt)] at h
      exact (Ioc_disjoint_Ioc_of_le (show y + 1 / 2 ≤ x - 1 / 2 by linarith)).symm
  have hs : (⋃ x ∈ S, W x) ⊆ Set.Ioc a b := by
    refine iUnion₂_subset fun x hx => ?_
    exact Ioc_subset_Ioc (hbound x hx).1 (hbound x hx).2
  have hi : ∀ x ∈ S, IntegrableOn w (W x) volume := fun x _ =>
    (hw.intervalIntegrable (x - 1 / 2) (x + 1 / 2)).1
  rw [intervalIntegral.integral_of_le hab]
  have heq : (∑ x ∈ S, ∫ t in (x - 1 / 2)..(x + 1 / 2), w t) =
      ∑ x ∈ S, ∫ t in W x, w t :=
    Finset.sum_congr rfl fun x _ => intervalIntegral.integral_of_le (by linarith)
  rw [heq]
  rw [← integral_biUnion_finset S (fun _ _ => measurableSet_Ioc) hpair hi]
  exact setIntegral_mono_set (hw.intervalIntegrable a b).1
    (Filter.Eventually.of_forall fun _ => hw0 _) hs.eventuallySubset

/-- Moving from continuous to separated discrete mean squares costs one weighted
derivative term. The sampling window on each side of the time interval is `1/2`. -/
theorem sampled_mean_square_le {ι : Type*} (I : Finset ι) (S : ι → Finset ℝ)
    (F D : ι → ℝ → ℂ) (hD : ∀ i ∈ I, ∀ t, HasDerivAt (F i) (D i t) t)
    (hDc : ∀ i ∈ I, Continuous (D i)) (hsep : WellSpaced S)
    {T L : ℝ} (hT : 0 ≤ T) (hL : 0 < L)
    (hbound : ∀ i ∈ I, ∀ t ∈ S i, |t| ≤ T) :
    (∑ i ∈ I, ∑ t ∈ S i, ‖F i t‖ ^ 2) ≤
      (1 + L / 2) * (∑ i ∈ I, ∫ t in (-T - 1 / 2)..(T + 1 / 2), ‖F i t‖ ^ 2) +
        (1 / (2 * L)) * (∑ i ∈ I, ∫ t in (-T - 1 / 2)..(T + 1 / 2), ‖D i t‖ ^ 2) := by
  let a := -T - 1 / 2
  let b := T + 1 / 2
  have hab : a ≤ b := by dsimp [a, b]; linarith
  have one_character (i : ι) (hi : i ∈ I) :
      (∑ t ∈ S i, ‖F i t‖ ^ 2) ≤ (1 + L / 2) * (∫ t in a..b, ‖F i t‖ ^ 2) +
        (1 / (2 * L)) * ∫ t in a..b, ‖D i t‖ ^ 2 := by
    let e (t : ℝ) := ‖F i t‖ ^ 2
    let d (t : ℝ) := ‖D i t‖ ^ 2
    let p (t : ℝ) := ‖F i t‖ * ‖D i t‖
    have hF : Continuous (F i) :=
      Differentiable.continuous (fun t => (hD i hi t).differentiableAt)
    have hE : Continuous e := hF.norm.pow 2
    have hdc : Continuous d := (hDc i hi).norm.pow 2
    have hp : Continuous p := hF.norm.mul (hDc i hi).norm
    have hbd (t : ℝ) (ht : t ∈ S i) : a ≤ t - 1 / 2 ∧ t + 1 / 2 ≤ b := by
      have h := abs_le.mp (hbound i hi t ht)
      dsimp [a, b]
      constructor <;> linarith [h.1, h.2]
    have hwindow := Finset.sum_le_sum (s := S i)
      (fun t _ => norm_sq_le_unit_window (hD i hi) (hDc i hi) t)
    rw [Finset.sum_add_distrib] at hwindow
    have hsample : (∑ t ∈ S i, ‖F i t‖ ^ 2) ≤ (∫ t in a..b, e t) + ∫ t in a..b, p t :=
      hwindow.trans (add_le_add
        (sum_unit_windows_le (S i) hE (fun _ => sq_nonneg _) hab (hsep i) hbd)
        (sum_unit_windows_le (S i) hp (fun _ => mul_nonneg (norm_nonneg _) (norm_nonneg _))
          hab (hsep i) hbd))
    have hyoung (t : ℝ) : p t ≤ L / 2 * e t + (1 / (2 * L)) * d t := by
      have hpos : 0 < 2 * L := by positivity
      have hsq : p t * (2 * L) ≤ L ^ 2 * e t + d t := by
        dsimp [p, e, d]
        nlinarith [sq_nonneg (L * ‖F i t‖ - ‖D i t‖)]
      calc
        p t ≤ (L ^ 2 * e t + d t) / (2 * L) := (le_div_iff₀ hpos).2 hsq
        _ = L / 2 * e t + (1 / (2 * L)) * d t := by field_simp [ne_of_gt hL]
    have hEc : Continuous (fun t => L / 2 * e t) := continuous_const.mul hE
    have hDc' : Continuous (fun t => (1 / (2 * L)) * d t) := continuous_const.mul hdc
    have hi' : (∫ t in a..b, p t) ≤ ∫ t in a..b, L / 2 * e t + (1 / (2 * L)) * d t :=
      intervalIntegral.integral_mono hab (hp.intervalIntegrable a b)
        ((hEc.add hDc').intervalIntegrable a b) hyoung
    rw [intervalIntegral.integral_add (hEc.intervalIntegrable a b) (hDc'.intervalIntegrable a b),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul] at hi'
    change _ ≤ (1 + L / 2) * (∫ t in a..b, e t) + (1 / (2 * L)) * ∫ t in a..b, d t
    linarith
  have htotal := Finset.sum_le_sum one_character
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum] at htotal
  exact htotal

/-- The time frequency for the `n`-th term in `n ^ (-i t)`. -/
def freq (n : ℕ) : ℂ := -(Real.log (n : ℝ) : ℂ) * Complex.I

/-- A finite critical-line Dirichlet polynomial, with its factor `n ^ (-1/2)`
already included in the coefficients `b`. The family `χ` may be indexed by
primitive characters and their conductors. -/
def poly (N : ℕ) (b χ : ℕ → ℂ) (t : ℝ) : ℂ :=
  ∑ n ∈ Finset.Icc 1 N, (b n * χ n) * Complex.exp ((t : ℂ) * freq n)

theorem hasDerivAt_poly (N : ℕ) (b χ : ℕ → ℂ) (t : ℝ) :
    HasDerivAt (poly N b χ) (poly N (fun n => freq n * b n) χ t) t := by
  unfold poly
  have hfun : (fun u : ℝ => ∑ n ∈ Finset.Icc 1 N, (b n * χ n) * Complex.exp ((u : ℂ) * freq n)) =
      ∑ n ∈ Finset.Icc 1 N, (fun u : ℝ => (b n * χ n) * Complex.exp ((u : ℂ) * freq n)) := by
    funext u
    rw [Finset.sum_apply]
  rw [hfun]
  apply HasDerivAt.sum
  intro n _
  have hexp : HasDerivAt (fun z : ℂ => Complex.exp (z * freq n))
      (Complex.exp ((t : ℂ) * freq n) * freq n) (t : ℂ) := by
    have h := (Complex.hasDerivAt_exp ((t : ℂ) * freq n)).comp (t : ℂ)
      ((hasDerivAt_id' (t : ℂ)).mul_const (freq n))
    rw [one_mul] at h
    exact h
  have heq : freq n * b n * χ n * Complex.exp ((t : ℂ) * freq n) =
      (b n * χ n) * (Complex.exp ((t : ℂ) * freq n) * freq n) := by ring
  change HasDerivAt (fun u : ℝ => (b n * χ n) * Complex.exp ((u : ℂ) * freq n))
    (freq n * b n * χ n * Complex.exp ((t : ℂ) * freq n)) t
  rw [heq]
  exact hexp.comp_ofReal.const_mul (b n * χ n)

theorem continuous_poly (N : ℕ) (b χ : ℕ → ℂ) : Continuous (poly N b χ) :=
  Differentiable.continuous (fun t => (hasDerivAt_poly N b χ t).differentiableAt)

/-- The logarithmic coefficient weight obtained by differentiating in time. -/
theorem energy_derivative_le (N : ℕ) (b : ℕ → ℂ) :
    (∑ n ∈ Finset.Icc 1 N, ‖freq n * b n‖ ^ 2) ≤
      Real.log (2 * (N : ℝ)) ^ 2 * (∑ n ∈ Finset.Icc 1 N, ‖b n‖ ^ 2) := by
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro n hn
  have h1 : (1 : ℝ) ≤ n := by exact_mod_cast (Finset.mem_Icc.mp hn).1
  have hN : (n : ℝ) ≤ N := by exact_mod_cast (Finset.mem_Icc.mp hn).2
  have hlog := Real.log_nonneg h1
  have hlog' : Real.log (n : ℝ) ≤ Real.log (2 * (N : ℝ)) :=
    Real.log_le_log (by linarith) (by linarith)
  rw [norm_mul, mul_pow]
  have hfreq : ‖freq n‖ = Real.log (n : ℝ) := by
    unfold freq
    rw [norm_mul, norm_neg, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hlog]
  rw [hfreq]
  gcongr

/-- The continuous input is uniform in the coefficients and covers the two extra
half-windows. For Lemma 3.1 its bound is `C ≪ Q²(T + 1/2) + N`. -/
def ContinuousMeanSquare {ι : Type*} (I : Finset ι) (χ : ι → ℕ → ℂ)
    (N : ℕ) (T C : ℝ) : Prop :=
  ∀ b : ℕ → ℂ, (∑ i ∈ I, ∫ t in (-T - 1 / 2)..(T + 1 / 2), ‖poly N b (χ i) t‖ ^ 2) ≤
    C * (∑ n ∈ Finset.Icc 1 N, ‖b n‖ ^ 2)

/-- A continuous mixed mean square for Dirichlet polynomials yields its discrete
counterpart with only one factor `1 + log (2 N)`. -/
theorem poly_sampled_mean_square_le {ι : Type*} (I : Finset ι) (χ : ι → ℕ → ℂ)
    (S : ι → Finset ℝ) {N : ℕ} (hN : 1 ≤ N) (b : ℕ → ℂ) {T C : ℝ}
    (hT : 0 ≤ T) (hC : 0 ≤ C) (hmean : ContinuousMeanSquare I χ N T C)
    (hsep : WellSpaced S) (hbound : ∀ i ∈ I, ∀ t ∈ S i, |t| ≤ T) :
    (∑ i ∈ I, ∑ t ∈ S i, ‖poly N b (χ i) t‖ ^ 2) ≤
      (1 + Real.log (2 * (N : ℝ))) * C * (∑ n ∈ Finset.Icc 1 N, ‖b n‖ ^ 2) := by
  let L := Real.log (2 * (N : ℝ))
  let E := ∑ n ∈ Finset.Icc 1 N, ‖b n‖ ^ 2
  let D := fun n => freq n * b n
  have hN' : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hL : 0 < L := Real.log_pos (by linarith)
  have h₂ :
      (∑ i ∈ I, ∫ t in (-T - 1 / 2)..(T + 1 / 2), ‖poly N D (χ i) t‖ ^ 2) ≤
        C * (L ^ 2 * E) :=
    (hmean D).trans (mul_le_mul_of_nonneg_left (energy_derivative_le N b) hC)
  calc
    (∑ i ∈ I, ∑ t ∈ S i, ‖poly N b (χ i) t‖ ^ 2) ≤
        (1 + L / 2) * (∑ i ∈ I, ∫ t in (-T - 1 / 2)..(T + 1 / 2), ‖poly N b (χ i) t‖ ^ 2) +
          (1 / (2 * L)) * (∑ i ∈ I, ∫ t in (-T - 1 / 2)..(T + 1 / 2), ‖poly N D (χ i) t‖ ^ 2) :=
      sampled_mean_square_le I S (fun i => poly N b (χ i)) (fun i => poly N D (χ i))
        (fun i _ t => hasDerivAt_poly N b (χ i) t) (fun i _ => continuous_poly N D (χ i))
        hsep hT hL hbound
    _ ≤ (1 + L / 2) * (C * E) + (1 / (2 * L)) * (C * (L ^ 2 * E)) :=
      add_le_add (mul_le_mul_of_nonneg_left (hmean b) (by positivity))
        (mul_le_mul_of_nonneg_left h₂ (by positivity))
    _ = (1 + L) * C * E := by field_simp [ne_of_gt hL]; ring

/-- The cardinality branch obtained from the continuous mixed mean square.
The sum of fiber cardinalities counts the pairs `(t, χ)`, not distinct times. -/
theorem poly_large_values_card_le {ι : Type*} (I : Finset ι) (χ : ι → ℕ → ℂ)
    (S : ι → Finset ℝ) {N : ℕ} (hN : 1 ≤ N) (b : ℕ → ℂ) {T C U : ℝ}
    (hT : 0 ≤ T) (hC : 0 ≤ C) (hU : 0 < U) (hmean : ContinuousMeanSquare I χ N T C)
    (hsep : WellSpaced S) (hbound : ∀ i ∈ I, ∀ t ∈ S i, |t| ≤ T)
    (hlarge : ∀ i ∈ I, ∀ t ∈ S i, U ≤ ‖poly N b (χ i) t‖) :
    (∑ i ∈ I, ((S i).card : ℝ)) ≤
      (1 + Real.log (2 * (N : ℝ))) * C * (∑ n ∈ Finset.Icc 1 N, ‖b n‖ ^ 2) / U ^ 2 := by
  apply (le_div_iff₀ (sq_pos_of_pos hU)).2
  calc
    (∑ i ∈ I, ((S i).card : ℝ)) * U ^ 2 = ∑ i ∈ I, ∑ _t ∈ S i, U ^ 2 := by
      rw [Finset.sum_mul]
      simp [nsmul_eq_mul]
    _ ≤ ∑ i ∈ I, ∑ t ∈ S i, ‖poly N b (χ i) t‖ ^ 2 := by
      refine Finset.sum_le_sum fun i hi => Finset.sum_le_sum fun t ht => ?_
      gcongr
      exact hlarge i hi t ht
    _ ≤ _ := poly_sampled_mean_square_le I χ S hN b hT hC hmean hsep hbound

/-- Passing from the usual coefficients at `s = 1/2 + it` to the normalized
coefficients used in `poly`. -/
def criticalCoeff (a : ℕ → ℂ) (n : ℕ) : ℂ := a n / (n : ℂ) ^ (1 / 2 : ℂ)

theorem poly_criticalCoeff_eq_sum_div_cpow (N : ℕ) (a χ : ℕ → ℂ) (t : ℝ) :
    poly N (criticalCoeff a) χ t =
      ∑ n ∈ Finset.Icc 1 N, a n * χ n / (n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I) := by
  unfold poly criticalCoeff
  refine Finset.sum_congr rfl fun n hn => ?_
  have hn' : (n : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)
  have hphase : Complex.exp ((t : ℂ) * freq n) = (n : ℂ) ^ (-((t : ℂ) * Complex.I)) := by
    rw [Complex.cpow_def_of_ne_zero hn', ← Complex.natCast_log]
    unfold freq
    congr 1
    ring
  rw [hphase, Complex.cpow_neg, Complex.cpow_add _ _ hn']
  simp only [div_eq_mul_inv, mul_inv_rev]
  ring

/-- Critical-line normalization turns coefficient energy into the `1/n`-weighted sum. -/
theorem norm_criticalCoeff_sq (a : ℕ → ℂ) (n : ℕ) :
    ‖criticalCoeff a n‖ ^ 2 = ‖a n‖ ^ 2 / n := by
  have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hs : (Real.sqrt (n : ℝ) : ℂ) = (n : ℂ) ^ (1 / 2 : ℂ) := by
    rw [Real.sqrt_eq_rpow]
    simpa only [Complex.ofReal_natCast, Complex.ofReal_div, Complex.ofReal_one,
      Complex.ofReal_ofNat] using Complex.ofReal_cpow hn (1 / 2)
  rw [criticalCoeff, ← hs, norm_div, div_pow, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Real.sqrt_nonneg _), Real.sq_sqrt hn]

/-- For `N ≥ 1` the sampling loss is at most `3 log (2N)`. -/
theorem sampling_loss_le_three_log {N : ℕ} (hN : 1 ≤ N) :
    1 + Real.log (2 * (N : ℝ)) ≤ 3 * Real.log (2 * (N : ℝ)) := by
  have hN' : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have h := Real.log_le_log (by norm_num : (0 : ℝ) < 2) (show 2 ≤ 2 * (N : ℝ) by linarith)
  linarith [Real.log_two_gt_d9]

/-- The `U⁻²` branch at the paper's `1/2 + it` line, without inserting a
divisor-function bound for the coefficient energy. -/
theorem critical_large_values_card_le {ι : Type*} (I : Finset ι) (χ : ι → ℕ → ℂ)
    (S : ι → Finset ℝ) {N : ℕ} (hN : 1 ≤ N) (a : ℕ → ℂ) {T C U : ℝ}
    (hT : 0 ≤ T) (hC : 0 ≤ C) (hU : 0 < U) (hmean : ContinuousMeanSquare I χ N T C)
    (hsep : WellSpaced S) (hbound : ∀ i ∈ I, ∀ t ∈ S i, |t| ≤ T)
    (hlarge : ∀ i ∈ I, ∀ t ∈ S i, U ≤
      ‖∑ n ∈ Finset.Icc 1 N, a n * χ i n / (n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I)‖) :
    (∑ i ∈ I, ((S i).card : ℝ)) ≤
      3 * Real.log (2 * (N : ℝ)) * C * (∑ n ∈ Finset.Icc 1 N, ‖a n‖ ^ 2 / (n : ℝ)) / U ^ 2 := by
  have h := poly_large_values_card_le I χ S hN (criticalCoeff a) hT hC hU hmean hsep hbound
    (fun i hi t ht => by rw [poly_criticalCoeff_eq_sum_div_cpow]; exact hlarge i hi t ht)
  simp_rw [norm_criticalCoeff_sq] at h
  refine h.trans (div_le_div_of_nonneg_right ?_ (sq_nonneg U))
  exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (sampling_loss_le_three_log hN) hC)
    (Finset.sum_nonneg fun n _ => div_nonneg (sq_nonneg _) (Nat.cast_nonneg n))

end
end ShortAPLargeValues

end

