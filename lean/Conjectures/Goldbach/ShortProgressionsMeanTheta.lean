theorem high_prefix_bound (p U : ℕ) {ε : ℝ} (hε : 0<ε) :
    ShortAPMobiusHighCap.HighOscPrefixBound p U ε := by
  obtain ⟨F,h⟩ := ShortAPMobiusHighPrefix.high_prefix p U hε
  refine ⟨F,?_⟩
  filter_upwards [h] with x hx
  intro q χ hq _ hQ t ht htx y hy hy'
  let _ : NeZero q := ⟨by omega⟩
  exact hx q χ t y hQ ht htx hy hy'

/-- The small-conductor second cap in (4.8), on every contributing box of
every block in the order-four Heath--Brown decomposition and the full |t|≤x band. -/
theorem all_blocks_cap (P Uexp : ℕ) : ∀ᶠ x : ℝ in atTop, ∀ {X H j q : ℕ}
    (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive → ∀ (t a z : ℝ) (b : Choice j),
    j < 4 → H ≠ 0 → H ≤ X → (X:ℝ) ≤ 4*x → (H:ℝ) ≤ (4*x)^((1:ℝ)/4) →
    x ≤ a → z ≤ 4*x → b ∈ activeChoices X H j a z →
    (q:ℝ) ≤ 2*(Real.log x)^Uexp → |t| ≤ x →
    ∀ U : {i // i ∈ blockIndices j} → ℝ,
    (∀ k, 0 ≤ U k ∧ U k ≤ ‖boxPolynomial H j k.val (b k.val k.property) χ
        (1/2+(t:ℂ)*Complex.I)‖+1) →
    (∏ k ∈ (blockIndices j).attach, U k)*(Real.log x)^P ≤ Real.sqrt x := by
  filter_upwards [ShortAPAllSmoothBlocks.first_three_cap P Uexp,
    ShortAPMobiusHighCap.fourth_cap_of_high_prefix P Uexp (high_prefix_bound _ _ (by norm_num))] with x hs hm
  intro X H j q χ hq hp t a z b hj
  by_cases hj' : j<3
  · exact hs χ hq hp t a z b hj'
  · obtain rfl : j=3 := by omega
    exact hm χ hq hp t a z b

end
end ShortAPAllSmallConductor

