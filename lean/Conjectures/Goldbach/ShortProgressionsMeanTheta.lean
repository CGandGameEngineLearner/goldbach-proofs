    simp only [← pow_two] at hp hlocal ⊢
    have hE := mul_le_mul_of_nonneg_left herror (sq_nonneg (M:ℝ))
    dsimp only [T] at *
    nlinarith
  have hh := V1ad f hf H M M ((M:ℝ)^2*(A+T)) hB
  dsimp only [f] at hh
  apply (mul_le_mul_iff_right₀ hM2).mp
  convert hh using 1
  · push_cast
    ring
  · dsimp only [T]
    push_cast
    ring
end V2
