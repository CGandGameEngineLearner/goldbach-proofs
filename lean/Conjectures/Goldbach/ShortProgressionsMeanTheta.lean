/-- Transport the absolute-convergence bound at the right edge to the left
edge of a zero-free horizontal segment. The exponent uses its actual width. -/
theorem horizontal {f : ℂ → ℂ} {a b t K : ℝ} (hab : a ≤ b)
    (hf : ∀ σ ∈ Icc a b, DifferentiableAt ℂ f ((σ:ℂ)+Complex.I*(t:ℂ)))
    (hz : ∀ σ ∈ Icc a b, f ((σ:ℂ)+Complex.I*(t:ℂ)) ≠ 0)
    (hd : ∀ σ ∈ Icc a b, ‖deriv f ((σ:ℂ)+Complex.I*(t:ℂ)) / f ((σ:ℂ)+Complex.I*(t:ℂ))‖ ≤ K) :
    ‖(f ((a:ℂ)+Complex.I*(t:ℂ)))⁻¹‖ ≤
      ‖(f ((b:ℂ)+Complex.I*(t:ℂ)))⁻¹‖ * Real.exp (K*(b-a)) := by
  let z := fun w : ℂ => (b:ℂ)-w+Complex.I*(t:ℂ)
  let g := fun u : ℝ => (f (z (u:ℂ)))⁻¹
  let d := fun u : ℝ => (deriv f (z (u:ℂ)) / f (z (u:ℂ))) * (f (z (u:ℂ)))⁻¹
  have hmem (u : ℝ) (hu : u ∈ Icc 0 (b-a)) : b-u ∈ Icc a b :=
    ⟨by linarith [hu.2], by linarith [hu.1]⟩
  have he (u : ℝ) : z (u:ℂ) = ((b-u:ℝ):ℂ)+Complex.I*(t:ℂ) := by simp [z]
  have hp (u : ℝ) (hu : u ∈ Icc 0 (b-a)) : HasDerivAt g (d u) u := by
    have hdf := (hf _ (hmem u hu)).hasDerivAt
    have hnon := hz _ (hmem u hu)
    rw [← he] at hdf hnon
    have hdz : HasDerivAt z (-1) (u:ℂ) := by
      simpa [z] using (((hasDerivAt_id (u:ℂ)).const_sub (b:ℂ)).add_const (Complex.I*(t:ℂ)))
    have h := ((hdf.comp (u:ℂ) hdz).inv hnon).comp_ofReal
    have he' : d u = -(deriv f (z (u:ℂ)) * -1) / (f (z (u:ℂ)))^2 := by
      dsimp only [d]; field_simp
    rw [he']
    exact h
  have hgr := norm_le_gronwallBound_of_norm_deriv_right_le
    (fun u hu => (hp u hu).continuousAt.continuousWithinAt)
    (fun u hu => (hp u (Ico_subset_Icc_self hu)).hasDerivWithinAt) (le_refl ‖g 0‖)
    (ε := 0) (K := K) (fun u hu => by
      dsimp [d,g]; rw [norm_mul, add_zero]
      apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
      rw [he]; exact hd _ (hmem u (Ico_subset_Icc_self hu)))
    (b-a) (right_mem_Icc.mpr (sub_nonneg.mpr hab))
  simpa [g,z,gronwallBound_ε0] using hgr

end ShortAPReciprocalStrip

