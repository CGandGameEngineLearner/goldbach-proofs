section

open Filter OAI.Vg
open scoped Topology

namespace ShortAPMobiusRectangleStrip

/-- One rectangle width works for all polynomial heights and all polylogarithmic
conductors. The reciprocal has an ordinary fixed power of log x as its bound. -/
theorem uniform_strip (B : ℕ) : ∃ A : ℕ, ∃ T₀ : ℝ, ∀ᶠ x : ℝ in atTop,
    ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) (w σ : ℝ),
      (q:ℝ) ≤ 2*(Real.log x)^B → T₀ ≤ |w| → |w| ≤ 2*x →
      1-(Real.log x)^(-(3:ℝ)/4) ≤ σ → σ ≤ 1+1/(Real.log x) →
      DirichletCharacter.LFunction χ ((σ:ℂ)+Complex.I*(w:ℂ)) ≠ 0 ∧
      ‖(DirichletCharacter.LFunction χ ((σ:ℂ)+Complex.I*(w:ℂ)))⁻¹‖ ≤ (Real.log x)^A := by
  obtain ⟨c,C,T,hc,hC,hT,hh⟩ := ShortAPVinogradovReciprocal.reciprocal_on_strip
  let M := (B:ℝ)+4
  have hM : 0<M := by dsimp [M]; positivity
  obtain ⟨d,hd⟩ := exists_nat_ge (C*M)
  let K := 2*M/c
  have hK : 0<K := by dsimp [K]; positivity
  have hlog : ∀ᶠ L : ℝ in atTop, K * Real.log L ≤ L^((1:ℝ)/12) := by
    have ho := (isLittleO_log_rpow_rpow_atTop (1:ℝ) (by norm_num : (0:ℝ)<1/12)).bound (inv_pos.mpr hK)
    filter_upwards [ho,eventually_ge_atTop (1:ℝ)] with L h h1
    rw [Real.rpow_one, Real.norm_eq_abs, abs_of_nonneg (Real.log_nonneg h1), Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (zero_le_one.trans h1) _)] at h
    exact (le_inv_mul_iff₀ hK).mp h
  refine ⟨d+1,max T (Real.exp 1),?_⟩
  filter_upwards [Real.tendsto_log_atTop.eventually hlog,
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (Real.exp 1)),eventually_ge_atTop (8:ℝ)] with x hpay hlarge hx
  let L := Real.log x
  have hx0 : 0<x := by linarith
  have hL1 : 1≤L := (Real.one_le_exp (by norm_num : (0:ℝ)≤1)).trans hlarge
  have hL0 : 0<L := zero_lt_one.trans_le hL1
  have hlog1 : 1 ≤ Real.log L := by simpa using Real.log_le_log (Real.exp_pos _) hlarge
  intro q _ χ w σ hq ht hw hlo hhi
  let W := V96 (2*w)
  let V := Vcw q (2*w)
  let r := c*V36 (2*w)/V
  have hW1 : 1≤W := by
    change 1 ≤ Real.log (|2*w|+3)
    rw [← Real.log_exp 1]
    apply Real.log_le_log (Real.exp_pos _)
    have he := (le_max_right T (Real.exp 1)).trans ht
    rw [abs_mul,abs_of_pos (by norm_num : (0:ℝ)<2)]
    linarith [abs_nonneg w]
  have hW0 : 0<W := zero_lt_one.trans_le hW1
  have hW : W ≤ 2*L := by
    have h := Real.log_le_log (show 0 < |2*w|+3 by positivity) (y := x^2) (by
      rw [abs_mul, abs_of_pos (by norm_num : (0:ℝ)<2)]
      nlinarith [sq_nonneg (x-4)])
    simpa [W,V96,L,Real.log_pow] using h
  have hV1 : 1≤V := V1h1 hW1
  have hV0 : 0<V := zero_lt_one.trans_le hV1
  have hV : V ≤ M*Real.log L := by
    have hq0 : 0<(q:ℝ) := by exact_mod_cast NeZero.pos q
    have h₁ := Real.log_le_log hq0 hq
    rw [Real.log_mul (by norm_num) (pow_ne_zero _ hL0.ne'),Real.log_pow] at h₁
    have h₂ := Real.log_le_log hW0 hW
    rw [Real.log_mul (by norm_num) hL0.ne'] at h₂
    change 1+Real.log q+Real.log W ≤ ((B:ℝ)+4)*Real.log L
    nlinarith [Real.log_le_sub_one_of_pos (by norm_num : (0:ℝ)<2)]
  have hr0 : 0<r := div_pos (mul_pos hc (Real.rpow_pos_of_pos hW0 _)) hV0
  have hwp : W^((2:ℝ)/3) ≤ 2*L^((2:ℝ)/3) := calc
    _ ≤ (2*L)^((2:ℝ)/3) := Real.rpow_le_rpow hW0.le hW (by norm_num)
    _ ≤ _ := by
      rw [Real.mul_rpow (by norm_num) hL0.le]
      exact mul_le_mul_of_nonneg_right ((Real.rpow_le_rpow_of_exponent_le (by norm_num : (1:ℝ)≤2)
        (by norm_num : (2:ℝ)/3≤1)).trans_eq (Real.rpow_one _)) (Real.rpow_nonneg hL0.le _)
  have hri : r⁻¹ ≤ L^((3:ℝ)/4) := by
    have hid : r⁻¹ = (V*W^((2:ℝ)/3))/c := by
      dsimp only [r,V36,W]; rw [Real.rpow_neg hW0.le]; field_simp; rfl
    rw [hid]
    calc
      _ ≤ ((M*Real.log L)*(2*L^((2:ℝ)/3)))/c := div_le_div_of_nonneg_right
        (mul_le_mul hV hwp (Real.rpow_nonneg hW0.le _) (mul_nonneg hM.le (by linarith))) hc.le
      _ = (K*Real.log L) * L^((2:ℝ)/3) := by dsimp [K]; ring
      _ ≤ L^((1:ℝ)/12)*L^((2:ℝ)/3) := mul_le_mul_of_nonneg_right hpay (Real.rpow_nonneg hL0.le _)
      _ = _ := by rw [← Real.rpow_add hL0]; norm_num
  have hrlo : L^(-(3:ℝ)/4) ≤ r := by
    rw [show -(3:ℝ)/4=-(3/4:ℝ) by ring, Real.rpow_neg hL0.le]
    simpa using inv_anti₀ (inv_pos.mpr hr0) hri
  have hriL : r⁻¹ ≤ L := hri.trans ((Real.rpow_le_rpow_of_exponent_le hL1
    (by norm_num : (3:ℝ)/4 ≤ 1)).trans_eq (Real.rpow_one _))
  have hir : 1/L ≤ r := by simpa [one_div] using inv_anti₀ (inv_pos.mpr hr0) hriL
  obtain ⟨hn, hrec⟩ := hh q χ w ((le_max_left _ _).trans ht) hW1 σ
    ⟨by linarith, by linarith⟩
  refine ⟨hn, hrec.trans ?_⟩
  have hexp : Real.exp (C*V) ≤ L^d := by
    rw [← Real.rpow_natCast,Real.rpow_def_of_pos hL0]
    apply Real.exp_le_exp.mpr
    nlinarith [mul_le_mul_of_nonneg_left hV hC.le,
      mul_le_mul_of_nonneg_right hd (show 0≤Real.log L by linarith)]
  exact (mul_le_mul hriL hexp (Real.exp_pos _).le hL0.le).trans_eq (by rw [pow_succ]; ring)

end ShortAPMobiusRectangleStrip

end

section

open Filter

namespace ShortAPMobiusContourBudget

/-- Left-edge gain and right-edge cost for Mellin inversion at a scale
y between x^ε and 8x. The logarithmic exponents and ε are fixed before x. -/
theorem edges (m : ℕ) {ε : ℝ} (hε : 0<ε) : ∀ᶠ x : ℝ in atTop, ∀ y : ℝ,
    x^ε ≤ y → y ≤ 8*x →
    let L := Real.log x
    L^m*y^(1-L^(-(3:ℝ)/4)) ≤ y ∧ y^(1+1/L) ≤ Real.exp 2*y := by
  have ho := (isLittleO_log_rpow_rpow_atTop (1:ℝ) (by norm_num : (0:ℝ)<1/4)).bound
    (show 0 < ε/((m:ℝ)+1) by positivity)
  filter_upwards [Real.tendsto_log_atTop.eventually ho, eventually_ge_atTop (8:ℝ),
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1:ℝ))] with x hl hx hL
  intro y hlower hupper L
  have hL0 : 0<L := zero_lt_one.trans_le hL
  have hx0 : 0<x := by linarith
  have hy0 := (Real.rpow_pos_of_pos hx0 ε).trans_le hlower
  have hl1 := Real.log_le_log (Real.rpow_pos_of_pos hx0 ε) hlower
  rw [Real.log_rpow hx0] at hl1
  have hp : (m:ℝ)*Real.log L ≤ ε*L^((1:ℝ)/4) := by
    change ‖(Real.log L)^(1:ℝ)‖ ≤ (ε/((m:ℝ)+1))*‖L^((1:ℝ)/4)‖ at hl
    rw [Real.rpow_one,Real.norm_eq_abs,abs_of_nonneg (Real.log_nonneg hL),
      Real.norm_eq_abs,abs_of_nonneg (Real.rpow_nonneg hL0.le _)] at hl
    have h₀ : 0<(m:ℝ)+1 := by positivity
    calc
      _ ≤ ((m:ℝ)+1)*Real.log L := by linarith [Real.log_nonneg hL]
      _ ≤ ((m:ℝ)+1)*((ε/((m:ℝ)+1))*L^((1:ℝ)/4)) := mul_le_mul_of_nonneg_left hl h₀.le
      _ = _ := by field_simp
  have hleft : L*L^(-(3:ℝ)/4) = L^((1:ℝ)/4) := by
    conv_lhs => lhs; rw [← Real.rpow_one L]
    rw [← Real.rpow_add hL0]; norm_num
  have hp' : (m:ℝ)*Real.log L ≤ Real.log y * L^(-(3:ℝ)/4) := hp.trans (by
    rw [← hleft, ← mul_assoc]
    exact mul_le_mul_of_nonneg_right hl1 (Real.rpow_nonneg hL0.le _))
  constructor
  · rw [← Real.rpow_natCast, Real.rpow_def_of_pos hL0, Real.rpow_def_of_pos hy0, ← Real.exp_add]
    conv_rhs => rw [← Real.exp_log hy0]
    exact Real.exp_le_exp.mpr (by nlinarith)
  · have hu := Real.log_le_log hy0 (show y ≤ x^2 by nlinarith [mul_nonneg hx0.le (sub_nonneg.mpr hx)])
    rw [Real.log_pow] at hu
    have hv : Real.log y/L ≤ 2 := (div_le_iff₀ hL0).mpr (by simpa [L] using hu)
    rw [Real.rpow_add hy0,Real.rpow_one,Real.rpow_def_of_pos hy0, mul_comm (Real.exp 2)]
    apply mul_le_mul_of_nonneg_left _ hy0.le
    exact Real.exp_le_exp.mpr (by simpa [div_eq_mul_inv] using hv)

/-- The complete four-edge and tail budget with the concrete truncation
height log(x)^(A+p+2). Constants do not depend on the modulus, height or y. -/
theorem rectangle_budget (A p : ℕ) {ε : ℝ} (hε : 0<ε) :
    ∀ᶠ x : ℝ in atTop, ∀ y : ℝ, x^ε ≤ y → y ≤ 8*x →
    let L := Real.log x
    let a := 1-L^(-(3:ℝ)/4)
    let b := 1+1/L
    let T := L^(A+p+2)
    (4*Real.pi*L^A*y^a + 2*(b-a)*L^A*y^b/T^2 + 2*y^b*(1+1/(b-1))/T)/(2*Real.pi) ≤
      ((4*Real.pi+8*Real.exp 2)/(2*Real.pi))*y/L^p := by
  filter_upwards [edges (A+p) hε,Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1:ℝ)),
    eventually_ge_atTop (1:ℝ)] with x hedge hL hx
  intro y hy hy' L a b T
  obtain ⟨hedgel,hedger⟩ := hedge y hy hy'
  have hL0 : 0<L := zero_lt_one.trans_le hL
  have hy0 : 0<y := (Real.rpow_pos_of_pos (zero_lt_one.trans_le hx) _).trans_le hy
  have hT : 1≤T := one_le_pow₀ hL
  have hT0 : 0<T := zero_lt_one.trans_le hT
  have hP : 0<L^p := pow_pos hL0 _
  have hc : b-a ≤ 2 := by
    have hneg := Real.rpow_le_one_of_one_le_of_nonpos hL (by norm_num : -(3:ℝ)/4≤0)
    dsimp only [a,b]; linarith [one_div_le_one_div_of_le (by norm_num : (0:ℝ)<1) hL]
  have hid : 1/(b-1) = L := by simp [b]
  have h1 : (4*Real.pi*L^A*y^a)*L^p ≤ 4*Real.pi*y := by
    convert mul_le_mul_of_nonneg_left hedgel (show 0 ≤ 4*Real.pi by positivity) using 1
    dsimp only [a,L]; rw [pow_add]; ring
  have h2 : (2*(b-a)*L^A*y^b/T^2)*L^p ≤ 4*Real.exp 2*y := by
    rw [div_mul_eq_mul_div,div_le_iff₀ (sq_pos_of_pos hT0)]
    calc
      _ ≤ 4*(L^A*L^p)*y^b := by
        nlinarith only [mul_le_mul_of_nonneg_right hc (show 0≤2*L^A*y^b*L^p by positivity)]
      _ ≤ 4*T^2*(Real.exp 2*y) := by
        rw [← pow_add]
        apply mul_le_mul _ hedger (Real.rpow_nonneg hy0.le _) (by positivity)
        apply mul_le_mul_of_nonneg_left _ (by norm_num)
        exact (pow_le_pow_right₀ hL (show A+p ≤ A+p+2 by omega)).trans (by nlinarith [hT])
      _ = _ := by ring
  have h3 : (2*y^b*(1+1/(b-1))/T)*L^p ≤ 4*Real.exp 2*y := by
    rw [hid,div_mul_eq_mul_div,div_le_iff₀ hT0]
    have hpow : L*L^p ≤ T := by
      rw [← pow_succ']
      exact pow_le_pow_right₀ hL (by omega : p+1≤A+p+2)
    have hcoef : (1+L)*L^p ≤ 2*T := by
      nlinarith only [mul_le_mul_of_nonneg_right (show 1+L≤2*L by linarith) hP.le,hpow]
    nlinarith only [mul_le_mul hcoef hedger (Real.rpow_nonneg hy0.le _) (by positivity : 0 ≤ 2*T)]
  have htotal : (4*Real.pi*L^A*y^a + 2*(b-a)*L^A*y^b/T^2 + 2*y^b*(1+1/(b-1))/T)*L^p ≤
      (4*Real.pi+8*Real.exp 2)*y := by linarith only [h1,h2,h3]
  apply (le_div_iff₀ hP).2
  rw [div_mul_eq_mul_div, div_le_iff₀ (show 0 < 2*Real.pi by positivity)]
  convert htotal using 1
  field_simp

end ShortAPMobiusContourBudget

end

section

/-! A finite-rectangle estimate for the Riesz integral of a twisted Möbius sum. -/

noncomputable section
open Set MeasureTheory

namespace ShortAPMobiusRectangle

set_option maxHeartbeats 1000000

private def vertical (σ v : ℝ) : ℂ := (σ : ℂ) + (v : ℂ) * Complex.I

@[simp] private theorem vertical_re (σ v : ℝ) : (vertical σ v).re = σ := by
  simp [vertical]

@[simp] private theorem vertical_im (σ v : ℝ) : (vertical σ v).im = v := by
  simp [vertical]

private theorem norm_vertical_sq (σ v : ℝ) :
    ‖vertical σ v‖ ^ 2 = σ ^ 2 + v ^ 2 := by
  rw [Complex.sq_norm, Complex.normSq_apply, vertical_re, vertical_im]
  ring

private theorem denominator_lower {σ : ℝ} (hσ : 0 ≤ σ) (v : ℝ) :
    σ ^ 2 + v ^ 2 ≤ ‖vertical σ v * (vertical σ v + 1)‖ := by
  have he : vertical σ v + 1 = vertical (σ + 1) v := by
    simp [vertical, Complex.ofReal_add]
    ring
  have hs : ‖vertical σ v‖ ≤ ‖vertical (σ + 1) v‖ := by
    have hsq : ‖vertical σ v‖ ^ 2 ≤ ‖vertical (σ + 1) v‖ ^ 2 := by
      rw [norm_vertical_sq, norm_vertical_sq]
      nlinarith
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) (by decide)).mp hsq
  rw [norm_mul, he, ← norm_vertical_sq]
  simpa only [pow_two] using mul_le_mul_of_nonneg_left hs (norm_nonneg _)

/-- Absolute convergence to the right of 1 gives a bound at every height,
so the high-frequency nonvanishing estimate is not needed on either tail. -/
theorem reciprocal_norm_le_of_one_lt {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (t : ℝ) {s : ℂ} (hs : 1 < s.re) :
    ‖(χ.LFunction (s + (t : ℂ) * Complex.I))⁻¹‖ ≤ 1 + 1 / (s.re - 1) := by
  let b := s.re
  have hb : 1 < b := hs
  have hneg : -b < -1 := by linarith
  have hg : Summable (fun n : ℕ => (n : ℝ) ^ (-b)) := Real.summable_nat_rpow.mpr hneg
  have hg₀ : (0 : ℝ) ^ (-b) = 0 := Real.zero_rpow (by linarith)
  have hterm (n : ℕ) : ‖LSeries.term (ShortAPMobiusRiesz.osc χ t) s n‖ ≤ (n : ℝ) ^ (-b) := by
    by_cases hn : n = 0
    · subst n
      simp [hg₀]
    rw [LSeries.term_of_ne_zero hn, norm_div, Complex.norm_natCast_cpow_of_pos (Nat.pos_of_ne_zero hn),
      Real.rpow_neg (by positivity)]
    rw [← one_div]
    exact div_le_div_of_nonneg_right (ShortAPMobiusRiesz.norm_osc χ t n)
      (Real.rpow_nonneg (Nat.cast_nonneg n) _)
  have hf : Summable fun n => ‖LSeries.term (ShortAPMobiusRiesz.osc χ t) s n‖ :=
    hg.of_nonneg_of_le (fun _ => norm_nonneg _) hterm
  rw [← ShortAPMobiusRiesz.series_eq_inv χ t s hs, LSeries]
  refine (norm_tsum_le_tsum_norm hf).trans ((hf.tsum_le_tsum hterm hg).trans ?_)
  have hmon : AntitoneOn (fun y : ℝ => y ^ (-b)) (Ici (1 : ℝ)) := by
    intro y hy z _ hyz
    exact Real.rpow_le_rpow_of_nonpos (by linarith [mem_Ici.mp hy]) hyz (by linarith)
  have hi := hmon.tsum_comp_add_le_integral 1
    (integrableOn_Ioi_rpow_of_lt hneg (by norm_num))
    (fun y hy => Real.rpow_nonneg (by linarith [mem_Ioi.mp hy]) _)
  simp only [Nat.cast_one] at hi
  rw [integral_Ioi_rpow_of_lt hneg (by norm_num), Real.one_rpow] at hi
  have hsplit := hg.sum_add_tsum_nat_add 2
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.cast_zero, Nat.cast_one,
    hg₀, Real.one_rpow, zero_add] at hsplit
  rw [← hsplit]
  change 1 + (∑' n : ℕ, ((n + 2 : ℕ) : ℝ) ^ (-b)) ≤ 1 + 1 / (b - 1)
  rw [add_le_add_iff_left]
  rw [show -b + 1 = -(b - 1) by ring, div_neg, neg_div, neg_neg] at hi
  simpa only [Nat.add_assoc] using hi

private theorem integral_right_tail {T : ℝ} (hT : 0 < T) :
    (∫ v : ℝ in Ioi T, (v ^ 2)⁻¹) = T⁻¹ := by
  have h := integral_Ioi_rpow_of_lt (a := -2) (by norm_num) hT
  rw [show (-2 : ℝ) + 1 = -1 by norm_num, Real.rpow_neg_one] at h
  simp only [div_neg, div_one, neg_neg] at h
  rw [← h]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro v hv
  change (v ^ (2 : ℕ))⁻¹ = v ^ (-2 : ℝ)
  rw [Real.rpow_neg (hT.trans (mem_Ioi.mp hv)).le, Real.rpow_two]

private theorem integrable_right_tail {T : ℝ} (hT : 0 < T) :
    IntegrableOn (fun v : ℝ => (v ^ 2)⁻¹) (Ioi T) := by
  apply (integrableOn_Ioi_rpow_of_lt (a := -2) (by norm_num) hT).congr_fun _ measurableSet_Ioi
  intro v hv
  change v ^ (-2 : ℝ) = (v ^ (2 : ℕ))⁻¹
  rw [Real.rpow_neg (hT.trans (mem_Ioi.mp hv)).le, Real.rpow_two]

/-- The three finite sides and the two infinite tails, separated before
estimating, so the better bound in the rectangle is used only there. -/
private theorem norm_integral_le_finite_rectangle {F : ℂ → ℂ} {a b T A H R : ℝ}
    (hab : a ≤ b) (hT : 0 < T)
    (hd : DifferentiableOn ℂ F (Complex.reProdIm (Icc a b) (Icc (-T) T)))
    (hint : Integrable (fun v : ℝ => F (vertical b v)))
    (hA : 0 ≤ A)
    (hleft : ∀ v ∈ Icc (-T) T, ‖F (vertical a v)‖ ≤ A * (1 + v ^ 2)⁻¹)
    (hhoriz : ∀ σ ∈ Icc a b, ∀ v : ℝ, |v| = T → ‖F (vertical σ v)‖ ≤ H)
    (htail : ∀ v : ℝ, T ≤ |v| → ‖F (vertical b v)‖ ≤ R * (v ^ 2)⁻¹) :
    ‖∫ v : ℝ, F (vertical b v)‖ ≤ A * Real.pi + 2 * (b - a) * H + 2 * R / T := by
  have hTT : -T ≤ T := by linarith
  let V (σ : ℝ) : ℂ := ∫ v in -T..T, F (vertical σ v)
  let W (v : ℝ) : ℂ := ∫ σ in a..b, F (vertical σ v)
  have hd' : DifferentiableOn ℂ F
      (Complex.reProdIm (uIcc (vertical a (-T)).re (vertical b T).re)
        (uIcc (vertical a (-T)).im (vertical b T).im)) := by
    simpa only [vertical_re, vertical_im, uIcc_of_le hab, uIcc_of_le hTT] using hd
  have he : W (-T) - W T + Complex.I * V b - Complex.I * V a = 0 := by
    have he := Complex.integral_boundary_rect_eq_zero_of_differentiableOn F (vertical a (-T))
      (vertical b T) hd'
    simp only [vertical_re, vertical_im, smul_eq_mul] at he
    exact he
  have hVA : ‖V a‖ ≤ A * Real.pi := by
    let g (v : ℝ) := A * (1 + v ^ 2)⁻¹
    have hg : Integrable g := integrable_inv_one_add_sq.const_mul A
    change ‖∫ v in -T..T, F (vertical a v)‖ ≤ _
    rw [intervalIntegral.integral_of_le hTT]
    refine (norm_integral_le_of_norm_le hg.integrableOn ?_).trans ?_
    · filter_upwards [ae_restrict_mem (μ := volume) measurableSet_Ioc] with v hv
      exact hleft v (Ioc_subset_Icc_self hv)
    · calc
        (∫ v in Ioc (-T) T, g v) ≤ ∫ v, g v :=
          setIntegral_le_integral hg (ae_of_all _ fun v => mul_nonneg hA (by positivity))
        _ = A * Real.pi := by rw [show (∫ v, g v) = A * ∫ v : ℝ, (1 + v ^ 2)⁻¹
              from integral_const_mul A _, integral_univ_inv_one_add_sq]
  have hW (v : ℝ) (hv : |v| = T) : ‖W v‖ ≤ H * (b - a) := by
    rw [← abs_of_nonneg (sub_nonneg.mpr hab)]
    exact intervalIntegral.norm_integral_le_of_norm_le_const
      (fun σ hσ => hhoriz σ (Ioc_subset_Icc_self (by simpa only [uIoc_of_le hab] using hσ)) v hv)
  have hVB : ‖V b‖ ≤ A * Real.pi + 2 * (b - a) * H := by
    have hrewrite : Complex.I * V b = Complex.I * V a + W T - W (-T) := by
      linear_combination he
    calc
      ‖V b‖ = ‖Complex.I * V b‖ := by rw [norm_mul, Complex.norm_I, one_mul]
      _ ≤ ‖Complex.I * V a‖ + ‖W T‖ + ‖W (-T)‖ := by
        rw [hrewrite]
        exact (norm_sub_le _ _).trans (add_le_add_left (norm_add_le _ _) _)
      _ ≤ A * Real.pi + 2 * (b - a) * H := by
        rw [norm_mul, Complex.norm_I, one_mul]
        linarith [hVA, hW T (abs_of_pos hT), hW (-T) (by simp [abs_of_pos hT])]
  let f (v : ℝ) := F (vertical b v)
  have hsplit : (∫ v : ℝ, f v) = V b + (∫ v in Iic (-T), f v) + ∫ v in Ioi T, f v := by
    have h₁ := intervalIntegral.integral_Iic_sub_Iic (a := -T) (b := T)
      hint.integrableOn hint.integrableOn
    have h₂ := intervalIntegral.integral_Iic_add_Ioi (b := T) hint.integrableOn hint.integrableOn
    change _ = (∫ v in -T..T, f v) + _ + _
    rw [← h₂, ← h₁]
    abel
  have hpos (g : ℝ → ℂ) (hg : ∀ v > T, ‖g v‖ ≤ R * (v ^ 2)⁻¹) :
      ‖∫ v in Ioi T, g v‖ ≤ R / T := by
    have hm := (integrable_right_tail hT).const_mul R
    have hle : ∀ᵐ v ∂(volume.restrict (Ioi T)), ‖g v‖ ≤ R * (v ^ 2)⁻¹ := by
      filter_upwards [ae_restrict_mem (μ := volume) measurableSet_Ioi] with v hv
      exact hg v hv
    simpa only [integral_const_mul, integral_right_tail hT, div_eq_mul_inv] using
      norm_integral_le_of_norm_le hm hle
  have hplus : ‖∫ v in Ioi T, f v‖ ≤ R / T :=
    hpos f (fun v hv => htail v (by rw [abs_of_pos (hT.trans hv)]; exact hv.le))
  have hminus : ‖∫ v in Iic (-T), f v‖ ≤ R / T := by
    rw [← integral_comp_neg_Ioi T f]
    apply hpos
    intro v hv
    simpa only [neg_sq] using htail (-v) (by
      rw [abs_neg, abs_of_pos (hT.trans hv)]; exact hv.le)
  change ‖∫ v, f v‖ ≤ _
  rw [hsplit]
  refine ((norm_add_le _ _).trans (add_le_add_left (norm_add_le _ _) _)).trans ?_
  rw [mul_div_assoc 2 R T]
  linarith

private def kernel {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (t x : ℝ) (z : ℂ) : ℂ :=
  (x : ℂ) ^ z * (χ.LFunction (z + (t : ℂ) * Complex.I))⁻¹ / (z * (z + 1))

private theorem kernel_differentiableAt {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {t x : ℝ} {z : ℂ} (hx : 0 < x) (hz : 0 < z.re)
    (havoid : z + (t : ℂ) * Complex.I ≠ 1)
    (hne : χ.LFunction (z + (t : ℂ) * Complex.I) ≠ 0) :
    DifferentiableAt ℂ (kernel χ t x) z := by
  have h₀ : z ≠ 0 := by
    intro h
    simp [h] at hz
  have h₁ : z + 1 ≠ 0 := by
    intro h
    have h' := congrArg Complex.re h
    simp only [Complex.add_re, Complex.one_re, Complex.zero_re] at h'
    linarith
  have hpow : DifferentiableAt ℂ (fun w : ℂ => (x : ℂ) ^ w) z :=
    differentiableAt_id.const_cpow (Or.inl (Complex.ofReal_ne_zero.mpr hx.ne'))
  have hshift : DifferentiableAt ℂ (fun w : ℂ => w + (t : ℂ) * Complex.I) z :=
    differentiableAt_id.add_const _
  have hL : DifferentiableAt ℂ (fun w : ℂ => χ.LFunction (w + (t : ℂ) * Complex.I)) z :=
    (χ.differentiableAt_LFunction _ (Or.inl havoid)).comp z hshift
  have hden : DifferentiableAt ℂ (fun w : ℂ => w * (w + 1)) z :=
    differentiableAt_id.mul (differentiableAt_id.add_const 1)
  exact (hpow.mul (hL.inv hne)).div hden (mul_ne_zero h₀ h₁)

private theorem kernel_norm_le {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {t x σ v K D : ℝ} (hx : 0 < x) (hD : 0 < D)
    (hrec : ‖(χ.LFunction (vertical σ v + (t : ℂ) * Complex.I))⁻¹‖ ≤ K)
    (hden : D ≤ ‖vertical σ v * (vertical σ v + 1)‖) :
    ‖kernel χ t x (vertical σ v)‖ ≤ x ^ σ * K / D := by
  rw [kernel, norm_div, norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hx, vertical_re]
  exact div_le_div₀ (mul_nonneg (by positivity) ((norm_nonneg _).trans hrec))
    (mul_le_mul_of_nonneg_left hrec (by positivity)) hD hden

private theorem integralValue_eq {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (t b : ℝ) {x : ℝ} (hx : 0 < x) :
    ShortAPMobiusRiesz.integralValue χ t b x =
      (1 / (2 * Real.pi)) • ∫ v : ℝ, kernel χ t x (vertical b v) := by
  unfold ShortAPMobiusRiesz.integralValue mellinInv
  congr 1
  apply integral_congr_ae
  filter_upwards with v
  change ((1 / x : ℝ) : ℂ) ^ (-vertical b v) *
      ((χ.LFunction (vertical b v + (t : ℂ) * Complex.I))⁻¹ /
        (vertical b v * (vertical b v + 1))) = _
  rw [one_div, Complex.ofReal_inv, Complex.inv_cpow_ofReal_nonneg hx.le, Complex.cpow_neg, inv_inv, kernel,
    mul_div_assoc]

/-- The Riesz Mellin integral can be moved to a finite rectangle of height
`T` with only a local zero-free hypothesis. The summands are, respectively,
the new vertical side, both horizontal sides and both tails on the original line. -/
theorem integralValue_norm_le {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {t a b T x K : ℝ} (ha : 1 / 2 ≤ a) (hab : a ≤ b) (hb : 1 < b)
    (hT : 1 ≤ T) (ht : T < |t|) (hx : 1 ≤ x) (hK : 0 ≤ K)
    (hrect : ∀ σ ∈ Icc a b, ∀ v ∈ Icc (-T) T,
      χ.LFunction ((σ : ℂ) + ((v + t : ℝ) : ℂ) * Complex.I) ≠ 0 ∧
      ‖(χ.LFunction ((σ : ℂ) + ((v + t : ℝ) : ℂ) * Complex.I))⁻¹‖ ≤ K) :
    ‖ShortAPMobiusRiesz.integralValue χ t b x‖ ≤
      (4 * Real.pi * K * x ^ a + 2 * (b - a) * K * x ^ b / T ^ (2 : ℕ) +
        2 * x ^ b * (1 + 1 / (b - 1)) / T) / (2 * Real.pi) := by
  have hx₀ : 0 < x := by linarith
  have ha₀ : 0 < a := by linarith
  have hT₀ : 0 < T := by linarith
  have htranslate (σ v : ℝ) :
      vertical σ v + (t : ℂ) * Complex.I = (σ : ℂ) + ((v + t : ℝ) : ℂ) * Complex.I := by
    simp only [vertical, Complex.ofReal_add]
    ring
  have hd : DifferentiableOn ℂ (kernel χ t x) (Complex.reProdIm (Icc a b) (Icc (-T) T)) := by
    intro z hz
    have hz' : z.re ∈ Icc a b ∧ z.im ∈ Icc (-T) T := Complex.mem_reProdIm.mp hz
    have he : vertical z.re z.im = z := Complex.re_add_im z
    have hne := (hrect z.re hz'.1 z.im hz'.2).1
    rw [← htranslate, he] at hne
    refine (kernel_differentiableAt χ hx₀ (ha₀.trans_le hz'.1.1) ?_ hne).differentiableWithinAt
    intro h
    have hv : z.im + t = 0 := by
      simpa using congrArg Complex.im h
    have heq : t = -z.im := by linarith
    have hvT : |z.im| ≤ T := abs_le.mpr hz'.2
    exact (not_le_of_gt ht) (by simpa only [heq, abs_neg] using hvT)
  let C : ℝ := 1 + 1 / (b - 1)
  have hC : 0 ≤ C := by
    have : 0 < b - 1 := by linarith
    positivity
  have hr (v : ℝ) : ‖(χ.LFunction (vertical b v + (t : ℂ) * Complex.I))⁻¹‖ ≤ C := by
    simpa only [C, vertical_re] using reciprocal_norm_le_of_one_lt χ t (s := vertical b v)
      (by simpa only [vertical_re] using hb)
  have hcont : Continuous (fun v : ℝ => kernel χ t x (vertical b v)) := by
    apply continuous_iff_continuousAt.mpr
    intro v
    have hbr : (vertical b v + (t : ℂ) * Complex.I).re = b := by simp [vertical]
    have havo : vertical b v + (t : ℂ) * Complex.I ≠ 1 := by
      intro h
      have hh := congrArg Complex.re h
      rw [hbr, Complex.one_re] at hh
      linarith
    have hne := χ.LFunction_ne_zero_of_one_le_re (Or.inr havo) (by rw [hbr]; exact hb.le)
    exact (kernel_differentiableAt χ hx₀ (by rw [vertical_re]; linarith) havo
      hne).continuousAt.comp (show ContinuousAt (vertical b) v by unfold vertical; fun_prop)
  have hint : Integrable (fun v : ℝ => kernel χ t x (vertical b v)) := by
    refine (integrable_inv_one_add_sq.const_mul (x ^ b * C)).mono'
      hcont.aestronglyMeasurable (ae_of_all _ fun v => ?_)
    have he := kernel_norm_le χ hx₀ (D := 1 + v ^ (2 : ℕ)) (by positivity) (hr v)
      ((by nlinarith : 1 + v ^ 2 ≤ b ^ 2 + v ^ 2).trans (denominator_lower (by linarith) v))
    simpa only [div_eq_mul_inv] using he
  have hmain := norm_integral_le_finite_rectangle (F := kernel χ t x) hab hT₀ hd hint
    (A := 4 * x ^ a * K) (H := x ^ b * K / T ^ (2 : ℕ)) (R := x ^ b * C)
    (by positivity)
  rw [integralValue_eq χ t b hx₀, norm_smul, Real.norm_of_nonneg (by positivity)]
  have hfinal : ‖∫ v : ℝ, kernel χ t x (vertical b v)‖ ≤
      (4 * x ^ a * K) * Real.pi + 2 * (b - a) * (x ^ b * K / T ^ (2 : ℕ)) +
        2 * (x ^ b * C) / T := by
    apply hmain
    · intro v hv
      have hrec := (hrect a ⟨le_rfl, hab⟩ v hv).2
      rw [← htranslate] at hrec
      have he := kernel_norm_le χ hx₀ (D := (1 + v ^ (2 : ℕ)) / 4) (by positivity) hrec
        ((by nlinarith [sq_nonneg (a - 1 / 2), sq_nonneg v] :
          (1 + v ^ 2) / 4 ≤ a ^ 2 + v ^ 2).trans (denominator_lower ha₀.le v))
      rw [div_div_eq_mul_div, div_eq_mul_inv] at he
      convert he using 1; ring
    · intro σ hσ v hv
      have hv' : v ∈ Icc (-T) T := abs_le.mp hv.le
      have hrec := (hrect σ hσ v hv').2
      rw [← htranslate] at hrec
      have hv₂ : v ^ 2 = T ^ 2 := by
        rw [← hv, sq_abs]
      have hden : T ^ 2 ≤ σ ^ 2 + v ^ 2 := by
        rw [← hv₂]
        exact le_add_of_nonneg_left (sq_nonneg σ)
      have he := kernel_norm_le χ hx₀ (D := T ^ (2 : ℕ)) (by positivity) hrec
        (hden.trans (denominator_lower (ha₀.le.trans hσ.1) v))
      exact he.trans (div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right (Real.rpow_le_rpow_of_exponent_le hx hσ.2) hK) (by positivity))
    · intro v hv
      have hv₀ : 0 < v ^ (2 : ℕ) := by
        have : 0 < |v| := hT₀.trans_le hv
        exact sq_pos_of_ne_zero (abs_pos.mp this)
      have he := kernel_norm_le χ hx₀ hv₀ (hr v)
        ((le_add_of_nonneg_left (sq_nonneg b)).trans (denominator_lower (by linarith) v))
      simpa only [div_eq_mul_inv] using he
  have hh := mul_le_mul_of_nonneg_left hfinal (show 0 ≤ 1 / (2 * Real.pi) by positivity)
  convert hh using 1; ring


end ShortAPMobiusRectangle

end

section

open Filter Set ShortAPMobiusRiesz

namespace ShortAPMobiusHighPrefix
noncomputable section

def cost : ℝ := (4*Real.pi+8*Real.exp 2)/(2*Real.pi)
theorem cost_pos : 0 < cost := by unfold cost; positivity

private theorem log_vs_power (p : ℕ) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ x : ℝ in atTop, (Real.log x)^p ≤ x^ε := by
  have h := (isLittleO_log_rpow_rpow_atTop (p:ℝ) hε).bound (by norm_num : (0:ℝ)<1)
  filter_upwards [h, eventually_ge_atTop (1:ℝ)] with x hh hx
  simpa only [Real.rpow_natCast,Real.norm_eq_abs,abs_of_nonneg (pow_nonneg (Real.log_nonneg hx) _),
    abs_of_nonneg (Real.rpow_nonneg (zero_le_one.trans hx) _),one_mul] using hh

theorem high_riesz (p U : ℕ) {ε : ℝ} (hε : 0<ε) :
    ∃ F : ℕ, ∀ᶠ x : ℝ in atTop, ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q)
    (t y : ℝ), (q:ℝ) ≤ 2*(Real.log x)^U → (Real.log x)^F ≤ |t| → |t| ≤ x →
    x^ε ≤ y → y ≤ 8*x →
    ‖integralValue χ t (1+1/Real.log x) y‖ ≤ cost*y/(Real.log x)^p := by
  obtain ⟨A,T₀,hstrip⟩ := ShortAPMobiusRectangleStrip.uniform_strip U
  let S := A+p+2
  refine ⟨S+1,?_⟩
  have hhalf := (tendsto_rpow_atTop (by norm_num : (0:ℝ)<3/4)).eventually (eventually_ge_atTop (2:ℝ))
  filter_upwards [hstrip,ShortAPMobiusContourBudget.rectangle_budget A p hε,
    Real.tendsto_log_atTop.eventually hhalf,Real.tendsto_log_atTop.eventually (eventually_ge_atTop (max 2 (T₀+1))),
    log_vs_power S (by norm_num : (0:ℝ)<1),eventually_ge_atTop (1:ℝ)] with x hstr hbud hhalf hLmax hTx hx
  intro q _ χ t y hq ht htx hlow hup
  let L := Real.log x
  let T := L^S
  let a := 1-L^(-(3:ℝ)/4)
  let b := 1+1/L
  have hL2 : 2 ≤ L := (le_max_left _ _).trans hLmax
  have hL1 : 1 ≤ L := by linarith
  have hLp : 0<L := by linarith
  have hT : 1≤T := one_le_pow₀ hL1
  have hTx' : T ≤ x := by simpa [T,L] using hTx
  have hδ : L^(-(3:ℝ)/4) ≤ 1/2 := by
    rw [show -(3:ℝ)/4=-(3/4:ℝ) by ring,Real.rpow_neg hLp.le]
    simpa [one_div] using inv_anti₀ (by norm_num : (0:ℝ)<2) hhalf
  have ha : 1/2 ≤ a := by dsimp [a]; linarith
  have hb : 1<b := by dsimp only [b]; linarith [one_div_pos.mpr hLp]
  have hab : a ≤ b := by dsimp [a,b]; linarith [Real.rpow_nonneg hLp.le (-(3:ℝ)/4),one_div_pos.mpr hLp]
  have ht' : T*L ≤ |t| := by simpa [T,L,pow_succ] using ht
  have hsep : T < |t| := by nlinarith [mul_nonneg (sub_nonneg.mpr hL2) (zero_le_one.trans hT)]
  have hT₀ : T₀ ≤ L-1 := by linarith [(le_max_right (2:ℝ) (T₀+1)).trans hLmax]
  have hbuffer : T₀+T ≤ |t| := by nlinarith [mul_nonneg (sub_nonneg.mpr hT) (show 0≤L-1 by linarith)]
  refine (ShortAPMobiusRectangle.integralValue_norm_le χ (t := t) (a := a) (b := b) (T := T) ha hab hb
    hT hsep ((Real.one_le_rpow hx hε.le).trans hlow) (pow_nonneg hLp.le A) ?_).trans (hbud y hlow hup)
  intro σ hσ v hv
  have hv' := abs_le.mpr hv
  have h₁ : T₀ ≤ |v+t| := by
    have h := abs_sub (v+t) v
    rw [add_sub_cancel_left] at h
    linarith
  have h₂ : |v+t| ≤ 2*x := (abs_add_le _ _).trans (by linarith)
  simpa only [mul_comm Complex.I] using hstr q χ (v+t) σ hq h₁ h₂ hσ.1 hσ.2

/-- Actual sharp oscillatory prefixes, with coefficient one in the bound.
F and the starting point are uniform in the height, modulus and character. -/
theorem high_prefix (p U : ℕ) {ε : ℝ} (hε : 0<ε) :
    ∃ F : ℕ, ∀ᶠ x : ℝ in atTop, ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q)
    (t y : ℝ), (q:ℝ) ≤ 2*(Real.log x)^U → (Real.log x)^F ≤ |t| → |t| ≤ x →
    x^ε ≤ y → y ≤ 4*x →
    ‖∑ n ∈ Finset.Ioc 0 ⌊y⌋₊, osc χ t n‖ ≤ y/(Real.log x)^p := by
  obtain ⟨F,h⟩ := high_riesz (2*(p+2)) U hε
  refine ⟨F,?_⟩
  filter_upwards [h, log_vs_power (p+2) hε, eventually_ge_atTop (1:ℝ),
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (max 2 (5*cost+2)))] with x hr hpow hx hL
  intro q _ χ t y hq ht htx hy hy'
  let L := Real.log x
  have hL2 : 2 ≤ L := (le_max_left _ _).trans hL
  have hLp : 0<L := by linarith
  let D := L^(p+2)
  have hD : 1 ≤ D := one_le_pow₀ (by linarith : 1 ≤ L)
  have hDp : 0<D := zero_lt_one.trans_le hD
  let h := y/D
  have hy0 : 0<y := (Real.rpow_pos_of_pos (zero_lt_one.trans_le hx) _).trans_le hy
  have hh : 0<h := div_pos hy0 hDp
  have hhy : h ≤ y := div_le_self hy0.le hD
  have hh1 : 1 ≤ h := (one_le_div hDp).2 (hpow.trans hy)
  have h₁ := hr q χ t y hq ht htx hy (by linarith)
  have h₂ := hr q χ t (y+h) hq ht htx (by linarith) (by linarith)
  have he : (Real.log x)^(2*(p+2)) = D^2 := by rw [Nat.mul_comm, pow_mul]
  rw [he] at h₁ h₂
  have hb : 1<1+1/L := by linarith [one_div_pos.mpr hLp]
  have h₀ := prefix_le_two_integrals χ t hb hy0 hh
  have hcost := cost_pos
  have hz : y+h ≤ 2*y := by linarith
  have hmain : ((y+h)*‖integralValue χ t (1+1/L) (y+h)‖+
      y*‖integralValue χ t (1+1/L) y‖)/h ≤ 5*cost*h := by
    apply (div_le_iff₀ hh).2
    calc
      _ ≤ (2*y)*(cost*(2*y)/D^2)+y*(cost*y/D^2) := by
        apply add_le_add _ (mul_le_mul_of_nonneg_left h₁ hy0.le)
        apply mul_le_mul hz _ (norm_nonneg _) (by positivity)
        exact h₂.trans (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hz hcost.le) (sq_nonneg _))
      _ = _ := by dsimp only [h]; ring
  have hus : ‖∑ n ∈ Finset.Ioc 0 ⌊y⌋₊, osc χ t n‖ ≤ (5*cost+2)*h := by linarith
  have hK : 5*cost+2 ≤ L^2 := ((le_max_right _ _).trans hL).trans (by nlinarith)
  refine hus.trans ((mul_le_mul_of_nonneg_right hK hh.le).trans_eq ?_)
  change L^2*(y/L^(p+2))=y/L^p
  rw [pow_add]; field_simp

end
end ShortAPMobiusHighPrefix

end

section

/-!
# Transfer of the high-frequency Möbius prefix to the sharp factor

The oscillation belongs to the coefficients before Abel summation. The
derivative is taken only on the real weight (y^{-1/2}), so no factor of
`|t|` is lost. The analytic prefix estimate remains an explicit premise
of the final combinatorial cap until supplied by the contour argument.
-/

open Finset Filter MeasureTheory ShortAPDyadicPartition ShortAPBoxedHB ShortAPSmoothedFactor
open scoped BigOperators

namespace ShortAPMobiusHighCap

open ShortAPSmallConductorMobius ShortAPMobiusLowCap ShortAPMobiusRiesz

noncomputable section

private def oscPrefix {q : ℕ} (χ : DirichletCharacter ℂ q) (t y : ℝ) : ℂ :=
  ∑ n ∈ Finset.Ioc 0 ⌊y⌋₊, osc χ t n

private theorem oscPrefix_eq_sum_Icc {q : ℕ} (χ : DirichletCharacter ℂ q) (t y : ℝ) :
    oscPrefix χ t y = ∑ n ∈ Finset.Icc 0 ⌊y⌋₊, osc χ t n := by
  rw [oscPrefix, ← Finset.insert_left_Ioc (Nat.zero_le ⌊y⌋₊),
    Finset.sum_insert (by simp)]
  simp [osc, mobiusTwist]

/-- Uniform Abel transfer from the already oscillatory prefix. The common
prefix envelope and the absolute constant are independent of the height. -/
theorem mobiusPoly_le_of_osc_prefix {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ)
    {a b B : ℝ} (ha : 0 < a) (hab : a ≤ b) (hb : b ≤ 2 * a) (hB : 0 ≤ B)
    (hprefix : ∀ y ∈ Set.Icc a b, ‖∑ n ∈ Finset.Ioc 0 ⌊y⌋₊, osc χ t n‖ ≤ B) :
    ‖mobiusPoly χ t a b‖ ≤ 3 * B * a ^ (-(1 / 2 : ℝ)) := by
  let c : ℂ := -(1 / 2)
  let f (y : ℝ) := (y : ℂ) ^ c
  have hp (y : ℝ) (hy : y ∈ Set.Icc a b) : 0 < y := ha.trans_le hy.1
  have hd (y : ℝ) (hy : y ∈ Set.Icc a b) : deriv f y = c * (y : ℂ) ^ (c - 1) :=
    Complex.deriv_ofReal_cpow_const _ (hp y hy).ne'
  have hcont : ContinuousOn (deriv f) (Set.Icc a b) := by
    apply ContinuousOn.congr _ hd
    exact continuousOn_const.mul (Complex.continuous_ofReal.continuousOn.cpow_const
      (fun y hy => Complex.ofReal_mem_slitPlane.2 (hp y hy)))
  have hfi : ∀ y ∈ Set.Icc a b, DifferentiableAt ℝ f y :=
    fun y hy => differentiableAt_id.ofReal_cpow_const _ (hp y hy).ne'
  have hInt : IntegrableOn (deriv f) (Set.Icc a b) volume := hcont.integrableOn_compact isCompact_Icc
  have habel := sum_mul_eq_sub_sub_integral_mul (osc χ t) ha.le hab hfi hInt
  have hpoly : mobiusPoly χ t a b =
      f b * oscPrefix χ t b - f a * oscPrefix χ t a -
        ∫ y in Set.Ioc a b, deriv f y * oscPrefix χ t y := by
    simp only [oscPrefix_eq_sum_Icc]
    rw [← habel]
    unfold mobiusPoly
    apply Finset.sum_congr rfl
    intro n hn
    have hn₀ : n ≠ 0 := (Nat.zero_le _).trans_lt ((Finset.mem_Ioc.mp hn).1) |>.ne'
    have hne : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn₀
    simp only [f, c, osc, critical, Complex.ofReal_natCast, Complex.cpow_add _ _ hne,
      Complex.cpow_neg, div_eq_mul_inv]
    ring
  have hc : c.re = -(1 / 2 : ℝ) := by norm_num [c]
  have hnc : ‖c‖ ≤ 1 := by norm_num [c, norm_div]
  have hfn (y : ℝ) (hy : y ∈ Set.Icc a b) : ‖f y‖ ≤ a ^ (-(1 / 2 : ℝ)) := by
    change ‖(y : ℂ) ^ c‖ ≤ _
    rw [Complex.norm_cpow_eq_rpow_re_of_pos (hp y hy), hc]
    exact Real.rpow_le_rpow_of_nonpos ha hy.1 (by norm_num)
  have hdn (y : ℝ) (hy : y ∈ Set.Icc a b) : ‖deriv f y‖ ≤ a ^ (-(3 / 2 : ℝ)) := by
    have hre : (c - 1).re = -(3 / 2 : ℝ) := by rw [Complex.sub_re, hc, Complex.one_re]; ring
    rw [hd y hy, norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos (hp y hy), hre]
    exact (mul_le_mul hnc (Real.rpow_le_rpow_of_nonpos ha hy.1 (by norm_num))
      (Real.rpow_nonneg (hp y hy).le _) zero_le_one).trans_eq (one_mul _)
  have hI : ‖∫ y in Set.Ioc a b, deriv f y * oscPrefix χ t y‖ ≤
      a * (a ^ (-(3 / 2 : ℝ)) * B) := by
    have hh := norm_setIntegral_le_of_norm_le_const
      (show volume (Set.Ioc a b) < ⊤ from measure_Ioc_lt_top)
      (f := fun y => deriv f y * oscPrefix χ t y)
      (C := a ^ (-(3 / 2 : ℝ)) * B) (fun y hy => by
        rw [norm_mul]
        have hy' := Set.Ioc_subset_Icc_self hy
        exact mul_le_mul (hdn y hy') (hprefix y hy') (norm_nonneg _) (by positivity))
    rw [Measure.real, Real.volume_Ioc, ENNReal.toReal_ofReal (sub_nonneg.mpr hab)] at hh
    exact hh.trans ((mul_le_mul_of_nonneg_left (show b - a ≤ a by linarith) (by positivity)).trans_eq
      (mul_comm _ _))
  rw [hpoly]
  have ha' : a * a ^ (-(3 / 2 : ℝ)) = a ^ (-(1 / 2 : ℝ)) := by
    calc
      _ = a ^ (1 : ℝ) * a ^ (-(3 / 2 : ℝ)) := by rw [Real.rpow_one]
      _ = _ := by rw [← Real.rpow_add ha]; congr 1; norm_num
  calc
    _ ≤ ‖f b * oscPrefix χ t b‖ + ‖f a * oscPrefix χ t a‖ +
        ‖∫ y in Set.Ioc a b, deriv f y * oscPrefix χ t y‖ :=
      (norm_sub_le _ _).trans (add_le_add (norm_sub_le _ _) le_rfl)
    _ ≤ (a ^ (-(1 / 2 : ℝ)) * B + a ^ (-(1 / 2 : ℝ)) * B) +
        a * (a ^ (-(3 / 2 : ℝ)) * B) := by
      simp only [norm_mul]
      have e (y : ℝ) (hy : y ∈ Set.Icc a b) : ‖f y‖ * ‖oscPrefix χ t y‖ ≤
          a ^ (-(1 / 2 : ℝ)) * B :=
        mul_le_mul (hfn y hy) (hprefix y hy) (norm_nonneg _) (by positivity)
      exact add_le_add (add_le_add (e b ⟨hab, le_rfl⟩) (e a ⟨le_rfl, hab⟩)) hI
    _ = _ := by rw [← mul_assoc, ha']; ring

/-- The analytic prefix input for the high-frequency range. Its cutoff
exponent and eventual threshold are uniform in the conductor, character,
height and endpoint. -/
def HighOscPrefixBound (p U : ℕ) (ε : ℝ) : Prop :=
  ∃ F : ℕ, ∀ᶠ x : ℝ in atTop,
    ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive →
    (q : ℝ) ≤ 2 * Real.log x ^ U →
    ∀ t : ℝ, Real.log x ^ F ≤ |t| → |t| ≤ x →
    ∀ y : ℝ, x ^ ε ≤ y → y ≤ 4 * x →
      ‖∑ n ∈ Finset.Ioc 0 ⌊y⌋₊, osc χ t n‖ ≤ y / Real.log x ^ p

/-- A uniform high-frequency oscillatory prefix bound gives the normalized
sharp factor cap. The endpoint is bounded by the actual HB truncation. -/
theorem box_sharp_high_cap_of_prefix (ε : ℝ) (hε : 0 < ε) (U p : ℕ)
    (h : HighOscPrefixBound (p+1) U ε) :
    ∃ F : ℕ, ∀ᶠ x : ℝ in atTop,
      ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive →
      (q : ℝ) ≤ 2 * Real.log x ^ U →
      ∀ (t : ℝ) (H j i b : ℕ), j + 1 ≤ i → x ^ ε ≤ scale b →
        scale b ≤ (H : ℝ) → (H : ℝ) ≤ 4 * x → Real.log x ^ F ≤ |t| → |t| ≤ x →
        (‖boxPolynomial H j i b χ (critical t)‖ + 1) * Real.log x ^ p ≤ Real.sqrt (scale b) := by
  obtain ⟨F, hF⟩ := h
  refine ⟨F, ?_⟩
  filter_upwards [hF, eventually_ge_atTop (1:ℝ),
    Real.tendsto_log_atTop.eventually_ge_atTop (12 : ℝ),
    eventual_log_power_bound (ε/2) (1/2) (by positivity) (by norm_num) p] with x hp hx hL hg
  intro q χ hq hχ hqsmall t H j i b hi hN hNH hH ht1 ht2
  let N := scale b
  let a := min (2*N) (H:ℝ)
  let L := Real.log x
  have hx₀ : 0 < x := zero_lt_one.trans_le hx
  have hN₀ : 0 < N := scale_pos _
  have hL₀ : 0 < L := by linarith
  have hB : 0 ≤ 2 * N / L^(p+1) := by positivity
  have hNa : N ≤ a := le_min (by linarith) hNH
  have ha : a ≤ 2*N := min_le_left _ _
  have hprefix (y : ℝ) (hy : y ∈ Set.Icc N a) :
      ‖∑ n ∈ Finset.Ioc 0 ⌊y⌋₊, osc χ t n‖ ≤ 2 * N / L^(p+1) := by
    have hy₁ := hN.trans hy.1
    have hy₂ : y ≤ 4*x := hy.2.trans ((min_le_right _ _).trans hH)
    exact (hp χ hq hχ hqsmall t ht1 ht2 y hy₁ hy₂).trans
      (div_le_div_of_nonneg_right (hy.2.trans ha) (by positivity))
  have hh := mobiusPoly_le_of_osc_prefix χ t hN₀ hNa ha hB hprefix
  rw [boxPolynomial_sharp_eq hi χ t, sharpBoxPoly_eq hi χ t]
  change (‖mobiusPoly χ t N a‖ + 1) * L^p ≤ Real.sqrt N
  have hR : 0 < Real.sqrt N := Real.sqrt_pos.mpr hN₀
  have hr : N ^ (-(1/2:ℝ)) = (Real.sqrt N)⁻¹ := by
    rw [Real.rpow_neg hN₀.le, ← Real.sqrt_eq_rpow]
  have hsmall : ‖mobiusPoly χ t N a‖ * L^p ≤ (1/2:ℝ) * Real.sqrt N := calc
    _ ≤ (3 * (2 * N / L^(p+1)) * N ^ (-(1/2:ℝ))) * L^p :=
      mul_le_mul_of_nonneg_right hh (by positivity)
    _ = (6 / L) * Real.sqrt N := by
      rw [hr, pow_succ]
      have hNs : N = (Real.sqrt N)^2 := (Real.sq_sqrt hN₀.le).symm
      field_simp [hL₀.ne', hR.ne']
      linarith only [hNs]
    _ ≤ _ := mul_le_mul_of_nonneg_right ((div_le_iff₀ hL₀).2 (by linarith)) hR.le
  have hone : L^p ≤ (1/2:ℝ) * Real.sqrt N := by
    apply hg.trans
    apply mul_le_mul_of_nonneg_left _ (by norm_num)
    rw [Real.sqrt_eq_rpow, show ε / 2 = ε * (1 / 2) by ring, Real.rpow_mul hx₀.le]
    exact Real.rpow_le_rpow (by positivity) hN (by norm_num)
  rw [add_mul, one_mul]
  exact (add_le_add hsmall hone).trans_eq (by ring)

/-- The fourth block has the genuine full-frequency cap provided the high
frequency oscillatory prefix estimate. Low frequencies and all long smooth
slots are already covered unconditionally. -/
theorem fourth_cap_of_high_prefix (P Uexp : ℕ)
    (h : HighOscPrefixBound (P+18) Uexp (1/32)) :
    ∀ᶠ x : ℝ in atTop, ∀ {X H q : ℕ} (χ : DirichletCharacter ℂ q),
    1 < q → χ.IsPrimitive → ∀ (t a z : ℝ) (b : Choice 3),
    H ≠ 0 → H ≤ X → (X : ℝ) ≤ 4*x → (H : ℝ) ≤ (4*x)^((1:ℝ)/4) →
    x ≤ a → z ≤ 4*x → b ∈ activeChoices X H 3 a z →
    (q : ℝ) ≤ 2 * (Real.log x)^Uexp → |t| ≤ x →
    ∀ U : {i // i ∈ blockIndices 3} → ℝ,
    (∀ k, 0 ≤ U k ∧ U k ≤ ‖boxPolynomial H 3 k.val (b k.val k.property) χ
        (1/2+(t:ℂ)*Complex.I)‖+1) →
    (∏ k ∈ (blockIndices 3).attach, U k)*(Real.log x)^P ≤ Real.sqrt x := by
  obtain ⟨F, hF⟩ := box_sharp_high_cap_of_prefix (1/32) (by norm_num) Uexp (P+17) h
  filter_upwards [hF, fourth_low_frequency_cap P Uexp F,
    ShortAPAllSmoothBlocks.fourth_long_slot_dichotomy,
    ShortAPAllSmoothBlocks.active_smooth_cap (ε := 1/32) (by norm_num) P Uexp,
    ShortAPSmallConductorProduct.active_box_cap P,
    eventually_ge_atTop (1:ℝ)] with x hsharp hlow hcases hsmooth hprod hx
  intro X H q χ hq hχ t a z b hH hHX hX hHr ha hz hb hqsmall ht U hU
  by_cases hfreq : |t| ≤ Real.log x ^ F
  · exact hlow χ hq hχ t a z b hH hHX hX hHr ha hz hb hqsmall hfreq U hU
  obtain ⟨k, hk, hN⟩ | hlong := hcases hb hH hHX hHr ha
  · exact hsmooth χ hq hχ t a z b (by norm_num) hH hHX hX hz hb hqsmall ht
      ⟨k, hk, hN.le⟩ U hU
  · let k : {i // i ∈ blockIndices 3} := ⟨4, by simp [blockIndices]⟩
    have hki : 3 + 1 ≤ k.val := by decide
    have hN := (hlong k hki).le
    have hcuts := (choice_scale_bounds hH hHX (Finset.mem_filter.mp hb).1 k.property).2
    have hHcap : scale (b k.val k.property) ≤ (H : ℝ) :=
      hcuts.2 (by simp [isSharp, k])
    have hH4 : (H : ℝ) ≤ 4 * x := (Nat.cast_le.mpr hHX).trans hX
    have hcap := hsharp χ hq hχ hqsmall t H 3 k.val (b k.val k.property)
      hki hN hHcap hH4 (le_of_not_ge hfreq) ht
    let _ : NeZero q := ⟨by omega⟩
    apply hprod χ t a z b (by norm_num) hH hHX hX hz hb U hU
    exact ⟨k, (mul_le_mul_of_nonneg_right (hU k).2 (pow_nonneg (Real.log_nonneg hx) _)).trans hcap⟩

end

end ShortAPMobiusHighCap

end

