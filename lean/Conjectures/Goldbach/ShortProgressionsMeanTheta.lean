        ∑ b : Fin M,∑ a : Fin M,Complex.exp
          (Complex.I*((t*Real.log ((x+n)+(a.val+1)*(b.val+1)):ℝ):ℂ)) := by
      rw [sum_comm]
      apply sum_congr rfl
      intro b _
      apply sum_congr rfl
      intro a _
      dsimp only [f]
      congr 3
      push_cast
      ring_nf
