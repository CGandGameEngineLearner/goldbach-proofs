section

namespace ShortAPConductorCap

/-- The first upper bound in (4.8) implies the second one whenever the
conductor scale satisfies `D ≥ L^(B+C)`. -/
theorem amplitude_cap_of_large_conductor {D L x U : ℝ} {B C : ℕ}
    (hL : 1 ≤ L) (hD : L^(B+C) ≤ D)
    (hfirst : U ≤ L^B * Real.sqrt x / D) :
    U ≤ Real.sqrt x / L^C := by
  have hLp : 0 < L := by linarith
  have hB : 0 < L^B := pow_pos hLp _
  have hC : 0 < L^C := pow_pos hLp _
  calc
    U ≤ L^B * Real.sqrt x / D := hfirst
    _ ≤ L^B * Real.sqrt x / L^(B+C) :=
      div_le_div_of_nonneg_left (mul_nonneg hB.le (Real.sqrt_nonneg _)) (pow_pos hLp _) hD
    _ = Real.sqrt x / L^C := by
      rw [pow_add]
      field_simp

/-- Convert the unsquared first upper bound in (4.8) to the form used by
the cardinality argument. -/
theorem squared_first_amplitude_cap {D L x U : ℝ} {B : ℕ}
    (hD : 0 < D) (hx : 0 ≤ x) (hU : 0 ≤ U)
    (hfirst : U ≤ L^B * Real.sqrt x / D) : U^2 * D^2 ≤ L^(2*B) * x := by
  have hmul := (le_div_iff₀ hD).mp hfirst
  have hsq := pow_le_pow_left₀ (mul_nonneg hU hD.le) hmul 2
  rwa [mul_pow, mul_pow, ← pow_mul, Real.sq_sqrt hx, mul_comm B 2] at hsq

/-- Cross-multiplied version for squared amplitudes. The second exponent may
be rounded down from `2*C`, as needed by the cardinality bound. -/
theorem squared_cap_of_large_conductor {D L x V : ℝ} {B C a : ℕ}
    (hL : 1 ≤ L) (hV : 0 ≤ V) (hD : L^(B+C) ≤ D)
    (hfirst : V * D^2 ≤ L^(2*B) * x) (ha : a ≤ 2*C) :
    V * L^a ≤ x := by
  have hLp : 0 < L := by linarith
  have hpow : L^(2*B+a) ≤ D^2 := calc
    L^(2*B+a) ≤ L^(2*(B+C)) := pow_le_pow_right₀ hL (by omega)
    _ = (L^(B+C))^2 := by rw [← pow_mul]; congr 1; omega
    _ ≤ D^2 := pow_le_pow_left₀ (pow_nonneg hLp.le _) hD 2
  apply (le_of_mul_le_mul_right · (pow_pos hLp (2*B)))
  calc
    V * L^a * L^(2*B) = V * L^(2*B+a) := by rw [pow_add]; ring
    _ ≤ V * D^2 := mul_le_mul_of_nonneg_left hpow hV
    _ ≤ L^(2*B) * x := hfirst
    _ = x * L^(2*B) := mul_comm _ _

set_option maxRecDepth 4096 in
/-- Supplies precisely the second amplitude assumption of the high-exponent
Section 4 cardinality estimate on the large-conductor subrange. -/
theorem fourth_section_large_conductor (p : ℕ) {D L x V : ℝ}
    (hL : 1 ≤ L) (hV : 0 ≤ V)
    (hD : L^(256 + (p + 512*2048 + 77 + 1)/2) ≤ D)
    (hfirst : V * D^2 ≤ L^512 * x) :
    V * L^(p + 512*2048 + 77) ≤ x := by
  let a := p + 512*2048 + 77
  exact squared_cap_of_large_conductor (B := 256) (C := (a+1)/2) hL hV hD hfirst (by omega)

end ShortAPConductorCap

end

section

namespace ShortAPFactorSampling

open scoped BigOperators

abbrev AF := ArithmeticFunction ℂ

/-- A Dirichlet polynomial with arithmetic-function coefficients, before taking
any convolution powers. -/
noncomputable def factor (N : ℕ) (f : AF) {q : ℕ} (χ : DirichletCharacter ℂ q)
    (s : ℂ) : ℂ := ∑ n ∈ Finset.Icc 1 N, f n * χ (n : ZMod q) / (n : ℂ)^s

/-- A finite factor with a bounded auxiliary weight and a possible logarithm. -/
noncomputable def cutoffWeight (N d : ℕ) (w : ℕ → ℂ) : AF :=
  ⟨fun n => if 1 ≤ n ∧ n ≤ N then w n * (Real.log n : ℂ)^d else 0, by simp⟩

theorem cutoffWeight_support (N d : ℕ) (w : ℕ → ℂ) (n : ℕ) (hn : N < n) :
    cutoffWeight N d w n = 0 := by
  simp [cutoffWeight, not_le_of_gt hn]

theorem cutoffWeight_coeff (N d : ℕ) (w : ℕ → ℂ) (hw : ∀ n, ‖w n‖ ≤ 1) (n : ℕ)
    (hn : 1 ≤ n) : ‖cutoffWeight N d w n‖ ≤ (Real.log n)^d := by
  have hl : 0 ≤ Real.log (n : ℝ) := Real.log_nonneg (by exact_mod_cast hn)
  by_cases hN : n ≤ N
  · change ‖if 1 ≤ n ∧ n ≤ N then w n * (Real.log n : ℂ)^d else 0‖ ≤ _
    rw [ite_eq_left ⟨hn, hN⟩, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hl]
    exact mul_le_of_le_one_left (pow_nonneg hl _) (hw n)
  · rw [cutoffWeight_support N d w n (lt_of_not_ge hN), norm_zero]
    exact pow_nonneg hl _

/-- The coefficient norm input for either smooth factor in (4.2), with
`d=1` for the logarithmic factor and `d=0` for the others. -/
theorem cutoff_smooth_coeff (N d : ℕ) (g : ℝ → ℝ) (M : ℝ)
    (hg : ∀ u, 0 ≤ g u ∧ g u ≤ 1) (n : ℕ) (hn : 1 ≤ n) :
    ‖cutoffWeight N d (fun n => (g ((n : ℝ)/M) : ℂ)) n‖ ≤ (Real.log n)^d := by
  apply cutoffWeight_coeff N d _ _ n hn
  intro m
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hg _).1]
  exact (hg _).2

/-- The sharp Möbius factor has no logarithmic weight in (4.2). -/
theorem cutoff_mobius_coeff (N : ℕ) (M : ℝ) (n : ℕ) (hn : 1 ≤ n) :
    ‖cutoffWeight N 0 (fun n => if M < (n : ℝ) ∧ (n : ℝ) ≤ 2*M
      then (ArithmeticFunction.moebius n : ℂ) else 0) n‖ ≤ (Real.log n)^0 := by
  apply cutoffWeight_coeff N 0 _ _ n hn
  intro m
  split_ifs
  · rw [Complex.norm_intCast, ← Int.cast_abs]
    exact_mod_cast (ArithmeticFunction.abs_moebius_le_one (n := m))
  · simp

private theorem convolution_support {f g : AF} {A B : ℕ}
    (hf : ∀ n > A, f n = 0) (hg : ∀ n > B, g n = 0) :
    ∀ n > A*B, (f*g) n = 0 := by
  intro n hn
  rw [ArithmeticFunction.mul_apply]
  refine Finset.sum_eq_zero fun p hp => ?_
  by_cases ha : A < p.1
  · rw [hf _ ha, zero_mul]
  by_cases hb : B < p.2
  · rw [hg _ hb, mul_zero]
  exact (not_lt_of_ge ((Nat.mem_divisorsAntidiagonal.mp hp).1 ▸
    Nat.mul_le_mul (le_of_not_gt ha) (le_of_not_gt hb))) hn |>.elim

/-- The convolution power is supported up to `N^r`, including the unit at `r=0`. -/
theorem convolution_power_support {N : ℕ} {f : AF} (hf : ∀ n > N, f n = 0) :
    ∀ (r n : ℕ), N^r < n → (f^r) n = 0 := by
  intro r
  induction r with
  | zero =>
      intro n hn
      rw [pow_zero, ArithmeticFunction.one_apply_ne (by simpa [eq_comm] using Nat.ne_of_gt hn)]
  | succ r ih => simpa only [pow_succ'] using convolution_support hf ih

private theorem log_bounds_of_mem {n : ℕ} {p : ℕ × ℕ} (hp : p ∈ n.divisorsAntidiagonal) :
    (0 ≤ Real.log (p.1 : ℝ) ∧ Real.log (p.1 : ℝ) ≤ Real.log n) ∧
      (0 ≤ Real.log (p.2 : ℝ) ∧ Real.log (p.2 : ℝ) ≤ Real.log n) := by
  obtain ⟨hm, hn⟩ := Nat.mem_divisorsAntidiagonal.mp hp
  have hp₁ : 0 < p.1 := Nat.pos_of_ne_zero (fun hp' => hn (by rw [← hm, hp', zero_mul]))
  have hp₂ : 0 < p.2 := Nat.pos_of_ne_zero (fun hp' => hn (by rw [← hm, hp', mul_zero]))
  have h₁ : 1 ≤ (p.1 : ℝ) := by exact_mod_cast hp₁
  have h₂ : 1 ≤ (p.2 : ℝ) := by exact_mod_cast hp₂
  have hm₁ : p.1 ≤ n := Nat.le_of_dvd (Nat.pos_of_ne_zero hn) ⟨p.2, hm.symm⟩
  have hm₂ : p.2 ≤ n := Nat.le_of_dvd (Nat.pos_of_ne_zero hn) ⟨p.1, by rw [← hm, mul_comm]⟩
  exact ⟨⟨Real.log_nonneg h₁, Real.log_le_log (by linarith) (by exact_mod_cast hm₁)⟩,
    ⟨Real.log_nonneg h₂, Real.log_le_log (by linarith) (by exact_mod_cast hm₂)⟩⟩

/-- The `r`-fold convolution of a coefficient bounded by `log(n)^d` fits the
exact divisor/logarithm budget of the first large-values estimate. -/
theorem convolution_power_coeff {f : AF} {d : ℕ}
    (hf : ∀ n : ℕ, 1 ≤ n → ‖f n‖ ≤ (Real.log n)^d) (r n : ℕ) :
    ‖(f^r) n‖ ≤ ((ArithmeticFunction.zeta^r) n : ℝ) * (Real.log n)^(d*r) := by
  induction r generalizing n with
  | zero =>
      by_cases hn : n = 1 <;> simp [hn]
  | succ r ih =>
      by_cases hn : n = 0
      · simp [hn]
      simp only [pow_succ', ArithmeticFunction.mul_apply, Nat.cast_sum, Nat.cast_mul]
      calc
        ‖∑ p ∈ n.divisorsAntidiagonal, f p.1 * (f^r) p.2‖ ≤
            ∑ p ∈ n.divisorsAntidiagonal, ‖f p.1 * (f^r) p.2‖ := norm_sum_le _ _
        _ ≤ ∑ p ∈ n.divisorsAntidiagonal,
            (((ArithmeticFunction.zeta : ArithmeticFunction ℕ) p.1 : ℝ) *
              ((ArithmeticFunction.zeta^r) p.2 : ℝ)) * (Real.log n)^(d*(r+1)) := by
          refine Finset.sum_le_sum fun p hp => ?_
          obtain ⟨⟨h₁, hl₁⟩, ⟨h₂, hl₂⟩⟩ := log_bounds_of_mem hp
          have hn₁ : p.1 ≠ 0 := fun h => hn (by rw [← (Nat.mem_divisorsAntidiagonal.mp hp).1, h, zero_mul])
          rw [ArithmeticFunction.zeta_apply_ne hn₁, Nat.cast_one, one_mul, norm_mul, Nat.mul_succ, pow_add]
          have h1' := (hf p.1 (Nat.pos_of_ne_zero hn₁)).trans (pow_le_pow_left₀ h₁ hl₁ d)
          have h2' := (ih p.2).trans (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ h₂ hl₂ (d*r))
            (Nat.cast_nonneg _))
          exact (mul_le_mul h1' h2' (norm_nonneg _) (pow_nonneg (h₁.trans hl₁) _)).trans_eq (by ring)
        _ = _ := by rw [Finset.sum_mul]

private theorem hasSum_factor (N : ℕ) (f : AF) {q : ℕ} (χ : DirichletCharacter ℂ q) (s : ℂ)
    (hf : ∀ n > N, f n = 0) : LSeriesHasSum (((χ ·) : ℕ → ℂ) * f) s (factor N f χ s) := by
  let a : ℕ → ℂ := ((χ ·) : ℕ → ℂ) * f
  have hz : ∀ n ∉ Finset.Icc 1 N, LSeries.term a s n = 0 := by
    intro n hn
    by_cases hn0 : n = 0
    · subst n
      simp
    have hnN : N < n := by
      by_contra! hh
      exact hn (Finset.mem_Icc.mpr ⟨Nat.pos_of_ne_zero hn0, hh⟩)
    simp [LSeries.term_of_ne_zero hn0, a, hf n hnN]
  have heq : (∑ n ∈ Finset.Icc 1 N, LSeries.term a s n) = factor N f χ s := by
    apply Finset.sum_congr rfl
    intro n hn
    have hn0 : n ≠ 0 := Nat.ne_of_gt (Finset.mem_Icc.mp hn).1
    simp [LSeries.term_of_ne_zero hn0, a, mul_comm]
  rw [← heq]
  exact hasSum_sum_of_ne_finset_zero hz

/-- A finite Dirichlet polynomial raised to an integer power is given by its
convolution power coefficients, with the same twist. -/
theorem factor_convolution_power (N : ℕ) (f : AF) {q : ℕ} (χ : DirichletCharacter ℂ q) (s : ℂ)
    (hf : ∀ n > N, f n = 0) (r : ℕ) : factor (N^r) (f^r) χ s = (factor N f χ s)^r := by
  have hf' := hasSum_factor N f χ s hf
  have h : LSeriesHasSum (((χ ·) : ℕ → ℂ) * (f^r : AF)) s ((factor N f χ s)^r) := by
    induction r with
    | zero =>
        have hunit := hasSum_factor 1 (1 : AF) χ s (by
          intro n hn
          exact ArithmeticFunction.one_apply_ne (Nat.ne_of_gt hn))
        simpa [factor, ArithmeticFunction.one_apply] using hunit
    | succ r ih =>
        have hm := hf'.convolution ih
        rw [DirichletCharacter.mul_convolution_distrib, ArithmeticFunction.coe_mul] at hm
        simpa only [pow_succ'] using hm
  have hfinite := hasSum_factor (N^r) (f^r) χ s (convolution_power_support hf r)
  exact hfinite.LSeries_eq.symm.trans h.LSeries_eq

def logExponent (r d : ℕ) : ℕ := 3*(r*r) + 6*(d*r) + 18

noncomputable def samplingConstant (r d : ℕ) : ℝ :=
  (36*Real.pi*(Real.pi+1) * (3 : ℝ)^(logExponent r d)) * ((2 : ℝ)^r)^2

/-- Factor-power sampling for actual finite Dirichlet polynomials. The lower
dyadic selection `U ≤ ‖F‖ + 1` supplies threshold `(U/2)^r` for the power. -/
theorem sampled_factor_power (N Q r d : ℕ) (hN : 1 ≤ N) (hQ : 1 ≤ Q)
    (T U : ℝ) (hT : 1 ≤ T) (hU : 2 ≤ U) (f : AF)
    (hf : ∀ n > N, f n = 0) (hcoeff : ∀ n : ℕ, 1 ≤ n → ‖f n‖ ≤ (Real.log n)^d)
    (S : ShortAP.CharIndex → Finset ℝ) (hsep : ShortAPLargeValues.WellSpaced S)
    (hb : ∀ j ∈ ShortAP.primitiveFamily Q, ∀ t ∈ S j, |t| ≤ T)
    (hv : ∀ j ∈ ShortAP.primitiveFamily Q, ∀ t ∈ S j,
      U ≤ ‖factor N f j.2 (1/2 + (t : ℂ) * Complex.I)‖ + 1) :
    (∑ j ∈ ShortAP.primitiveFamily Q, ((S j).card : ℝ)) * (U^2)^r ≤
      samplingConstant r d * ((N:ℝ)^r + (Q:ℝ)^2*T) *
        (Real.log (2*(N:ℝ)^r))^(logExponent r d) := by
  have hU2 : 1 ≤ U/2 := by linarith
  have hW : 1 ≤ (U/2)^r := one_le_pow₀ hU2
  have hN' : 1 ≤ N^r := one_le_pow₀ hN
  have hExp : ((logExponent r d : ℕ) : ℝ) = 3*((r*r : ℕ) : ℝ) + 6*(d*r : ℕ) + 18 := by
    simp [logExponent]
  have hbig : ∀ j ∈ ShortAP.primitiveFamily Q, ∀ t ∈ S j, (U/2)^r ≤
      ‖∑ n ∈ Finset.Icc 1 (N^r), (f^r) n * ShortAP.charValue j n /
        (n : ℂ)^(1/2 + (t : ℂ) * Complex.I)‖ := by
    intro j hj t ht
    let s : ℂ := 1/2 + (t : ℂ) * Complex.I
    change (U/2)^r ≤ ‖factor (N^r) (f^r) j.2 s‖
    rw [factor_convolution_power N f j.2 s hf, norm_pow]
    exact pow_le_pow_left₀ (by linarith) (by linarith only [hv j hj t ht, hU]) r
  have h := ShortAP.large_values_first_branch (N^r) Q hN' hQ T ((U/2)^r) hT hW r (d*r : ℕ)
    (Nat.cast_nonneg _) (f^r : AF) (fun n _ => by
      rw [Real.rpow_natCast]
      exact convolution_power_coeff hcoeff r n) S hsep hb hbig
  dsimp only at h
  simp only [← hExp, Real.rpow_natCast, Nat.cast_pow] at h
  have hWp : 0 < ((U/2)^r)^2 := sq_pos_of_pos (by linarith)
  have hfirst : (∑ j ∈ ShortAP.primitiveFamily Q, ((S j).card : ℝ)) * ((U/2)^r)^2 ≤
    (36*Real.pi*(Real.pi+1) * (3 : ℝ)^(logExponent r d)) *
      ((N:ℝ)^r + (Q:ℝ)^2*T) * (Real.log (2*(N:ℝ)^r))^(logExponent r d) := by
    apply (le_div_iff₀ hWp).mp
    convert h using 1
    ring
  have hscale : ((U/2)^r)^2 * ((2 : ℝ)^r)^2 = (U^2)^r := by
    rw [← mul_pow, ← mul_pow, div_mul_cancel₀ _ (by norm_num : (2 : ℝ) ≠ 0), pow_right_comm]
  calc
    _ = ((∑ j ∈ ShortAP.primitiveFamily Q, ((S j).card : ℝ)) * ((U/2)^r)^2) * ((2 : ℝ)^r)^2 := by
      rw [mul_assoc, hscale]
    _ ≤ _ := (mul_le_mul_of_nonneg_right hfirst (sq_nonneg _)).trans_eq (by
      unfold samplingConstant
      ring)

noncomputable def scaledSamplingConstant (r d : ℕ) (c C : ℝ) : ℝ :=
  samplingConstant r d * (c^r*C) * (Real.log 2 + (r:ℝ)*(Real.log c+1))^(logExponent r d)

theorem scaledSamplingConstant_nonneg (r d : ℕ) {c C : ℝ} (hc : 1 ≤ c) (hC : 1 ≤ C) :
    0 ≤ scaledSamplingConstant r d c C := by
  unfold scaledSamplingConstant samplingConstant
  have := Real.log_nonneg hc
  positivity

/-- Analytic input `hpower` in §4, in the scales used by the cardinality
argument. `M` is the factor scale and `N` is its integer support limit.
The fixed comparison constants `c,C` absorb the cutoff and dyadic band. -/
theorem sampled_factor_power_scales (N Q r d : ℕ) (hN : 1 ≤ N) (hQ : 1 ≤ Q)
    {x M H c C T U : ℝ} (hx : Real.exp 1 ≤ x) (hM : 0 ≤ M) (hH : 0 ≤ H)
    (hc : 1 ≤ c) (hC : 1 ≤ C) (hNM : (N : ℝ) ≤ c*M) (hNx : (N : ℝ) ≤ c*x)
    (hHT : (Q : ℝ)^2*T ≤ C*H) (hT : 1 ≤ T) (hU : 2 ≤ U) (f : AF)
    (hf : ∀ n > N, f n = 0) (hcoeff : ∀ n : ℕ, 1 ≤ n → ‖f n‖ ≤ (Real.log n)^d)
    (S : ShortAP.CharIndex → Finset ℝ) (hsep : ShortAPLargeValues.WellSpaced S)
    (hb : ∀ j ∈ ShortAP.primitiveFamily Q, ∀ t ∈ S j, |t| ≤ T)
    (hv : ∀ j ∈ ShortAP.primitiveFamily Q, ∀ t ∈ S j,
      U ≤ ‖factor N f j.2 (1/2 + (t : ℂ) * Complex.I)‖ + 1) :
    (∑ j ∈ ShortAP.primitiveFamily Q, ((S j).card : ℝ)) * (U^2)^r ≤
      scaledSamplingConstant r d c C * (M^r + H) * (Real.log x)^(logExponent r d) := by
  have hx0 : 0 < x := (Real.exp_pos _).trans_le hx
  have hc0 : 0 < c := by linarith
  have hC0 : 0 ≤ C := by linarith
  have hN1 : (1:ℝ) ≤ N := by exact_mod_cast hN
  have hN0 : (0:ℝ) < N := by linarith
  have hL : 1 ≤ Real.log x := by
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hx
  have hLm : 0 ≤ Real.log c := Real.log_nonneg hc
  have hL2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hlogN : Real.log (N:ℝ) ≤ Real.log c + Real.log x := by
    rw [← Real.log_mul hc0.ne' hx0.ne']
    exact Real.log_le_log hN0 hNx
  have hlog : Real.log (2*(N:ℝ)^r) ≤
      (Real.log 2 + (r:ℝ)*(Real.log c+1)) * Real.log x := by
    rw [Real.log_mul (by norm_num) (pow_ne_zero _ hN0.ne'), Real.log_pow]
    calc
      Real.log 2 + (r:ℝ) * Real.log (N:ℝ) ≤
          Real.log 2 + (r:ℝ) * (Real.log c + Real.log x) := by gcongr
      _ ≤ Real.log 2 * Real.log x + (r:ℝ) * ((Real.log c + 1) * Real.log x) := by
        refine add_le_add (le_mul_of_one_le_right hL2 hL) ?_
        apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
        nlinarith only [mul_nonneg hLm (sub_nonneg.mpr hL)]
      _ = _ := by ring
  have hlog0 : 0 ≤ Real.log (2*(N:ℝ)^r) := by
    apply Real.log_nonneg
    have hNr : (1:ℝ) ≤ (N:ℝ)^r := one_le_pow₀ hN1
    linarith
  have hcPow : 1 ≤ c^r := one_le_pow₀ hc
  have hlen : (N:ℝ)^r + (Q:ℝ)^2*T ≤ (c^r*C) * (M^r+H) := by
    have hNM' := pow_le_pow_left₀ hN0.le hNM r
    rw [mul_pow] at hNM'
    have hN' : c^r * M^r ≤ (c^r*C) * M^r :=
      mul_le_mul_of_nonneg_right (le_mul_of_one_le_right (pow_nonneg hc0.le _) hC) (pow_nonneg hM _)
    have hH' : C*H ≤ (c^r*C) * H := mul_le_mul_of_nonneg_right (le_mul_of_one_le_left hC0 hcPow) hH
    rw [mul_add]
    exact add_le_add (hNM'.trans hN') (hHT.trans hH')
  have hK0 : 0 ≤ samplingConstant r d := by unfold samplingConstant; positivity
  calc
    _ ≤ samplingConstant r d * ((N:ℝ)^r + (Q:ℝ)^2*T) *
        (Real.log (2*(N:ℝ)^r))^(logExponent r d) :=
      sampled_factor_power N Q r d hN hQ T U hT hU f hf hcoeff S hsep hb hv
    _ ≤ samplingConstant r d * ((c^r*C)*(M^r+H)) *
        ((Real.log 2 + (r:ℝ)*(Real.log c+1)) * Real.log x)^(logExponent r d) := by
      gcongr
    _ = _ := by unfold scaledSamplingConstant; rw [mul_pow]; ring

/-- One constant and one logarithmic exponent cover both possible factors
with `d=0` and `d=1`. -/
noncomputable def commonSamplingConstant (r : ℕ) (c C : ℝ) : ℝ :=
  scaledSamplingConstant r 0 c C + scaledSamplingConstant r 1 c C

theorem commonSamplingConstant_nonneg (r : ℕ) {c C : ℝ} (hc : 1 ≤ c) (hC : 1 ≤ C) :
    0 ≤ commonSamplingConstant r c C :=
  add_nonneg (scaledSamplingConstant_nonneg r 0 hc hC) (scaledSamplingConstant_nonneg r 1 hc hC)

theorem scaled_power_budget_le (r d : ℕ) {c C ell M H : ℝ}
    (hd : d ≤ 1) (hc : 1 ≤ c) (hC : 1 ≤ C) (hL : 1 ≤ ell) (hM : 0 ≤ M) (hH : 0 ≤ H) :
    scaledSamplingConstant r d c C * (M^r+H) * ell^(logExponent r d) ≤
      commonSamplingConstant r c C * (M^r+H) * ell^(logExponent r 1) := by
  have h0 := scaledSamplingConstant_nonneg r (d := 0) hc hC
  have h1 := scaledSamplingConstant_nonneg r (d := 1) hc hC
  have hK : scaledSamplingConstant r d c C ≤ commonSamplingConstant r c C := by
    rcases (show d = 0 ∨ d = 1 by omega) with h | h
    · subst d; unfold commonSamplingConstant; linarith
    · subst d; unfold commonSamplingConstant; linarith
  have hP : logExponent r d ≤ logExponent r 1 := by
    unfold logExponent
    gcongr
  have hL0 : 0 ≤ ell := by linarith
  have hbase : 0 ≤ M^r+H := add_nonneg (pow_nonneg hM _) hH
  have hcom : 0 ≤ commonSamplingConstant r c C := commonSamplingConstant_nonneg r hc hC
  gcongr

end ShortAPFactorSampling

