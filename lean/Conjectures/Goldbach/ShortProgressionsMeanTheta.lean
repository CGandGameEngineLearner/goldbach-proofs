  simp only [← Real.rpow_natCast,← Real.rpow_mul hf,← Real.rpow_mul hg]
  rw [← mul_assoc,← Real.rpow_add' hf]
  · rw [he,mul_one_div_cancel hk0,Real.rpow_one,Real.rpow_natCast]
  · rw [he]
    exact_mod_cast (by omega : 2*(s+k)-2≠0)
