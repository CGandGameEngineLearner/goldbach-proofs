      (∑ n∈range N,(((n+1:ℕ):ℝ)+a:ℂ)^(-s)) =
      (riemannZeta s-(∑ n∈range N,((n+1:ℕ):ℂ)^(-s)))+
        ∑' n,V3u a (n+N) s := by
