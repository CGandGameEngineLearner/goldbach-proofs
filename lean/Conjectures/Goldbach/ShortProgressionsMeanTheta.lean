/-!
# Lemma 3.3 on the actual smooth box factors of Section 4

The coefficient and support identifications are unconditional. The final
inequality instantiates the uniform unweighted shortening inequality through
the logarithmic lifting; it does not assume any further analytic bound.
-/

open ArithmeticFunction MeasureTheory
open scoped BigOperators ArithmeticFunction.zeta

namespace ShortAPSmoothedFactor

open ShortAPDyadicPartition ShortAPBoxedHB ShortAPDualSplit

noncomputable section

/-- Real arithmetic coefficients viewed as complex coefficients. -/
def complexCoeffs (f : ArithmeticFunction ℝ) : ArithmeticFunction ℂ :=
  ⟨fun n => (f n : ℂ), by simp⟩

@[simp] theorem complexCoeffs_apply (f : ArithmeticFunction ℝ) (n : ℕ) :
    complexCoeffs f n = (f n : ℂ) := rfl

def logDegree (i : ℕ) : ℕ := if i = 0 then 1 else 0

theorem logDegree_le_one (i : ℕ) : logDegree i ≤ 1 := by
  unfold logDegree
  split <;> omega

def smoothCutoff (x : ℝ) : ℂ := (smoothWeight x : ℂ)

theorem smoothCutoff_smooth : ContDiff ℝ (⊤ : ℕ∞) smoothCutoff :=
  Complex.ofRealCLM.contDiff.comp contDiff_smoothWeight

theorem smoothCutoff_zero (x : ℝ) (hx : x ∉ Set.Icc (1 : ℝ) 4) : smoothCutoff x = 0 := by
  have he : smoothWeight x = 0 := by
    by_contra hv
    exact hx (Set.Ioo_subset_Icc_self (support_smoothWeight hv))
  simp [smoothCutoff, he]

private theorem not_sharp_of_lt {j i : ℕ} (hi : i < j + 1) : isSharp j i = false := by
  simp [isSharp, not_le.mpr hi]

/-- The actual logarithmic factor (`i=0`) and each actual zeta factor
(`0<i<j+1`) have logarithmic degree one and zero respectively. -/
theorem boxFactor_coeff {H j i b n : ℕ} (hi : i < j + 1) (hn : 1 ≤ n) :
    complexCoeffs (boxFactor H j i b) n =
      (Real.log n : ℂ) ^ logDegree i * smoothCutoff ((n : ℝ) / scale b) := by
  have hsh := not_sharp_of_lt hi
  by_cases hz : i = 0
  · subst i
    simp [boxFactor, hsh, ShortAPHeathBrown.factor, logDegree,
      ArithmeticFunction.log_apply, smoothCutoff, Complex.ofReal_mul, mul_comm]
  · simp [boxFactor, hsh, ShortAPHeathBrown.factor, hz, hi, logDegree, smoothCutoff,
      ArithmeticFunction.zeta_apply_ne (Nat.ne_of_gt hn)]

/-- The original factor already vanishes beyond `⌊4 N⌋`; truncation here
does not replace or discard a nonzero coefficient. -/
theorem boxFactor_zero_of_gt {H j i b n : ℕ} (hi : i < j + 1) (hn : ⌊4 * scale b⌋₊ < n) :
    boxFactor H j i b n = 0 := by
  have hb := scale_pos b
  have h₀ : 0 ≤ 4 * scale b := mul_nonneg (by norm_num) hb.le
  have hN : 4 * scale b < (n : ℝ) := (Nat.floor_lt h₀).mp hn
  have harg : 4 ≤ (n : ℝ) / scale b := (le_div_iff₀ hb).2 hN.le
  simp [boxFactor, not_sharp_of_lt hi, smoothWeight_zero_above harg]

/-- The canonical finite Dirichlet polynomial of a smooth box factor. -/
def boxPolynomial (H j i b : ℕ) {q : ℕ} (χ : DirichletCharacter ℂ q) (s : ℂ) : ℂ :=
  ShortAPFactorSampling.factor ⌊4 * scale b⌋₊ (complexCoeffs (boxFactor H j i b)) χ s

/-- Identify the actual truncated factor with the input sum of the
shortening estimate, including both endpoints. -/
theorem boxPolynomial_eq {H j i b q : ℕ} (hi : i < j + 1)
    (χ : DirichletCharacter ℂ q) (s : ℂ) :
    boxPolynomial H j i b χ s =
      ∑ n ∈ Finset.Icc 1 ⌊4 * scale b⌋₊,
        (Real.log n : ℂ) ^ logDegree i * smoothCutoff ((n : ℝ) / scale b) *
          χ (n : ZMod q) / (n : ℂ) ^ s := by
  unfold boxPolynomial ShortAPFactorSampling.factor
  exact Finset.sum_congr rfl fun n hn => by rw [boxFactor_coeff hi (Finset.mem_Icc.mp hn).1]

/-- Uniform shortening for both genuine smooth factors when their scale is
at least one. The single premise is the uniform unweighted shortening
estimate; the constant covers both logarithmic degrees independently of all
box and character parameters. -/
theorem smooth_box_shortening (δ : ℝ) (h : UniformUnweightedShortening δ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {q : ℕ} (χ : DirichletCharacter ℂ q),
      1 < q → χ.IsPrimitive → ∀ Q T t : ℝ, (q : ℝ) ≤ Q → 2 ≤ T → |t| ≤ T →
      ∀ H j i b : ℕ, i < j + 1 → 1 ≤ scale b →
        ‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ ≤
          C * (Real.log (2 * scale b)) ^ logDegree i *
            ShortAPLogWeight.dualMass χ t (dualCutoff δ Q T (scale b)) := by
  obtain ⟨C₀, hC₀, h₀⟩ := lift_uniform_shortening δ h 0 smoothCutoff smoothCutoff_smooth smoothCutoff_zero
  obtain ⟨C₁, hC₁, h₁⟩ := lift_uniform_shortening δ h 1 smoothCutoff smoothCutoff_smooth smoothCutoff_zero
  refine ⟨C₀ + C₁, add_nonneg hC₀ hC₁, ?_⟩
  intro q χ hq hp Q T t hQ hT ht H j i b hi hb
  let N := scale b
  let D := ShortAPLogWeight.dualMass χ t (dualCutoff δ Q T N)
  have hD : 0 ≤ D := by
    unfold D ShortAPLogWeight.dualMass
    exact integral_nonneg (fun _ => div_nonneg (norm_nonneg _) (by positivity))
  have hL : 0 ≤ Real.log (2 * N) := Real.log_nonneg (by dsimp [N]; linarith)
  rw [boxPolynomial_eq hi]
  calc
    _ ≤ (if i = 0 then C₁ else C₀) * (Real.log (2 * N)) ^ logDegree i * D := by
      by_cases hz : i = 0
      · simpa only [hz, ite_true, logDegree] using h₁ χ hq hp Q T t N hQ hT ht hb
      · simpa only [hz, ite_false, logDegree] using h₀ χ hq hp Q T t N hQ hT ht hb
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_right _ hD
      apply mul_le_mul_of_nonneg_right _ (pow_nonneg hL _)
      split <;> linarith

end
end ShortAPSmoothedFactor

end

section

/-! Koukoulopoulos, *Primes in short arithmetic progressions*, Lemma 3.3.
The smooth weight is fixed before q,Q,T,t,N and may be complex. -/
namespace ShortAPShortening
open ShortAPFEBridge ShortAPCriticalMain ShortAPDualSplit ShortAPLogWeight ShortAPActualHead
noncomputable section

private theorem floor_cutoff (δ Q T N : ℝ) :
    ⌊max 1 ((Q*T/N)^((1:ℝ)+δ))⌋₊ = dualCutoff δ Q T N := by
  exact (dualCutoff_eq_floor_max ..).symm

theorem normalized_tail (δ : ℝ) (hδ : 0 < δ) (g : ℝ → ℂ)
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (hs : ∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (_ : χ.IsPrimitive) (Q T t N : ℝ), (q:ℝ) ≤ Q → 2 ≤ T → |t| ≤ T → 1 ≤ N →
    let M := dualCutoff δ Q T N
    (Summable fun j : ℕ => ‖dualTerm χ N t g (j+M+1)‖) ∧
    ‖pref χ N t‖ * ‖∑' j : ℕ, dualTerm χ N t g (j+M+1)‖ ≤ D := by
  choose C hC he using fun odd : Bool =>
    ShortAPActualDualTail.actual_dual_tail_from_five_halves odd hg hs δ 0 hδ
  refine ⟨max (C true) (C false), (hC true).trans (le_max_left ..), ?_⟩
  intro q _ χ hp Q T t N hQ hT ht hN
  have hN' : 0 < N := zero_lt_one.trans_le hN
  have H := he (parity χ) q Q N T (-t) (by exact_mod_cast NeZero.pos q) hQ hN'
    (by linarith) (by simpa using ht) (fun n => χ⁻¹ (n : ZMod q)) (fun n => χ⁻¹.norm_le_one _)
  dsimp only at H ⊢
  have hC' : C (parity χ) ≤ max (C true) (C false) := by cases parity χ <;> simp
  rw [norm_pref hp hN']
  apply And.imp_right (fun h => le_trans h hC')
  simpa only [dualTerm, point, floor_cutoff, neg_zero, Real.rpow_zero, mul_one,
    norm_smul, Real.norm_of_nonneg (Real.sqrt_nonneg _), Complex.ofReal_div, Complex.ofReal_ofNat] using H

/-- The unweighted assertion, with a single constant for all primitive
characters, conductor bounds, frequencies and lengths. -/
theorem unweighted (δ : ℝ) (hδ : 0 < δ) : UniformUnweightedShortening δ := by
  intro g hg hs
  obtain ⟨A,hA,hhead⟩ := normalized_head g hg hs
  obtain ⟨D,hD,htail⟩ := normalized_tail δ hδ g hg hs
  obtain ⟨K,hK,habs⟩ := absorb_split_error
  let c : ℝ := 1/(2*Real.pi)
  have hc : 0 ≤ c := by dsimp [c]; positivity
  refine ⟨c*(A+D*K), mul_nonneg hc (add_nonneg hA (mul_nonneg hD hK.le)), ?_⟩
  intro q χ hq hp Q T t N hQ hT ht hN
  have : NeZero q := ⟨by omega⟩
  let M := dualCutoff δ Q T N
  let b := dualTerm χ N t g
  have hh := hhead χ hp N (zero_lt_one.trans_le hN) M t
  obtain ⟨hsum,ht'⟩ := htail χ hp Q T t N hQ hT ht hN
  have h := habs χ t M (one_le_dualCutoff ..) b (dualTerm_zero ..) hsum
    (pref χ N t * (∑' n, b n)) (pref χ N t) A D hD rfl hh ht'
  have he := ShortAPSourceDual.smooth_dirichlet_dual_expansion hq hp hN t g hg hs
  change ‖∑ n ∈ Finset.Icc 1 ⌊4*N⌋₊, g ((n:ℝ)/N)*χ (n:ZMod q)/(n:ℂ)^(point t)‖ ≤ _
  rw [he,mul_assoc,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hc]
  exact (mul_le_mul_of_nonneg_left h hc).trans_eq (by ring)

/-- Lemma 3.3 of *Primes in short arithmetic progressions*. Both sides
use (1/2+it), the exact lower cutoff 1 and natural floor of the upper endpoint. -/
theorem lemma_3_3 (δ : ℝ) (hδ : 0 < δ) (r : ℕ) (g : ℝ → ℂ)
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (hs : ∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive →
    ∀ Q T t N : ℝ, (q : ℝ) ≤ Q → 2 ≤ T → |t| ≤ T → 1 ≤ N →
      ‖∑ n ∈ Finset.Icc 1 ⌊4*N⌋₊, (Real.log n : ℂ)^r * g ((n:ℝ)/N) *
        χ (n:ZMod q) / (n:ℂ)^(point t)‖ ≤ C * Real.log (2*N)^r *
        ∫ u : ℝ, ‖∑ n ∈ Finset.Icc 1 (dualCutoff δ Q T N),
          χ (n:ZMod q)/(n:ℂ)^(point (t+u))‖/(1+u^2) :=
  lift_uniform_shortening δ (unweighted δ hδ) r g hg hs

/-- Equivalence to the infinite-sum convention in the paper: neither the
zero index nor the part above floor(4N) contributes. -/
theorem smooth_tsum_eq {q : ℕ} (χ : DirichletCharacter ℂ q) (r : ℕ) (N t : ℝ)
    (hN : 0 < N) (g : ℝ → ℂ) (hs : ∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) :
    (∑' n : ℕ, (Real.log n : ℂ)^r * g ((n:ℝ)/N)*χ (n:ZMod q)/(n:ℂ)^point t) =
    ∑ n ∈ Finset.Icc 1 ⌊4*N⌋₊, (Real.log n : ℂ)^r * g ((n:ℝ)/N) *
      χ (n:ZMod q) / (n:ℂ)^point t := by
  apply tsum_eq_sum
  intro n hn
  have hzero : g ((n:ℝ)/N) = 0 := by
    apply hs
    intro h
    have hlo := (le_div_iff₀ hN).1 h.1
    have hup := (div_le_iff₀ hN).1 h.2
    have hnpos : 0 < (n:ℝ) := by linarith
    exact hn (Finset.mem_Icc.mpr ⟨by exact_mod_cast hnpos, (Nat.le_floor_iff (by positivity)).2 hup⟩)
  simp [hzero]

end
end ShortAPShortening

