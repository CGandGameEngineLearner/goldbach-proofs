    rw [← Real.rpow_natCast,← Real.rpow_mul hx]
    norm_num
  norm_num only [Nat.cast_ofNat,show (1:ℝ)-1/2=1/2 by norm_num,
    hs _ (hF0 _),hs _ (hG0 _),Nat.reduceSub,pow_one] at h
