namespace ShortAPSmallConductorEnergy
noncomputable section

/-- The two squared caps consumed by the large-values argument. -/
theorem squared_caps {ι : Type*} {s : Finset ι} {U : ι → ℝ} {x D : ℝ}
    {B m : ℕ} (hx : 0 ≤ x) (hL : 1 ≤ Real.log x) (hD : 0 ≤ D) (hDB : D ≤ (Real.log x)^B)
    (hU : ∀ k ∈ s, 0 ≤ U k)
    (hs : (∏ k ∈ s, U k) * (Real.log x)^(B+m) ≤ Real.sqrt x) :
    (∏ k ∈ s, (U k)^2)*D^2 ≤ (Real.log x)^512*x ∧
    (∏ k ∈ s, (U k)^2)*(Real.log x)^m ≤ x := by
  let A := ∏ k ∈ s, U k
  have hA : 0 ≤ A := prod_nonneg hU
  have h1 : 1 ≤ (Real.log x)^m := one_le_pow₀ hL
  have he (y : ℝ) (hy : 0≤y) (hb : y ≤ (Real.log x)^(B+m)) : (A*y)^2 ≤ x := by
    exact (pow_le_pow_left₀ (mul_nonneg hA hy) ((mul_le_mul_of_nonneg_left hb hA).trans hs) 2).trans_eq
      (Real.sq_sqrt hx)
  have ha := he D hD (hDB.trans (pow_le_pow_right₀ hL (show B ≤ B+m by omega)))
  have hb := he ((Real.log x)^m) (by positivity) (pow_le_pow_right₀ hL (by omega))
  rw [mul_pow] at ha hb
  rw [Finset.prod_pow]
  refine ⟨ha.trans (le_mul_of_one_le_left hx (one_le_pow₀ hL)), ?_⟩
  exact (mul_le_mul_of_nonneg_left (show (Real.log x)^m ≤ ((Real.log x)^m)^2 by nlinarith)
    (sq_nonneg A)).trans hb

/-- Genuine continuous energy on a frequency/amplitude box, summed over all
nontrivial primitive conductors. Here the upper-amplitude hypotheses of (4.11)
are discharged, not assumed; the geometric height and short-scale restrictions remain. -/
theorem all_blocks_energy (j B Bq : ℕ) (hj : j < 4) {CHeight : ℝ} (hHeight : 1 ≤ CHeight) :
    ∀ᶠ x : ℝ in atTop, ∀ {X H Q : ℕ} (a z T Z D θ β : ℝ) (b : Choice j)
      (U : {i // i ∈ blockIndices j} → ℝ),
    let s := (blockIndices j).attach
    let M := fun k : {i // i ∈ blockIndices j} => scale (b k.val k.property)
    let F := fun k (χ : ShortAP.CharIndex) (t : ℝ) =>
      boxPolynomial H j k.val (b k.val k.property) χ.2 (1/2+(t:ℂ)*Complex.I)
    H ≠ 0 → H ≤ X → (X : ℝ) ≤ 4*x → (H : ℝ) ≤ (4*x)^((1:ℝ)/4) → x ≤ a → z ≤ 4*x →
    b ∈ activeChoices X H j a z → 1 ≤ Q → 1 ≤ T → 0 ≤ Z → 0 < D → D ≤ (Real.log x)^B →
    (Q:ℝ) ≤ 2*(Real.log x)^Bq → 2*T ≤ x → (Q:ℝ)^2*(2*T) ≤ CHeight*Z →
    5/8 ≤ θ → θ ≤ 1 → (1-θ)/3+1/32 ≤ β → (∀ k, M k ≤ x^((1:ℝ)/3-1/256)) →
    (∀ k, 1 ≤ U k) → D^2*x^β*(Real.log x)^19 = x^θ → Z*x^β ≤ x*(Real.log x)^120 →
    (∑ χ ∈ (ShortAP.primitiveFamily Q).filter (fun χ => 1 < χ.1),
      ∫ t in amplitudeBox s F T U χ, ‖∏ k ∈ s, F k χ t‖^2)*(Real.log x)^77 ≤
      (((2:ℝ)^8)^2 * (4*boxSamplingConstant 4 4 CHeight))*x := by
  classical
  let m := ShortAPFactorSampling.logExponent 2048 1 + 512*2048+77
  filter_upwards [ShortAPAllSmallConductor.all_blocks_cap (B+m) Bq,
    actual_box_energy (ι := {i // i ∈ blockIndices j}) (c := 4) (C := 4) (C₀ := 4^8)
      (p := ShortAPFactorSampling.logExponent 2048 1) le_rfl (by norm_num) (by norm_num)
      (by norm_num) hHeight, eventually_ge_atTop (Real.exp 1)] with x hcap hE hx
  have hL : 1 ≤ Real.log x := by simpa using Real.log_le_log (Real.exp_pos _) hx
  have hx0 := ((Real.exp_pos _).trans_le hx).le
  intro X H Q a z T Z D θ β b U s M F hH hHX hX hHr ha hz hb hQ hT hZ hD hDB hQsmall hf hHeight' hθ hθ' hβ hM hU hid hZ'
  let I := (ShortAP.primitiveFamily Q).filter (fun χ => 1 < χ.1)
  let E := fun χ => ∫ t in amplitudeBox s F T U χ, ‖∏ k ∈ s, F k χ t‖^2
  have hn (χ) : 0 ≤ E χ := integral_nonneg (fun _ => sq_nonneg _)
  have hc : s.card ≤ 8 := by simp [s, blockIndices]; omega
  by_cases h : ∃ χ ∈ I, (amplitudeBox s F T U χ).Nonempty
  · obtain ⟨χ, hχ, t, ht⟩ := h
    obtain ⟨hχQ, hq⟩ := mem_filter.mp hχ
    obtain ⟨hqQ, hp⟩ := mem_sigma.mp hχQ
    have hprim : χ.2.IsPrimitive := by
      simpa [ShortAP.primitiveChars, show χ.1 ≠ 0 by omega] using hp
    have ht' := abs_le_of_mem_amplitudeBox ht
    have hχsmall : (χ.1:ℝ) ≤ 2*(Real.log x)^Bq :=
      (show (χ.1:ℝ) ≤ Q by exact_mod_cast (mem_Icc.mp hqQ).2).trans hQsmall
    have hv := hcap χ.2 hq hprim t a z b hj hH hHX hX hHr ha hz hb hχsmall (ht'.trans hf) U
      (fun k => ⟨zero_le_one.trans (hU k), (mem_amplitudeBox_factor ht (mem_attach _ k)).1⟩)
    obtain ⟨h1,h2⟩ := squared_caps hx0 hL hD.le hDB (fun k _ => zero_le_one.trans (hU k)) hv
    have hscale := active_box_scales hb
    have hprod : x ≤ (4:ℝ)^8 * ∏ k ∈ s, M k := by
      have hh := (div_le_iff₀ (by positivity)).mp hscale.1
      exact ha.trans (hh.trans (by
        rw [mul_comm]
        exact mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num) (by omega))
          (prod_nonneg (s := s) (f := M) (fun k _ => (scale_pos _).le))))
    have he := hE s (fun k => ⌊4*M k⌋₊) (fun k => logDegree k.val) M U
      (fun k => complexCoeffs (boxFactor H j k.val (b k.val k.property))) Q T Z D θ β
      hQ hT hZ hD hHeight' hθ hθ' hβ hc (fun k _ => ⟨by linarith [one_half_le_scale (b k.val k.property)],hM k⟩)
      hprod (hscale.2.trans hz) (fun k _ => ⟨(Nat.le_floor_iff (mul_nonneg (by norm_num) (scale_pos _).le)).2
        (by have := one_half_le_scale (b k.val k.property); change (1:ℝ) ≤ 4*scale _; linarith),
        Nat.floor_le (mul_nonneg (by norm_num) (scale_pos _).le)⟩)
      (fun k _ => hU k) (ShortAPSmallConductorProduct.sampling_degree j)
      (fun k _ n => ShortAPSmallConductorProduct.sampling_support H j k.val (b k.val k.property) n)
      (fun k _ n => ShortAPSmallConductorProduct.sampling_coeff H j k.val (b k.val k.property) n)
      hid hZ' h1 h2
    exact (mul_le_mul_of_nonneg_right (sum_le_sum_of_subset_of_nonneg (filter_subset _ _)
      (fun χ _ _ => hn χ)) (pow_nonneg (zero_le_one.trans hL) _)).trans he
  · have hempty (χ) (hχ : χ ∈ I) : amplitudeBox s F T U χ = ∅ :=
      Set.not_nonempty_iff_eq_empty.mp (fun he => h ⟨χ, hχ, he⟩)
    have hzE : ∑ χ ∈ I, E χ = 0 := sum_eq_zero (fun χ hχ => by simp [E, hempty χ hχ])
    change (∑ χ ∈ I, E χ)*_ ≤ _
    rw [hzE, zero_mul]
    have hK : 0 ≤ boxSamplingConstant 4 4 CHeight := add_nonneg
      (ShortAPFactorSampling.commonSamplingConstant_nonneg 2048 (by norm_num) hHeight)
      (ShortAPComplementSampling.complementConstant_nonneg (by norm_num) (by norm_num) hHeight)
    positivity

end
end ShortAPSmallConductorEnergy

