open Set

namespace ShortAPVinogradovReciprocal
open OAI.Vg

/-- Quantitative reciprocal bound throughout a high-frequency Vinogradov
strip. Its exponential loss involves log q + log log |t|, not log |t|. -/
theorem reciprocal_on_strip :
    ∃ c C T : ℝ, 0<c ∧ 0<C ∧ 0<T ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q)
    (t : ℝ), T ≤ |t| → 1 ≤ V96 (2*t) →
    let W := V36 (2*t)
    let V := Vcw q (2*t)
    let r := c*W/V
    ∀ σ ∈ Icc (1-r) (1+2*r), DirichletCharacter.LFunction χ ((σ:ℂ)+Complex.I*(t:ℂ)) ≠ 0 ∧
      ‖(DirichletCharacter.LFunction χ ((σ:ℂ)+Complex.I*(t:ℂ)))⁻¹‖ ≤
        r⁻¹ * Real.exp (C * V) := by
  obtain ⟨a,K,T,ha,hK,hT,hz⟩ := V1bc
  obtain ⟨b,hb,_,hright⟩ := V1ks
  let c := min a (min b (1/32))
  have hc : 0<c := lt_min ha (lt_min hb (by norm_num))
  have hca : c ≤ a := min_le_left _ _
  have hcb : c ≤ b := (min_le_right _ _).trans (min_le_left _ _)
  have hcn : c ≤ 1/32 := (min_le_right _ _).trans (min_le_right _ _)
  refine ⟨c,3*c*K,T,hc,by positivity,hT,?_⟩
  intro q _ χ t ht hlog W V r σ hσ
  have hv : 1 ≤ V := V1h1 hlog
  have hv0 : 0<V := zero_lt_one.trans_le hv
  have hlog0 : 0<V96 (2*t) := zero_lt_one.trans_le hlog
  have hw0 : 0<W := Real.rpow_pos_of_pos hlog0 _
  have hw1 : W ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hlog (by norm_num)
  have hr : 0<r := div_pos (mul_pos hc hw0) hv0
  have hrcw : r ≤ c*W := div_le_self (mul_nonneg hc.le hw0.le) hv
  have hrc : r ≤ c := hrcw.trans (mul_le_of_le_one_right hc.le hw1)
  have hr' : r ≤ a*W/V := div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hca hw0.le) hv0.le
  have h2r : 2*r ≤ W/16 := by nlinarith [mul_le_mul_of_nonneg_right hcn hw0.le]
  let f := DirichletCharacter.LFunction χ
  let z := fun u : ℝ => (u:ℂ)+Complex.I*(t:ℂ)
  let D := K*V^2*(V96 (2*t))^((2:ℝ)/3)
  have hD : 0 ≤ D := mul_nonneg (mul_nonneg hK.le (sq_nonneg _)) (Real.rpow_nonneg hlog0.le _)
  have hreg (u : ℝ) (hu : u ∈ Icc (1-r) (1+2*r)) : f (z u) ≠ 0 ∧ ‖deriv f (z u)/f (z u)‖ ≤ D :=
    hz q χ t u ht (by linarith [hu.1]) (by linarith [hu.2])
  have hdiff (u : ℝ) : DifferentiableAt ℂ f (z u) := by
    apply χ.differentiableAt_LFunction _ (Or.inl ?_)
    intro hh
    have he := congrArg Complex.im hh
    simp [z] at he
    exact (ne_of_gt (hT.trans_le ht)) (by simp [he])
  have hseg (u : ℝ) (hu : u ∈ Icc σ (1+2*r)) : u ∈ Icc (1-r) (1+2*r) := ⟨hσ.1.trans hu.1, hu.2⟩
  have hhor := ShortAPReciprocalStrip.horizontal (f := f) (t := t) hσ.2
    (fun u _ => hdiff u) (fun u hu => (hreg u (hseg u hu)).1) (fun u hu => (hreg u (hseg u hu)).2)
  have he : D*(3*r) = 3*c*K*V := by
    change (K*V^2*(V96 (2*t))^((2:ℝ)/3))*(3*(c*V36 (2*t)/V)) = _
    rw [V36, Real.rpow_neg hlog0.le]
    field_simp
  have hlen : D*(1+2*r-σ) ≤ 3*c*K*V :=
    (mul_le_mul_of_nonneg_left (by linarith [hσ.1] : 1+2*r-σ ≤ 3*r) hD).trans_eq he
  have hbase : ‖(f (z (1+2*r)))⁻¹‖ ≤ r⁻¹ := by
    simpa only [V1a, mul_zero, add_zero, one_div, f,z] using hright r hr (hrc.trans hcb) q χ t
  exact ⟨(hreg σ hσ).1,hhor.trans (mul_le_mul hbase (Real.exp_le_exp.mpr hlen)
    (Real.exp_pos _).le (inv_nonneg.mpr hr.le))⟩

end ShortAPVinogradovReciprocal

