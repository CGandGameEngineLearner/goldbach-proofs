    exact_mod_cast hq
  · intro h
    funext j
    have hj : j.val+1 ∈ Icc 1 k := mem_Icc.mpr ⟨by omega,by omega⟩
    have hq := (Ves.mp h) (j.val+1) hj
    dsimp only [Vb]
    exact_mod_cast hq
