    Va5 s N
      = (N : ℂ) ^ (1 - s)
        + (s * ∫ u in (1 : ℝ)..N, (u : ℂ) ^ (-s))
        - (s * ∫ u in (1 : ℝ)..N, Vq s u) := by
  rw [V23l s N hN, V1vd s N hN, mul_sub, add_sub_assoc]
theorem V1zz (s : ℂ) (hs : s ≠ 1) (N : ℕ) (hN : 1 ≤ N) :
