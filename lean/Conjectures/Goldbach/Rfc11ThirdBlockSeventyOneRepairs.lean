import Mathlib

/-!
The interval proof uses a separate pair of certified primes at each even target.
One summand is 1 modulo a power of 2, and the other is 1 modulo a power of
an odd prime. The BLS criterion and its group-order argument are adapted from
the accepted dyadic endpoint proof at 88d12c634462fdc8c18bca52d59d4e5cab497ac3.
The packed rows store the witnesses used by that criterion.
-/

namespace Rfc11ThirdBlockSeventyOneRepairsCertificate
namespace BLS

/-- Base-16 exponentiation. Every recursive step reduces the exponent and
performs a single modular reduction after the fixed sixteenth power. -/
def hexAux (a m : ℕ) : ℕ → ℕ → ℕ
  | 0, _ => 1 % m
  | f + 1, e => if e = 0 then 1 % m else
      ((hexAux a m f (e/16)) ^ 16 * a ^ (e%16)) % m

theorem hexAux_eq (a m f e : ℕ) (h : e < 16^f) :
    hexAux a m f e = a^e % m := by
  induction f generalizing e with
  | zero =>
    have : e=0 := by simpa using h
    simp [this, hexAux]
  | succ f ih =>
    by_cases hz : e=0
    · simp [hexAux, hz]
    rw [hexAux]
    simp only [hz, ↓reduceIte]
    have hr : e/16 < 16^f := (Nat.div_lt_iff_lt_mul (by decide)).2 (by simpa [pow_succ] using h)
    rw [ih _ hr]
    have hm : (a^(e/16) % m)^16 * a^(e%16) ≡
        (a^(e/16))^16 * a^(e%16) [MOD m] :=
      ((Nat.mod_modEq _ _).pow 16).mul (Nat.ModEq.refl _)
    calc
      _ = ((a^(e/16))^16 * a^(e%16))%m := hm
      _ = a^e%m := by rw [← pow_mul, ← pow_add, Nat.div_add_mod']

def powMod (a e m : ℕ) : ℕ := hexAux a m (Nat.log2 e + 1) e

theorem powMod_eq (a e m : ℕ) : powMod a e m = a^e % m :=
  hexAux_eq _ _ _ _ (lt_of_lt_of_le Nat.lt_log2_self (Nat.pow_le_pow_left (by decide : 2≤16) _))

/-- Certificate check for `N` with `F = ℓ^e ∣ N - 1` and `N < F^3`.
`a` is the witness base, `s` an integer-square-root witness for the discriminant. -/
def checkAt (N ℓ e s x : ℕ) : Bool :=
  let F := ℓ ^ e
  let m := (N - 1) / F
  let c1 := m % F
  let c2 := m / F
  decide (1 < N) && decide (0 < e) && decide (N % F = 1) && decide (N < F * F * F) &&
  decide (powMod x ℓ N = 1) && decide (Nat.gcd (x + N - 1) N = 1) &&
  (decide (N ≤ F * F) || decide (c1 * c1 < 4 * c2) ||
    (decide (s * s + 4 * c2 < c1 * c1) && decide (c1 * c1 < (s + 1) * (s + 1) + 4 * c2)))


def check (N ℓ e a s : ℕ) : Bool := checkAt N ℓ e s (powMod a ((N-1)/ℓ) N)

/-- If `d ∣ n` but `d ∤ n / ℓ` (`ℓ` prime), then the full `ℓ`-part of `n` divides `d`. -/
theorem pow_dvd_of_dvd_of_not_dvd_div {ℓ e d n : ℕ} (hℓ : ℓ.Prime) (hn : ℓ ^ e ∣ n)
    (hd : d ∣ n) (hnd : ¬ d ∣ n / ℓ) : ℓ ^ e ∣ d := by
  obtain ⟨k, rfl⟩ := hd
  have hk : ¬ ℓ ∣ k := by
    rintro ⟨k', rfl⟩
    apply hnd
    rw [show d * (ℓ * k') = ℓ * (d * k') by ring, Nat.mul_div_cancel_left _ hℓ.pos]
    exact dvd_mul_right _ _
  have hc : Nat.Coprime (ℓ ^ e) k :=
    Nat.Coprime.pow_left e ((Nat.Prime.coprime_iff_not_dvd hℓ).mpr hk)
  exact hc.dvd_of_dvd_mul_right hn

/-- Pocklington step: every prime factor of `N` is `≡ 1 (mod ℓ^e)`. -/
theorem prime_factor_dvd_sub_one {N ℓ e a r : ℕ} (hℓ : ℓ.Prime) (hN : 1 < N)
    (hF : ℓ ^ e ∣ N - 1) (he : 0 < e)
    (hx : (a ^ ((N - 1) / ℓ) % N) ^ ℓ % N = 1)
    (hg : Nat.gcd (a ^ ((N - 1) / ℓ) % N + N - 1) N = 1)
    (hr : r.Prime) (hrN : r ∣ N) : ℓ ^ e ∣ r - 1 := by
  have := Fact.mk hr
  have hℓN : ℓ ∣ N - 1 := (dvd_pow_self ℓ he.ne').trans hF
  generalize hxdef : a ^ ((N - 1) / ℓ) % N = x at hx hg
  have hxc : (x : ZMod r) = (a : ZMod r) ^ ((N - 1) / ℓ) := by
    have h1 : (x : ZMod r) = ((a ^ ((N - 1) / ℓ) : ℕ) : ZMod r) := by
      rw [ZMod.natCast_eq_natCast_iff, ← hxdef]
      exact (Nat.mod_modEq _ _).of_dvd hrN
    rw [h1, Nat.cast_pow]
  have hxl : (x : ZMod r) ^ ℓ = 1 := by
    have h1 : ((x ^ ℓ : ℕ) : ZMod r) = ((1 : ℕ) : ZMod r) := by
      rw [ZMod.natCast_eq_natCast_iff]
      have h2 : x ^ ℓ ≡ 1 [MOD N] := by
        unfold Nat.ModEq
        rw [hx, Nat.mod_eq_of_lt hN]
      exact h2.of_dvd hrN
    simpa using h1
  have hne : (x : ZMod r) ≠ 1 := by
    intro h1
    have h2 : ((x + N - 1 : ℕ) : ZMod r) = 0 := by
      rw [Nat.cast_sub (by omega), Nat.cast_add, h1, (ZMod.natCast_eq_zero_iff N r).mpr hrN]
      simp
    rw [ZMod.natCast_eq_zero_iff] at h2
    have h3 := Nat.dvd_gcd h2 hrN
    rw [hg] at h3
    exact hr.one_lt.ne' (Nat.dvd_one.mp h3)
  have hpow : (a : ZMod r) ^ (N - 1) = 1 := by
    rw [← Nat.div_mul_cancel hℓN, pow_mul, ← hxc, hxl]
  have ha0 : (a : ZMod r) ≠ 0 := by
    intro h0
    rw [h0, zero_pow (by omega)] at hpow
    exact zero_ne_one hpow
  have hd1 : orderOf (a : ZMod r) ∣ N - 1 := orderOf_dvd_of_pow_eq_one hpow
  have hd2 : ¬ orderOf (a : ZMod r) ∣ (N - 1) / ℓ := by
    rw [orderOf_dvd_iff_pow_eq_one, ← hxc]
    exact hne
  have hd3 : orderOf (a : ZMod r) ∣ r - 1 :=
    orderOf_dvd_of_pow_eq_one (ZMod.pow_card_sub_one_eq_one ha0)
  exact (pow_dvd_of_dvd_of_not_dvd_div hℓ hF hd1 hd2).trans hd3

/-- `(α+β)² - 4αβ = (α-β)²` is a perfect square, so it is neither negative nor strictly
between two consecutive squares. -/
theorem square_gap {α β s : ℕ} :
    ¬ ((α + β) * (α + β) < 4 * (α * β)) ∧
    ¬ (s * s + 4 * (α * β) < (α + β) * (α + β) ∧
      (α + β) * (α + β) < (s + 1) * (s + 1) + 4 * (α * β)) := by
  have key : ∀ a d : ℕ,
      ¬ ((a + (a + d)) * (a + (a + d)) < 4 * (a * (a + d))) ∧
      ¬ (s * s + 4 * (a * (a + d)) < (a + (a + d)) * (a + (a + d)) ∧
        (a + (a + d)) * (a + (a + d)) < (s + 1) * (s + 1) + 4 * (a * (a + d))) := by
    intro a d
    have hid : (a + (a + d)) * (a + (a + d)) = d * d + 4 * (a * (a + d)) := by ring
    rw [hid]
    refine ⟨by omega, ?_⟩
    rintro ⟨h1, h2⟩
    have h1' : s * s < d * d := by omega
    have h2' : d * d < (s + 1) * (s + 1) := by omega
    have hsd : s < d := by
      by_contra hc
      have := Nat.mul_le_mul (Nat.le_of_not_lt hc) (Nat.le_of_not_lt hc)
      omega
    have hds : d < s + 1 := by
      by_contra hc
      have := Nat.mul_le_mul (Nat.le_of_not_lt hc) (Nat.le_of_not_lt hc)
      omega
    omega
  rcases le_total α β with h | h
  · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
    exact key α d
  · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
    have := key β d
    rwa [Nat.add_comm (β + d) β, Nat.mul_comm (β + d) β]

theorem check_sound {N ℓ e a s : ℕ} (hℓ : ℓ.Prime) (h : check N ℓ e a s = true) : N.Prime := by
  simp only [check, checkAt, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq, powMod_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨hN, he⟩, hmod⟩, hlt⟩, hx⟩, hg⟩, hsq⟩ := h
  generalize hFdef : ℓ ^ e = F at hmod hlt hsq
  have hFpos : 0 < F := by
    rw [← hFdef]
    exact pow_pos hℓ.pos e
  have hF : F ∣ N - 1 := by
    have h1 := Nat.dvd_sub_mod (n := F) N
    rwa [hmod] at h1
  by_contra hNp
  have hr : (N.minFac).Prime := Nat.minFac_prime (by omega)
  obtain ⟨t, ht⟩ := Nat.minFac_dvd N
  generalize N.minFac = r at hr ht
  have hrF : F ∣ r - 1 := by
    rw [← hFdef]
    exact prime_factor_dvd_sub_one hℓ hN (hFdef ▸ hF) he hx hg hr (Dvd.intro t ht.symm)
  have ht1 : t ≠ 1 := by
    rintro rfl
    rw [mul_one] at ht
    exact hNp (ht ▸ hr)
  have ht0 : t ≠ 0 := by
    rintro rfl
    rw [mul_zero] at ht
    omega
  obtain ⟨α, hα⟩ := hrF
  have hr2 := hr.two_le
  have hα0 : α ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hα
    omega
  have hrα : r = F * α + 1 := by omega
  have htF : F ∣ t - 1 := by
    have h1 : N - 1 = F * (α * t) + (t - 1) := by
      have h2 : N = F * (α * t) + t := by
        rw [ht, hrα]
        ring
      omega
    rw [h1] at hF
    exact (Nat.dvd_add_right (dvd_mul_right F (α * t))).mp hF
  obtain ⟨β, hβ⟩ := htF
  have hβ0 : β ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hβ
    omega
  have htβ : t = F * β + 1 := by omega
  have hNeq : N = α * β * (F * F) + (α + β) * F + 1 := by
    rw [ht, hrα, htβ]
    ring
  have hαβpos : 1 ≤ α * β := Nat.mul_pos (Nat.pos_of_ne_zero hα0) (Nat.pos_of_ne_zero hβ0)
  have hαβ : α * β < F := by
    by_contra hc
    have h1 : F * (F * F) ≤ α * β * (F * F) := Nat.mul_le_mul_right _ (Nat.le_of_not_lt hc)
    have h2 : F * F * F = F * (F * F) := by ring
    have h3 := Nat.zero_le ((α + β) * F)
    omega
  have hNbig : F * F < N := by
    have h1 : 1 * (F * F) ≤ α * β * (F * F) := Nat.mul_le_mul_right _ hαβpos
    have h3 := Nat.zero_le ((α + β) * F)
    omega
  have hsum1 : α + β ≤ α * β + 1 := by
    obtain ⟨a', rfl⟩ : ∃ a', α = a' + 1 := ⟨α - 1, by omega⟩
    obtain ⟨b', rfl⟩ : ∃ b', β = b' + 1 := ⟨β - 1, by omega⟩
    have h1 : (a' + 1) * (b' + 1) = a' * b' + a' + b' + 1 := by ring
    omega
  have hsum : α + β < F := by
    by_contra hc
    have h1 : α + β = F := by omega
    have h2 : α * β + 1 = F := by omega
    have h3 : N = F * F * F + 1 := by
      calc N = α * β * (F * F) + (α + β) * F + 1 := hNeq
        _ = (α * β + 1) * (F * F) + 1 := by rw [h1]; ring
        _ = F * F * F + 1 := by rw [h2]; ring
    omega
  have hm : (N - 1) / F = (α + β) + F * (α * β) := by
    apply Nat.div_eq_of_eq_mul_right hFpos
    have h1 : α * β * (F * F) + (α + β) * F = F * ((α + β) + F * (α * β)) := by ring
    omega
  have hc1 : (N - 1) / F % F = α + β := by
    rw [hm, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hsum]
  have hc2 : (N - 1) / F / F = α * β := by
    rw [hm, Nat.add_mul_div_left _ _ hFpos, Nat.div_eq_of_lt hsum, zero_add]
  rw [hc1, hc2] at hsq
  have hgap := square_gap (α := α) (β := β) (s := s)
  rcases hsq with (h1 | h1) | h1
  · omega
  · exact hgap.1 h1
  · exact hgap.2 h1

def certified (N ℓ e a s x : ℕ) : Bool :=
  (powMod a ((N-1)/ℓ) N == x) && checkAt N ℓ e s x

theorem certified_prime {N ℓ e a s x : ℕ} (hℓ : ℓ.Prime) (h : certified N ℓ e a s x = true) :
    N.Prime := by
  simp only [certified, Bool.and_eq_true, beq_iff_eq] at h
  apply check_sound (a := a) (e := e) (s := s) hℓ
  unfold check
  rw [h.1]
  exact h.2
end BLS

def lOf (i : ℕ) : ℕ :=
  match i with
  | 0 => 3 | 1 => 5 | 2 => 7 | 3 => 11 | 4 => 13 | 5 => 17 | 6 => 19 | _ => 23

theorem lOf_prime (i : ℕ) : (lOf i).Prime := by
  unfold lOf
  split <;> norm_num

def bOf (i : ℕ) : ℕ :=
  match i with
  | 0 => 126 | 1 => 86 | 2 => 71 | 3 => 58 | 4 => 54 | 5 => 49 | 6 => 47 | _ => 45

private def field (row shift width : ℕ) := (row >>> shift) &&& ((1 <<< width)-1)

private def lidx (r : ℕ) := field r 0 3

private def leftBase (r : ℕ) := field r 3 6

private def rightBase (r : ℕ) := field r 9 5

private def left (r : ℕ) := field r 14 418

private def rightResidue (r : ℕ) := field r 432 598

private def leftDisc (r : ℕ) := field r 1030 200

private def rightDisc (r : ℕ) := field r 1230 201

private def rowOK (n r : ℕ) : Bool :=
  let p := left r
  let q := n-p
  decide (p≤n) && BLS.certified p 2 200 (leftBase r) (leftDisc r) (p-1) &&
    BLS.certified q (lOf (lidx r)) (bOf (lidx r)) (rightBase r) (rightDisc r) (rightResidue r)

private theorem rowOK_sound {n r : ℕ} (h : rowOK n r = true) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p+q=n := by
  simp only [rowOK, Bool.and_eq_true, decide_eq_true_eq] at h
  exact ⟨_, _, BLS.certified_prime Nat.prime_two h.1.2,
    BLS.certified_prime (lOf_prime _) h.2, Nat.add_sub_of_le h.1.1⟩

def checkList (f : ℕ → ℕ) : ℕ → List ℕ → Bool
  | _, [] => true
  | i, c :: cs => rowOK (f i) c && checkList f (i + 1) cs

theorem checkList_sound (f : ℕ → ℕ) : ∀ (cs : List ℕ) (i0 : ℕ), checkList f i0 cs = true →
    ∀ i, i0 ≤ i → i < i0 + cs.length → ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p + q = f i := by
  intro cs
  induction cs with
  | nil =>
    intro i0 _ i h1 h2
    simp only [List.length_nil] at h2
    omega
  | cons c cs ih =>
    intro i0 h i h1 h2
    simp only [checkList, Bool.and_eq_true] at h
    simp only [List.length_cons] at h2
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · exact rowOK_sound h.1
    · exact ih (i0 + 1) h.2 i hlt (by omega)

private def target (i : ℕ) := 999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999975424 + 2*i
private def Covers (lower upper : ℕ) : Prop :=
  ∀ (i : ℕ), (lower ≤ i) → (i < upper) →
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p+q=target i

private theorem appendCover {a b c : ℕ} (left : Covers a b) (right : Covers b c) : Covers a c := by
  intro i lo hi
  by_cases h : i<b
  · exact left i lo h
  · exact right i (by omega) hi

private theorem fromRows (lo : ℕ) (rows : List ℕ) (h : checkList target lo rows = true) :
    Covers lo (lo+rows.length) := checkList_sound target rows lo h

