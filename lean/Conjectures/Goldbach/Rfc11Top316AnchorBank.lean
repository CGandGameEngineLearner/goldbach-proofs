import Mathlib
/-!
# Primality certificates for the RFC 1.1 anchor bank

The 43 offsets are those of the project's fourth research proposal, V11.
PARI/GP supplied candidate curves and points. The checker below verifies
their order in every possible prime-divisor field using Jacobian coordinates,
with a Lucas certificate at the end of each chain. Its counting bound uses
at most two ordinates per abscissa. All arithmetic is checked by the kernel.
-/
namespace Rfc316Cert

structure J where
  x : Nat
  y : Nat
  z : Nat
  deriving DecidableEq

def negMod (n x : Nat) := n - x % n

def double (n a : Nat) (P : J) : J :=
  let x := P.x
  let y := P.y
  let z := P.z
  let yy := y*y % n
  let zz := z*z % n
  let s := 4*x*yy % n
  let m := (3*x*x + a*zz*zz) % n
  let u := (m*m + 2*negMod n s) % n
  ⟨u, (m*(s+negMod n u) + 8*negMod n (yy*yy)) % n, 2*y*z % n⟩

def addFixed (n x y : Nat) (P : J) : J :=
  let zz := P.z*P.z % n
  let h := (x*zz + negMod n P.x) % n
  let r := (y*zz*P.z + negMod n P.y) % n
  let hh := h*h % n
  let hhh := hh*h % n
  let v := P.x*hh % n
  let u := (r*r + negMod n hhh + 2*negMod n v) % n
  ⟨u, (r*(v+negMod n u)+negMod n (P.y*hhh)) % n, P.z*h % n⟩

def scan (n a x y k : Nat) : Nat → J → J
  | 0, R => R
  | l+1, R =>
    let D := double n a R
    scan n a x y k l (if k.testBit l then addFixed n x y D else D)

open WeierstrassCurve

def curve (p a b : ℕ) : WeierstrassCurve.Affine (ZMod p) := ⟨0,0,0,a,b⟩

theorem castMod {p n : ℕ} (hp : p ∣ n) (t : ℕ) :
    ((t % n : ℕ) : ZMod p) = t :=
  (ZMod.natCast_eq_natCast_iff' ..).2 (Nat.mod_mod_of_dvd _ hp)

theorem castNeg {p n : ℕ} (hp : p ∣ n) (hn : 0 < n) (t : ℕ) :
    ((negMod n t : ℕ) : ZMod p) = -(t : ZMod p) := by
  rw [negMod, Nat.cast_sub (Nat.mod_lt _ hn).le, castMod hp, (ZMod.natCast_eq_zero_iff _ _).mpr hp]
  simp

def Rep {p : ℕ} (a b : ℕ) (P : J) (T : (curve p a b).Point) : Prop :=
  (P.z : ZMod p) ≠ 0 → ∃ (x y : ZMod p) (h : (curve p a b).Nonsingular x y),
    T = .some x y h ∧ (P.x : ZMod p) = x * P.z ^ 2 ∧ (P.y : ZMod p) = y * P.z ^ 3

theorem doubleRep {p n : ℕ} [Fact p.Prime] (hp : p ∣ n) (hn : 0 < n)
    (a b : ℕ) (P : J) (T : (curve p a b).Point) (hP : Rep a b P T) :
    Rep a b (double n a P) (T+T) := by
  intro hz
  have dz : ((double n a P).z : ZMod p) = 2 * P.y * P.z := by
    simp [double, castMod hp]
  rw [dz] at hz
  obtain ⟨h2y, hZ⟩ := mul_ne_zero_iff.mp hz
  obtain ⟨x,y,h,rfl,hx,hy⟩ := hP hZ
  have htwo : (2 : ZMod p) ≠ 0 := (mul_ne_zero_iff.mp h2y).1
  have hy0 : y ≠ 0 := by intro H; simp [hy,H] at h2y
  have hfour : (4 : ZMod p) ≠ 0 := by
    rw [show (4 : ZMod p) = 2*2 by norm_num]; exact mul_ne_zero htwo htwo
  have hny : y ≠ (curve p a b).negY x y := by
    simp only [Affine.negY,curve,zero_mul,sub_zero]
    intro H
    exact (mul_ne_zero htwo hy0) (by linear_combination H)
  rw [Affine.Point.add_some (fun e => hny e.2)]
  refine ⟨_,_,_,rfl,?_,?_⟩ <;>
    simp only [double,castMod hp, Nat.cast_mul,Nat.cast_add,castNeg hp hn,
      Nat.cast_ofNat,Affine.addX,Affine.addY,Affine.negAddY,Affine.negY,
      Affine.slope_of_Y_ne rfl hny] <;>
    simp only [curve,Affine.negY,zero_mul,zero_add,add_zero,sub_zero,hx,hy] <;>
    field_simp [show y - -y = 2*y by ring, htwo, hy0] <;> ring_nf <;> field_simp [hfour,htwo] <;> ring

theorem addRep {p n : ℕ} [Fact p.Prime] (hp : p ∣ n) (hn : 0 < n) (a b x y : ℕ)
    (h : (curve p a b).Nonsingular (x:ZMod p) (y:ZMod p))
    (P : J) (T : (curve p a b).Point) (hP : Rep a b P T) :
    Rep a b (addFixed n x y P) (T + .some _ _ h) := by
  intro hz
  have dz : ((addFixed n x y P).z : ZMod p) = P.z * ((x:ZMod p) * ((P.z:ZMod p)*P.z) - P.x) := by
    simp [addFixed,castMod hp,castNeg hp hn,sub_eq_add_neg]
  rw [dz] at hz
  obtain ⟨hZ, hd⟩ := mul_ne_zero_iff.mp hz
  obtain ⟨u,v,g,rfl,hx,hy⟩ := hP hZ
  have hnu : u ≠ (x : ZMod p) := by
    rintro rfl
    apply hd; rw [hx]; ring
  rw [Affine.Point.add_some (fun e => hnu e.1)]
  refine ⟨_,_,_,rfl,?_,?_⟩ <;>
    simp only [addFixed,castMod hp,Nat.cast_mul,Nat.cast_add,castNeg hp hn,
      Nat.cast_ofNat,Affine.addX,Affine.addY,Affine.negAddY,Affine.negY,
      Affine.slope_of_X_ne hnu,curve,zero_mul,zero_add,add_zero,sub_zero,hx,hy] <;>
    field_simp [sub_ne_zero.mpr hnu, sub_ne_zero.mpr hnu.symm] <;> ring

def indexScan (k : ℕ) : ℕ → ℕ → ℕ
  | 0,i => i
  | l+1,i => indexScan k l (if k.testBit l then i+i+1 else i+i)

theorem scanRep {p n : ℕ} [Fact p.Prime] (hp : p ∣ n) (hn : 0 < n)
    (a b x y : ℕ) (h : (curve p a b).Nonsingular (x:ZMod p) (y:ZMod p))
    (k l i : ℕ) (R : J) (hR : Rep a b R (i • (.some _ _ h : (curve p a b).Point))) :
    Rep a b (scan n a x y k l R) (indexScan k l i • (.some _ _ h : (curve p a b).Point)) := by
  induction l generalizing i R with
  | zero => exact hR
  | succ l ih =>
    simp only [scan,indexScan]
    split
    · exact ih _ _ (by simpa [add_nsmul] using addRep hp hn a b x y h _ _ (doubleRep hp hn a b R _ hR))
    · exact ih _ _ (by simpa [add_nsmul] using doubleRep hp hn a b R _ hR)
def tag {p : ℕ} (a b : ℕ) : (curve p a b).Point → Option (ZMod p × Bool)
  | .zero => none
  | .some x y _ => some (x, decide (y.val ≤ (-y).val))

theorem tagInj {p : ℕ} [Fact p.Prime] (a b : ℕ) : Function.Injective (tag (p := p) a b) := by
  rintro ( _ | ⟨x,y,h⟩ ) ( _ | ⟨u,v,g⟩ ) e <;> simp only [tag,reduceCtorEq,Option.some.injEq,Prod.mk.injEq] at e
  · rfl
  obtain ⟨rfl,he⟩ := e
  have ey := (Affine.equation_iff _ _).mp h.1
  have ev := (Affine.equation_iff _ _).mp g.1
  simp only [curve,zero_mul,add_zero,zero_add] at ey ev
  have ee : y^2=v^2 := ey.trans ev.symm
  rcases sq_eq_sq_iff_eq_or_eq_neg.mp ee with rfl | rfl
  · rfl
  · simp only [neg_neg,decide_eq_decide] at he
    have e' : (-v).val = v.val := by omega
    have h' : -v=v := ZMod.val_injective _ e'
    congr 1

theorem orderBound {p : ℕ} [Fact p.Prime] (a b : ℕ) (T : (curve p a b).Point)
    {q : ℕ} (hq : q.Prime) (hne : T ≠ 0) (hz : q • T = 0) : q ≤ 2*p+1 := by
  classical
  letI : Fintype (curve p a b).Point := Fintype.ofInjective _ (tagInj a b)
  letI : Fact q.Prime := ⟨hq⟩
  have ho : addOrderOf T = q := addOrderOf_eq_prime hz hne
  have hc := Fintype.card_le_of_injective _ (tagInj (p := p) a b)
  have hl : q ≤ Fintype.card (curve p a b).Point := by
    rw [← ho]
    exact Nat.le_of_dvd Fintype.card_pos (addOrderOf_dvd_card)
  simp only [Fintype.card_option,Fintype.card_prod,Fintype.card_bool,ZMod.card] at hc
  omega


def coefficient (n a x y : ℕ) := y*y + negMod n (x*x*x+a*x)

def valid (n q a x y l : ℕ) : Bool :=
  let R := scan n a x y (q-1) l ⟨x,y,1⟩
  decide (1 < n ∧ 4*n < (q-1)^2 ∧ indexScan (q-1) l 1 = q-1 ∧
    (2*y*R.z).gcd n = 1 ∧ R.x % n = (x*R.z*R.z) % n ∧
    (R.y+y*R.z*R.z*R.z) % n = 0)

theorem step {n q a x y l : ℕ} (hq : q.Prime) (check : valid n q a x y l = true) : n.Prime := by
  let R := scan n a x y (q-1) l ⟨x,y,1⟩
  change decide (_ ∧ _ ∧ _ ∧ (2*y*R.z).gcd n = 1 ∧ R.x % n = (x*R.z*R.z) % n ∧ (R.y+y*R.z*R.z*R.z) % n = 0) = true at check
  obtain ⟨hn,hs,hi,hu,hx,hy⟩ := of_decide_eq_true check
  by_contra hc
  let p := n.minFac
  have hp : p.Prime := Nat.minFac_prime (by omega)
  have hd : p ∣ n := Nat.minFac_dvd _
  have hsmall : p^2 ≤ n := Nat.minFac_sq_le_self (by omega) hc
  letI : Fact p.Prime := ⟨hp⟩
  have hn0 : 0 < n := by omega
  let b := coefficient n a x y
  have unit : ((2*y*R.z : ℕ) : ZMod p) ≠ 0 := by
    intro he
    have dv := Nat.dvd_gcd ((ZMod.natCast_eq_zero_iff ..).1 he) hd
    rw [hu] at dv
    exact hp.ne_one (Nat.dvd_one.mp dv)
  push_cast at unit
  obtain ⟨h2y,hz⟩ := mul_ne_zero_iff.mp unit
  have hns : (curve p a b).Nonsingular (x:ZMod p) (y:ZMod p) := by
    rw [Affine.nonsingular_iff']
    refine ⟨(Affine.equation_iff ..).mpr ?_,Or.inr ?_⟩
    · simp only [curve,b,coefficient,Nat.cast_add,Nat.cast_mul,castNeg hd hn0,zero_mul,add_zero,zero_add]
      ring
    · simpa [curve] using h2y
  let T : (curve p a b).Point := .some _ _ hns
  have hP : Rep a b ⟨x,y,1⟩ (1 • T) := by
    rw [one_nsmul]; exact fun _ => ⟨_,_,hns,rfl,by simp,by simp⟩
  have hr := scanRep hd hn0 a b x y hns (q-1) l 1 _ hP
  rw [hi] at hr
  obtain ⟨u,v,g,hg,h1,h2⟩ := hr hz
  change (R.x : ZMod p) = u * (R.z:ZMod p)^2 at h1
  change (R.y : ZMod p) = v * (R.z:ZMod p)^3 at h2
  have ex := congrArg (fun t : ℕ => (t : ZMod p)) hx
  have ey := congrArg (fun t : ℕ => (t : ZMod p)) hy
  simp only [castMod hd,Nat.cast_mul,Nat.cast_add,Nat.cast_zero] at ex ey
  have hux : u = (x:ZMod p) := (mul_right_cancel₀ (pow_ne_zero 2 hz)) (by linear_combination ex-h1)
  have hvy : v = -(y:ZMod p) := (mul_right_cancel₀ (pow_ne_zero 3 hz)) (by linear_combination ey-h2)
  subst u v
  have hneg : (q-1) • T = -T := by
    rw [hg]
    change Affine.Point.some _ _ g = Affine.Point.some _ ((curve p a b).negY x y) _
    congr 1
    simp [Affine.negY,curve]
  have hqz : q • T = 0 := by
    conv_lhs => rw [show q=q-1+1 by have := hq.two_le; omega, add_nsmul,one_nsmul,hneg]
    simp
  have hb := orderBound a b T hq (Affine.Point.some_ne_zero hns) hqz
  have hh : q-1 ≤ 2*p := by omega
  have hs' := Nat.pow_le_pow_left hh 2
  nlinarith

