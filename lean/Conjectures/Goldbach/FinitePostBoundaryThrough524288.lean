import Mathlib.NumberTheory.LucasPrimality
import Mathlib.Data.Nat.Bitwise
import Mathlib.Data.Nat.Prime.Basic
import Mathlib.Data.Nat.Sqrt

/-!
The offset bank and bit-sieve argument adapt Anders Hafreager's reference contribution
in the preceding interval (Goldbach PR #3706, commit 25cc1158ef5f053ed8e0a0ca1a4f69820fbd6c4b).
The eleven repairs and the new interval are those of the published checkpoint proposal.
The modular power residues and finite bit masks are literal data whose arithmetic is rechecked.
-/

/-! The checked power trace is from Anders Hafreager's reference proof for the preceding
range. Offset data include the published eleven repairs for the new block.
-/
namespace PostBoundary524288.Anchors

private def powerTrace (p a : ℕ) : ℕ → ℕ → List ℕ → Bool
  | e, r, [] => e == 0 && r == 1
  | e, r, v :: vs =>
    r == (if e % 2 = 1 then v * v * a else v * v) % p &&
      powerTrace p a (e/2) v vs

private theorem powerTrace_sound (p a e r : ℕ) (vs : List ℕ)
    (h : powerTrace p a e r vs = true) : (a : ZMod p)^e = (r : ZMod p) := by
  induction vs generalizing e r with
  | nil =>
    simp only [powerTrace, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨rfl, rfl⟩ := h
    simp
  | cons v vs ih =>
    simp only [powerTrace, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨hr, ht⟩ := h
    have hv := ih (e/2) v ht
    by_cases hodd : e % 2 = 1
    · rw [ite_eq_left hodd] at hr
      have he : e / 2 + e / 2 + 1 = e := by omega
      calc
        (a : ZMod p)^e = (a : ZMod p)^(e/2) * (a : ZMod p)^(e/2) * a := by
          rw [← pow_add, ← pow_succ, he]
        _ = (r : ZMod p) := by simp [hr, hv]
    · rw [ite_eq_right hodd] at hr
      have he : e / 2 + e / 2 = e := by omega
      calc
        (a : ZMod p)^e = (a : ZMod p)^(e/2) * (a : ZMod p)^(e/2) := by
          rw [← pow_add, he]
        _ = (r : ZMod p) := by simp [hr, hv]

private theorem primeFactor_mem (xs : List ℕ) (hxs : ∀ r ∈ xs, Nat.Prime r)
    {q : ℕ} (hq : q.Prime) (hd : q ∣ xs.prod) : q ∈ xs := by
  induction xs with
  | nil => exact (hq.not_dvd_one hd).elim
  | cons a xs ih =>
    rw [List.prod_cons, hq.dvd_mul] at hd
    rcases hd with ha | ht
    · have heq := (Nat.prime_dvd_prime_iff_eq hq (hxs a (by simp))).mp ha
      simp [heq]
    · exact List.mem_cons_of_mem _ (ih (fun r hr => hxs r (by simp [hr])) ht)

private def smallPrime (q : ℕ) : Bool :=
  decide (2 ≤ q) && (List.range (q.sqrt + 1)).all (fun d => decide (d < 2 ∨ q % d ≠ 0))

private theorem smallPrime_sound {q : ℕ} (h : smallPrime q = true) : q.Prime := by
  simp only [smallPrime, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  refine Nat.prime_def_le_sqrt.mpr ⟨h.1, ?_⟩
  intro d hd hl hdiv
  have hc := h.2 d (List.mem_range.mpr (by omega))
  exact (hc.resolve_left (by omega)) (Nat.mod_eq_zero_of_dvd hdiv)


private abbrev Probe := ℕ × ℕ × List ℕ

private theorem prime_of_trace (p a : ℕ) (fs full : List ℕ) (probes : List Probe)
    (hprod : fs.prod = p-1) (hfs : ∀ q ∈ fs, Nat.Prime q)
    (hfull : powerTrace p a (p-1) 1 full = true)
    (hcover : fs.all (fun q => decide (q ∈ probes.map Prod.fst)) = true)
    (hprobe : probes.all (fun (q, v, vs) => decide (v % p ≠ 1 % p) &&
      powerTrace p a ((p-1)/q) v vs) = true) : Nat.Prime p := by
  refine lucas_primality p a ?_ ?_
  · simpa using powerTrace_sound _ _ _ _ _ hfull
  · intro q hq hdiv
    have hf := primeFactor_mem _ hfs hq (hprod.symm ▸ hdiv)
    have hm : q ∈ probes.map Prod.fst :=
      of_decide_eq_true (List.all_eq_true.mp hcover q hf)
    obtain ⟨⟨q',v,vs⟩,hi,rfl⟩ := List.mem_map.mp hm
    have hv := List.all_eq_true.mp hprobe _ hi
    rw [Bool.and_eq_true] at hv
    rw [powerTrace_sound _ _ _ _ _ hv.2]
    intro hbad
    exact (of_decide_eq_true hv.1) ((ZMod.natCast_eq_natCast_iff' v 1 p).mp (by simpa using hbad))

