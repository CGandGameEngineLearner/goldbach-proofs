private theorem offset_bound {a : ℕ} (h : a ∈ offsets) : a ≤ 245771 := by
  have checked : offsets.all (fun v => decide (v ≤ 245771)) = true := by decide +kernel
  exact of_decide_eq_true (List.all_eq_true.mp checked a h)

theorem offset_witness (k : ℕ) (hk : 2*k < 262144) :
    ∃ a ∈ offsets, Nat.Prime (a + 262146 + 2*k) ∧ a ≤ 245771 := by
  let j := (2*k)/tileSize
  let r := (2*k)%tileSize
  have hj : j < 32 := by
    change (2*k)/8192 < 32
    omega
  have hr : r < tileSize := Nat.mod_lt _ (by decide)
  have hQR : r + tileSize*j = 2*k := Nat.mod_add_div _ _
  have he : r = 2*(r/2) := by
    change ((2*k)%8192) = 2*(((2*k)%8192)/2)
    omega
  have hbit : (targetMask j).testBit r = true := by
    rw [he]
    exact multiples_in_mask (targetMask_checked j hj) (r/2) (by omega)
  obtain ⟨a, ha, hsmall⟩ := (unionBy_bit _ offsets r).mp hbit
  have hA := offset_bound ha
  have hEq : a + 262146 + j*tileSize + r = a + 262146 + 2*k := by
    rw [Nat.mul_comm j tileSize]
    omega
  have hq := span_prime rawTile_checked (by omega : 2 ≤ a + 262146 + j*tileSize + r)
    (by rw [hEq]; omega : a + 262146 + j*tileSize + r < 770060) hsmall
  rw [hEq] at hq
  exact ⟨a, ha, hq, hA⟩


end PostBoundary524288.Tiles

theorem Conjectures.Goldbach.FinitePostBoundaryThrough524288 :
    (fun (lo hi : ℕ) => ∀ n : ℕ, lo≤n → n<hi → 2∣n →
      ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p+q=n)
      (4*10^18+262146) (4*10^18+524290) := by
  intro n hlo hhi he
  obtain ⟨half, hhalf⟩ := he
  let k : ℕ := half - 2000000000000131073
  have hEq : n = 4000000000000000000 + 262146 + 2*k := by
    dsimp only [k]
    omega
  have hRange : 2*k < 262144 := by omega
  obtain ⟨a, ha, hSmall, hA⟩ := PostBoundary524288.Tiles.offset_witness k hRange
  have hLarge := PostBoundary524288.Anchors.anchors_prime a ha
  exact ⟨4000000000000000000-a, a+262146+2*k, hLarge, hSmall, by omega⟩
