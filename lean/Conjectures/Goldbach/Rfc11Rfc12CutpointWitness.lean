import Mathlib

/-! Short Weierstrass certificates. The curve group and coordinate formulas
are those of Mathlib. The order argument follows Goldwasser--Kilian.
The certificate shape and reduction modulo a prime divisor were informed by
Kim Morrison's HexECPPTheory (Apache-2.0), revision
3a1b9813b1d1876ae0c89f5cfc20da05547bd854. For the steps used here the
elementary bound 2p+1 on the number of points suffices. -/

namespace GoldbachAnchorCurve
open WeierstrassCurve

structure Coords (R : Type*) where
  X : R
  Y : R
  Z : R
deriving DecidableEq

def Coords.vec {R : Type*} (c : Coords R) : Fin 3 → R := ![c.X,c.Y,c.Z]

def curve {R : Type*} [CommRing R] (a b : R) : WeierstrassCurve R := ⟨0,0,0,a,b⟩

def dbl {R : Type*} [CommRing R] (a : R) (c : Coords R) : Coords R :=
  let h := 2*c.Y
  let h₂ := h*h
  let u := 3*c.X^2 + a*c.Z^4
  let v := c.X*h₂
  let X := u^2 - 2*v
  ⟨X, u*(v-X) - c.Y*h*h₂, c.Z*h⟩

def mixed {R : Type*} [CommRing R] (a b u v : R) (c : Coords R) : Coords R :=
  let Z₂ := c.Z^2
  let Z₄ := Z₂^2
  let X₂ := c.X^2
  let U₂ := u^2
  let k := a*u+2*b
  let newX := c.X*Z₂*(U₂+a) - 2*c.Y*v*c.Z + X₂*u + Z₄*k
  let newY := v*(3*X₂*u*Z₂ - X₂*c.X + 2*c.Y^2 + Z₄*Z₂*k + a*c.X*Z₄)
    + c.Y*c.Z*(Z₂*(U₂*u-2*v^2-a*u-2*b) - c.X*(3*U₂+a))
  ⟨newX,newY,c.X-u*Z₂⟩

theorem dbl_vec {R : Type*} [CommRing R] (a b : R) (c : Coords R) :
    (dbl a c).vec = (curve a b).toJacobian.dblXYZ c.vec := by
  rcases c with ⟨X,Y,Z⟩
  ext i
  fin_cases i <;>
    simp [Coords.vec,dbl,Jacobian.dblXYZ,Jacobian.dblX,Jacobian.dblY,Jacobian.dblZ,
      Jacobian.negDblY,Jacobian.dblU_eq,Jacobian.negY,curve] <;> ring

theorem mixed_vec {R : Type*} [CommRing R] (a b u v : R) (c : Coords R) :
    (mixed a b u v c).vec = (curve a b).toJacobian.addXYZ c.vec ![u,v,1] := by
  rcases c with ⟨X,Y,Z⟩
  ext i
  fin_cases i <;>
    simp [Coords.vec,mixed,Jacobian.addXYZ,Jacobian.addX,Jacobian.addY,
      Jacobian.addZ,Jacobian.negAddY,Jacobian.negY,curve] <;> ring

def ladder {R : Type*} [CommRing R] (a b u v : R) : ℕ → ℕ → Coords R
  | 0, _ => ⟨1,1,0⟩
  | k+1, m =>
    let d := dbl a (ladder a b u v k (m/2))
    if m % 2 = 1 then mixed a b u v d else d

def Coords.map {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S)
    (c : Coords R) : Coords S := ⟨f c.X, f c.Y, f c.Z⟩

private theorem map_dbl {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S)
    (a : R) (c : Coords R) : (dbl a c).map f = dbl (f a) (c.map f) := by
  simp [dbl,Coords.map,map_ofNat]

private theorem map_mixed {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S)
    (a b u v : R) (c : Coords R) :
    (mixed a b u v c).map f = mixed (f a) (f b) (f u) (f v) (c.map f) := by
  simp [mixed,Coords.map,map_ofNat]

theorem map_ladder {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S)
    (a b u v : R) (k m : ℕ) :
    (ladder a b u v k m).map f = ladder (f a) (f b) (f u) (f v) k m := by
  induction k generalizing m with
  | zero => simp [ladder,Coords.map]
  | succ k ih =>
    by_cases h : m % 2=1 <;> simp only [ladder,h,ite_true,ite_false,map_mixed,map_dbl,ih]

section Geometry
variable {F : Type*} [Field F] [DecidableEq F]
open scoped WeierstrassCurve.Jacobian

private def represents (a b : F) (c : Coords F) (P : (curve a b).toAffine.Point) : Prop :=
  c = ⟨0,0,0⟩ ∨
  (curve a b).toJacobian.Nonsingular c.vec ∧ Jacobian.Point.toAffine (curve a b) c.vec = P

private theorem dbl_rep {a b : F} {c : Coords F} {P : (curve a b).toAffine.Point}
    (h : represents a b c P) : represents a b (dbl a c) (P+P) := by
  classical
  rcases h with h | ⟨hc, he⟩
  · subst c
    exact Or.inl (by simp [dbl])
  · right
    rw [dbl_vec, ← Jacobian.add_self]
    exact ⟨Jacobian.nonsingular_add hc hc, (Jacobian.Point.toAffine_add hc hc).trans (by rw [he])⟩

omit [DecidableEq F] in
private theorem collapsed_of_equiv (W : Jacobian F) {A B : Fin 3 → F}
    (he : A ≈ B) (hB : W.Equation B) : W.addXYZ A B = ![0,0,0] := by
  obtain ⟨u,rfl⟩ := he
  change W.addXYZ ((u : F) • B) B = _
  calc
    _ = W.addXYZ ((u : F) • B) ((1:F) • B) := by rw [one_smul]
    _ = _ := by rw [Jacobian.addXYZ_smul,Jacobian.addXYZ_self hB,Jacobian.smul_fin3]; simp

private theorem mixed_rep {a b u v : F} {c : Coords F}
    {P : (curve a b).toAffine.Point}
    (hQ : (curve a b).toJacobian.Nonsingular ![u,v,1])
    (h : represents a b c P) :
    represents a b (mixed a b u v c) (P + Jacobian.Point.toAffine (curve a b) ![u,v,1]) := by
  classical
  rcases h with h | ⟨hc, he⟩
  · subst c
    exact Or.inl (by simp [mixed])
  · by_cases heq : c.vec ≈ ![u,v,1]
    · left
      have hzero := (mixed_vec a b u v c).trans (collapsed_of_equiv _ heq hQ.left)
      let T := mixed a b u v c
      have hX : T.X = 0 := congrFun hzero 0
      have hY : T.Y = 0 := congrFun hzero 1
      have hZ : T.Z = 0 := congrFun hzero 2
      change (⟨T.X,T.Y,T.Z⟩ : Coords F) = _
      rw [hX,hY,hZ]
    · right
      rw [mixed_vec, ← Jacobian.add_of_not_equiv heq]
      exact ⟨Jacobian.nonsingular_add hc hQ, (Jacobian.Point.toAffine_add hc hQ).trans (by rw [he])⟩

private theorem ladder_rep (a b u v : F) (hQ : (curve a b).toJacobian.Nonsingular ![u,v,1])
    (k m : ℕ) (hm : m < 2^k) :
    represents a b (ladder a b u v k m) (m • Jacobian.Point.toAffine (curve a b) ![u,v,1]) := by
  classical
  induction k generalizing m with
  | zero =>
    have hm0 : m=0 := by simpa using hm
    subst m
    right
    exact ⟨Jacobian.nonsingular_zero, by simp [ladder,Coords.vec,Jacobian.Point.toAffine_zero]⟩
  | succ k ih =>
    have hhalf : m/2 < 2^k := by rw [pow_succ] at hm; omega
    have hd := dbl_rep (ih (m/2) hhalf)
    by_cases hbit : m % 2=1
    · simp only [ladder,hbit,ite_true]
      have ha := mixed_rep hQ hd
      rwa [← add_nsmul, ← succ_nsmul, show m/2+m/2+1=m by omega] at ha
    · simp only [ladder,hbit,ite_false]
      rwa [← add_nsmul, show m/2+m/2=m by omega] at hd

end Geometry

private theorem point_card_bound (p : ℕ) [Fact p.Prime] (a b : ZMod p) :
    Nat.card (curve a b).toAffine.Point ≤ 2*p+1 := by
  classical
  let S := {z : ZMod p × ZMod p // (curve a b).toAffine.Nonsingular z.1 z.2}
  let code (z : S) := (z.val.1, decide (z.val.2.val ≤ (-z.val.2).val))
  have eqn {x y : ZMod p} (h : (curve a b).toAffine.Nonsingular x y) :
      y^2 = x^3+a*x+b := by
    simpa [Affine.equation_iff,curve] using h.1
  have inj : Function.Injective code := by
    rintro ⟨⟨x,y⟩,h⟩ ⟨⟨x',y'⟩,h'⟩ he
    have hx : x=x' := congrArg Prod.fst he
    subst x'
    have hsgn : decide (y.val ≤ (-y).val) = decide (y'.val ≤ (-y').val) :=
      congrArg Prod.snd he
    have hyy : y=y' := by
      rcases sq_eq_sq_iff_eq_or_eq_neg.mp ((eqn h).trans (eqn h').symm) with hy | hy
      · exact hy
      · change y = -y' at hy
        subst y
        simp only [neg_neg,decide_eq_decide] at hsgn
        apply ZMod.val_injective p
        omega
    subst y'
    rfl
  have hc := Fintype.card_le_of_injective code inj
  change Fintype.card S ≤ Fintype.card (ZMod p × Bool) at hc
  rw [Fintype.card_prod, ZMod.card] at hc
  change Fintype.card S ≤ p*2 at hc
  rw [Nat.card_congr (curve a b).toAffine.nonsingularPointEquiv]
  change Nat.card (Option S) ≤ _
  rw [Nat.card_eq_fintype_card, Fintype.card_option]
  omega

private def curveB {R : Type*} [CommRing R] (a u v : R) : R := v^2-u^3-a*u

def finish (n q a u v : ℕ) : Coords (ZMod n) :=
  ladder (a : ZMod n) (curveB (a : ZMod n) u v) u v (q.log2+1) q

def stepOK (n q a u v : ℕ) : Bool :=
  let res := finish n q a u v
  decide (1 < n) && decide ((2*v).Coprime n) && decide (2*n.sqrt+1 < q) &&
    (res.Z.val == 0) && decide (res.X.val.Coprime n)

/-- For every prime divisor p of n the terminal coordinates are a nonzero
point representative at infinity, hence q kills the initial affine point.
The latter is nonzero, so the prime q divides the number of smooth points. -/
theorem step_sound {n q a u v : ℕ} (hq : q.Prime) (h : stepOK n q a u v = true) :
    n.Prime := by
  classical
  simp only [stepOK,Bool.and_eq_true,decide_eq_true_eq,beq_iff_eq] at h
  obtain ⟨⟨⟨⟨hn,hyunit⟩,hsize⟩,hz⟩,hxunit⟩ := h
  by_contra hncomp
  let p := n.minFac
  have hp : p.Prime := Nat.minFac_prime (by omega : n ≠ 1)
  have hpn : p ∣ n := Nat.minFac_dvd n
  let _ : Fact p.Prime := ⟨hp⟩
  let _ : Fact q.Prime := ⟨hq⟩
  let _ : NeZero n := ⟨by omega⟩
  let f := ZMod.castHom hpn (ZMod p)
  have f_val (z : ZMod n) : f z = (z.val : ZMod p) := by
    rw [← map_natCast f z.val, ZMod.natCast_zmod_val]
  have nonzero {k : ℕ} (hk : k.Coprime n) : (k : ZMod p) ≠ 0 := by
    intro hzero
    have hd := Nat.dvd_gcd ((ZMod.natCast_eq_zero_iff k p).mp hzero) hpn
    exact hp.not_dvd_one (hk.gcd_eq_one ▸ hd)
  let A : ZMod p := a
  let U : ZMod p := u
  let V : ZMod p := v
  let B := curveB A U V
  let W := (curve A B).toJacobian
  have hQ : W.Nonsingular ![U,V,1] := by
    apply (Jacobian.nonsingular_some ..).mpr
    apply (Affine.nonsingular_iff' ..).mpr
    constructor
    · rw [Affine.equation_iff]
      dsimp [W,curve,B,curveB]
      ring
    · right
      have hne := nonzero hyunit
      simpa [W,curve,V,Nat.cast_mul] using hne
  let P := Jacobian.Point.toAffine W ![U,V,1]
  have hP : P ≠ 0 := by
    dsimp only [P]
    rw [Jacobian.Point.toAffine_some hQ]
    exact Affine.Point.some_ne_zero _
  let res := finish n q a u v
  have hf : res.map f = ladder A B U V (q.log2+1) q := by
    unfold res finish
    rw [map_ladder]
    simp [A,B,U,V,curveB]
  have hr : represents A B (res.map f) (q • P) := by
    rw [hf]
    exact ladder_rep A B U V hQ _ _ (Nat.lt_log2_self)
  have hX : f res.X ≠ 0 := (f_val _).symm ▸ nonzero hxunit
  have hZ : f res.Z = 0 := by rw [f_val]; change ((finish n q a u v).Z.val : ZMod p)=0; rw [hz]; simp
  have hzero : q • P = 0 := by
    rcases hr with dead | ⟨_, hrep⟩
    · exact (hX (congrArg Coords.X dead)).elim
    · exact hrep.symm.trans (Jacobian.Point.toAffine_of_Z_eq_zero hZ)
  let S := {z : ZMod p × ZMod p // W.toAffine.Nonsingular z.1 z.2}
  let _ : Fintype W.toAffine.Point :=
    Fintype.ofEquiv (Option S) W.toAffine.nonsingularPointEquiv.symm
  have hord : addOrderOf P = q := addOrderOf_eq_prime hzero hP
  have hle : q ≤ Fintype.card W.toAffine.Point := by
    rw [← hord]
    exact Nat.le_of_dvd Fintype.card_pos addOrderOf_dvd_card
  have hcard := point_card_bound p A B
  change Nat.card W.toAffine.Point ≤ _ at hcard
  rw [Nat.card_eq_fintype_card] at hcard
  have hmin : p ≤ n.sqrt := Nat.le_sqrt'.mpr (Nat.minFac_sq_le_self (by omega) hncomp)
  omega

end GoldbachAnchorCurve

/- The terminal Lucas helper is adapted from the Apache-2.0 Goldbach proof
Conjectures.Goldbach.FinitePostBoundaryThrough32768, revision
f5b2e7c99f3ac446c3aa3cf9d35129254d518b0b, prime_of_cert.
The ECPP data were produced using PARI/GP 2.17.4 primecert.
Each step below checks the reduced point from the corresponding certificate. -/

namespace GoldbachCutpointCertificate
set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
section

lemma prime_mem_of_dvd_prod {fs : List ℕ} {q : ℕ}
    (hfs : ∀ r ∈ fs, Nat.Prime r) (hq : Nat.Prime q) (hd : q ∣ fs.prod) : q ∈ fs := by
  induction fs with
  | nil =>
      rw [List.prod_nil] at hd
      have hle : q ≤ 1 := Nat.le_of_dvd (by norm_num) hd
      have := hq.two_le
      omega
  | cons a t ih =>
      rw [List.prod_cons] at hd
      rcases (hq.dvd_mul).mp hd with h | h
      · have hqa : q = a := (Nat.prime_dvd_prime_iff_eq hq (hfs a (List.mem_cons_self))).mp h
        subst hqa; exact List.mem_cons_self
      · exact List.mem_cons_of_mem a (ih (fun r hr => hfs r (List.mem_cons_of_mem a hr)) h)

lemma cast_powMod (p a k : ℕ) : ((Nat.powMod a k p : ℕ) : ZMod p) = (a : ZMod p)^k := by
  rw [Nat.powMod_def, ZMod.natCast_mod, Nat.cast_pow]

theorem prime_of_cert {p a : ℕ} {fs : List ℕ} (hp2 : 2 < p) (hprod : fs.prod = p - 1)
    (hfs : ∀ r ∈ fs, Nat.Prime r)
    (ha : Nat.powMod a (p - 1) p = 1 % p)
    (hd : ∀ r ∈ fs, Nat.powMod a ((p - 1) / r) p ≠ 1 % p) : Nat.Prime p := by
  have hp1 : 1 < p := by omega
  refine lucas_primality p (a : ZMod p) ?_ ?_
  · have h := congrArg (fun n : ℕ => (n : ZMod p)) ha
    rw [cast_powMod] at h
    rwa [Nat.mod_eq_of_lt hp1, Nat.cast_one] at h
  · intro q hq hqd
    have hqmem : q ∈ fs := by
      have hqt : q ∣ fs.prod := by rw [hprod]; exact hqd
      exact prime_mem_of_dvd_prod hfs hq hqt
    intro hzmod
    have hnatcast : ((Nat.powMod a ((p - 1) / q) p : ℕ) : ZMod p) = ((1 % p : ℕ) : ZMod p) := by
      rw [cast_powMod, hzmod, Nat.mod_eq_of_lt hp1, Nat.cast_one]
    have hmod : Nat.ModEq p (Nat.powMod a ((p - 1) / q) p) (1 % p) :=
      (ZMod.natCast_eq_natCast_iff _ _ _).mp hnatcast
    have hlt1 : Nat.powMod a ((p - 1) / q) p < p := by
      rw [Nat.powMod_def]; exact Nat.mod_lt _ (by omega)
    have hlt2 : 1 % p < p := Nat.mod_lt _ (by omega)
    exact hd q hqmem (Nat.ModEq.eq_of_lt_of_lt hmod hlt1 hlt2)

