     push_cast
     gcongr
     linarith
    _=_:=by rw [Real.mul_rpow (by norm_num:(0:ℝ)≤2) hN0]; dsimp [Cl]; ring
  have hp:(N:ℝ)^ε≤((N:ℝ)*D)^(2*ε):=by
   calc
    _≤((N:ℝ)*D)^ε:=Real.rpow_le_rpow hN0 hNle hε.le
    _≤_:=Real.rpow_le_rpow_of_exponent_le hND (by linarith)
