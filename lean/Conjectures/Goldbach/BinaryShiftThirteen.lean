   _≤Cl*((N:ℝ)*D)^(2*ε)*((N:ℝ)*G):=by gcongr
   _≤(Cs+Cl)*((N:ℝ)*D)^(2*ε)*((N:ℝ)*G+W):=by
    gcongr
    ·exact le_add_of_nonneg_left hCs.le
