 have hn0:(0:ℝ)≤n:=by positivity
 have hD1:(1:ℝ)≤D:=by exact_mod_cast hD
 have hd:(n.divisors.card:ℝ)^k≤(D:ℝ)*(n:ℝ):=by
  exact_mod_cast hb n (by omega)
 have a5o:(D:ℝ)≤(D:ℝ)^k:=by
  simpa only [pow_one] using pow_le_pow_right₀ hD1 (Nat.succ_le_of_lt hk)
 have hnpow:(n:ℝ)≤((n:ℝ)^ε)^k:=by
  rw [← Real.rpow_natCast,← Real.rpow_mul hn0]
  simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hn1 hkε
