theorem k6 (q ell L:ℕ) [NeZero q] (b:ℚ)
  (hell:0<ell) (hb0:0≤b) (hperiod:(2:ZMod q)^ell=1)
  (hb:∀a:ZMod q,b≤aE q ell 13 a)
  (hL:10000*ell≤L) (a:ZMod q):
  b/(ell:ℚ)^13*((9999/10000:ℚ)*L)^13≤aE q L 13 a:=by
 have he:(0:ℚ)<ell:=by exact_mod_cast hell
 have hfloor:(L:ℚ)<((L/ell:ℕ):ℚ)*ell+ell:=by
  exact_mod_cast (Nat.lt_div_mul_add (a:=L) hell)
 have hlarge:(10000:ℚ)*ell≤L:=by exact_mod_cast hL
 have hnear:(9999/10000:ℚ)*L≤((L/ell:ℕ):ℚ)*ell:=by
  linarith
 have hdiv:((9999/10000:ℚ)*L)/ell≤((L/ell:ℕ):ℚ):=
  (div_le_iff₀ he).mpr hnear
 have hp:=pow_le_pow_left₀
  (div_nonneg (mul_nonneg (by norm_num:(0:ℚ)≤9999/10000)
   (Nat.cast_nonneg L)) he.le) hdiv 13
 have hm:=aU6 q (Nat.div_mul_le_self L ell) 13 a
 rw [aD4 q ell (L/ell) 13 a hperiod] at hm
 calc
  _=b*(((9999/10000:ℚ)*L)/ell)^13:=by rw [div_pow]; ring
  _≤b*((L/ell:ℕ):ℚ)^13:=mul_le_mul_of_nonneg_left hp hb0
  _=((L/ell:ℕ):ℚ)^13*b:=by ring
  _≤((L/ell:ℕ):ℚ)^13*aE q ell 13 a:=
   mul_le_mul_of_nonneg_left (hb a) (by positivity)
  _≤aE q L 13 a:=hm
end
