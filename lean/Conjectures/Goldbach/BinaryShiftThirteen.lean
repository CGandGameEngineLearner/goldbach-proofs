  _=fO*(X/P^(1/2:ℝ))^(θ-1/2):=by rw [mul_assoc,he]
  _≤fO*(2*P^(1/2+δ)/P^(1/2:ℝ))^(1/2:ℝ):=
   mul_le_mul_of_nonneg_left hr yI.le
  _=_:=by
   rw [GZ P 2 (1/2+δ) (1/2) (1/2) hPpos (by norm_num)]
   rw [show (1/2+δ-1/2)*(1/2)=δ/2 by ring]
   ring
end
