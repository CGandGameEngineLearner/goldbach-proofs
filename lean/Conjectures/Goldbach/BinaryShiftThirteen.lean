namespace aZ
open Finset
open scoped BigOperators
lemma azc {ι:Type*} (s:Finset ι) (a:ι→ℂ):
  ‖∑i∈s,a i‖^2≤(s.card:ℝ)*∑i∈s, ‖a i‖^2:=by
 have hc:=Finset.sum_mul_sq_le_sq_mul_sq s (fun _=>(1:ℝ)) (fun i=> ‖a i‖)
 simp only [one_mul,one_pow,sum_const,nsmul_eq_mul,mul_one] at hc
 exact (pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le s a) 2).trans hc
theorem aXw {ι κ:Type*} [DecidableEq κ]
  (s:Finset ι) (t:Finset κ) (f:ι→κ) (a:ι→ℂ) (D:ℝ)
  (hf:∀i∈s,f i∈t)
  (hD:∀j∈t,((s.filter (fun i=>f i=j)).card:ℝ)≤D):
  (∑j∈t, ‖∑i∈s.filter (fun i=>f i=j),a i‖^2)≤
   D*∑i∈s, ‖a i‖^2:=by
 calc
  _≤∑j∈t,D*∑i∈s.filter (fun i=>f i=j), ‖a i‖^2:=by
   apply sum_le_sum
   intro j hj
   exact (azc _ _).trans
    (mul_le_mul_of_nonneg_right (hD j hj) (sum_nonneg (fun _ _=>sq_nonneg _)))
  _=D*∑j∈t,∑i∈s.filter (fun i=>f i=j), ‖a i‖^2:=by rw [mul_sum]
  _=_:=by rw [sum_fiberwise_of_maps_to hf]
theorem ahY (A B S:Finset ℕ) (a b:ℕ→ℂ) (D:ℝ)
  (hS:∀n∈A,∀m∈B,n*m∈S)
  (hD:∀r∈S,
   (((A ×ˢ B).filter (fun nm=>nm.1*nm.2=r)).card:ℝ)≤D):
  (∑r∈S,
   ‖∑nm∈(A ×ˢ B).filter (fun nm=>nm.1*nm.2=r),a nm.1*b nm.2‖^2)≤
   D*(∑n∈A, ‖a n‖^2)*(∑m∈B, ‖b m‖^2):=by
 have h:=aXw (A ×ˢ B) S (fun nm=>nm.1*nm.2)
  (fun nm=>a nm.1*b nm.2) D
  (by intro nm hnm; exact hS _ (mem_product.mp hnm).1 _ (mem_product.mp hnm).2) hD
 simp only [norm_mul,mul_pow] at h
 rw [sum_product] at h
 simp_rw [← mul_sum] at h
 rw [← sum_mul] at h
 simpa only [mul_assoc] using h
noncomputable def xO (A B:Finset ℕ) (a b:ℕ→ℂ) (r:ℕ):ℂ:=
 ∑nm∈(A ×ˢ B).filter (fun nm=>nm.1*nm.2=r),a nm.1*b nm.2
noncomputable def aP {q:ℕ} (χ:DirichletCharacter ℂ q)
  (A:Finset ℕ) (a:ℕ→ℂ) (s:ℂ):ℂ:=
 ∑n∈A,a n*χ (n:ZMod q)*(n:ℂ)^(-s)
theorem VJ {q:ℕ} (χ:DirichletCharacter ℂ q)
  (A B S:Finset ℕ) (a b:ℕ→ℂ) (s:ℂ)
  (hS:∀n∈A,∀m∈B,n*m∈S):
  aP χ A a s*aP χ B b s=
   aP χ S (xO A B a b) s:=by
 have hp (n m:ℕ):
   a n*χ (n:ZMod q)*(n:ℂ)^(-s)*
    (b m*χ (m:ZMod q)*(m:ℂ)^(-s))=
   a n*b m*χ ((n*m:ℕ):ZMod q)*((n*m:ℕ):ℂ)^(-s):=by
  rw [Nat.cast_mul,map_mul,Nat.cast_mul,Complex.natCast_mul_natCast_cpow]
  ring
 have hm:∀nm∈A ×ˢ B,nm.1*nm.2∈S:=by
  intro nm hnm
  exact hS _ (mem_product.mp hnm).1 _ (mem_product.mp hnm).2
 unfold aP
 rw [sum_mul]
 simp_rw [mul_sum]
 simp_rw [hp]
 change (∑n∈A,∑m∈B,
  (fun nm:ℕ × ℕ=>a nm.1*b nm.2*χ ((nm.1*nm.2:ℕ):ZMod q)*
   ((nm.1*nm.2:ℕ):ℂ)^(-s)) (n,m))=_
 rw [← sum_product A B (fun nm:ℕ × ℕ=>a nm.1*b nm.2*
  χ ((nm.1*nm.2:ℕ):ZMod q)*((nm.1*nm.2:ℕ):ℂ)^(-s))]
 rw [← sum_fiberwise_of_maps_to hm]
 apply sum_congr rfl
 intro r hr
 unfold xO
 rw [sum_mul,sum_mul]
 apply sum_congr rfl
 intro nm hnm
 rw [(mem_filter.mp hnm).2]
end aZ
end

