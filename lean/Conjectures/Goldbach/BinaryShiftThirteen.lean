  apply mul_le_mul_of_nonneg_right _ (Real.exp_nonneg _)
  rw [Ny,← Nh χ K X hX]
  have hlow:=ail χ K X hKX hX θ v hθhalf s hs0
  apply (norm_add_le _ _).trans
