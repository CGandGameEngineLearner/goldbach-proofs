  _≤2* ‖1/log (n:ℝ)‖ :=by
   rw [Real.norm_eq_abs,abs_of_pos (one_div_pos.mpr hlog0)]
   simpa [div_eq_mul_inv] using mul_le_mul_of_nonneg_left hinv (by norm_num:(0:ℝ)≤2)
