 change χ (x:ZMod (2*m))=1
 rcases hxval with hxval | hxval
 ·have hxone:(x:ZMod (2*m))=1:=by
   rw [← ZMod.natCast_zmod_val (x:ZMod (2*m)),hxval,Nat.cast_one]
