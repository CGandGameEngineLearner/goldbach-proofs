private theorem romanovReindex (M : ℕ) (hM : 0 < M) :
    DX M = ∑ d ∈ Finset.Icc 1 (M - 1), aF d *
      (∑ k ∈ Finset.Icc 1 ((M - 1) / d), (ArithmeticFunction.moebius k : ℝ) *
        (1 / ((d * k : ℕ) : ℝ) - 1 / (M : ℝ))) := by
  calc
    DX M = ∑ x ∈ (range M).sigma (fun m => m.divisors),
        (ArithmeticFunction.moebius (x.1 / x.2) : ℝ) * aF x.2 *
          (1 / (x.1 : ℝ) - 1 / (M : ℝ)) := by
      rw [DX, sum_sigma]
      apply sum_congr rfl
      intro m _
      rw [aD, sum_mul]
    _ = ∑ x ∈ (Icc 1 (M - 1)).sigma (fun d => Icc 1 ((M - 1) / d)),
        (ArithmeticFunction.moebius x.2 : ℝ) * aF x.1 *
          (1 / ((x.1 * x.2 : ℕ) : ℝ) - 1 / (M : ℝ)) := by
      refine sum_nbij' (fun x => ⟨x.2, x.1 / x.2⟩) (fun x => ⟨x.1 * x.2, x.1⟩)
        ?_ ?_ ?_ ?_ ?_
      · intro x hx
        obtain ⟨hrange, hdivisor⟩ := mem_sigma.mp hx
        obtain ⟨hdvd, hx0⟩ := Nat.mem_divisors.mp hdivisor
        have hm : x.1 ≤ M - 1 := by have := mem_range.mp hrange; omega
        have hpos := Nat.pos_of_dvd_of_pos hdvd (Nat.pos_of_ne_zero hx0)
        have hle := Nat.le_of_dvd (Nat.pos_of_ne_zero hx0) hdvd
        refine mem_sigma.mpr ⟨mem_Icc.mpr ⟨hpos, hle.trans hm⟩,
          mem_Icc.mpr ⟨Nat.div_pos hle hpos, (Nat.le_div_iff_mul_le hpos).mpr ?_⟩⟩
        rwa [Nat.div_mul_cancel hdvd]
      · intro x hx
        obtain ⟨hd, hk⟩ := mem_sigma.mp hx
        have hpos : 0 < x.1 := (mem_Icc.mp hd).1
        have hkpos : 0 < x.2 := (mem_Icc.mp hk).1
        have hle := (Nat.le_div_iff_mul_le hpos).mp (mem_Icc.mp hk).2
        have hprod : x.1 * x.2 ≤ M - 1 := by simpa [Nat.mul_comm] using hle
        have hm : x.1 * x.2 < M := by omega
        refine mem_sigma.mpr ⟨mem_range.mpr hm, Nat.mem_divisors.mpr
          ⟨Nat.dvd_mul_right _ _, (Nat.mul_pos hpos hkpos).ne'⟩⟩
      · intro x hx
        have hdvd := (Nat.mem_divisors.mp (mem_sigma.mp hx).2).1
        change (⟨x.2 * (x.1 / x.2), x.2⟩ : Σ _ : ℕ, ℕ) = x
        rw [Nat.mul_div_cancel' hdvd]
      · intro x hx
        have hpos : 0 < x.1 := (mem_Icc.mp (mem_sigma.mp hx).1).1
        change (⟨x.1, x.1 * x.2 / x.1⟩ : Σ _ : ℕ, ℕ) = x
        rw [Nat.mul_div_cancel_left _ hpos]
      · intro x hx
        have hdvd := (Nat.mem_divisors.mp (mem_sigma.mp hx).2).1
        simp only [Nat.mul_div_cancel' hdvd]
    _ = _ := by
      rw [sum_sigma]
      apply sum_congr rfl
      intro d _
      rw [mul_sum]
      apply sum_congr rfl
      intro k _
      ac_rfl

