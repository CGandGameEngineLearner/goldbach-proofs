theorem ajr {ε U:ℝ} (hε:0<ε) (hU:0<U)
  (S:Finset (ℕ × ℕ)) (hpos:∀x∈S,0<x.1∧0<x.2)
  (hprod:∀x∈S,((x.1*x.2:ℕ):ℝ)≤U):
  ∑x∈S,((x.1*x.2:ℕ):ℝ)^(ε-1)≤
   (mL ε)^2*U^(2*ε):=by
