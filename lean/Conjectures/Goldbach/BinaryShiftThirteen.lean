    (mertensSecondConstant+nJ)=
   -(primeReciprocalSum n-
     (log (log (n:ℝ))+mertensSecondConstant))+
    (nJ-vO n):=by
 have h:=arw n
 linarith
theorem auW:
  (fun n:ℕ=>log (primeProduct n)+log (log (n:ℝ))+
   (mertensSecondConstant+nJ)) =O[atTop]
   fun n=>1/log (n:ℝ):=by
