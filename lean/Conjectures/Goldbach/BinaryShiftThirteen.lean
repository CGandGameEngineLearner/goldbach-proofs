namespace aZ
open Complex Finset OAI.Ostmann
open scoped BigOperators
theorem Ci {q:ℕ} (χ:DirichletCharacter ℂ q)
  (A:Finset ℕ) (a:ℕ→ℂ) (hA:∀n∈A,0<n) (t:ℝ):
  aP χ A a ((2*Real.pi*t:ℝ)*I)=
   OAI.Ostmann.V3 A a χ t:=by
 unfold aP OAI.Ostmann.V3 OAI.Ostmann.Vv
 apply sum_congr rfl
 intro n hn
 have hnp:(0:ℝ)<n:=Nat.cast_pos.mpr (hA n hn)
 rw [Complex.cpow_def_of_ne_zero (by exact_mod_cast (hA n hn).ne'),
  ← Complex.ofReal_natCast,← Complex.ofReal_log hnp.le]
 congr 2
 push_cast
 ring
theorem Xt:
  ∃C:ℝ,0<C∧∀K Q:ℕ,1≤Q→∀T:ℝ,1≤T→
   ∀A B:Finset ℕ,∀a b:ℕ→ℂ,∀D:ℝ,
   (∀n∈A,∀m∈B,n*m∈Finset.Icc 1 K)→
   (∀r∈Finset.Icc 1 K,
    (((A ×ˢ B).filter (fun nm=>nm.1*nm.2=r)).card:ℝ)≤D)→
   ∀{ι:Type} (R:Finset ι) (c:ι→PrimitiveComplexCharacter) (t:ι→ℝ),
   (∀i∈R,(c i).modulus≤Q)→
   (∀i∈R, |t i| ≤T)→
   (∀i∈R,∀j∈R,c i=c j→i≠j→1≤ |t i-t j|)→
   (∑i∈R,
    ‖aP (c i).character A a ((2*Real.pi*t i:ℝ)*I)*
     aP (c i).character B b ((2*Real.pi*t i:ℝ)*I)‖ ^2)≤
   C*((K:ℝ)+(Q:ℝ)^2*(T+1))*
    (2+64*(Real.log (K+1:ℕ))^2)*D*
     (∑n∈A, ‖a n‖ ^2)*(∑m∈B, ‖b m‖ ^2):=by
 obtain ⟨C,hC,hmean⟩:=OAI.Ostmann.V109
 refine ⟨C,hC,?_⟩
 intro K Q hQ T hT A B a b D hS hD ι R c t hc ht hsep
 have he (i:ι):
   aP (c i).character A a ((2*Real.pi*t i:ℝ)*I)*
    aP (c i).character B b ((2*Real.pi*t i:ℝ)*I)=
   OAI.Ostmann.V3 (Finset.Icc 1 K) (xO A B a b) (c i).character (t i):=by
  rw [VJ _ A B (Finset.Icc 1 K) a b _ hS]
  exact Ci _ _ _
   (fun n hn=>(Finset.mem_Icc.mp hn).1) _
 simp_rw [he]
 have hm:=hmean K Q hQ T hT (xO A B a b) R c t hc ht hsep
 have hp:=ahY A B (Finset.Icc 1 K) a b D hS hD
 have hnonneg:0≤C*((K:ℝ)+(Q:ℝ)^2*(T+1))*
   (2+64*(Real.log (K+1:ℕ))^2):=by positivity
 apply hm.trans
 have hh:=mul_le_mul_of_nonneg_left hp hnonneg
 simpa only [xO,mul_assoc] using hh
end aZ
end

