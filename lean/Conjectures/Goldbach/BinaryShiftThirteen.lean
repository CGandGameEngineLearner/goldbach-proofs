   rw [Finset.prod_mul_distrib,← Nat.prod_primeFactors_pow_factorization hn]
  _≤_:=Nat.mul_le_mul_right n hcost
theorem KR (ε:ℝ) (hε:0<ε):
  ∃C:ℝ,1≤C∧∀n:ℕ,1≤n→(n.divisors.card:ℝ)≤C*(n:ℝ)^ε:=by
