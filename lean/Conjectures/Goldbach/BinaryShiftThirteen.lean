  _=2/(x:ℝ):=by
   dsimp [f]
   rw [integral_const_mul,integral_Ioi_rpow_of_lt (by norm_num) hxR]
   rw [show (-2:ℝ)+1=-1 by norm_num,
    Real.rpow_neg (le_of_lt hxR)]
   field_simp
   simp
