namespace aZ
open Complex DirichletCharacter
open scoped ComplexConjugate BigOperators Classical
variable {q:ℕ} [NeZero q]
theorem U6 (χ:DirichletCharacter ℂ q) (s:ℂ):
  gammaFactor χ⁻¹ (conj s)=conj (gammaFactor χ s):=by
 have hi:(χ⁻¹).Even↔χ.Even:=by
  change (χ⁻¹) (-1)=1↔χ (-1)=1
  rw [← MulChar.star_eq_inv,MulChar.star_apply,RCLike.star_def]
  constructor
  ·intro h
   simpa using congrArg conj h
  ·intro h
   rw [h,map_one]
 by_cases he:χ.Even
 ·simp only [gammaFactor,he,hi.mpr he,ite_true,Complex.Gammaℝ_conj]
 ·have hie:¬(χ⁻¹).Even:=fun h=>he (hi.mp h)
  simpa only [gammaFactor,he,hie,ite_false,map_add,map_one] using
   Complex.Gammaℝ_conj (s+1)
theorem Fe (χ:DirichletCharacter ℂ q) (s:ℂ)
  (hs:0< s.re):gammaFactor χ s≠0:=by
 classical
 unfold gammaFactor
 split_ifs
 ·exact Complex.Gammaℝ_ne_zero_of_re_pos hs
 ·apply Complex.Gammaℝ_ne_zero_of_re_pos
  simp only [add_re,one_re]
  linarith
noncomputable def i7 (χ:DirichletCharacter ℂ q) (s:ℂ):ℂ:=
 (q:ℂ)^(1/2-s)*rootNumber χ*gammaFactor χ⁻¹ (1-s)/
  gammaFactor χ s
theorem JR (χ:DirichletCharacter ℂ q) (hχ:χ.IsPrimitive)
  (s:ℂ) (hs:s.re<1) (hs0:s≠0):
  LFunction χ s=i7 χ s*LFunction χ⁻¹ (1-s):=by
 have hr:0<(1-s).re:=by simp; linarith
 have hg:=Fe χ⁻¹ (1-s) hr
 have harg:1-(1-s)=s:=by ring
 have hexp:(1-s)-1/2=1/2-s:=by ring
 have hfun:=hχ.completedLFunction_one_sub (1-s)
 rw [harg,hexp] at hfun
 rw [LFunction_eq_completed_div_gammaFactor χ s (Or.inl hs0),hfun,
  LFunction_eq_completed_div_gammaFactor χ⁻¹ (1-s) (Or.inl (by
   intro h
   simp [h] at hr))]
 unfold i7
 field_simp
theorem agt (χ:DirichletCharacter ℂ q)
  (hχ:χ.IsPrimitive) (s:ℂ) (hs:s.re=1/2):
  ‖i7 χ s‖ =1:=by
 have he:1-s=conj s:=by
  apply Complex.ext <;> simp [hs] <;> ring
 have hq:(0:ℝ)<q:=Nat.cast_pos.mpr (NeZero.pos q)
 have hp: ‖(q:ℂ)^(1/2-s)‖ =1:=by
  rw [← Complex.ofReal_natCast,Complex.norm_cpow_eq_rpow_re_of_pos hq]
  norm_num [hs]
 unfold i7
 rw [norm_div,norm_mul,norm_mul,hp,DirichletCharacter.norm_rootNumber hχ,
  one_mul,one_mul,he,U6,norm_conj]
 exact div_self (norm_ne_zero_iff.mpr (Fe χ s (by linarith)))
theorem Xq (χ:DirichletCharacter ℂ q) (s:ℂ)
  (hs:s≠0) (hs1:s+1≠0):
  gammaFactor χ (s+2)=
   gammaFactor χ s*(s+if χ.Even then 0 else 1)/2/(Real.pi:ℂ):=by
 classical
 by_cases he:χ.Even
 ·simpa [gammaFactor,he] using Complex.Gammaℝ_add_two hs
 ·simpa [gammaFactor,he,show s+2+1=s+1+2 by ring] using
   Complex.Gammaℝ_add_two hs1
theorem aBh (χ:DirichletCharacter ℂ q) (s:ℂ)
  (hs:s.re=-(1/2)):gammaFactor χ s≠0:=by
 have hs0:s≠0:=by intro h; simp [h] at hs
 have hs1:s+1≠0:=by
  intro h
  have hr:=congrArg Complex.re h
  norm_num [hs] at hr
 have hg:=Fe χ (s+2) (by norm_num [hs])
 rw [Xq χ s hs0 hs1] at hg
 intro h
 simp [h] at hg
theorem ag6 (χ:DirichletCharacter ℂ q)
  (hχ:χ.IsPrimitive) (s:ℂ) (hs:s.re=-(1/2)):
  ‖i7 χ s‖ =(q:ℝ)* ‖s‖ /(2*Real.pi):=by
 classical
 have he:1-s=conj (s+2):=by
  apply Complex.ext <;> simp [hs] <;> ring
 have hs0:s≠0:=by intro h; simp [h] at hs
 have hs1:s+1≠0:=by
  intro h
  have hr:=congrArg Complex.re h
  norm_num [hs] at hr
 have hn: ‖s+if χ.Even then 0 else 1‖ = ‖s‖ :=by
  split_ifs
  ·simp
  ·apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
   simp only [← Complex.normSq_eq_norm_sq,Complex.normSq_apply,
    (add_re),add_im,one_re,one_im,add_zero,hs]
   ring
 have hq:(0:ℝ)<q:=Nat.cast_pos.mpr (NeZero.pos q)
 have hp: ‖(q:ℂ)^(1/2-s)‖ =(q:ℝ):=by
  rw [← Complex.ofReal_natCast,Complex.norm_cpow_eq_rpow_re_of_pos hq]
  norm_num [hs]
 unfold i7
 rw [norm_div,norm_mul,norm_mul,hp,DirichletCharacter.norm_rootNumber hχ,
  mul_one,he,U6,norm_conj,
  Xq χ s hs0 hs1,norm_div,norm_div,norm_mul,hn]
 have hgn:=norm_ne_zero_iff.mpr (aBh χ s hs)
 simp only [Complex.norm_ofNat,Complex.norm_real,Real.norm_eq_abs,
  abs_of_pos Real.pi_pos]
 field_simp
theorem auj (χ:DirichletCharacter ℂ q)
  (hχ:χ.IsPrimitive) (s:ℂ) (hs:s.re=-(1/2)):
  ‖i7 χ s‖ ≤(q:ℝ)*(1+ |s.im|):=by
 rw [ag6 χ hχ s hs]
 have hn: ‖s‖ ≤1+ |s.im| :=by
  calc
   _≤ |s.re| + |s.im| :=Complex.norm_le_abs_re_add_abs_im s
   _≤_:=by norm_num [hs]
 have hden:1≤2*Real.pi:=by linarith [Real.pi_gt_three]
 exact (div_le_self (by positivity) hden).trans
  (mul_le_mul_of_nonneg_left hn (Nat.cast_nonneg q))
theorem axE (r:ℝ) (z:ℂ)
  (hr:1≤r) (hz: ‖z‖ ≤1):
  ‖1-(r:ℂ)*z‖ ≤ ‖(r:ℂ)-z‖ :=by
 apply (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
 have a8k: ‖z‖ ^2≤1:=by nlinarith [norm_nonneg z]
 have hp:=mul_nonneg (show 0≤r^2-1 by nlinarith)
  (show 0≤1- ‖z‖ ^2 by linarith)
 simp only [← Complex.normSq_eq_norm_sq,Complex.normSq_apply] at hp ⊢
 simp only [sub_re,sub_im,one_re,one_im,mul_re,mul_im,ofReal_re,
  ofReal_im,zero_mul,mul_zero,sub_zero,add_zero]
 nlinarith
theorem awc (r:ℝ) (z:ℂ)
  (hr:1≤r) (hz: ‖z‖ ≤1):
  ‖(1-(r:ℂ)*z)/(1-conj z/(r:ℂ))‖ ≤r:=by
 have hr0:r≠0:=by linarith
 have hrc:(r:ℂ)≠0:=Complex.ofReal_ne_zero.mpr hr0
 have he: ‖1-conj z/(r:ℂ)‖ = ‖1-z/(r:ℂ)‖ :=by
  rw [← norm_conj (1-z/(r:ℂ))]
  simp
 have hm:(r:ℂ)-z=(r:ℂ)*(1-z/(r:ℂ)):=by
  field_simp
 rw [norm_div,he]
 have h:=axE r z hr hz
 rw [hm,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (by linarith:0<r)] at h
 by_cases hd: ‖1-z/(r:ℂ)‖ =0
 ·simp [hd]; linarith
 ·exact (div_le_iff₀ (lt_of_le_of_ne (norm_nonneg _) (Ne.symm hd))).mpr h
theorem axb (z:ℂ) (hz: ‖z‖ <1):
  ‖(1-z)/(1-conj z)‖ =1:=by
 have hn:1-z≠0:=by
  intro h
  have he:z=1:=(sub_eq_zero.mp h).symm
  simpa [he] using hz
 have he: ‖1-conj z‖ = ‖1-z‖ :=by
  simpa only [map_sub,map_one] using norm_conj (1-z)
 rw [norm_div,he]
 exact div_self (norm_ne_zero_iff.mpr hn)
end aZ
