private theorem ai0:Summable (fun p:ℕ=>2/(p:ℝ)^2):=by
 simpa [div_eq_mul_inv] using
  ((Real.summable_one_div_nat_pow (p:=2)).2 (by norm_num:(1:ℕ)<2)).mul_left 2
