  _≤∑x∈S,U^(2*ε)*
    ((x.1:ℝ)^(-1-ε)*(x.2:ℝ)^(-1-ε)):=by
   apply sum_le_sum
   intro x hx
   obtain ⟨ha,hb⟩:=hpos x hx
   have hab:(0:ℝ)<(x.1*x.2:ℕ):=by exact_mod_cast Nat.mul_pos ha hb
   have he:ε-1=2*ε+(-1-ε):=by ring
   rw [he,rpow_add hab]
   have hpow:=rpow_le_rpow hab.le (hprod x hx) (by positivity:0≤2*ε)
   have hm:(((x.1*x.2:ℕ):ℝ)^(-1-ε))=
     (x.1:ℝ)^(-1-ε)*(x.2:ℝ)^(-1-ε):=by
    rw [Nat.cast_mul,mul_rpow (Nat.cast_nonneg _) (Nat.cast_nonneg _)]
