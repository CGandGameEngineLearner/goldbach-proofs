theorem agn (χ:DirichletCharacter ℂ q) (hdiv:q∣Q)
  (hprimes:∀p∈Q.primeFactors,p∣q) (s:ℂ) (hs:s≠1):
  LFunction (changeLevel hdiv χ) s=LFunction χ s:=by
 rw [LFunction_changeLevel hdiv χ (Or.inr hs)]
 have he:(∏p∈Q.primeFactors,(1-χ (p:ZMod q)*(p:ℂ)^(-s)))=1:=by
  apply prod_eq_one
  intro p hp
  have hprime:=Nat.prime_of_mem_primeFactors hp
  have hz:χ (p:ZMod q)=0:=by
   apply MulChar.map_nonunit
   intro hu
   exact (hprime.coprime_iff_not_dvd.mp ((ZMod.isUnit_iff_coprime p q).mp hu)) (hprimes p hp)
  simp only [hz,zero_mul,sub_zero]
 rw [he,mul_one]
theorem ash (χ:DirichletCharacter ℂ q)
  (hdiv:q∣Q) (hprimes:∀p∈Q.primeFactors,p∣q)
  (s:ℂ) (hs:s.re=-(1/2:ℝ)):
  m9 (changeLevel hdiv χ) s=m9 χ s:=by
 have hs1:s≠1:=by intro h; norm_num [h] at hs
 have hs0:s≠0:=by intro h; norm_num [h] at hs
 have hleft:s.re<1:=by rw [hs]; norm_num
 have ht1:1-s≠1:=by
  intro h
  have hr:=congrArg Complex.re h
  simp only [sub_re,one_re,hs] at hr
  norm_num at hr
 have ht:1≤(1-s).re:=by simp only [sub_re,one_re,hs]; norm_num
 have hnonzero:LFunction χ⁻¹ (1-s)≠0:=
  LFunction_ne_zero_of_one_le_re χ⁻¹ (Or.inr ht1) ht
 have hl:=Yf (changeLevel hdiv χ) s hleft hs0
 have hr:=Yf χ s hleft hs0
 rw [agn χ hdiv hprimes s hs1,
  ← map_inv (changeLevel hdiv) χ,
  agn χ⁻¹ hdiv hprimes (1-s) ht1] at hl
 exact (mul_right_cancel₀ hnonzero) (hl.symm.trans hr)
theorem axR (χ ψ:DirichletCharacter ℂ q):
  dN χ ψ=changeLevel (Nat.dvd_mul_right q q) (χ*ψ⁻¹):=by
 unfold dN
 rw [map_mul,map_inv]
theorem atx (χ ψ:DirichletCharacter ℂ q)
  (s:ℂ) (hs:s.re=-(1/2:ℝ)):
  ‖m9 (dN χ ψ) s‖ ≤(q:ℝ)* ‖s‖ /(2*Real.pi):=by
 have hp:∀p∈(q*q).primeFactors,p∣q:=by
  intro p hp
  have hprime:=Nat.prime_of_mem_primeFactors hp
  exact (hprime.dvd_mul.mp (Nat.dvd_of_mem_primeFactors hp)).elim id id
 rw [axR,
  ash (χ*ψ⁻¹) (Nat.dvd_mul_right q q) hp s hs]
