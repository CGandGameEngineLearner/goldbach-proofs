theorem au8 (w:ℕ→ℝ) (M:ℕ):
  tj w M=
   ∑k∈range M,w (k+1)*(1/((k:ℝ)+1)-1/(M:ℝ)):=by
 unfold tj m6 nY
 simp_rw [mul_sub,mul_one_div]
 rw [sum_sub_distrib]
 simp only [div_eq_mul_inv,sum_mul]
theorem agC (M:ℕ):
  tj aD M=DX M:=by
 rw [au8]
 let g:ℕ→ℝ:=fun k=>aD k*(1/(k:ℝ)-1/(M:ℝ))
 have hzero:g 0=0:=by simp [g,Ph]
 have hend:g M=0:=by simp [g]
 have h:=sum_range_succ' g M
 rw [sum_range_succ,hzero,hend,add_zero,add_zero] at h
 change _=∑k∈range M,g k
 rw [h]
 apply sum_congr rfl
 intro k hk
 simp [g]
theorem W2 {w:ℕ→ℝ} (hw:∀k,0≤w k):
  Monotone (m6 w):=by
 intro M N hMN
 exact sum_le_sum_of_subset_of_nonneg (range_mono hMN)
  (fun k _ _=>div_nonneg (hw _) (by positivity))
theorem asd
  (hpos:∀m,0≤aD m)
  (pJ:∀N:ℕ,100≤N→
   nY aD N≤(24/5:ℝ)*Real.log N)
  (N:ℕ):m6 aD N<43/20:=by
 have hlarge (L:ℕ) (hL:100≤L):
   m6 aD L<43/20:=by
  have h:=agu aD (24/5) (by norm_num)
   100 (by norm_num) pJ L hL
  rw [agC] at h
  exact h.trans_lt aud
 by_cases hn:100≤N
 ·exact hlarge N hn
 ·exact (W2 hpos (le_of_not_ge hn)).trans_lt (hlarge 100 le_rfl)
theorem aiY (w:ℕ→ℝ) (N:ℕ):
  m6 w N=∑d∈Icc 1 N,w d/(d:ℝ):=by
 rw [← Ico_add_one_right_eq_Icc,sum_Ico_eq_sum_range]
 simp [m6,Nat.add_comm]
theorem aow (L d:ℕ):
  ((Icc 1 L).filter (fun n=>d∣n)).card=L/d:=by
 rw [← Nat.card_multiples' L d]
 congr 1
 ext n
 simp only [mem_filter,mem_range,mem_Icc]
 omega
theorem aMI (a:ℕ→ℝ) (L:ℕ):
  (∑n∈Icc 1 L,∑d∈n.divisors,a d)=
   ∑d∈Icc 1 L,((L/d:ℕ):ℝ)*a d:=by
 classical
 have row (n:ℕ) (hn:n∈Icc 1 L):
   (∑d∈n.divisors,a d)=∑d∈Icc 1 L,if d∣n then a d else 0:=by
  rw [← sum_filter]
  congr 1
  ext d
  rw [mem_filter,Nat.mem_divisors,mem_Icc]
  obtain ⟨hn1,hnL⟩:=mem_Icc.mp hn
  constructor
  ·rintro ⟨hdn,hn0⟩
   exact ⟨⟨Nat.pos_of_dvd_of_pos hdn hn1,(Nat.le_of_dvd hn1 hdn).trans hnL⟩,hdn⟩
  ·rintro ⟨_,hdn⟩
   exact ⟨hdn,by omega⟩
 rw [sum_congr rfl row,sum_comm]
 apply sum_congr rfl
 intro d hd
 rw [← sum_filter,sum_const,nsmul_eq_mul,aow]
theorem aHD (a:ℕ→ℝ) (ha:∀d,0≤a d) (L:ℕ):
  (∑n∈Icc 1 L,∑d∈n.divisors,a d)≤
   (L:ℝ)*m6 a L:=by
 rw [aMI,aiY,mul_sum]
 apply sum_le_sum
 intro d hd
 have h:((L/d:ℕ):ℝ)≤(L:ℝ)/(d:ℝ):=Nat.cast_div_le
 calc
  _≤((L:ℝ)/(d:ℝ))*a d:=mul_le_mul_of_nonneg_right h (ha d)
  _=_:=by ring
end
end
end Goldbach.eW
