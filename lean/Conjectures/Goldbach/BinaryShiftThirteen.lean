private theorem residueLowerFromClasses {q ell classes : ℕ} [NeZero q]
    (orbit : Fin ell → ZMod q) (category : ZMod q → Fin classes)
    (matrix : Fin classes → Fin classes → ℕ) (rows : Fin 14 → Fin classes → ℕ)
    (hpow : ∀ j : Fin ell, orbit j = (2 : ZMod q) ^ (j.val + 1))
    (transition : ∀ (a : ZMod q) (c : Fin classes),
      (∑ j : Fin ell, if category (a - orbit j) = c then (1 : ℕ) else 0) =
        matrix (category a) c)
    (hzero : ∀ a : ZMod q, rows 0 (category a) = if a = 0 then 1 else 0)
    (hstep : ∀ (k : Fin 13) (c : Fin classes),
      rows k.succ c = ∑ d : Fin classes, matrix c d * rows k.castSucc d)
    {lower : ℕ} (hmin : ∀ c : Fin classes, lower ≤ rows 13 c) (a : ZMod q) :
    (lower : ℚ) ≤ aE q ell 13 a := by
  have count (k : ℕ) (hk : k ≤ 13) (a : ZMod q) :
      aE q ell k a = (rows ⟨k, by omega⟩ (category a) : ℚ) := by
    induction k generalizing a with
    | zero =>
      change (if a = 0 then (1 : ℚ) else 0) = (rows 0 (category a) : ℚ)
      rw [hzero, Nat.cast_ite, Nat.cast_one, Nat.cast_zero]
    | succ k ih =>
      have prev (x : ZMod q) := ih (by omega) x
      rw [aE]
      simp_rw [← hpow, prev]
      have hrow := congrArg (fun n : ℕ => (n : ℚ))
        (hstep ⟨k, by omega⟩ (category a))
      push_cast at hrow
      exact (sumByResidueClass orbit category matrix transition a
        (fun c => (rows ⟨k, by omega⟩ c : ℚ))).trans hrow.symm
  rw [count 13 (by omega) a]
  exact_mod_cast hmin (category a)

