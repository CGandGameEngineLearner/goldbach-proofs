-- The factor list is executable and gives a Möbius value without proving each entry separately.
private def romanovMobius (k : ℕ) : ℤ :=
  if k = 0 then 0
  else if k.primeFactorsList.Nodup then (-1) ^ k.primeFactorsList.length else 0

private theorem romanovMobius_eq (k : ℕ) : romanovMobius k = ArithmeticFunction.moebius k := by
  by_cases hzero : k = 0
  · subst k
    simp [romanovMobius]
  · have hn := Nat.squarefree_iff_nodup_primeFactorsList hzero
    by_cases h : Squarefree k
    · simp [romanovMobius, hzero, hn.mp h, ArithmeticFunction.moebius_apply_of_squarefree h,
        ArithmeticFunction.cardFactors_apply]
    · have hnd : ¬ k.primeFactorsList.Nodup := fun h' => h (hn.mpr h')
      simp [romanovMobius, hzero, hnd, ArithmeticFunction.moebius_eq_zero_of_not_squarefree h]

private def romanovWeight (M d : ℕ) : ℚ :=
  ∑ k ∈ Finset.Icc 1 ((M - 1) / d),
    (romanovMobius k : ℚ) * (1 / ((d * k : ℕ) : ℚ) - 1 / (M : ℚ))

private theorem romanovWeight_cast (M d : ℕ) :
    (romanovWeight M d : ℝ) =
      ∑ k ∈ Finset.Icc 1 ((M - 1) / d),
        (ArithmeticFunction.moebius k : ℝ) * (1 / ((d * k : ℕ) : ℝ) - 1 / (M : ℝ)) := by
  simp only [romanovWeight, Rat.cast_sum, Rat.cast_mul, Rat.cast_sub, Rat.cast_div,
    Rat.cast_one, Rat.cast_natCast, Rat.cast_intCast, romanovMobius_eq]

private def romanovMajorant (d : ℕ) : ℚ :=
  (romanovUpperNumerators.getD d 0 : ℚ) / 1000000

private theorem romanovMajorant_cast (d : ℕ) :
    (romanovMajorant d : ℝ) = (romanovUpperNumerators.getD d 0 : ℝ) / 1000000 := by
  simp only [romanovMajorant, Rat.cast_div, Rat.cast_natCast, Rat.cast_ofNat]

private def romanovCertificateSum (M : ℕ) : ℚ :=
  ∑ d ∈ Finset.Icc 1 (M - 1), romanovMajorant d * romanovWeight M d

private theorem romanovBoundOfCertificate {M : ℕ} {bound : ℚ}
    (reindexed : DX M = ∑ d ∈ Finset.Icc 1 (M - 1), aF d * (romanovWeight M d : ℝ))
    (hupper : ∀ d : ℕ, 0 < d → d < M → aF d ≤ (romanovMajorant d : ℝ))
    (hweights : ∀ d : Fin M, 0 ≤ romanovWeight M d.val)
    (hsum : romanovCertificateSum M < bound) (hM : 0 < M) :
    DX M < (bound : ℝ) := by
  rw [reindexed]
  calc
    _ ≤ (romanovCertificateSum M : ℝ) := by
      simp only [romanovCertificateSum, Rat.cast_sum, Rat.cast_mul]
      apply Finset.sum_le_sum
      intro d hd
      obtain ⟨hpos, hle⟩ := Finset.mem_Icc.mp hd
      have hlt : d < M := by omega
      have hnonneg : 0 ≤ ((romanovWeight M d : ℚ) : ℝ) := by
        exact_mod_cast hweights ⟨d, hlt⟩
      exact mul_le_mul_of_nonneg_right (hupper d hpos hlt) hnonneg
    _ < _ := by exact_mod_cast hsum

