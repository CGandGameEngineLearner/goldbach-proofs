theorem aMM (S:Finset (ℕ × ℕ))
  (hS:∀x∈S,0<x.1∧0<x.2) (y:ℕ × ℕ):
  Set.InjOn (fun x:ℕ × ℕ=>x.1) (↑(S.filter fun x=>fq x=y)):=by
 intro x hx z hz hxz
 change x.1=z.1 at hxz
 obtain ⟨hxS,hxy⟩:=mem_filter.mp hx
 obtain ⟨hzS,hzy⟩:=mem_filter.mp hz
