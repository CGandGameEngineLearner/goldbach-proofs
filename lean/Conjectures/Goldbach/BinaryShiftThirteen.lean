  _≤ ‖(2*(Real.pi:ℂ))⁻¹‖*(B*∫ v:ℝ,
    ‖M*dM χ (Icc 1 X) (f9 θ X v) s‖*Real.exp (-|v|)):=
   mul_le_mul_of_nonneg_left ((norm_integral_le_integral_norm _).trans hb) (norm_nonneg _)
  _=_:=by dsimp [B,fO]; ring
