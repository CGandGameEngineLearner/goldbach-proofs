theorem asq (χ ψ:DirichletCharacter ℂ q)
  (s:ℂ) (hs:s.re=1/2) (N:ℝ) (hN:0<N) (B:Finset ℕ) (u:ℝ):
  ‖vN (dN χ ψ) s N B ((-1:ℂ)+(u:ℂ)*I)‖ ≤
   ((q:ℝ)*(1+ |s.im| + |u|)*Real.exp 1/N)*Real.exp (-(u^2))*
