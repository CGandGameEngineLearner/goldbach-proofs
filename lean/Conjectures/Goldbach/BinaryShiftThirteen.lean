   (‖jt χ K X (fF K X (f9 θ X v)) s‖+E)*
    Real.exp (-|v|)):=by
  apply (hj.add (sI.const_mul E)).congr
  filter_upwards with v
  change (‖jt χ K X (fF K X (f9 θ X v)) s‖*
   Real.exp (-|v|))+E*Real.exp (-|v|)=_
  ring
