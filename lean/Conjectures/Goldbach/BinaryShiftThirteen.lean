    Y^(-(J:ℝ)-s.re-1/2))*(X:ℝ)^(-(J:ℝ)-1/2))+
   2*(fO*Y^(1/2-θ)*(X:ℝ)^(θ-1/2))*
    (((K:ℝ)/(X:ℝ))^(θ-1/2))*(K:ℝ)^2:=by
 letI:NeZero χ.modulus:=⟨χ.positive.ne'⟩
 have hs0:0≤ s.re:=by linarith
 have M5:7/12≤ s.re:=hθ.trans hθs
 have hYpos:0<Y:=by linarith
