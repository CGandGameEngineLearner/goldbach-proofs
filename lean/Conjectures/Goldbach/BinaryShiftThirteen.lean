section
namespace aZ
open Complex DirichletCharacter Finset
open scoped ComplexConjugate BigOperators Classical
theorem Lj (p:ℝ) (hp:0<p) (w:ℂ):
  conj ((p:ℂ)^w)=(p:ℂ)^(conj w):=by
 have harg:(p:ℂ).arg≠Real.pi:=by
  rw [Complex.arg_ofReal_of_nonneg hp.le]
  exact Real.pi_pos.ne
 simpa only [Complex.conj_ofReal] using (Complex.cpow_conj (p:ℂ) w harg).symm
noncomputable def nO (a:ℂ) (p:ℝ) (s:ℂ):ℂ:=
 (1-a*(p:ℂ)^(-s))/(1-conj a*(p:ℂ)^(s-1))
theorem agw (a:ℂ) (ha: ‖a‖ ≤1)
  (p:ℝ) (hp:1<p) (s:ℂ) (hs:s.re<1):
  1-conj a*(p:ℂ)^(s-1)≠0:=by
 have hn: ‖conj a*(p:ℂ)^(s-1)‖ <1:=by
  rw [norm_mul,norm_conj,Complex.norm_cpow_eq_rpow_re_of_pos (by linarith:0<p)]
  have he:(s-1).re=s.re-1:=by simp
  rw [he]
  exact (mul_le_of_le_one_left (Real.rpow_nonneg (by linarith) _) ha).trans_lt
   (Real.rpow_lt_one_of_one_lt_of_neg hp (by linarith))
 intro he
 have h:conj a*(p:ℂ)^(s-1)=1:=(sub_eq_zero.mp he).symm
 simpa [h] using hn
theorem atz (a:ℂ) (ha: ‖a‖ ≤1)
  (p:ℝ) (hp:1<p) (s:ℂ) (hs:s.re=1/2):
  ‖nO a p s‖ =1:=by
 have hp0:0<p:=by linarith
 have he:s-1=-(conj s):=by
  apply Complex.ext <;> simp [hs] <;> ring
 have hn: ‖a*(p:ℂ)^(-s)‖ <1:=by
  rw [norm_mul,Complex.norm_cpow_eq_rpow_re_of_pos hp0]
  have hneg:(-s).re=-(1/2:ℝ):=by simp [hs]
  rw [hneg]
  exact (mul_le_of_le_one_left (Real.rpow_nonneg hp0.le _) ha).trans_lt
   (Real.rpow_lt_one_of_one_lt_of_neg hp (by norm_num))
 have hd:conj a*(p:ℂ)^(s-1)=conj (a*(p:ℂ)^(-s)):=by
  rw [map_mul,Lj p hp0,map_neg,he]
 unfold nO
 rw [hd]
 exact axb _ hn
theorem avU (a:ℂ) (ha: ‖a‖ ≤1)
  (p:ℝ) (hp:1<p) (s:ℂ) (hs:s.re=-(1/2)):
  ‖nO a p s‖ ≤p:=by
 have hp0:0<p:=by linarith
 have hpc:(p:ℂ)≠0:=Complex.ofReal_ne_zero.mpr hp0.ne'
 let z:ℂ:=a*(p:ℂ)^(-s)/(p:ℂ)
 have hz: ‖z‖ ≤1:=by
  dsimp [z]
  rw [norm_div,norm_mul,Complex.norm_cpow_eq_rpow_re_of_pos hp0,
   Complex.norm_real,Real.norm_eq_abs,abs_of_pos hp0]
  apply (div_le_iff₀ hp0).mpr
  have hpn:p^(-s).re≤p:=by
   rw [show (-s).re=(1/2:ℝ) by simp [hs]]
   exact (Real.rpow_le_rpow_of_exponent_le hp.le (by norm_num:(1/2:ℝ)≤1)).trans_eq
