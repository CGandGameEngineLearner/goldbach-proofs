theorem SD (ε:ℝ) (hε:0<ε) (hε1:ε≤1/2):
  ∃C:ℝ,0<C∧∀N Q:ℕ,1≤N→1≤Q→
   ∀T:ℝ,1≤T→∀A:Finset ℕ,A ⊆ Ioc N (2*N)→∀a:ℕ→ℂ,
   ∀{ι:Type} (R:Finset ι) (c:ι→PrimitiveComplexCharacter) (t β:ι→ℝ),
   (∀i∈R,(c i).modulus≤Q)→
   (∀i∈R, |t i| ≤T)→
   (∀i∈R,∀j∈R,c i=c j→i≠j→1≤ |t i-t j|)→
   ∀θ:ℝ,0≤θ→θ≤1→(∀i∈R,θ≤β i∧β i≤1)→
   let D:ℝ:=(Q:ℝ)^2*(T+1)
   (∑i∈R, ‖aP (c i).character A a
    ((β i:ℂ)+(2*Real.pi*t i:ℝ)*I)‖ ^2)≤
    C*((N:ℝ)*D)^(2*ε)*(2+(Real.log (2*N+1:ℕ))^2)*
     ((N:ℝ)+((N:ℝ)*D)^(1/3:ℝ)*(R.card:ℝ)^(2/3:ℝ))*
      ∑n∈A, ‖V6 a θ n‖ ^2:=by
 obtain ⟨C,hC,hm⟩:=W8 ε hε hε1
 refine ⟨2*C,by positivity,?_⟩
 intro N Q hN hQ T hT A hA a ι R c t β hc ht hsep θ hθ hθ1 hβ
 let D:ℝ:=(Q:ℝ)^2*(T+1)
 let K:=C*((N:ℝ)*D)^(2*ε)*
  ((N:ℝ)+((N:ℝ)*D)^(1/3:ℝ)*(R.card:ℝ)^(2/3:ℝ))
 have hD0:0≤D:=by dsimp [D]; positivity
 have hK:0≤K:=by dsimp [K]; positivity
 have hA':A ⊆ Icc 1 (2*N):=by
  intro n hn
  have hh:=mem_Ioc.mp (hA hn)
  exact mem_Icc.mpr ⟨by omega,hh.2⟩
 have hpos (n:ℕ) (hn:n∈A):0<n:=(mem_Icc.mp (hA' hn)).1
 have hmean (b:ℕ→ℂ):
   (∑i∈R, ‖V3 A b (c i).character (t i)‖ ^2)≤K*∑n∈A, ‖b n‖ ^2:=by
  have hh:=hm N Q hN hQ T hT A hA b R c t hc ht hsep
  simp_rw [Ci _ A b hpos] at hh
  apply hh.trans_eq
  dsimp [K,D]
  ring
