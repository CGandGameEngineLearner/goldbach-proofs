  ‖M*(∑n∈Icc 1 X,iJ χ s Y n)‖ ≤
   (fO*Y^(1/2-θ)*(X:ℝ)^(θ-1/2))*
    ∫ v:ℝ, ‖M*dM χ (Icc 1 X) (f9 θ X v) s‖*
     Real.exp (-|v|):=by
 have hYpos:0<Y:=by linarith
 have hXpos:(0:ℝ)<X:=Nat.cast_pos.mpr hX
 let B:ℝ:=(12*Real.exp 3)*Y^(1/2-θ)*(X:ℝ)^(θ-1/2)
 have hB:0≤B:=by dsimp [B]; positivity
 have hpoly:=M7 χ X hX θ (by linarith) s (by linarith)
 have hw:Integrable (fun v:ℝ=>
   ‖M*dM χ (Icc 1 X) (f9 θ X v) s‖*Real.exp (-|v|)):=by
  simpa only [norm_mul,mul_assoc] using hpoly.const_mul ‖M‖
 have hpoint (v:ℝ): ‖M*m4 χ θ s Y X v‖ ≤
   B*(‖M*dM χ (Icc 1 X) (f9 θ X v) s‖*Real.exp (-|v|)):=by
  have hk:=Wq χ hχ θ s hθ hθs hs Y hY hP v
  have hp:=aij χ (Icc 1 X) (fun n hn=>(mem_Icc.mp hn).1)
   θ X v hXpos s
  unfold m4
  rw [norm_mul,norm_mul,hp]
  calc
   _= ‖gG χ s Y ((fG θ s:ℂ)+(v:ℂ)*I)/
     ((fG θ s:ℂ)+(v:ℂ)*I)‖*(X:ℝ)^(θ-1/2)*
      ‖M*dM χ (Icc 1 X) (f9 θ X v) s‖ :=by
    rw [norm_mul]
    ring
   _≤((12*Real.exp 3)*Y^(1/2-θ)*Real.exp (-|v|))*(X:ℝ)^(θ-1/2)*
     ‖M*dM χ (Icc 1 X) (f9 θ X v) s‖ :=by gcongr
   _=_:=by dsimp [B]; ring
