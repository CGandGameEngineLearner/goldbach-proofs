   (K:ℝ)*((jo J*((χ.modulus:ℝ)*(1+|s.im|))^(J+1)*
    Y^(-(J:ℝ)-s.re-1/2))*(X:ℝ)^(-(J:ℝ)-1/2)):=by
  rw [norm_mul]
  exact mul_le_mul hm hu.2 (norm_nonneg _) (Nat.cast_nonneg K)
