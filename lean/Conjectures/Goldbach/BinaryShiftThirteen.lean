 have hG:0≤G:=sum_nonneg fun _ _=>sq_nonneg _
 have hB:0≤B:=sum_nonneg fun _ _=>sq_nonneg _
 have hW:0≤W:=by dsimp [W]; positivity
 have hNG:0≤(N:ℝ)*G:=mul_nonneg hN0 hG
 have hND:1≤(N:ℝ)*D:=one_le_mul_of_one_le_of_one_le hNr hD
 have hDle:D≤(N:ℝ)*D:=by nlinarith
 have hNle:(N:ℝ)≤(N:ℝ)*D:=by nlinarith
 change B≤(Cs+Cl)*((N:ℝ)*D)^(2*ε)*((N:ℝ)*G+W)
 by_cases hshort:(N:ℝ)≤D
 ·have q8:=hg N Q hN hQ T hT hshort A hA a R c t hc ht hsep
  have hh:=Binary13.KV.ak9 hAa.le hEe.le hε.le
   hB hN0 hD hG (Nat.cast_nonneg R.card) q8
