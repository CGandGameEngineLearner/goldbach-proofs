open Finset
open scoped BigOperators
namespace Goldbach.eW
noncomputable section
def nY (w:ℕ→ℝ) (N:ℕ):ℝ:=∑k∈Finset.range N,w (k+1)
def m6 (w:ℕ→ℝ) (N:ℕ):ℝ:=
 ∑k∈Finset.range N,w (k+1)/((k:ℝ)+1)
def tj (w:ℕ→ℝ) (M:ℕ):ℝ:=
 m6 w M-nY w M/M
def F3 (x:ℝ):ℝ:=(1+Real.log x)/x
theorem aPF {x:ℝ} (hx:0<x):
  Real.log (x+1)-Real.log x≤1/x:=by
 have h:=Real.log_le_sub_one_of_pos (show 0<(x+1)/x by positivity)
 rw [Real.log_div (by positivity) hx.ne'] at h
 have hr:(x+1)/x-1=1/x:=by field_simp; ring
 rwa [hr] at h
theorem aAd {x:ℝ} (hx:0<x):
  Real.log x/(x*(x+1))≤F3 x-F3 (x+1):=by
 have h:=aPF hx
 unfold F3
 apply (mul_le_mul_iff_of_pos_right (show 0<x*(x+1) by positivity)).mp
 have hid:((1+Real.log x)/x-(1+Real.log (x+1))/(x+1))*(x*(x+1))
   =1+Real.log x+x*(Real.log x-Real.log (x+1)):=by
  field_simp
  ring
 rw [div_mul_cancel₀ _ (by positivity),hid]
 have hp:=(mul_le_mul_of_nonneg_left h hx.le)
 rw [mul_one_div_cancel hx.ne'] at hp
 nlinarith only [hp]
theorem aJB (w:ℕ→ℝ) {N:ℕ} (hN:0<N):
  tj w (N+1)=tj w N+
   nY w N/((N:ℝ)*((N:ℝ)+1)):=by
 have hNr:(0:ℝ)<N:=by exact_mod_cast hN
 unfold tj m6 nY
 rw [Finset.sum_range_succ,Finset.sum_range_succ]
 push_cast
 field_simp
 ring
theorem aNr (w:ℕ→ℝ) (C:ℝ) (hC:0≤C)
  (M:ℕ) (hM:0<M)
  (hbound:∀N:ℕ,M≤N→nY w N≤C*Real.log N):
  ∀N:ℕ,M≤N→tj w N≤tj w M+
   C*(F3 M-F3 N):=by
 intro N hMN
 induction N,hMN using Nat.le_induction with
 | base=>simp
 | succ N hMN ih=>
  have hN:0<N:=hM.trans_le hMN
  have hNr:(0:ℝ)<N:=by exact_mod_cast hN
  rw [aJB w hN]
  have hquot:=div_le_div_of_nonneg_right (hbound N hMN)
   (show 0≤(N:ℝ)*((N:ℝ)+1) by positivity)
  have a7d:=mul_le_mul_of_nonneg_left (aAd hNr) hC
  push_cast
  have hscale:C*Real.log (N:ℝ)/((N:ℝ)*((N:ℝ)+1))=
   C*(Real.log (N:ℝ)/((N:ℝ)*((N:ℝ)+1))):=by ring
  rw [hscale] at hquot
  linarith only [ih,hquot,a7d]
theorem agu (w:ℕ→ℝ) (C:ℝ) (hC:0≤C)
  (M:ℕ) (hM:0<M)
  (hbound:∀N:ℕ,M≤N→nY w N≤C*Real.log N)
  (N:ℕ) (hMN:M≤N):
  m6 w N≤tj w M+C*(1+Real.log M)/M:=by
 have hN:0<N:=hM.trans_le hMN
 have hNr:(0:ℝ)<N:=by exact_mod_cast hN
 have h:=aNr w C hC M hM hbound N hMN
 have hb:=div_le_div_of_nonneg_right (hbound N hMN) hNr.le
 unfold tj at h
 unfold F3 at h
 have hnon:0≤C/(N:ℝ):=div_nonneg hC hNr.le
 have hid:C*((1+Real.log M)/M-(1+Real.log N)/N)+
   C*Real.log N/N=C*(1+Real.log M)/M-C/N:=by ring
 unfold tj
 linarith only [h,hb,hnon,hid]
end
end Goldbach.eW
end

