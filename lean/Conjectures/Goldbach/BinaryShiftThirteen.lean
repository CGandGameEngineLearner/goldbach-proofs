  calc
   _≤∑'q:ℕ,‖coefficient O O m q‖ :=hsingle
   _= ‖qL.series O O m‖ *∏'p:ℕ,correction (Nat.lcm 1 1*m) p:=habs
   _≤ ‖qL.series O O m‖*4:=mul_le_mul_of_nonneg_left
