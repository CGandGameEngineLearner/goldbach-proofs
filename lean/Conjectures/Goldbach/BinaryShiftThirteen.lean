theorem au7 {q r:ℕ} (hr:0<r) (hrq:r<q)
  {a m:ℤ} (hcop:IsCoprime a (q:ℤ)):
  (1:ℝ)≤ |(r:ℝ)*a-(m:ℝ)*q| :=by
 have hn:(r:ℤ)*a-m*q≠0:=by
  intro hz
  have hd:(q:ℤ)∣(r:ℤ)*a:=by
   refine ⟨m,?_⟩
   nlinarith only [hz]
  have a5K:q∣r:=by
   exact_mod_cast hcop.symm.dvd_of_dvd_mul_right hd
  have hqr:=Nat.le_of_dvd hr a5K
  omega
 have hz:(1:ℤ)≤ |(r:ℤ)*a-m*q| :=by
  have:=abs_pos.mpr hn
  omega
 exact_mod_cast hz
theorem auf (j:ℕ):
  ∃C d:ℕ,0<C∧0<d∧
   ∀(P:Polynomial ℝ) (N q:ℕ) (a:ℤ) (δ θ:ℝ),
    P.natDegree≤j+1→0<N→0<q→IsCoprime a (q:ℤ)→
    0<δ→δ≤1→0≤θ→
    |P.coeff (j+1)-(a:ℝ)/q| ≤θ→
    (C:ℝ)≤δ^d*N→(C:ℝ)<δ^d*q→
    (C:ℝ)*q*(1/(N:ℝ)^(j+1)+θ)<δ^d→
    ‖OAI.dL.vk P N‖ <δ*N:=by
 obtain ⟨C,d,hC,hd,hW⟩:=OAI.dL.as1 j
 refine ⟨C,d,hC,hd,?_⟩
 intro P N q a δ θ hP hN hq hcop hδ hδ1 hθ hcoeff hsize hden hbudget
 by_contra! hlarge
 obtain ⟨r,hr,aqe,m,hm⟩:=hW P N δ hP hN hδ hδ1 hsize hlarge
 have hδd:0<δ^d:=pow_pos hδ d
 have hqR:(0:ℝ)<q:=Nat.cast_pos.mpr hq
 have hNR:(0:ℝ)<N:=Nat.cast_pos.mpr hN
 have hrR:(0:ℝ)≤r:=Nat.cast_nonneg r
 have hrq:r<q:=by
  have hCq:(C:ℝ)/δ^d<(q:ℝ):=
   (div_lt_iff₀ hδd).mpr (by simpa only [mul_comm] using hden)
  exact_mod_cast aqe.trans_lt hCq
 have hlower:=au7 (m:=m) hr hrq hcop
 have hid:(r:ℝ)*a-(m:ℝ)*q=
   (q:ℝ)*((r:ℝ)*P.coeff (j+1)-m)+
    (q:ℝ)*r*((a:ℝ)/q-P.coeff (j+1)):=by
  field_simp [hqR.ne']
  <;> ring
 have hbound: |(r:ℝ)*a-(m:ℝ)*q| ≤
   ((C:ℝ)*q*(1/(N:ℝ)^(j+1)+θ))/δ^d:=by
  calc
   _≤ |(q:ℝ)*((r:ℝ)*P.coeff (j+1)-m)| +
     |(q:ℝ)*r*((a:ℝ)/q-P.coeff (j+1))| :=by
    rw [hid]
    exact abs_add_le _ _
   _=(q:ℝ)*|(r:ℝ)*P.coeff (j+1)-m| +
     (q:ℝ)*r*|P.coeff (j+1)-(a:ℝ)/q| :=by
    simp only [abs_mul,abs_of_pos hqR,abs_of_nonneg hrR,
     abs_sub_comm ((a:ℝ)/q) (P.coeff (j+1))]
   _≤(q:ℝ)*((C:ℝ)/(δ^d*(N:ℝ)^(j+1)))+
     (q:ℝ)*((C:ℝ)/δ^d)*θ:=by
    apply add_le_add
    ·exact mul_le_mul_of_nonneg_left hm hqR.le
    ·exact (mul_le_mul_of_nonneg_left hcoeff (mul_nonneg hqR.le hrR)).trans
      (mul_le_mul_of_nonneg_right
       (mul_le_mul_of_nonneg_left aqe hqR.le) hθ)
   _=_:=by
    field_simp [hδd.ne',(pow_pos hNR (j+1)).ne']
    <;> ring
 have hsmall:((C:ℝ)*q*(1/(N:ℝ)^(j+1)+θ))/δ^d<1:=
  (div_lt_one hδd).mpr hbudget
 exact (not_lt_of_ge (hlower.trans hbound)) hsmall
