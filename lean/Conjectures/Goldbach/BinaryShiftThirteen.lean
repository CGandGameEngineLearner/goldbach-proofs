theorem W8 (ε:ℝ) (hε:0<ε) (hε1:ε≤1/2):
  ∃C:ℝ,0<C∧∀N Q:ℕ,1≤N→1≤Q→
   ∀T:ℝ,1≤T→∀A:Finset ℕ,A ⊆ Ioc N (2*N)→∀a:ℕ→ℂ,
   ∀{ι:Type} (R:Finset ι) (c:ι→PrimitiveComplexCharacter) (t:ι→ℝ),
   (∀i∈R,(c i).modulus≤Q)→
