private theorem fullOrbitLower (q : ℕ) [NeZero q]
    (himage : (univ.image fun j : Fin (q - 1) => (2 : ZMod q) ^ (j.val + 1)) = Dv q)
    (b : ℚ) (hb : (q : ℚ) * b ≤ (q - 1 : ℚ)^13 - (q - 1)) (a : ZMod q) :
    b ≤ aE q (q - 1) 13 a := by
  have hinj : Set.InjOn (fun j : Fin (q - 1) => (2 : ZMod q) ^ (j.val + 1))
      (univ : Finset (Fin (q - 1))) := by
    apply injOn_of_card_image_eq
    rw [himage, card_univ, Fintype.card_fin]
    simp [Dv, card_erase_of_mem (mem_univ _), ZMod.card]
  have hcount (k : ℕ) (x : ZMod q) : aE q (q - 1) k x = tW q k x := by
    induction k generalizing x with
    | zero => rfl
    | succ k ih =>
      rw [aE, tW]
      simp_rw [ih]
      rw [← himage, sum_image hinj]
  rw [hcount]
  have hq : (0 : ℚ) < q := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  exact le_of_mul_le_mul_left (hb.trans (ahZ q a)) hq

theorem awT (a : ZMod 11) : (909090909090 : ℚ) ≤ aE 11 10 13 a :=
  fullOrbitLower 11 (by decide+kernel) _ (by norm_num) a

theorem awU (a : ZMod 13) : (8230246567620 : ℚ) ≤ aE 13 12 13 a :=
  fullOrbitLower 13 (by decide+kernel) _ (by norm_num) a

theorem awX (a : ZMod 19) : (1095945519245850 : ℚ) ≤ aE 19 18 13 a :=
  fullOrbitLower 19 (by decide+kernel) _ (by norm_num) a

theorem aw0 (a : ZMod 29) : (224210738706825780 : ℚ) ≤ aE 29 28 13 a :=
  fullOrbitLower 29 (by decide+kernel) _ (by norm_num) a

-- Count by classes of residues under multiplication by 2. Each modulus certifies
-- its transition counts and 14 short rows of natural-number counts.
private theorem sumByResidueClass {q ell classes : ℕ}
    (orbit : Fin ell → ZMod q) (category : ZMod q → Fin classes)
    (matrix : Fin classes → Fin classes → ℕ)
    (transition : ∀ (a : ZMod q) (c : Fin classes),
      (∑ j : Fin ell, if category (a - orbit j) = c then (1 : ℕ) else 0) =
        matrix (category a) c)
    (a : ZMod q) (f : Fin classes → ℚ) :
    (∑ j : Fin ell, f (category (a - orbit j))) =
      ∑ c : Fin classes, (matrix (category a) c : ℚ) * f c := by
  calc
    _ = ∑ j : Fin ell, ∑ c : Fin classes,
        (if category (a - orbit j) = c then (1 : ℚ) else 0) * f c := by
      apply Finset.sum_congr rfl
      intro j _
      simp [ite_mul]
    _ = _ := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro c _
      rw [← Finset.sum_mul]
      congr 1
      calc
        _ = ((↑(∑ j : Fin ell,
            if category (a - orbit j) = c then (1 : ℕ) else 0)) : ℚ) := by
          rw [Nat.cast_sum]
          apply Finset.sum_congr rfl
          intro j _
          by_cases h : category (a - orbit j) = c <;> simp [h]
