def bY (P:Finset ℕ) (a b:ℕ):ℝ:=
 ∑p∈P,∑q∈P,if p+a=q+b then (1:ℝ) else 0
theorem aRV (P:Finset ℕ) (a b:ℕ):
  bY P a b=bY P b a:=by
 unfold bY
 rw [Finset.sum_comm]
 apply Finset.sum_congr rfl
 intro q hq
 apply Finset.sum_congr rfl
 intro p hp
 simp only [eq_comm]
theorem aRU (P:Finset ℕ) (a:ℕ):
  bY P a a=P.card:=by
 simp [bY]
theorem Xw (P:Finset ℕ) {a b:ℕ} (hab:a≤b):
  bY P a b=((P.filter (fun q=>q+(b-a)∈P)).card:ℝ):=by
 unfold bY
 rw [Finset.sum_comm]
 have heq (p q:ℕ):p+a=q+b↔p=q+(b-a):=by omega
 simp only [heq]
 simp
def wM (P:Finset ℕ) (L:ℕ):ℝ:=
 ∑e∈Finset.range L,∑f∈Finset.range L,
  bY P (2^(e+1)) (2^(f+1))
theorem aRR (P:Finset ℕ) (L:ℕ):
  wM P (L+1)=wM P L+P.card+
   2*∑e∈Finset.range L,bY P (2^(e+1)) (2^(L+1)):=by
 unfold wM
 rw [Finset.sum_range_succ]
 simp_rw [Finset.sum_range_succ]
 rw [Finset.sum_add_distrib,aRU]
 have hs:(∑e∈Finset.range L,bY P (2^(L+1)) (2^(e+1)))=
   ∑e∈Finset.range L,bY P (2^(e+1)) (2^(L+1)):=by
  apply Finset.sum_congr rfl
  intro e he
  exact aRV P _ _
 rw [hs]
 ring
theorem azb (P:Finset ℕ) (B:ℝ)
  (hrow:∀L:ℕ,
   (∑e∈Finset.range L,bY P (2^(e+1)) (2^(L+1)))
    ≤B*(L:ℝ)) (L:ℕ):
  wM P L≤(P.card:ℝ)*L+B*(L:ℝ)*((L:ℝ)-1):=by
 induction L with
 | zero=>simp [wM]
 | succ L ih=>
  rw [aRR]
  have h:=hrow L
  push_cast
  nlinarith only [ih,h]
theorem Ym (A:ℕ→ℝ) (L:ℕ):
  (∑e∈Finset.range L,A (L-e))=∑h∈Finset.Icc 1 L,A h:=by
 calc
  _=∑e∈Finset.range L,A ((L-1-e)+1):=by
   apply Finset.sum_congr rfl
   intro e he
   congr 1
   have he':=Finset.mem_range.mp he
   omega
  _=∑e∈Finset.range L,A (e+1):=Finset.sum_range_reflect (fun e=>A (e+1)) L
  _=∑h∈Finset.Icc 1 L,A h:=by
   rw [← Finset.Ico_add_one_right_eq_Icc]
   rw [Finset.sum_Ico_eq_sum_range]
   simp only [Nat.add_sub_cancel,Nat.add_comm]
theorem axA (P:Finset ℕ) (A:ℕ→ℝ) (B C:ℝ)
  (hB:0≤B)
  (hshift:∀e f:ℕ,e<f→
   ((P.filter (fun p=>p+(2^(f+1)-2^(e+1))∈P)).card:ℝ)
    ≤B*A (f-e))
  (hmean:∀L:ℕ,(∑h∈Finset.Icc 1 L,A h)≤C*(L:ℝ)) (L:ℕ):
  wM P L≤(P.card:ℝ)*L+(B*C)*(L:ℝ)*((L:ℝ)-1):=by
 apply azb
 intro k
 calc
  _≤∑e∈Finset.range k,B*A (k-e):=by
   apply Finset.sum_le_sum
   intro e he
   have hek:=Finset.mem_range.mp he
   rw [Xw P (Nat.pow_le_pow_right (by decide:1≤(2:ℕ)) (by omega))]
   exact hshift e k hek
  _=B*∑e∈Finset.range k,A (k-e):=(Finset.mul_sum ..).symm
  _≤B*(C*(k:ℝ)):=by rw [Ym]; exact mul_le_mul_of_nonneg_left (hmean k) hB
  _=(B*C)*(k:ℝ):=by ring
end
end Goldbach.eW
