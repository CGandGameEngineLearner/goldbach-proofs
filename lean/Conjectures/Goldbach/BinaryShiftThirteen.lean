 have hboundF:(∫ t in (0:ℝ)..1,(Ioc r (1-r)).indicator F t)≤1/(2*r):=by
  simpa only [F,Ls,phase,mul_assoc] using hbound
 rw [hrepr] at hboundF
 rw [htail]
