   rw [div_le_div_iff₀ (sq_pos_of_pos h1) (sq_pos_of_pos h0)]
   nlinarith [mul_nonneg (show 0≤(p:ℝ)-2 by linarith) (show 0≤3*(p:ℝ)-2 by linarith)]
  calc
   _≤(p:ℝ)^u*(4/(p:ℝ)^2):=mul_le_mul_of_nonneg_left denom nonneg
