theorem Cj:Differentiable ℂ dY:=by
 unfold dY
 fun_prop
theorem k5 (c t:ℝ):
  ‖dY ((c:ℂ)+(t:ℂ)*I)‖ =Real.exp (c^2-t^2):=by
 rw [dY,norm_exp]
 congr 1
 simp [pow_two]
theorem Wf (x:ℝ):
  ov x=(Real.exp (-(Real.log x)^2/4):ℂ):=by
 rw [ov,Complex.ofReal_exp]
 congr 1
 push_cast
 ring
theorem aDK (x:ℝ) (hx1:1≤x) (hx2:x≤2):
  Real.exp (-1)≤(ov x).re:=by
 rw [Wf,Complex.ofReal_re]
 have hx:0<x:=by linarith
 have hlog0:=Real.log_nonneg hx1
 have hlog1:Real.log x≤1:=by
  have h:=Real.log_le_sub_one_of_pos hx
  linarith
 apply Real.exp_le_exp.mpr
 nlinarith
theorem ayj (x c t:ℝ) (hx:0<x):
  dY ((c:ℂ)+(t:ℂ)*I)*
   (x:ℂ)^(-((c:ℂ)+(t:ℂ)*I))=
  Complex.exp ((-1:ℂ)*(t:ℂ)^2+
   (I*(2*(c:ℂ)-(Real.log x:ℂ)))*t+
   ((c:ℂ)^2-(c:ℂ)*(Real.log x:ℂ))):=by
 rw [dY,
  Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hx.ne'),
  ← Complex.ofReal_log hx.le,← Complex.exp_add]
 congr 1
 ring_nf
 simp [I_sq]
 ring
theorem aBi (x c:ℝ) (hx:0<x):
  (∫ t:ℝ,dY ((c:ℂ)+(t:ℂ)*I)*
   (x:ℂ)^(-((c:ℂ)+(t:ℂ)*I)))=
   (Real.pi:ℂ)^(1/2:ℂ)*ov x:=by
 simp_rw [ayj x c _ hx]
 rw [integral_cexp_quadratic (by norm_num:(-1:ℂ).re<0)]
 norm_num only [neg_neg,div_one]
 unfold ov
 congr 2
 ring_nf
 simp [I_sq]
