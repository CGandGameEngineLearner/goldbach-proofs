 exact ⟨hp.1,hp.2.trans hxy⟩
noncomputable def primeReciprocalSum (x:ℕ):ℝ:=
 (primesUpTo x).sum fun p=>1/(p:ℝ)
noncomputable def primeProduct (x:ℕ):ℝ:=
 (primesUpTo x).prod fun p=>1-1/(p:ℝ)
set_option maxHeartbeats 14000000 in
mutual
theorem Nz (x:ℕ):0≤primeReciprocalSum x:=by
 unfold primeReciprocalSum
 exact Finset.sum_nonneg fun p _=>by positivity
theorem aiX:Monotone primeReciprocalSum:=by
 intro x y hxy
 unfold primeReciprocalSum
 refine Finset.sum_le_sum_of_subset_of_nonneg (aR9 hxy) ?_
 intro p _ _
