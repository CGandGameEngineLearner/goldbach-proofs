 let short:=jt χ.character K X a s
 let M:=V1u K χ.character s
 let head:=∑n∈Icc 1 X,iJ χ.character s Y n
 let tailD:=∑' n:ℕ,l4 χ.character s Y (n+X+1)
 let u6:=∑' n:ℕ,iJ χ.character s Y (n+X+1)
 have hd:=alw χ.character s hs0 Y hYpos X J hX hJ
 have hu:=aak χ.character χ.primitive s M5 hs Y hYpos X J hX (by omega)
 have hdecomp:=N5 (l4 χ.character s Y) X hd.1
  (by simp [l4])
 have aeP:=N5 (iJ χ.character s Y) X hu.1
  (by simp [iJ])
 have afJ:=VY χ s M5 hs Y hY
 have he:(∑n∈Icc 1 X,l4 χ.character s Y n)+tailD=head+u6:=by
  calc
   _=∑' n:ℕ,l4 χ.character s Y n:=hdecomp
   _=∑' n:ℕ,iJ χ.character s Y n:=by
    simpa only [l4,iJ,hz,zero_add] using afJ
   _=_:=aeP.symm
 have tZ:=congrArg (fun z:ℂ=>M*z) he
 simp only [mul_add] at tZ
 rw [ajt] at tZ
