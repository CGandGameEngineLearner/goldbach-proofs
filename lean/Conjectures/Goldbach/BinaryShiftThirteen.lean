  exact ags (n+(x+1))
theorem atZ (x:ℕ) (hx:1≤x):
  ∑' n:ℕ,2/((n+(x+1):ℕ):ℝ)^2≤2/(x:ℝ):=by
 have hxR:0<(x:ℝ):=by
  exact_mod_cast (show 0<x by omega)
