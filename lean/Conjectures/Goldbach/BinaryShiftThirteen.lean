     |-(log (1-1/(p:ℝ))+1/(p:ℝ))| :=by congr 1; ring
   _= |log (1-1/(p:ℝ))+1/(p:ℝ)| :=abs_neg _
   _≤2/(p:ℝ)^2:=abs_log_primeFactor_add_le hp
