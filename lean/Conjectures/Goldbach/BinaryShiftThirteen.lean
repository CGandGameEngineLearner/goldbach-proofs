   dM χ.character (Icc 1 X) (fun m=>jA ((m:ℝ)/Y)) s+
   M*tailD=M*head+M*u6 at tZ
 rw [Ny,
  ← Nh χ.character K X hX] at tZ
 have hidentity:low+short=M*head+M*u6-M*tailD:=eq_sub_of_add_eq tZ
 have hbase:=alm low short (M*head) (M*u6) (M*tailD) hidentity
 have hlow:=ahh χ.character K X J hK hKX BZ s hs0 Y hYpos
 have hhead:=TU χ.character χ.primitive θ s hθ hθs hs Y hY hP K X hX hKX
 have hm: ‖M‖ ≤(K:ℝ):=Vyh χ K s hs0
 have hmd: ‖M*tailD‖ ≤(K:ℝ)*(e5 J*Y^(J:ℝ)*(X:ℝ)^(1-s.re-(J:ℝ))):=by
  rw [norm_mul]
  exact mul_le_mul hm hd.2 (norm_nonneg _) (Nat.cast_nonneg K)
