lemma aPW (m R:ℕ) (hR:0<R) (MW:R<2^m)
  (hrough:∀p∈R.primeFactors,8192<p):
  R.primeFactors.card≤ m/13:=by
 have hpow:(2:ℕ)^(13*R.primeFactors.card)≤R:=by
  calc
   _=(8192:ℕ)^R.primeFactors.card:=by rw [pow_mul]; norm_num
   _=∏_p∈R.primeFactors,(8192:ℕ):=by simp
   _≤∏p∈R.primeFactors,p:=Finset.prod_le_prod (fun p hp=>(hrough p hp).le)
   _≤R:=Nat.le_of_dvd hR (Nat.prod_primeFactors_dvd R)
 have hcard:13*R.primeFactors.card< m:=
  (Nat.pow_lt_pow_iff_right (by decide:1<(2:ℕ))).1 (hpow.trans_lt MW)
 apply (Nat.le_div_iff_mul_le (by decide:0<13)).2
 omega
lemma aIu (m R:ℕ) (hR:0<R) (MW:R<2^m)
  (hrough:∀p∈R.primeFactors,8192<p):
  correction R≤(8192/8191:ℝ)^(m/13):=by
 have hlocal (p:ℕ) (hp:p∈R.primeFactors):
   0≤((p:ℝ)-1)/((p:ℝ)-2)∧
   ((p:ℝ)-1)/((p:ℝ)-2)≤(8192/8191:ℝ):=by
  have hpB:(8193:ℝ)≤p:=by exact_mod_cast (hrough p hp)
  constructor
  ·apply div_nonneg <;> linarith
  ·apply (div_le_iff₀ (by linarith:(0:ℝ)<(p:ℝ)-2)).2
   linarith
 calc
  _≤∏_p∈R.primeFactors,(8192/8191:ℝ):=
   Finset.prod_le_prod₀ (fun p hp=>(hlocal p hp).1) (fun p hp=>(hlocal p hp).2)
  _=(8192/8191:ℝ)^R.primeFactors.card:=by rw [Finset.prod_const]
  _≤_:=pow_le_pow_right₀ (by norm_num) (aPW m R hR MW hrough)
private lemma azi (l:List ℕ)
  (hp:∀p∈l,p.Prime):l.prod.primeFactors=l.toFinset:=by
 have h:=Nat.primeFactorsList_unique (show l.prod=l.prod from rfl) hp
 ext p
 rw [Nat.mem_primeFactors_iff_mem_primeFactorsList,List.mem_toFinset]
 exact h.mem_iff.symm
lemma bC (m R:ℕ) (l:List ℕ)
  (hR:0<R)
  (hl:∀p∈l,p.Prime∧2<p∧p≤8192)
  (hfac:l.prod*R=2^m-1)
  (hrough:∀p∈R.primeFactors,8192<p):
  aF m≤
   (∏p∈l.toFinset,((p:ℝ)-1)/((p:ℝ)-2))*(8192/8191:ℝ)^(m/13):=by
 have hlpos:0<l.prod:=List.prod_pos (fun p hp=>(hl p hp).1.pos)
 have hle:R≤l.prod*R:=by
  simpa using Nat.mul_le_mul_right R (show 1≤l.prod from hlpos)
 have MW:R<2^m:=by
  rw [hfac] at hle
  exact hle.trans_lt (Nat.sub_lt (by positivity) (by decide))
 have hsplit:(2^m-1:ℕ).primeFactors=l.toFinset ∪ R.primeFactors:=by
  rw [← hfac,Nat.primeFactors_mul hlpos.ne' hR.ne',
   azi l (fun p hp=>(hl p hp).1)]
 have hdisj:Disjoint l.toFinset R.primeFactors:=by
  apply Finset.disjoint_left.mpr
  intro p hp hr
  exact (not_lt_of_ge (hl p (List.mem_toFinset.mp hp)).2.2) (hrough p hr)
 have hnonneg:0≤∏p∈l.toFinset,((p:ℝ)-1)/((p:ℝ)-2):=by
  apply Finset.prod_nonneg
  intro p hp
  have hp2:(2:ℝ)<p:=by exact_mod_cast (hl p (List.mem_toFinset.mp hp)).2.1
  apply div_nonneg <;> linarith
 rw [aF,hsplit,Finset.prod_union hdisj]
 exact mul_le_mul_of_nonneg_left (aIu m R hR MW hrough) hnonneg
end
end
