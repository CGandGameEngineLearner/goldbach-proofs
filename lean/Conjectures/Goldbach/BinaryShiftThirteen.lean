private theorem aX5 {p m:ℕ} (hp:p.Prime) (hm:0< m) {u:ℝ} (hu:u≤1):
  1+(p:ℝ)^u*|gI m p-1| ≤
   majorant u p*(if p∈m.primeFactors then 3 else 1):=by
