theorem Xj (P X δ θ:ℝ) (hP:1≤P)
  (hX:P^(1/2:ℝ)≤X) (hXu:X≤2*P^(1/2+δ)) (hδ:0≤δ)
  (hθ:1/2≤θ) (hθ':θ≤1):
  fO*(P^(1/2:ℝ))^(1/2-θ)*X^(θ-1/2)≤
   (fO*2^(1/2:ℝ))*P^(δ/2):=by
 have hH:=yI
 have hPpos:0<P:=by linarith
 have hYpos:0<P^(1/2:ℝ):=Real.rpow_pos_of_pos hPpos _
 have hXpos:0<X:=hYpos.trans_le hX
 have he:(P^(1/2:ℝ))^(1/2-θ)*X^(θ-1/2)=(X/P^(1/2:ℝ))^(θ-1/2):=by
  rw [show 1/2-θ=-(θ-1/2) by ring,Real.rpow_neg hYpos.le,
   Real.div_rpow hXpos.le hYpos.le]
  ring
 have hr:(X/P^(1/2:ℝ))^(θ-1/2)≤(2*P^(1/2+δ)/P^(1/2:ℝ))^(1/2:ℝ):=by
  calc
   _≤(X/P^(1/2:ℝ))^(1/2:ℝ):=
    Real.rpow_le_rpow_of_exponent_le ((one_le_div hYpos).mpr hX) (by linarith)
   _≤_:=Real.rpow_le_rpow (by positivity)
    (div_le_div_of_nonneg_right hXu hYpos.le) (by norm_num)
