  (hw.const_mul B) hpoint
 rw [integral_const_mul] at hb
 have he:M*(∑n∈Icc 1 X,iJ χ s Y n)=
   (2*(Real.pi:ℂ))⁻¹*∫ v:ℝ,M*m4 χ θ s Y X v:=by
  rw [Yo χ hχ θ s hθ hθs hs Y hYpos X,integral_const_mul]
  ring
 rw [he,norm_mul]
