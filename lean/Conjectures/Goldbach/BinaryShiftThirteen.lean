  letI:NeZero χ.modulus:=⟨χ.positive.ne'⟩
  (1:ℝ)≤
   ‖jt χ.character K X
    (fF K X (fun m=>jA ((m:ℝ)/Y))) s‖+
   (fO*Y^(1/2-θ)*(X:ℝ)^(θ-1/2))*p7 χ.character K X θ s+
