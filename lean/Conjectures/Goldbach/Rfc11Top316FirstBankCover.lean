def nthRow : List (List ℕ) → ℕ → List ℕ
  | [], _ => []
  | a :: _, 0 => a
  | _ :: t, n + 1 => nthRow t n

def w (i : ℕ) : ℕ := nthL (nthRow wit ((i - 1) / 128)) ((i - 1) % 128)

def rowOK (i : ℕ) : Bool :=
  if memB badL i then offs.all (fun t => !(isPrimeTiny (t - 2 * i)))
  else (memB offs (w i)) && isPrimeTiny (w i - 2 * i)

def cover : Bool := (List.range 12288).all (fun j => rowOK (j + 1))

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 4000000 in
theorem cover_eq : cover = true := by rfl

lemma rowOK_of_cover {i : ℕ} (h1 : 1 ≤ i) (h2 : i ≤ 12288) : rowOK i = true := by
  have hall := List.all_eq_true.mp cover_eq (i - 1) (List.mem_range.mpr (by omega))
  have hsub : i - 1 + 1 = i := by omega
  rw [hsub] at hall
  exact hall

lemma offs_bound : ∀ t ∈ offs, t ≤ 60269 := by decide

