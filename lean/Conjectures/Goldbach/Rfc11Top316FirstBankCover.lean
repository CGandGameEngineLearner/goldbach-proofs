def memB : List ℕ → ℕ → Bool
  | [], _ => false
  | a :: t, x => (a == x) || memB t x

lemma memB_true : ∀ {l : List ℕ} {x : ℕ}, memB l x = true → x ∈ l
  | [], _, h => by cases h
  | a :: t, x, h => by
      rw [memB, Bool.or_eq_true] at h
      rcases h with h | h
      · exact List.mem_cons.mpr (Or.inl (beq_iff_eq.mp h).symm)
      · exact List.mem_cons.mpr (Or.inr (memB_true h))

lemma memB_of_mem : ∀ {l : List ℕ} {x : ℕ}, x ∈ l → memB l x = true
  | [], _, h => by cases h
  | a :: t, x, h => by
      rcases List.mem_cons.mp h with h | h
      · subst h
        simp [memB]
      · rw [memB, memB_of_mem h, Bool.or_true]

def nthL : List ℕ → ℕ → ℕ
  | [], _ => 0
  | a :: _, 0 => a
  | _ :: t, n + 1 => nthL t n

