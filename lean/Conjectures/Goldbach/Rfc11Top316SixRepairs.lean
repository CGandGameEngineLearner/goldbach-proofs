import Conjectures.Goldbach.Rfc11Top316FirstBankCover
import Conjectures.Goldbach.Rfc11Top316AnchorBank
import Mathlib

/-!
The first 40 offsets cover all but six index values, as proved by the
accepted first-bank module at 960daf9ecbcdabfd64d789cbe6750809c847eddf.
For the six missing indices we check explicit small prime differences
using the three extra offsets. Subtracting twice the index then gives
the required pair for each of the 12288 even targets below 10^316.
-/

namespace Top316EndpointAssembly

private def offsets : List ℕ := [25787, 23073, 28121, 30291, 29519, 51747, 29183, 30693, 46539, 27299, 55077, 35117, 58401, 48851, 29673, 44813, 22041, 52193, 40623, 35561, 59667, 54623, 31341, 41939, 42603, 49467, 57963, 12377, 33269, 18117, 18191, 42833, 46341, 38403, 48893, 1821, 8307, 14831, 15039, 60269, 71799, 73059, 66447]
private def misses : List ℕ := [7564, 7909, 11134, 11329, 11989, 12154]

private theorem complementary (i : ℕ) (lo : 1 ≤ i) (hi : i ≤ 12288) :
    ∃ t ∈ offsets, (t-2*i).Prime := by
  by_cases h : i ∈ misses
  · simp only [misses, List.mem_cons, List.not_mem_nil, or_false] at h
    rcases h with rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨71799, by decide, by norm_num⟩
    · exact ⟨73059, by decide, by norm_num⟩
    · exact ⟨71799, by decide, by norm_num⟩
    · exact ⟨66447, by decide, by norm_num⟩
    · exact ⟨73059, by decide, by norm_num⟩
    · exact ⟨71799, by decide, by norm_num⟩
  · obtain ⟨t, ht, hp⟩ := (Conjectures.Goldbach.Rfc11Top316FirstBankCover i lo hi).2 h
    exact ⟨t, List.mem_of_mem_take ht, hp⟩

private theorem bounded (t : ℕ) (ht : t ∈ offsets) : t ≤ 73059 := by
  have h : offsets.all (fun s => decide (s≤73059)) = true := by decide +kernel
  exact of_decide_eq_true (List.all_eq_true.mp h t ht)

theorem result (anchors : ∀ t ∈ offsets, Nat.Prime (10^316-t)) :
    (fun (lo hi : ℕ) => ∀ n : ℕ, lo≤n → n<hi → 2∣n → ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p+q=n) (10^316-24576) (10^316) := by
  intro n hlo hhi even
  obtain ⟨m, hm⟩ := even
  change  ≤ n at hlo
  change n <  at hhi
  let i := -m
  have h1 : 1 ≤ i := by dsimp [i]; omega
  have h2 : i ≤ 12288 := by dsimp [i]; omega
  have hn : n+2*i =  := by dsimp [i]; omega
  obtain ⟨t, ht, hp⟩ := complementary i h1 h2
  have htMax := bounded t ht
  have hh := hp.two_le
  refine ⟨10^316-t, t-2*i, anchors t ht, hp, ?_⟩
  change -t+(t-2*i)=n
  omega

end Top316EndpointAssembly

theorem Conjectures.Goldbach.Rfc11Top316SixRepairs :
    (fun (lo hi : ℕ) => ∀ n : ℕ, lo≤n → n<hi → 2∣n → ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p+q=n) (10^316-24576) (10^316) :=
  Top316EndpointAssembly.result Conjectures.Goldbach.Rfc11Top316AnchorBank
