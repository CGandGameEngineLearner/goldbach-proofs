import Mathlib

set_option linter.unusedSimpArgs false
namespace CosRationalBound
open Real

private theorem integratePositive {f g : ℝ → ℝ} (h : Differentiable ℝ f)
    (hd : ∀ x, deriv f x = g x) (hzero : 0 ≤ f 0)
    (hg : ∀ x, 0 ≤ x → 0 ≤ g x) : ∀ x, 0 ≤ x → 0 ≤ f x := by
  have mono : MonotoneOn f (Set.Ici 0) :=
    monotoneOn_of_deriv_nonneg (convex_Ici _) h.continuous.continuousOn h.differentiableOn
      (fun x hx => (hd x).symm ▸ hg x (interior_subset hx))
  exact fun x hx => hzero.trans (mono (by simp) hx hx)

noncomputable def polynomial (x:ℝ) : ℝ := 1 - x^2/2 + x^4/24 - x^6/720 + x^8/40320 - x^10/3628800 + x^12/479001600 - x^14/87178291200

private theorem poly_lower (x:ℝ) (hx:0≤x) : polynomial x ≤ Real.cos x := by
  apply sub_nonneg.mp
  unfold polynomial
  have d14 : ∀ x:ℝ, 0 ≤ x → 0 ≤ -Real.cos x - (- 1) := by
    intro x _
    linarith only [Real.cos_le_one x]
  have d13 : ∀ x:ℝ, 0 ≤ x → 0 ≤ -Real.sin x - (- x) := by
    apply integratePositive (g := fun x => -Real.cos x - (- 1))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
    · norm_num
    · exact d14
  have d12 : ∀ x:ℝ, 0 ≤ x → 0 ≤ Real.cos x - (1 - x^2/2) := by
    apply integratePositive (g := fun x => -Real.sin x - (- x))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d13
  have d11 : ∀ x:ℝ, 0 ≤ x → 0 ≤ Real.sin x - (x - x^3/6) := by
    apply integratePositive (g := fun x => Real.cos x - (1 - x^2/2))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d12
  have d10 : ∀ x:ℝ, 0 ≤ x → 0 ≤ -Real.cos x - (- 1 + x^2/2 - x^4/24) := by
    apply integratePositive (g := fun x => Real.sin x - (x - x^3/6))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d11
  have d9 : ∀ x:ℝ, 0 ≤ x → 0 ≤ -Real.sin x - (- x + x^3/6 - x^5/120) := by
    apply integratePositive (g := fun x => -Real.cos x - (- 1 + x^2/2 - x^4/24))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d10
  have d8 : ∀ x:ℝ, 0 ≤ x → 0 ≤ Real.cos x - (1 - x^2/2 + x^4/24 - x^6/720) := by
    apply integratePositive (g := fun x => -Real.sin x - (- x + x^3/6 - x^5/120))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d9
  have d7 : ∀ x:ℝ, 0 ≤ x → 0 ≤ Real.sin x - (x - x^3/6 + x^5/120 - x^7/5040) := by
    apply integratePositive (g := fun x => Real.cos x - (1 - x^2/2 + x^4/24 - x^6/720))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d8
  have d6 : ∀ x:ℝ, 0 ≤ x → 0 ≤ -Real.cos x - (- 1 + x^2/2 - x^4/24 + x^6/720 - x^8/40320) := by
    apply integratePositive (g := fun x => Real.sin x - (x - x^3/6 + x^5/120 - x^7/5040))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d7
  have d5 : ∀ x:ℝ, 0 ≤ x → 0 ≤ -Real.sin x - (- x + x^3/6 - x^5/120 + x^7/5040 - x^9/362880) := by
    apply integratePositive (g := fun x => -Real.cos x - (- 1 + x^2/2 - x^4/24 + x^6/720 - x^8/40320))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d6
  have d4 : ∀ x:ℝ, 0 ≤ x → 0 ≤ Real.cos x - (1 - x^2/2 + x^4/24 - x^6/720 + x^8/40320 - x^10/3628800) := by
    apply integratePositive (g := fun x => -Real.sin x - (- x + x^3/6 - x^5/120 + x^7/5040 - x^9/362880))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d5
  have d3 : ∀ x:ℝ, 0 ≤ x → 0 ≤ Real.sin x - (x - x^3/6 + x^5/120 - x^7/5040 + x^9/362880 - x^11/39916800) := by
    apply integratePositive (g := fun x => Real.cos x - (1 - x^2/2 + x^4/24 - x^6/720 + x^8/40320 - x^10/3628800))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d4
  have d2 : ∀ x:ℝ, 0 ≤ x → 0 ≤ -Real.cos x - (- 1 + x^2/2 - x^4/24 + x^6/720 - x^8/40320 + x^10/3628800 - x^12/479001600) := by
    apply integratePositive (g := fun x => Real.sin x - (x - x^3/6 + x^5/120 - x^7/5040 + x^9/362880 - x^11/39916800))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d3
  have d1 : ∀ x:ℝ, 0 ≤ x → 0 ≤ -Real.sin x - (- x + x^3/6 - x^5/120 + x^7/5040 - x^9/362880 + x^11/39916800 - x^13/6227020800) := by
    apply integratePositive (g := fun x => -Real.cos x - (- 1 + x^2/2 - x^4/24 + x^6/720 - x^8/40320 + x^10/3628800 - x^12/479001600))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d2
  have d0 : ∀ x:ℝ, 0 ≤ x → 0 ≤ Real.cos x - (1 - x^2/2 + x^4/24 - x^6/720 + x^8/40320 - x^10/3628800 + x^12/479001600 - x^14/87178291200) := by
    apply integratePositive (g := fun x => -Real.sin x - (- x + x^3/6 - x^5/120 + x^7/5040 - x^9/362880 + x^11/39916800 - x^13/6227020800))
    · fun_prop
    · intro x
      simp (disch := fun_prop) [deriv_fun_sub, deriv_fun_add, Real.deriv_cos, Real.deriv_sin]
      ring
    · norm_num
    · exact d1
  exact d0 x hx

def folded (j:ℕ) : ℕ := min j (65536-j)

noncomputable def argument (j:ℕ) : ℝ := (3141592:ℝ) * (folded j:ℝ)/(32768*10^6)

theorem lower (j:ℕ) (hj:j≤65536) :
    polynomial (argument j) - 1/10^6 ≤ Real.cos (2*Real.pi*(j:ℝ)/65536) := by
  let r := folded j
  have rc : r≤32768 := by dsimp [r,folded];omega
  have rcast : (r:ℝ)≤32768 := by exact_mod_cast rc
  have fold : Real.cos (2*Real.pi*(j:ℝ)/65536) = Real.cos (Real.pi*(r:ℝ)/32768) := by
    by_cases h : j≤32768
    · have eq : r=j := by dsimp [r,folded];omega
      rw [eq];congr 1;ring
    · have eq : r=65536-j := by dsimp [r,folded];omega
      rw [eq,Nat.cast_sub hj];norm_num
      rw [show Real.pi * (65536 - (j:ℝ)) / 32768 = 2*Real.pi - 2*Real.pi*(j:ℝ)/65536 by ring, Real.cos_two_pi_sub]
  let u := argument j
  let v := Real.pi*(r:ℝ)/32768
  have rc0 : 0≤(r:ℝ) := by positivity
  have u0 : 0≤u := by dsimp [u,argument];positivity
  have eq : v-u = (Real.pi-3.141592)*(r:ℝ)/32768 := by dsimp [u,v,argument,r];ring
  have vn : 0≤v-u := by rw [eq];exact div_nonneg (mul_nonneg (sub_nonneg.mpr Real.pi_gt_d6.le) rc0) (by norm_num)
  have diff : v-u≤1/10^6 := by
    rw [eq]
    have cap := mul_le_mul (show Real.pi-3.141592≤(0.000001:ℝ) by linarith only [Real.pi_lt_d6]) rcast rc0 (by norm_num)
    linarith only [cap]
  have lip := Real.abs_cos_sub_cos_le v u
  rw [abs_of_nonneg vn] at lip
  have low := (abs_le.mp (lip.trans diff)).1
  rw [fold];change polynomial u - 1/10^6 ≤ Real.cos v
  linarith only [low,poly_lower u u0]

end CosRationalBound

open Finset
open scoped BigOperators
namespace FlipMeanAssembly
set_option maxRecDepth 4096
def flips (j : ℕ) := ((range 15).filter fun i => j.testBit i ≠ j.testBit (i+1)).card
def wt (j : ℕ) := 17^(flips j) * 183^(15-flips j)
def rad (j : ℕ) := min j (65536-j)
def moment (k : ℕ) : ℕ := ∑ a ∈ range 256, ∑ b ∈ range 256, wt (256*a+b) * rad (256*a+b)^k
private noncomputable def scale : ℝ := 3141592/(32768*10^6)
private noncomputable def evaluate : (ℕ → ℝ) →ₗ[ℝ] ℝ where
  toFun f := ∑ a ∈ range 256, ∑ b ∈ range 256, (wt (256*a+b):ℝ) * f (256*a+b)
  map_add' f g := by simp only [Pi.add_apply, mul_add, sum_add_distrib]
  map_smul' a f := by simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum, mul_left_comm]
private theorem evaluate_mono {f g : ℕ → ℝ} (h : ∀ j, j ≤ 65536 → f j ≤ g j) :
    evaluate f ≤ evaluate g := by
  dsimp only [evaluate, LinearMap.coe_mk, AddHom.coe_mk]
  apply sum_le_sum
  intro a ha
  apply sum_le_sum
  intro b hb
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  have ha' := Finset.mem_range.mp ha
  have hb' := Finset.mem_range.mp hb
  exact h _ (by omega)
private def monomial (k j : ℕ) : ℝ := (rad j : ℝ)^k
private theorem eval_mono (k : ℕ) : evaluate (monomial k) = (moment k:ℝ) := by
  simp only [evaluate, LinearMap.coe_mk, AddHom.coe_mk, monomial, moment, Nat.cast_sum,
    Nat.cast_mul, Nat.cast_pow]

private theorem numeric (h0 : moment 0 = 65536000000000000000000000000000000) (h1 : moment 2 = 6816321645532327741492287912169474497708032) (h2 : moment 4 = 5577513720022978514822244508628905347402978157395968) (h3 : moment 6 = 5469873556530933126422172753179938808934193750556206256095232) (h4 : moment 8 = 5616174026770673965654196784886675418318303963445712203637094264864768) (h5 : moment 10 = 5854845365403969522235084787634683688780462192001413201756130724339691586322432) (h6 : moment 12 = 6144411029942511749160273957705038724268824073611313403658766613474190330471286537453568) (h7 : moment 14 = 6472721346408609947965370229680190376572919820400885042283754558484355619916232065839304783429632) :
    (1863/2500:ℝ) * (2*200^15) < (1 - 1/(10:ℝ)^6) * (moment 0 : ℝ) + (-(scale^2/2)) * (moment 2 : ℝ) + (scale^4/24) * (moment 4 : ℝ) + (-(scale^6/720)) * (moment 6 : ℝ) + (scale^8/40320) * (moment 8 : ℝ) + (-(scale^10/3628800)) * (moment 10 : ℝ) + (scale^12/479001600) * (moment 12 : ℝ) + (-(scale^14/87178291200)) * (moment 14 : ℝ) := by
  rw [h0, h1, h2, h3, h4, h5, h6, h7]
  norm_num [scale]

attribute [local irreducible] evaluate moment monomial scale wt
set_option maxHeartbeats 480000 in
theorem combined
    (h0 : moment 0 = 65536000000000000000000000000000000)
    (h1 : moment 2 = 6816321645532327741492287912169474497708032)
    (h2 : moment 4 = 5577513720022978514822244508628905347402978157395968)
    (h3 : moment 6 = 5469873556530933126422172753179938808934193750556206256095232)
    (h4 : moment 8 = 5616174026770673965654196784886675418318303963445712203637094264864768)
    (h5 : moment 10 = 5854845365403969522235084787634683688780462192001413201756130724339691586322432)
    (h6 : moment 12 = 6144411029942511749160273957705038724268824073611313403658766613474190330471286537453568)
    (h7 : moment 14 = 6472721346408609947965370229680190376572919820400885042283754558484355619916232065839304783429632)
    (minor : ∀ j : ℕ, j ≤ 65536 →
        (1 - 1/(10:ℝ)^6) * monomial 0 j + (-(scale^2/2)) * monomial 2 j + (scale^4/24) * monomial 4 j + (-(scale^6/720)) * monomial 6 j + (scale^8/40320) * monomial 8 j + (-(scale^10/3628800)) * monomial 10 j + (scale^12/479001600) * monomial 12 j + (-(scale^14/87178291200)) * monomial 14 j ≤
        Real.cos (2*Real.pi*j/65536)) :
    (1863/2500 : ℝ) < evaluate (fun j : ℕ => Real.cos (2*Real.pi*j/65536))/(2*200^15) := by
  let f : ℕ → ℝ := (1 - 1/(10:ℝ)^6) • monomial 0 + (-(scale^2/2)) • monomial 2 + (scale^4/24) • monomial 4 + (-(scale^6/720)) • monomial 6 + (scale^8/40320) • monomial 8 + (-(scale^10/3628800)) • monomial 10 + (scale^12/479001600) • monomial 12 + (-(scale^14/87178291200)) • monomial 14
  have lo : evaluate f ≤ evaluate (fun j => Real.cos (2*Real.pi*j/65536)) := by
    apply evaluate_mono
    intro j hj
    simpa only [f, Pi.add_apply, Pi.smul_apply, smul_eq_mul] using (minor j hj)
  apply (lt_div_iff₀ (by positivity : 0 < (2:ℝ)*200^15)).mpr
  change (1863/2500:ℝ)*(2*200^15) < evaluate (fun j : ℕ => Real.cos (2*Real.pi*j/65536))
  refine lt_of_lt_of_le ?_ lo
  dsimp only [f]
  rw [map_add, map_add, map_add, map_add, map_add, map_add, map_add]
  simp only [map_smul, smul_eq_mul, eval_mono]
  exact numeric h0 h1 h2 h3 h4 h5 h6 h7
end FlipMeanAssembly

open Finset
namespace FlipMeanAssembly
theorem unroll {T : Type*} [AddCommMonoid T] (n B : ℕ) (g : ℕ → T) :
    (∑ j ∈ range (B*n), g j) = ∑ a ∈ range n, ∑ b ∈ range B, g (B*a+b) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Nat.mul_succ, Finset.sum_range_add, ih, Finset.sum_range_succ]
end FlipMeanAssembly

open Finset
namespace CosFiniteCertificate
def flips (j : ℕ) := ((Finset.range 15).filter fun i => j.testBit i ≠ j.testBit (i+1)).card
def weight (j : ℕ) : ℕ := 17 ^ flips j * 183 ^ (15-flips j)
def fold (j : ℕ) := min j (65536-j)
def mom (d : ℕ) := ∑ j ∈ Finset.range 65536, weight j * fold j ^ d

private def c (l j : ℕ) := ∑ i ∈ range l, if j.testBit i ≠ j.testBit (i+1) then 1 else 0
private def W (l j : ℕ) := 17^(c l j)*183^(l-c l j)
private theorem c_le (l j : ℕ) : c l j ≤ l := by
  unfold c
  exact (Finset.sum_le_sum (g := fun _ => 1) (fun _ _ => by split <;> omega)).trans_eq (by simp)
private theorem W_weight (j : ℕ) : W 15 j = weight j := by
  have hc : c 15 j = flips j := by unfold c flips; rw [Finset.card_filter]
  simp only [W, weight, hc]
private theorem c_succ (l j : ℕ) :
    c (l+1) j = c l (j/2) + (if j.testBit 0 ≠ j.testBit 1 then 1 else 0) := by
  simp only [c, sum_range_succ', Nat.testBit_div_two]
private theorem W_succ (l j : ℕ) :
    W (l+1) j = (if j.testBit 0 = j.testBit 1 then 183 else 17) * W l (j/2) := by
  have h := c_le l (j/2)
  unfold W
  rw [c_succ]
  split_ifs <;> try contradiction
  all_goals first | (simp only [Nat.add_zero]; rw [show l+1-c l (j/2) = (l-c l (j/2))+1 by omega, pow_succ]; ring)
                  | (rw [show l+1-(c l (j/2)+1) = l-c l (j/2) by omega, pow_succ]; ring)
private def edge (a b : ℕ) : ℕ := if a=b then 183 else 17
private theorem W_append (l j b : ℕ) (hb : b<2) :
    W (l+1) (2*j+b) = edge (j%2) b * W l j := by
  rw [W_succ, show (2*j+b)/2=j by omega]
  simp only [show 1 = Nat.succ 0 from rfl, Nat.testBit_succ, Nat.testBit_zero,
    show (2*j+b)%2=b by omega, show (2*j+b)/2=j by omega, edge]
  rcases Nat.mod_two_eq_zero_or_one j with h|h <;> interval_cases b <;> simp [h]
private theorem split_parity (n : ℕ) (f : ℕ → ℕ) :
    (∑ j ∈ range (2*n), f j) = ∑ j ∈ range n, (f (2*j)+f (2*j+1)) := by
  induction n with
  | zero => simp
  | succ n ih => rw [Nat.mul_succ, sum_range_succ, sum_range_succ, ih, sum_range_succ]; omega
private def M (l b d : ℕ) := ∑ j ∈ range (2^l), if j%2=b then W l j*j^d else 0
private theorem M_step (l b d : ℕ) (hb : b<2) :
    M (l+1) b d = ∑ j ∈ range (2^l), edge (j%2) b * W l j * (2*j+b)^d := by
  unfold M
  rw [pow_succ', split_parity]
  apply sum_congr rfl
  intro j _
  rw [show 2*j%2=0 by omega, show (2*j+1)%2=1 by omega,
    show W (l+1) (2*j) = edge (j%2) 0 * W l j by simpa using W_append l j 0 (by decide),
    W_append l j 1 (by decide)]
  interval_cases b <;> simp
private theorem M_base (b d : ℕ) : M 0 b d = if b=0 then 0^d else 0 := by
  simp [M, W, c, eq_comm]
private theorem mixed (l b h : ℕ) :
    (∑ j ∈ range (2^l), edge (j%2) b * (W l j*j^h)) =
    edge 0 b * M l 0 h + edge 1 b * M l 1 h := by
  simp only [M, mul_sum, ← sum_add_distrib]
  apply sum_congr rfl
  intro j _
  rcases Nat.mod_two_eq_zero_or_one j with hj|hj <;> simp [hj]
private theorem M_rec (l b d : ℕ) (hb : b<2) :
    M (l+1) b d =
      ∑ h ∈ range (d+1), (2^h*b^(d-h)*d.choose h) *
         (edge 0 b * M l 0 h + edge 1 b * M l 1 h) := by
  rw [M_step l b d hb]
  simp_rw [add_pow, mul_sum, mul_pow, ← mixed]
  rw [sum_comm]
  apply sum_congr rfl
  intro h _
  rw [mul_sum]
  apply sum_congr rfl
  intro j _
  simp only [Nat.cast_id]
  ring

private theorem mirror (j : ℕ) (hj : j<32768) : weight (65535-j) = weight j := by
  have hx : j < 2^16 := by omega
  have hbit (i : ℕ) (hi : i<16) : (65535-j).testBit i = !(j.testBit i) := by
    rw [show 65535-j=2^16-(j+1) by omega, Nat.testBit_two_pow_sub_succ hx]
    simp [hi]
  have hc : flips (65535-j) = flips j := by
    unfold flips
    congr 1
    ext i
    simp only [mem_filter, mem_range]
    refine and_congr_right fun hi => ?_
    rw [hbit i (by omega), hbit (i+1) (by omega)]
    cases j.testBit i <;> cases j.testBit (i+1) <;> decide
  simp only [weight, hc]
private def total (d : ℕ) := M 15 0 d + M 15 1 d
private theorem total_sum (d : ℕ) :
    (∑ j ∈ range 32768, W 15 j*j^d) = total d := by
  unfold total M
  rw [← sum_add_distrib]
  apply sum_congr (congrArg Finset.range (by decide))
  intro j _
  rcases Nat.mod_two_eq_zero_or_one j with h|h <;> simp [h]
private theorem mom_half (d : ℕ) :
    mom d = (∑ j ∈ range 32768, W 15 j*j^d) + ∑ j ∈ range 32768, W 15 j*(j+1)^d := by
  unfold mom
  change (∑ j ∈ range (32768+32768), _) = _
  rw [sum_range_add]
  apply congrArg₂ Nat.add
  · apply sum_congr rfl
    intro j hj
    have h : j<32768 := mem_range.mp hj
    rw [W_weight, fold, min_eq_left (by omega)]
  · rw [← sum_range_reflect (fun i => weight (32768+i)*fold (32768+i)^d) 32768]
    apply sum_congr rfl
    intro j hj
    have h : j<32768 := mem_range.mp hj
    rw [show 32768+(32768-1-j)=65535-j by omega, mirror j h, W_weight, fold,
      min_eq_right (by omega), show 65536-(65535-j)=j+1 by omega]
private theorem mom_formula (d : ℕ) :
    mom d = total d + ∑ h ∈ range (d+1), total h*d.choose h := by
  rw [mom_half, total_sum]
  apply congrArg (total d + ·)
  simp_rw [add_pow, one_pow, mul_one, Nat.cast_id, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro h _
  rw [← total_sum, sum_mul]
  apply sum_congr rfl
  intro j _
  ring

-- The rows are indexed by the number of appended bits, then by the final bit.
private def T : ℕ → ℕ → ℕ → ℕ
