      have h6 := (le_div_iff₀ h1δpos).mp hcore2
      linarith
    linarith
  have hhi_m : ((t.2.1 * t.2.2 : ℕ) : ℝ) ≤ (x : ℝ) / (TSw_U x j : ℝ) := by
    rw [le_div_iff₀ hUpos, mul_comm]
    exact hstep2
  have hα : TSw_alpha x j (t.2.1 * t.2.2) = 1 :=
    (TSw_alpha_eq_one_iff x j (t.2.1 * t.2.2)).mpr
      ⟨⟨t.2.1, t.2.2, ht2, ht3, htro, htle, rfl⟩, hlo_m, hhi_m⟩
  have hM : t.2.1 * t.2.2 ≤ TSw_M x j := Nat.le_floor hhi_m
  have hpairs : (t.2.1 * t.2.2, t.1) ∈ TSw_pairs x j := by
    unfold TSw_pairs
    refine Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨?_, ?_⟩, hα, hβ⟩
    · exact Finset.mem_Icc.mpr ⟨Nat.succ_le_of_lt (Nat.mul_pos ht2.pos ht3.pos), hM⟩
    · exact Finset.mem_Icc.mpr ⟨ht1.pos, hbox.2⟩
