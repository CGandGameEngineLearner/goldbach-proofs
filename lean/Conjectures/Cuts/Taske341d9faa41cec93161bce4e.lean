          (M * Real.sqrt (2 + H)) * (2 * R * Real.sqrt ((2 + H) * U)) :=
        mul_le_mul hA hB (by positivity) (by positivity)
      have hsq3 : Real.sqrt (2 + H) * Real.sqrt ((2 + H) * U) = (2 + H) * Real.sqrt U := by
        calc Real.sqrt (2 + H) * Real.sqrt ((2 + H) * U)
            = Real.sqrt ((2 + H) * ((2 + H) * U)) := by rw [← Real.sqrt_mul hT ((2 + H) * U)]
          _ = Real.sqrt ((2 + H) ^ 2 * U) := by congr 1; ring
          _ = (2 + H) * Real.sqrt U := by rw [Real.sqrt_mul (by positivity), Real.sqrt_sq hT]
      calc (1 / R) * ((Real.sqrt (M + 1 + (2 * R) ^ 2 * H) * Real.sqrt M) *
            (Real.sqrt (U + 1 + (2 * R) ^ 2 * H) * Real.sqrt U))
          ≤ (1 / R) * ((M * Real.sqrt (2 + H)) * (2 * R * Real.sqrt ((2 + H) * U))) :=
            mul_le_mul_of_nonneg_left hprod (by positivity)
        _ = (1 / R) * (2 * R * M * (Real.sqrt (2 + H) * Real.sqrt ((2 + H) * U))) := by ring
        _ = (1 / R) * (2 * R * M * ((2 + H) * Real.sqrt U)) := by rw [hsq3]
        _ = (2 + H) * (2 * M * Real.sqrt U) := by field_simp
        _ ≤ (2 + H) * (M * U / R + 2 * M * Real.sqrt U + 2 * U * Real.sqrt M +
              4 * R * Real.sqrt (M * U)) := by
            gcongr
            linarith
  · have hM' : M ≤ 4 * R ^ 2 := by linarith
    by_cases h2 : 4 * R ^ 2 ≤ U
    · have hA := (hfac M hM).2 hM'
      have hB := (hfac U hU).1 h2
      have hprod : (Real.sqrt (M + 1 + (2 * R) ^ 2 * H) * Real.sqrt M) *
          (Real.sqrt (U + 1 + (2 * R) ^ 2 * H) * Real.sqrt U) ≤
          (2 * R * Real.sqrt ((2 + H) * M)) * (U * Real.sqrt (2 + H)) :=
        mul_le_mul hA hB (by positivity) (by positivity)
      have hsq3 : Real.sqrt ((2 + H) * M) * Real.sqrt (2 + H) = (2 + H) * Real.sqrt M := by
        calc Real.sqrt ((2 + H) * M) * Real.sqrt (2 + H)
            = Real.sqrt ((2 + H) * M * (2 + H)) := by
                rw [← Real.sqrt_mul (by positivity) (2 + H)]
          _ = Real.sqrt ((2 + H) ^ 2 * M) := by congr 1; ring
          _ = (2 + H) * Real.sqrt M := by rw [Real.sqrt_mul (by positivity), Real.sqrt_sq hT]
      calc (1 / R) * ((Real.sqrt (M + 1 + (2 * R) ^ 2 * H) * Real.sqrt M) *
            (Real.sqrt (U + 1 + (2 * R) ^ 2 * H) * Real.sqrt U))
          ≤ (1 / R) * ((2 * R * Real.sqrt ((2 + H) * M)) * (U * Real.sqrt (2 + H))) :=
            mul_le_mul_of_nonneg_left hprod (by positivity)
        _ = (1 / R) * (2 * R * U * (Real.sqrt ((2 + H) * M) * Real.sqrt (2 + H))) := by ring
        _ = (1 / R) * (2 * R * U * ((2 + H) * Real.sqrt M)) := by rw [hsq3]
        _ = (2 + H) * (2 * U * Real.sqrt M) := by field_simp
        _ ≤ (2 + H) * (M * U / R + 2 * M * Real.sqrt U + 2 * U * Real.sqrt M +
              4 * R * Real.sqrt (M * U)) := by
            gcongr
            linarith
    · have hA := (hfac M hM).2 hM'
      have hB := (hfac U hU).2 (by linarith)
      have hprod : (Real.sqrt (M + 1 + (2 * R) ^ 2 * H) * Real.sqrt M) *
          (Real.sqrt (U + 1 + (2 * R) ^ 2 * H) * Real.sqrt U) ≤
          (2 * R * Real.sqrt ((2 + H) * M)) * (2 * R * Real.sqrt ((2 + H) * U)) :=
        mul_le_mul hA hB (by positivity) (by positivity)
      have hsq4 : Real.sqrt ((2 + H) * M) * Real.sqrt ((2 + H) * U) =
