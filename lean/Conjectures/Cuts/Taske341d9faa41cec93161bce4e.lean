lemma TSw_defect_nonneg (x j d : ℕ) : 0 ≤ TSw_defectSum x j d := by
  unfold TSw_defectSum
  refine Finset.sum_nonneg fun n _ => ?_
  split_ifs
  · exact le_rfl
  · exact TSw_seq_nonneg x j n

lemma TSw_defect_eq (x j d : ℕ) :
    TSw_defectSum x j d =
      ∑ p ∈ (Finset.Icc 1 (TSw_M x j) ×ˢ Finset.Icc 1 (TSw_U x j)),
        (if ¬ Nat.Coprime (p.1 * p.2) d then TSw_alpha x j p.1 * TSw_beta x j p.2 else 0) := by
  unfold TSw_defectSum TSw_seq Taske724d7d203de1af512de02c5_convSeq
  calc
    ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j),
        (if ¬ Nat.Coprime n d then
          ∑ m ∈ Finset.Icc 1 (TSw_M x j), ∑ k ∈ Finset.Icc 1 (TSw_U x j),
            if m * k = n then TSw_alpha x j m * TSw_beta x j k else 0 else 0)
      = ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j),
          ∑ p ∈ (Finset.Icc 1 (TSw_M x j) ×ˢ Finset.Icc 1 (TSw_U x j)),
            if ¬ Nat.Coprime n d then
              (if p.1 * p.2 = n then TSw_alpha x j p.1 * TSw_beta x j p.2 else 0) else 0 := by
        refine Finset.sum_congr rfl fun n _ => ?_
        split_ifs with h
        · simp
        · exact (Finset.sum_product (Finset.Icc 1 (TSw_M x j)) (Finset.Icc 1 (TSw_U x j))
            (fun q : ℕ × ℕ =>
              if q.1 * q.2 = n then TSw_alpha x j q.1 * TSw_beta x j q.2 else 0)).symm
    _ = ∑ p ∈ (Finset.Icc 1 (TSw_M x j) ×ˢ Finset.Icc 1 (TSw_U x j)),
          ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j),
            if ¬ Nat.Coprime n d then
              (if p.1 * p.2 = n then TSw_alpha x j p.1 * TSw_beta x j p.2 else 0) else 0 :=
        Finset.sum_comm
    _ = ∑ p ∈ (Finset.Icc 1 (TSw_M x j) ×ˢ Finset.Icc 1 (TSw_U x j)),
          (if ¬ Nat.Coprime (p.1 * p.2) d then TSw_alpha x j p.1 * TSw_beta x j p.2 else 0) := by
        refine Finset.sum_congr rfl fun p hp => ?_
        have hm := (Finset.mem_product.mp hp).1
        have hk := (Finset.mem_product.mp hp).2
        have hm1 := (Finset.mem_Icc.mp hm).1
        have hk1 := (Finset.mem_Icc.mp hk).1
        have hmem : p.1 * p.2 ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j) :=
          Finset.mem_Icc.mpr ⟨by calc 1 = 1 * 1 := rfl
              _ ≤ p.1 * p.2 := Nat.mul_le_mul hm1 hk1,
            Nat.mul_le_mul (Finset.mem_Icc.mp hm).2 (Finset.mem_Icc.mp hk).2⟩
        rw [Finset.sum_eq_single (p.1 * p.2)]
        · simp
        · intro n _ hn
          have hne : p.1 * p.2 ≠ n := fun h => hn h.symm
          simp [hne]
        · intro h
          exact absurd hmem h

/-- A prime dividing the product of a pair of a box and a divisor of the odd product is the
small prime of the pair. -/
lemma TSw_pair_dvd {x j m k d : ℕ} (hpair : (m, k) ∈ TSw_pairs x j)
    (hdP : d ∣ Taske724d7d203de1af512de02c5_chen_A1_lower_aux_oddProd
      (Taske724d7d203de1af512de02c5_w x))
    (hcop : ¬ Nat.Coprime (m * k) d)
    (hwroot : Taske724d7d203de1af512de02c5_w x ≤ Taske724d7d203de1af512de02c5_root x) :
    k ∣ d := by
  obtain ⟨hm, hk, hα, hβ⟩ := TSw_pairs_mem hpair
  obtain ⟨⟨p2, p3, hp2, hp3, hroot, hle, hmeq⟩, hlo, hhi⟩ := TSw_alpha_spec hα
  obtain ⟨hL, hU, hkP⟩ := TSw_beta_spec hβ
  have hPne : Taske724d7d203de1af512de02c5_chen_A1_lower_aux_oddProd
      (Taske724d7d203de1af512de02c5_w x) ≠ 0 :=
    (Taske724d7d203de1af512de02c5_chen_A1_lower_aux_oddProd_squarefree _).ne_zero
  have hgcd : Nat.gcd (m * k) d ≠ 1 := hcop
  obtain ⟨p, hp, hpg⟩ := Nat.exists_prime_and_dvd hgcd
  have hpmk : p ∣ m * k := dvd_trans hpg (Nat.gcd_dvd_left _ _)
  have hpd : p ∣ d := dvd_trans hpg (Nat.gcd_dvd_right _ _)
  have hpP : p ∈ (Taske724d7d203de1af512de02c5_chen_A1_lower_aux_oddProd
      (Taske724d7d203de1af512de02c5_w x)).primeFactors :=
    Nat.mem_primeFactors.mpr ⟨hp, dvd_trans hpd hdP, hPne⟩
  rw [Taske724d7d203de1af512de02c5_chen_A1_lower_aux_oddProd_factors] at hpP
  have hpw : p < Taske724d7d203de1af512de02c5_w x :=
    (Taske724d7d203de1af512de02c5_chen_A1_lower_aux_mem_oddPrimes hpP).2.2
  rcases hp.dvd_mul.mp hpmk with hpm | hpk
  · exfalso
    rw [hmeq] at hpm
    rcases hp.dvd_mul.mp hpm with hp2d | hp3d
    · have heq : p2 = p := (hp2.dvd_iff_eq hp.ne_one).mp hp2d
      omega
    · have heq : p3 = p := (hp3.dvd_iff_eq hp.ne_one).mp hp3d
      omega
  · have heq : k = p := (hkP.dvd_iff_eq hp.ne_one).mp hpk
    exact heq.symm ▸ hpd



lemma TSw_totient_prod {P : ℕ} (hP : Squarefree P) {s : Finset ℕ} (hs : s ⊆ P.primeFactors) :
    (1 / ((s.prod id).totient : ℝ)) = ∏ p ∈ s, (1 / ((p : ℝ) - 1)) := by
  have hpr : ∀ p ∈ s, p.Prime := fun p hp => Nat.prime_of_mem_primeFactors (hs hp)
  have h1 := progressionDensity_mult.map_prod_of_prime s hpr
  have h1'' : progressionDensity (∏ a ∈ s, a) = ∏ p ∈ s, (1 / ((p : ℝ) - 1)) := by
    rw [h1]
    exact Finset.prod_congr rfl fun p hp => progressionDensity_prime (hpr p hp)
  have h1' : progressionDensity (s.prod id) = ∏ p ∈ s, (1 / ((p : ℝ) - 1)) := h1''
  have h3 : progressionDensity (s.prod id) = ((s.prod id).totient : ℝ)⁻¹ := rfl
  rw [h3] at h1'
  have h4 : (1 / ((s.prod id).totient : ℝ)) = ((s.prod id).totient : ℝ)⁻¹ := one_div _
  rw [h4]
  exact h1'

lemma TSw_sum_seq_eq (x j : ℕ) :
    ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j), TSw_seq x j n =
      ∑ p ∈ (Finset.Icc 1 (TSw_M x j) ×ˢ Finset.Icc 1 (TSw_U x j)),
        TSw_alpha x j p.1 * TSw_beta x j p.2 := by
  calc ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j), TSw_seq x j n
      = ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j),
          ∑ p ∈ (Finset.Icc 1 (TSw_M x j) ×ˢ Finset.Icc 1 (TSw_U x j)),
            if p.1 * p.2 = n then TSw_alpha x j p.1 * TSw_beta x j p.2 else 0 := by
        refine Finset.sum_congr rfl fun n _ => ?_
        unfold TSw_seq Taske724d7d203de1af512de02c5_convSeq
        rw [Finset.sum_product]
    _ = ∑ p ∈ (Finset.Icc 1 (TSw_M x j) ×ˢ Finset.Icc 1 (TSw_U x j)),
          ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j),
            if p.1 * p.2 = n then TSw_alpha x j p.1 * TSw_beta x j p.2 else 0 :=
        Finset.sum_comm
    _ = ∑ p ∈ (Finset.Icc 1 (TSw_M x j) ×ˢ Finset.Icc 1 (TSw_U x j)),
          TSw_alpha x j p.1 * TSw_beta x j p.2 := by
        refine Finset.sum_congr rfl fun p hp => ?_
        have hm := (Finset.mem_product.mp hp).1
        have hk := (Finset.mem_product.mp hp).2
        have hm1 := (Finset.mem_Icc.mp hm).1
        have hk1 := (Finset.mem_Icc.mp hk).1
        have hmem : p.1 * p.2 ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j) :=
          Finset.mem_Icc.mpr ⟨by calc 1 = 1 * 1 := rfl
              _ ≤ p.1 * p.2 := Nat.mul_le_mul hm1 hk1,
            Nat.mul_le_mul (Finset.mem_Icc.mp hm).2 (Finset.mem_Icc.mp hk).2⟩
        rw [Finset.sum_eq_single (p.1 * p.2)]
        · rw [if_pos rfl]
        · intro n _ hn
          rw [if_neg (fun h => hn h.symm)]
        · intro h
          exact absurd hmem h
lemma TSw_prod_nonneg {P : ℕ} :
    0 ≤ ∏ p ∈ P.primeFactors, (1 + 1 / ((p : ℝ) - 1)) := by
  refine Finset.prod_nonneg fun p hp => ?_
  have hpr : p.Prime := Nat.prime_of_mem_primeFactors hp
  have hp1 : (1 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hpr.pos
  have hnn : (0 : ℝ) ≤ 1 / ((p : ℝ) - 1) := div_nonneg zero_le_one (by linarith)
  linarith

lemma TSw_one_le_prod {s : Finset ℕ} {g : ℕ → ℝ} (h : ∀ p ∈ s, 1 ≤ g p) :
    1 ≤ ∏ p ∈ s, g p := by
  induction s using Finset.induction with
  | empty => simp
  | @insert a s ha ih =>
    rw [Finset.prod_insert ha]
    have h1 : 1 ≤ g a := h a (Finset.mem_insert_self a s)
    have h2 : 1 ≤ ∏ p ∈ s, g p := ih (fun p hp => h p (Finset.mem_insert_of_mem hp))
    calc (1 : ℝ) = 1 * 1 := by ring
      _ ≤ g a * ∏ p ∈ s, g p := mul_le_mul h1 h2 (by norm_num) (by linarith)

lemma TSw_prod_le_prod {s : Finset ℕ} {f g : ℕ → ℝ} (h : ∀ p ∈ s, f p ≤ g p)
    (hfg : ∀ p ∈ s, 0 ≤ f p) (hg : ∀ p ∈ s, 0 ≤ g p) :
    ∏ p ∈ s, f p ≤ ∏ p ∈ s, g p := by
  induction s using Finset.induction with
  | empty => simp
  | @insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha]
    have h1 : f a ≤ g a := h a (Finset.mem_insert_self a s)
    have h2 : ∏ p ∈ s, f p ≤ ∏ p ∈ s, g p :=
      ih (fun p hp => h p (Finset.mem_insert_of_mem hp))
        (fun p hp => hfg p (Finset.mem_insert_of_mem hp))
        (fun p hp => hg p (Finset.mem_insert_of_mem hp))
    have h3 : 0 ≤ ∏ p ∈ s, f p :=
      Finset.prod_nonneg (fun p hp => hfg p (Finset.mem_insert_of_mem hp))
    have h4 : 0 ≤ g a := hg a (Finset.mem_insert_self a s)
    calc f a * ∏ p ∈ s, f p ≤ g a * ∏ p ∈ s, f p := mul_le_mul_of_nonneg_right h1 h3
      _ ≤ g a * ∏ p ∈ s, g p := mul_le_mul_of_nonneg_left h2 h4

lemma TSw_prod_mono_subset {s t : Finset ℕ} (hst : s ⊆ t) {g : ℕ → ℝ}
    (h1 : ∀ p ∈ t, 1 ≤ g p) :
    ∏ p ∈ s, g p ≤ ∏ p ∈ t, g p := by
  have hsplit : ∏ p ∈ t, g p = (∏ p ∈ t \ s, g p) * (∏ p ∈ s, g p) :=
    (Finset.prod_sdiff hst).symm
  rw [hsplit, mul_comm]
  have hle : 1 ≤ ∏ p ∈ t \ s, g p :=
    TSw_one_le_prod (fun p hp => h1 p (Finset.mem_sdiff.mp hp).1)
  have hnn : 0 ≤ ∏ p ∈ s, g p :=
    Finset.prod_nonneg (fun p hp => by linarith [h1 p (hst hp)])
  calc ∏ p ∈ s, g p = (∏ p ∈ s, g p) * 1 := by ring
    _ ≤ (∏ p ∈ s, g p) * (∏ p ∈ t \ s, g p) := mul_le_mul_of_nonneg_left hle hnn

lemma TSw_sum_inv_totient_dvd_aux1 {P : ℕ} (hP : Squarefree P) {k : ℕ} (hk : k.Prime) :
    ∑ s ∈ P.primeFactors.powerset,
      (if k ∣ s.prod id then (1 / ((s.prod id).totient : ℝ)) else 0) =
      ∑ s ∈ P.primeFactors.powerset,
        (if k ∈ s then ∏ p ∈ s, (1 / ((p : ℝ) - 1)) else 0) := by
  have hcond : ∀ s ∈ P.primeFactors.powerset, (k ∣ s.prod id) ↔ k ∈ s := by
    intro s hs
    have hsub : s ⊆ P.primeFactors := Finset.mem_powerset.mp hs
    constructor
    · intro hdiv
      obtain ⟨p, hps, hkp⟩ := (hk.prime.dvd_finsetProd_iff id).mp hdiv
      have hpp : p.Prime := Nat.prime_of_mem_primeFactors (hsub hps)
      have heq : p = k := (hpp.dvd_iff_eq hk.ne_one).mp hkp
      exact heq ▸ hps
    · intro hmem
      exact Finset.dvd_prod_of_mem _ hmem
  refine Finset.sum_congr rfl fun s hs => ?_
  by_cases hks : k ∈ s
  · rw [if_pos ((hcond s hs).mpr hks), if_pos hks,
      TSw_totient_prod hP (Finset.mem_powerset.mp hs)]
  · rw [if_neg (fun h => hks ((hcond s hs).mp h)), if_neg hks]

lemma TSw_sum_inv_totient_dvd_aux2 {P k : ℕ} (hkP : k ∈ P.primeFactors) :
    ∑ s ∈ P.primeFactors.powerset,
        (if k ∈ s then ∏ p ∈ s, (1 / ((p : ℝ) - 1)) else 0) =
      (1 / ((k : ℝ) - 1)) * ∏ p ∈ (P.primeFactors.erase k), (1 + 1 / ((p : ℝ) - 1)) := by
  have hkn : k ∉ P.primeFactors.erase k := Finset.notMem_erase k P.primeFactors
  have hT : P.primeFactors = insert k (P.primeFactors.erase k) := (Finset.insert_erase hkP).symm
  have hdisj : Disjoint (P.primeFactors.erase k).powerset
      ((P.primeFactors.erase k).powerset.image (insert k)) := by
    rw [Finset.disjoint_left]
    intro s hs hs'
    obtain ⟨t, ht, hst⟩ := Finset.mem_image.mp hs'
    have h1 : k ∈ s := by rw [← hst]; exact Finset.mem_insert_self k t
    exact hkn (Finset.mem_powerset.mp hs h1)
  have hinj : Set.InjOn (fun s : Finset ℕ => insert k s)
      (↑((P.primeFactors.erase k).powerset) : Set (Finset ℕ)) := by
    intro s hs t ht hst
    have hsa : k ∉ s := fun hmem => hkn (Finset.mem_powerset.mp hs hmem)
    have hta : k ∉ t := fun hmem => hkn (Finset.mem_powerset.mp ht hmem)
    dsimp only at hst
    have her := congrArg (fun u : Finset ℕ => u.erase k) hst
    simpa [Finset.erase_insert hsa, Finset.erase_insert hta] using her
  have hfirst : ∑ s ∈ (P.primeFactors.erase k).powerset,
      (if k ∈ s then ∏ p ∈ s, (1 / ((p : ℝ) - 1)) else 0) = 0 := by
    refine Finset.sum_eq_zero fun s hs => ?_
    have hks : k ∉ s := fun hmem => hkn (Finset.mem_powerset.mp hs hmem)
    rw [if_neg hks]
  have hsecond : ∑ s ∈ (P.primeFactors.erase k).powerset.image (insert k),
      (if k ∈ s then ∏ p ∈ s, (1 / ((p : ℝ) - 1)) else 0) =
      ∑ t ∈ (P.primeFactors.erase k).powerset,
        (1 / ((k : ℝ) - 1)) * ∏ p ∈ t, (1 / ((p : ℝ) - 1)) := by
    rw [Finset.sum_image hinj]
    refine Finset.sum_congr rfl fun t ht => ?_
    have hkt : k ∉ t := fun hmem => hkn (Finset.mem_powerset.mp ht hmem)
    rw [if_pos (Finset.mem_insert_self k t), Finset.prod_insert hkt]
  have hsplit : ∑ s ∈ P.primeFactors.powerset,
      (if k ∈ s then ∏ p ∈ s, (1 / ((p : ℝ) - 1)) else 0) =
      ∑ s ∈ (P.primeFactors.erase k).powerset,
          (if k ∈ s then ∏ p ∈ s, (1 / ((p : ℝ) - 1)) else 0) +
        ∑ s ∈ (P.primeFactors.erase k).powerset.image (insert k),
          (if k ∈ s then ∏ p ∈ s, (1 / ((p : ℝ) - 1)) else 0) := by
    conv_lhs => rw [hT, Finset.powerset_insert (P.primeFactors.erase k) k,
      Finset.sum_union hdisj]
  rw [hsplit, hfirst, hsecond, zero_add, ← Finset.mul_sum, TSw_sum_powerset_prod]

