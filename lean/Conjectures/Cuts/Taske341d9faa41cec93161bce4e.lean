open Finset
open Classical
open Filter
open scoped BigOperators
open GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens

namespace A2C

noncomputable def V (y : ℕ) : ℝ :=
  ∏ p ∈ (Finset.Icc 3 (y - 1)).filter Nat.Prime, (1 - 1 / ((p : ℝ) - 1))

noncomputable def gV (y : ℕ) : ℝ := Real.log (V y) + Real.log (Real.log (y : ℝ))

/-! ### Per-prime bounds -/

private lemma inv_sub_one_le_half {p : ℕ} (hp : 3 ≤ p) :
    1 / ((p : ℝ) - 1) ≤ 1 / 2 := by
  have hpR : (3 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp
  have h1 : (0 : ℝ) < (p : ℝ) - 1 := by linarith
  rw [div_le_div_iff₀ h1 (by norm_num)]
  linarith

private lemma log_factor_upper {p : ℕ} (hp : 3 ≤ p) :
    Real.log (1 - 1 / ((p : ℝ) - 1)) ≤ -(1 / ((p : ℝ) - 1)) := by
  have h := inv_sub_one_le_half hp
  have hpos : 0 < 1 - 1 / ((p : ℝ) - 1) := by linarith
  have hlog := Real.log_le_sub_one_of_pos hpos
  linarith

private lemma log_factor_lower {p : ℕ} (hp : 3 ≤ p) :
    -(1 / ((p : ℝ) - 1)) - 2 * (1 / ((p : ℝ) - 1)) ^ 2 ≤
      Real.log (1 - 1 / ((p : ℝ) - 1)) := by
  have hpR : (3 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp
  have h1 : (0 : ℝ) < (p : ℝ) - 1 := by linarith
  set u : ℝ := 1 / ((p : ℝ) - 1)
  have hu0 : 0 < u := by positivity
  have hu : u ≤ 1 / 2 := inv_sub_one_le_half hp
  have hpos : 0 < 1 - u := by linarith
  have hrec : 0 < (1 - u)⁻¹ := by positivity
  have h := Real.log_le_sub_one_of_pos hrec
  rw [Real.log_inv] at h
  have h2 : (1 - u)⁻¹ - 1 = u / (1 - u) := by
    field_simp [hpos.ne']
    ring
  rw [h2] at h
  have h3 : u / (1 - u) ≤ u + 2 * u ^ 2 := by
    rw [div_le_iff₀ hpos]
    nlinarith [hu]
  change -u - 2 * u ^ 2 ≤ Real.log (1 - u)
  linarith

private lemma factor_pos {p : ℕ} (hp : 3 ≤ p) : 0 < 1 - 1 / ((p : ℝ) - 1) := by
  have h := inv_sub_one_le_half hp
  linarith

/-! ### Log of the product -/

private lemma log_V (y : ℕ) :
    Real.log (V y) =
      ∑ p ∈ (Finset.Icc 3 (y - 1)).filter Nat.Prime,
        Real.log (1 - 1 / ((p : ℝ) - 1)) := by
  unfold V
  apply Real.log_prod
  intro p hp
  have hp3 : 3 ≤ p := (Finset.mem_Icc.mp (Finset.mem_filter.mp hp).1).1
  have := factor_pos hp3
  linarith

private lemma V_pos (y : ℕ) : 0 < V y := by
  unfold V
  refine Finset.prod_pos fun p hp => ?_
  have hp3 : 3 ≤ p := (Finset.mem_Icc.mp (Finset.mem_filter.mp hp).1).1
  exact factor_pos hp3

/-! ### Telescoping and real-arithmetic helpers -/

private lemma sum_Icc_telescope_shift {c : ℝ} {y N : ℕ} (h : y ≤ N) :
    (∑ n ∈ Finset.Icc y N, (1 / ((n : ℝ) - c - 1) - 1 / ((n : ℝ) - c))) =
      1 / ((y : ℝ) - c - 1) - 1 / ((N : ℝ) - c) := by
  induction N with
  | zero =>
    have hy0 : y = 0 := by omega
    subst hy0
    simp
  | succ N ih =>
    rcases Nat.lt_or_ge y (N + 1) with hlt | hle
    · have hle' : y ≤ N := by omega
      rw [Finset.sum_Icc_succ_top (by omega : y ≤ N + 1), ih hle']
      push_cast
      ring
    · have hyN : y = N + 1 := by omega
      subst hyN
      simp

private lemma log_le_half (m : ℕ) (hm : 4 ≤ m) : Real.log (m : ℝ) ≤ (m : ℝ) / 2 := by
  have hmR : (4 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hpos : 0 < (m : ℝ) / 2 := by linarith
  have h := Real.log_le_sub_one_of_pos hpos
  have hlog2 : Real.log 2 ≤ 1 := by
    have := Real.log_two_lt_d9
    linarith
  have hsplit : Real.log (m : ℝ) = Real.log ((m : ℝ) / 2) + Real.log 2 := by
    have h2 : (0 : ℝ) < 2 := by norm_num
    rw [← Real.log_mul hpos.ne' h2.ne']
    congr 1
    ring
  linarith

private lemma log_pred_ge_half (m : ℕ) (hm : 4 ≤ m) :
    Real.log (m : ℝ) / 2 ≤ Real.log ((m - 1 : ℕ) : ℝ) := by
  have hmR : (4 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hcast : ((m - 1 : ℕ) : ℝ) = (m : ℝ) - 1 := by
    rw [Nat.cast_sub (by omega)]
    push_cast
    ring
  have hlogm : 2 * Real.log 2 ≤ Real.log (m : ℝ) := by
    have h4 : Real.log (4 : ℝ) = 2 * Real.log 2 := by
      have h4' : (4 : ℝ) = 2 * 2 := by norm_num
      rw [h4', Real.log_mul (by norm_num) (by norm_num)]
      ring
    have hle : Real.log (4 : ℝ) ≤ Real.log (m : ℝ) := Real.log_le_log (by norm_num) hmR
    linarith
  have h1 : (m : ℝ) / 2 ≤ (m : ℝ) - 1 := by linarith
  have hpos : 0 < (m : ℝ) / 2 := by linarith
  have h := Real.log_le_log hpos h1
  have hsplit : Real.log ((m : ℝ) / 2) = Real.log (m : ℝ) - Real.log 2 := by
    rw [Real.log_div (by linarith) (by norm_num)]
  have hlog2 : Real.log 2 ≤ 1 := by
    have := Real.log_two_lt_d9
    linarith
  rw [hcast]
  linarith

private lemma loglog_pred (m : ℕ) (hm : 4 ≤ m) :
    |Real.log (Real.log (m : ℝ)) - Real.log (Real.log ((m - 1 : ℕ) : ℝ))| ≤
      2 * (1 / Real.log (m : ℝ)) := by
  have hmR : (4 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hcast : ((m - 1 : ℕ) : ℝ) = (m : ℝ) - 1 := by
    rw [Nat.cast_sub (by omega)]
    push_cast
    ring
  have hlm : 0 < Real.log (m : ℝ) := Real.log_pos (by linarith)
  have hlm1 : 0 < Real.log ((m : ℝ) - 1) := Real.log_pos (by linarith)
  have hle : Real.log ((m : ℝ) - 1) ≤ Real.log (m : ℝ) :=
    Real.log_le_log (by linarith) (by linarith)
  have hhalf := log_pred_ge_half m hm
  rw [hcast] at hhalf
  have hstep : Real.log (Real.log (m : ℝ)) - Real.log (Real.log ((m : ℝ) - 1)) ≤
      2 * (1 / Real.log (m : ℝ)) := by
    have h1 : Real.log (Real.log (m : ℝ)) - Real.log (Real.log ((m : ℝ) - 1)) =
        Real.log (Real.log (m : ℝ) / Real.log ((m : ℝ) - 1)) := by
      rw [Real.log_div hlm.ne' hlm1.ne']
    have hpos : 0 < Real.log (m : ℝ) / Real.log ((m : ℝ) - 1) := div_pos hlm hlm1
    have h2 := Real.log_le_sub_one_of_pos hpos
    have h3 : Real.log (m : ℝ) / Real.log ((m : ℝ) - 1) - 1 =
        (Real.log (m : ℝ) - Real.log ((m : ℝ) - 1)) / Real.log ((m : ℝ) - 1) := by
      field_simp [hlm1.ne']
    have h4 : Real.log (m : ℝ) - Real.log ((m : ℝ) - 1) ≤ 1 := by
      have h5 : Real.log (m : ℝ) - Real.log ((m : ℝ) - 1) =
          Real.log ((m : ℝ) / ((m : ℝ) - 1)) := by
        rw [Real.log_div (by linarith) (by linarith)]
      have h6 := Real.log_le_sub_one_of_pos (x := (m : ℝ) / ((m : ℝ) - 1))
        (div_pos (by linarith) (by linarith))
      have h7 : (m : ℝ) / ((m : ℝ) - 1) - 1 = 1 / ((m : ℝ) - 1) := by
        have hne : (m : ℝ) - 1 ≠ 0 := by linarith
        field_simp [hne]
        ring
      have h8 : 1 / ((m : ℝ) - 1) ≤ 1 := by
        rw [div_le_iff₀ (by linarith)]
        linarith
      linarith
    have h5 : 1 / Real.log ((m : ℝ) - 1) ≤ 2 * (1 / Real.log (m : ℝ)) := by
      rw [show 2 * (1 / Real.log (m : ℝ)) = 2 / Real.log (m : ℝ) by ring,
        div_le_div_iff₀ hlm1 hlm]
      linarith
    have h6 : (Real.log (m : ℝ) - Real.log ((m : ℝ) - 1)) / Real.log ((m : ℝ) - 1) =
        (Real.log (m : ℝ) - Real.log ((m : ℝ) - 1)) * (1 / Real.log ((m : ℝ) - 1)) := by
      ring
    have h7 : (Real.log (m : ℝ) - Real.log ((m : ℝ) - 1)) * (1 / Real.log ((m : ℝ) - 1)) ≤
        1 * (2 * (1 / Real.log (m : ℝ))) := by
      have h8 : 0 ≤ Real.log (m : ℝ) - Real.log ((m : ℝ) - 1) := by linarith
      have h9 : 0 ≤ 1 / Real.log ((m : ℝ) - 1) := by positivity
      exact mul_le_mul h4 h5 h9 (by norm_num)
    linarith
  rw [hcast]
  rw [abs_le]
  refine ⟨?_, hstep⟩
  have h : Real.log (Real.log ((m : ℝ) - 1)) ≤ Real.log (Real.log (m : ℝ)) :=
    Real.log_le_log hlm1 hle
  have hpos : 0 ≤ 2 * (1 / Real.log (m : ℝ)) := by positivity
  linarith

/-! ### Primes in a short interval -/

private def PT (y y' : ℕ) : Finset ℕ := (Finset.Icc y (y' - 1)).filter Nat.Prime

private lemma mem_PT {y y' p : ℕ} (hp : p ∈ PT y y') : y ≤ p ∧ p ≤ y' - 1 ∧ p.Prime := by
  have h := Finset.mem_filter.mp hp
  rw [Finset.mem_Icc] at h
  exact ⟨h.1.1, h.1.2, h.2⟩

private lemma log_V_diff {y y' : ℕ} (hy : 4 ≤ y) (hyy : y ≤ y') :
    Real.log (V y') - Real.log (V y) =
      ∑ p ∈ PT y y', Real.log (1 - 1 / ((p : ℝ) - 1)) := by
  rw [log_V, log_V]
  have hS : (Finset.Icc 3 (y' - 1)).filter Nat.Prime =
      (Finset.Icc 3 (y - 1)).filter Nat.Prime ∪ PT y y' := by
    ext p
    simp only [Finset.mem_filter, Finset.mem_Icc, Finset.mem_union, PT]
    constructor
    · rintro ⟨⟨h3, hle⟩, hp⟩
      by_cases h : p < y
      · exact Or.inl ⟨⟨h3, by omega⟩, hp⟩
      · exact Or.inr ⟨⟨by omega, hle⟩, hp⟩
    · rintro (⟨⟨h3, hle⟩, hp⟩ | ⟨⟨hlo, hle⟩, hp⟩)
      · exact ⟨⟨h3, by omega⟩, hp⟩
      · exact ⟨⟨by omega, hle⟩, hp⟩
  have hdisj : Disjoint ((Finset.Icc 3 (y - 1)).filter Nat.Prime) (PT y y') := by
    rw [Finset.disjoint_left]
    intro p hp1 hp2
    have h1 := (Finset.mem_filter.mp hp1).1
    have h2 := mem_PT hp2
    rw [Finset.mem_Icc] at h1
    omega
  rw [hS, Finset.sum_union hdisj]
  ring

private lemma sum_log_factor_lower {y y' : ℕ} (hy : 4 ≤ y) :
    -(∑ p ∈ PT y y', (1 / ((p : ℝ) - 1))) - (∑ p ∈ PT y y', 2 * (1 / ((p : ℝ) - 1)) ^ 2) ≤
      ∑ p ∈ PT y y', Real.log (1 - 1 / ((p : ℝ) - 1)) := by
  have h1 : -(∑ p ∈ PT y y', (1 / ((p : ℝ) - 1))) - (∑ p ∈ PT y y', 2 * (1 / ((p : ℝ) - 1)) ^ 2) =
      ∑ p ∈ PT y y', (-(1 / ((p : ℝ) - 1)) - 2 * (1 / ((p : ℝ) - 1)) ^ 2) := by
    rw [Finset.sum_sub_distrib, Finset.sum_neg_distrib]
  rw [h1]
  refine Finset.sum_le_sum fun p hp => ?_
  have hp3 : 3 ≤ p := by have := (mem_PT hp).1; omega
  exact log_factor_lower hp3

private lemma sum_log_factor_upper {y y' : ℕ} (hy : 4 ≤ y) :
    (∑ p ∈ PT y y', Real.log (1 - 1 / ((p : ℝ) - 1))) ≤
      -(∑ p ∈ PT y y', (1 / ((p : ℝ) - 1))) := by
  rw [← Finset.sum_neg_distrib]
  refine Finset.sum_le_sum fun p hp => ?_
  have hp3 : 3 ≤ p := by have := (mem_PT hp).1; omega
  exact log_factor_upper hp3

private lemma sum_inv_sub_one {y y' : ℕ} (hy : 4 ≤ y) (hyy : y ≤ y') :
    (∑ p ∈ PT y y', (1 / ((p : ℝ) - 1))) =
      (primeReciprocalSum (y' - 1) - primeReciprocalSum (y - 1)) +
        ∑ p ∈ PT y y', (1 / ((p : ℝ) * ((p : ℝ) - 1))) := by
  have hterm : ∀ p ∈ PT y y', (1 / ((p : ℝ) - 1)) =
      1 / (p : ℝ) + 1 / ((p : ℝ) * ((p : ℝ) - 1)) := by
    intro p hp
    have hp3 : 3 ≤ p := by have := (mem_PT hp).1; omega
    have hpR : (3 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp3
    field_simp [show (p : ℝ) ≠ 0 by linarith, show (p : ℝ) - 1 ≠ 0 by linarith]
    ring
  rw [Finset.sum_congr rfl hterm, Finset.sum_add_distrib]
  congr 1
  have hsub : primesUpTo (y - 1) ⊆ primesUpTo (y' - 1) := by
    intro p hp
    rw [mem_primesUpTo] at hp ⊢
    exact ⟨hp.1, by omega⟩
  have hT : PT y y' = primesUpTo (y' - 1) \ primesUpTo (y - 1) := by
    ext p
    rw [PT, Finset.mem_filter, Finset.mem_Icc, Finset.mem_sdiff, mem_primesUpTo, mem_primesUpTo]
    constructor
    · rintro ⟨⟨hlo, hhi⟩, hp⟩
      exact ⟨⟨hp, hhi⟩, fun h => by have := h.2; omega⟩
    · rintro ⟨⟨hp, hhi⟩, hnot⟩
      refine ⟨⟨?_, hhi⟩, hp⟩
      by_contra h
      exact hnot ⟨hp, by omega⟩
  rw [hT]
  unfold primeReciprocalSum
  have hsd := Finset.sum_sdiff hsub (f := fun p : ℕ => 1 / (p : ℝ))
  linarith

private lemma PT_empty_of {y y' : ℕ} (h : ¬ y ≤ y' - 1) : PT y y' = ∅ := by
  ext p
  simp only [PT, Finset.mem_filter, Finset.mem_Icc, Finset.notMem_empty, iff_false]
  rintro ⟨⟨h1, h2⟩, _⟩
  omega

private lemma sum_tail_inv {y y' : ℕ} (hy : 4 ≤ y) (hyy : y ≤ y') :
    (∑ p ∈ PT y y', (1 / ((p : ℝ) * ((p : ℝ) - 1)))) ≤ 1 / ((y : ℝ) - 1) := by
  have hyR : (4 : ℝ) ≤ (y : ℝ) := by exact_mod_cast hy
  by_cases h : y ≤ y' - 1
  · have hsub : PT y y' ⊆ Finset.Icc y (y' - 1) := Finset.filter_subset _ _
    calc (∑ p ∈ PT y y', (1 / ((p : ℝ) * ((p : ℝ) - 1))))
        ≤ ∑ n ∈ Finset.Icc y (y' - 1), (1 / ((n : ℝ) * ((n : ℝ) - 1))) := by
          refine Finset.sum_le_sum_of_subset_of_nonneg hsub fun n hn _ => ?_
          have hn3 : 3 ≤ n := by rw [Finset.mem_Icc] at hn; omega
          have hnR : (3 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn3
          have : (0 : ℝ) < (n : ℝ) := by linarith
          have : (0 : ℝ) < (n : ℝ) - 1 := by linarith
          positivity
      _ = ∑ n ∈ Finset.Icc y (y' - 1), (1 / ((n : ℝ) - 1) - 1 / (n : ℝ)) := by
          refine Finset.sum_congr rfl fun n hn => ?_
          have hn3 : 3 ≤ n := by rw [Finset.mem_Icc] at hn; omega
          have hnR : (3 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn3
          field_simp [show (n : ℝ) ≠ 0 by linarith, show (n : ℝ) - 1 ≠ 0 by linarith]
          ring
      _ = 1 / ((y : ℝ) - 1) - 1 / (((y' - 1 : ℕ) : ℝ)) := by
          have htel := sum_Icc_telescope_shift (c := (0 : ℝ)) (y := y) (N := y' - 1) h
          simpa using htel
      _ ≤ 1 / ((y : ℝ) - 1) := by
          have hpos : 0 < (((y' - 1 : ℕ) : ℝ)) := by
            have : (0 : ℕ) < y' - 1 := by omega
            exact_mod_cast this
          have : 0 ≤ 1 / (((y' - 1 : ℕ) : ℝ)) := div_nonneg zero_le_one hpos.le
          linarith
  · rw [PT_empty_of h, Finset.sum_empty]
    have : 0 ≤ 1 / ((y : ℝ) - 1) := by
      have : (0 : ℝ) < (y : ℝ) - 1 := by linarith
      positivity
    exact this

private lemma sum_tail_sq {y y' : ℕ} (hy : 4 ≤ y) (hyy : y ≤ y') :
    (∑ p ∈ PT y y', 2 * (1 / ((p : ℝ) - 1)) ^ 2) ≤ 2 / ((y : ℝ) - 2) := by
  have hyR : (4 : ℝ) ≤ (y : ℝ) := by exact_mod_cast hy
  by_cases h : y ≤ y' - 1
  · have hsub : PT y y' ⊆ Finset.Icc y (y' - 1) := Finset.filter_subset _ _
    have hshift : ∀ n : ℕ, 1 / ((n : ℝ) - 1 - 1) - 1 / ((n : ℝ) - 1) =
        1 / ((n : ℝ) - 2) - 1 / ((n : ℝ) - 1) := fun n => by ring
    calc (∑ p ∈ PT y y', 2 * (1 / ((p : ℝ) - 1)) ^ 2)
        ≤ ∑ n ∈ Finset.Icc y (y' - 1), 2 * (1 / ((n : ℝ) - 1)) ^ 2 := by
          refine Finset.sum_le_sum_of_subset_of_nonneg hsub fun n hn _ => ?_
          have hn3 : 3 ≤ n := by rw [Finset.mem_Icc] at hn; omega
          have hnR : (3 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn3
          have : (0 : ℝ) < (n : ℝ) - 1 := by linarith
          positivity
      _ ≤ ∑ n ∈ Finset.Icc y (y' - 1), 2 * (1 / ((n : ℝ) - 2) - 1 / ((n : ℝ) - 1)) := by
          refine Finset.sum_le_sum fun n hn => ?_
          have hn3 : 3 ≤ n := by rw [Finset.mem_Icc] at hn; omega
          have hnR : (3 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn3
          have hpos1 : 0 < (n : ℝ) - 1 := by linarith
          have hpos2 : 0 < (n : ℝ) - 2 := by linarith
          have key : 1 / ((n : ℝ) - 2) - 1 / ((n : ℝ) - 1) =
              1 / (((n : ℝ) - 2) * ((n : ℝ) - 1)) := by
            field_simp [hpos1.ne', hpos2.ne']
            ring
          have hle : (1 / ((n : ℝ) - 1)) ^ 2 ≤ 1 / (((n : ℝ) - 2) * ((n : ℝ) - 1)) := by
            have hsq : (1 / ((n : ℝ) - 1)) ^ 2 = 1 / ((n : ℝ) - 1) ^ 2 := by
              rw [div_pow, one_pow]
            rw [hsq]
            refine one_div_le_one_div_of_le (by positivity) ?_
            nlinarith
          rw [key]
          linarith
      _ = 2 * (1 / ((y : ℝ) - 2) - 1 / (((y' - 1 : ℕ) : ℝ) - 1)) := by
          have htel := sum_Icc_telescope_shift (c := (1 : ℝ)) (y := y) (N := y' - 1) h
          rw [← Finset.mul_sum]
          simp_rw [hshift] at htel
          rw [htel]
          ring
      _ ≤ 2 / ((y : ℝ) - 2) := by
          have hpos : 0 ≤ 1 / (((y' - 1 : ℕ) : ℝ) - 1) := by
            have h1 : (2 : ℝ) ≤ ((y' - 1 : ℕ) : ℝ) := by
              have : (2 : ℕ) ≤ y' - 1 := by omega
              exact_mod_cast this
            have h2 : (0 : ℝ) < ((y' - 1 : ℕ) : ℝ) - 1 := by linarith
            exact div_nonneg zero_le_one h2.le
          have hrew : 2 / ((y : ℝ) - 2) = 2 * (1 / ((y : ℝ) - 2)) := by ring
          rw [hrew]
          linarith
  · rw [PT_empty_of h, Finset.sum_empty]
    have : 0 ≤ 2 / ((y : ℝ) - 2) := by
      have : (0 : ℝ) < (y : ℝ) - 2 := by linarith
      positivity
    exact this

/-! ### The two-point estimate -/

private lemma log_V_two_point :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ y y' : ℕ, 4 ≤ y → y ≤ y' →
      |Real.log (V y) + Real.log (Real.log (y : ℝ)) -
        (Real.log (V y') + Real.log (Real.log (y' : ℝ)))| ≤
        K * (1 / Real.log (y : ℝ) + 1 / Real.log (y' : ℝ)) := by
  obtain ⟨Cm, hCm0, hM⟩ := mertensSecond
  refine ⟨2 * Cm + 5, by linarith, ?_⟩
  intro y y' hy hyy
  have hy' : 4 ≤ y' := by omega
  have hyR : (4 : ℝ) ≤ (y : ℝ) := by exact_mod_cast hy
  have hy'R : (4 : ℝ) ≤ (y' : ℝ) := by exact_mod_cast hy'
  have hly : 0 < Real.log (y : ℝ) := Real.log_pos (by linarith)
  have hly' : 0 < Real.log (y' : ℝ) := Real.log_pos (by linarith)
  have hdiff := log_V_diff hy hyy
  have hlow := sum_log_factor_lower (y' := y') hy
  have hupp := sum_log_factor_upper (y' := y') hy
  have hinv := sum_inv_sub_one hy hyy
  have ht1 := sum_tail_inv hy hyy
  have ht2 := sum_tail_sq hy hyy
  have hMy : |primeReciprocalSum (y - 1) -
      (Real.log (Real.log ((y - 1 : ℕ) : ℝ)) + mertensSecondConstant)| ≤
      Cm / Real.log ((y - 1 : ℕ) : ℝ) := by
    have h := hM ((y - 1 : ℕ) : ℝ) (by
      have : (3 : ℝ) ≤ ((y - 1 : ℕ) : ℝ) := by exact_mod_cast (by omega : 3 ≤ y - 1)
      linarith)
    simpa using h
  have hMy' : |primeReciprocalSum (y' - 1) -
      (Real.log (Real.log ((y' - 1 : ℕ) : ℝ)) + mertensSecondConstant)| ≤
      Cm / Real.log ((y' - 1 : ℕ) : ℝ) := by
    have h := hM ((y' - 1 : ℕ) : ℝ) (by
      have : (3 : ℝ) ≤ ((y' - 1 : ℕ) : ℝ) := by exact_mod_cast (by omega : 3 ≤ y' - 1)
      linarith)
    simpa using h
  have hll := loglog_pred y hy
  have hll' := loglog_pred y' hy'
  have hMy2 : Cm / Real.log ((y - 1 : ℕ) : ℝ) ≤ 2 * Cm / Real.log (y : ℝ) := by
    have hhalf := log_pred_ge_half y hy
    have hpos : 0 < Real.log ((y - 1 : ℕ) : ℝ) := lt_of_lt_of_le (half_pos hly) hhalf
    rw [div_le_div_iff₀ hpos hly]
    have hstep : Real.log (y : ℝ) ≤ 2 * Real.log ((y - 1 : ℕ) : ℝ) := by linarith
    have hmul := mul_le_mul_of_nonneg_left hstep hCm0.le
    linarith
  have hMy2' : Cm / Real.log ((y' - 1 : ℕ) : ℝ) ≤ 2 * Cm / Real.log (y' : ℝ) := by
    have hhalf := log_pred_ge_half y' hy'
    have hpos : 0 < Real.log ((y' - 1 : ℕ) : ℝ) := lt_of_lt_of_le (half_pos hly') hhalf
    rw [div_le_div_iff₀ hpos hly']
    have hstep : Real.log (y' : ℝ) ≤ 2 * Real.log ((y' - 1 : ℕ) : ℝ) := by linarith
    have hmul := mul_le_mul_of_nonneg_left hstep hCm0.le
    linarith
  have hMy2m : Cm * (1 / Real.log ((y - 1 : ℕ) : ℝ)) ≤
      2 * (Cm * (1 / Real.log (y : ℝ))) := by
    have heq1 : Cm / Real.log ((y - 1 : ℕ) : ℝ) = Cm * (1 / Real.log ((y - 1 : ℕ) : ℝ)) := by ring
    have heq2 : 2 * Cm / Real.log (y : ℝ) = 2 * (Cm * (1 / Real.log (y : ℝ))) := by ring
    rw [heq1, heq2] at hMy2
    exact hMy2
  have hMy2m' : Cm * (1 / Real.log ((y' - 1 : ℕ) : ℝ)) ≤
      2 * (Cm * (1 / Real.log (y' : ℝ))) := by
    have heq1 : Cm / Real.log ((y' - 1 : ℕ) : ℝ) =
        Cm * (1 / Real.log ((y' - 1 : ℕ) : ℝ)) := by ring
    have heq2 : 2 * Cm / Real.log (y' : ℝ) = 2 * (Cm * (1 / Real.log (y' : ℝ))) := by ring
    rw [heq1, heq2] at hMy2'
    exact hMy2'
  have ht3 : 1 / ((y : ℝ) - 1) + 2 / ((y : ℝ) - 2) ≤ 3 / Real.log (y : ℝ) := by
    have hhalf := log_le_half y hy
    have h1 : 1 / ((y : ℝ) - 1) ≤ 2 / (y : ℝ) := by
      rw [div_le_div_iff₀ (by linarith) (by linarith)]; linarith
    have h2 : 2 / ((y : ℝ) - 2) ≤ 4 / (y : ℝ) := by
      rw [div_le_div_iff₀ (by linarith) (by linarith)]; linarith
    have h3 : 6 / (y : ℝ) ≤ 3 / Real.log (y : ℝ) := by
      rw [div_le_div_iff₀ (by linarith) hly]; linarith
    have hsum : 2 / (y : ℝ) + 4 / (y : ℝ) = 6 / (y : ℝ) := by ring
    linarith
  have ht3m : 1 / ((y : ℝ) - 1) + 2 / ((y : ℝ) - 2) ≤ 3 * (1 / Real.log (y : ℝ)) := by
    have heq : 3 / Real.log (y : ℝ) = 3 * (1 / Real.log (y : ℝ)) := by ring
    rw [heq] at ht3
    exact ht3
  have hD : Real.log (V y') - Real.log (V y) +
      (Real.log (Real.log (y' : ℝ)) - Real.log (Real.log (y : ℝ))) =
      (Real.log (Real.log (y' : ℝ)) - Real.log (Real.log ((y' - 1 : ℕ) : ℝ))) -
      (Real.log (Real.log (y : ℝ)) - Real.log (Real.log ((y - 1 : ℕ) : ℝ))) -
      ((primeReciprocalSum (y' - 1) -
          (Real.log (Real.log ((y' - 1 : ℕ) : ℝ)) + mertensSecondConstant)) -
        (primeReciprocalSum (y - 1) -
          (Real.log (Real.log ((y - 1 : ℕ) : ℝ)) + mertensSecondConstant))) -
      (∑ p ∈ PT y y', (1 / ((p : ℝ) * ((p : ℝ) - 1)))) -
      (-(∑ p ∈ PT y y', (1 / ((p : ℝ) - 1))) -
        ∑ p ∈ PT y y', Real.log (1 - 1 / ((p : ℝ) - 1))) := by
    linarith [hdiff, hinv]
  have hDabs : |Real.log (V y') - Real.log (V y) +
      (Real.log (Real.log (y' : ℝ)) - Real.log (Real.log (y : ℝ)))| ≤
      (2 * Cm + 5) * (1 / Real.log (y : ℝ) + 1 / Real.log (y' : ℝ)) := by
    rw [hD, abs_le]
    obtain ⟨hll1, hll2⟩ := abs_le.mp hll
    obtain ⟨hll1', hll2'⟩ := abs_le.mp hll'
    obtain ⟨ha1, ha2⟩ := abs_le.mp hMy
    obtain ⟨hb1, hb2⟩ := abs_le.mp hMy'
    have hR0 : 0 ≤ -(∑ p ∈ PT y y', (1 / ((p : ℝ) - 1))) -
        ∑ p ∈ PT y y', Real.log (1 - 1 / ((p : ℝ) - 1)) := by linarith [hupp]
    have hR1 : -(∑ p ∈ PT y y', (1 / ((p : ℝ) - 1))) -
        ∑ p ∈ PT y y', Real.log (1 - 1 / ((p : ℝ) - 1)) ≤
        ∑ p ∈ PT y y', 2 * (1 / ((p : ℝ) - 1)) ^ 2 := by linarith [hlow]
    have hS30 : 0 ≤ ∑ p ∈ PT y y', (1 / ((p : ℝ) * ((p : ℝ) - 1))) := by
      refine Finset.sum_nonneg fun p hp => ?_
      have hp3 : 3 ≤ p := by have := (mem_PT hp).1; omega
      have hpR : (3 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp3
      have : (0 : ℝ) < (p : ℝ) := by linarith
      have : (0 : ℝ) < (p : ℝ) - 1 := by linarith
      positivity
    have hexp : (2 * Cm + 5) * (1 / Real.log (y : ℝ) + 1 / Real.log (y' : ℝ)) =
        2 * (Cm * (1 / Real.log (y : ℝ))) + 5 * (1 / Real.log (y : ℝ)) +
          2 * (Cm * (1 / Real.log (y' : ℝ))) + 5 * (1 / Real.log (y' : ℝ)) := by ring
    have heqa : Cm / Real.log ((y - 1 : ℕ) : ℝ) = Cm * (1 / Real.log ((y - 1 : ℕ) : ℝ)) := by ring
    have heqb : Cm / Real.log ((y' - 1 : ℕ) : ℝ) =
        Cm * (1 / Real.log ((y' - 1 : ℕ) : ℝ)) := by ring
    rw [heqa] at ha1 ha2
    rw [heqb] at hb1 hb2
    rw [hexp]
    have hUy : 0 ≤ 1 / Real.log (y : ℝ) := div_nonneg zero_le_one hly.le
    have hUy' : 0 ≤ 1 / Real.log (y' : ℝ) := div_nonneg zero_le_one hly'.le
    constructor
    · linarith only [hll1', hll2, ha1, hb2, hMy2m, hMy2m', ht1, hR1, ht2, ht3m, hUy, hUy']
    · linarith only [hll2', hll1, ha2, hb1, hMy2m, hMy2m', hS30, hR0, hUy, hUy']
  have hneg : Real.log (V y) + Real.log (Real.log (y : ℝ)) -
      (Real.log (V y') + Real.log (Real.log (y' : ℝ))) =
      -(Real.log (V y') - Real.log (V y) +
        (Real.log (Real.log (y' : ℝ)) - Real.log (Real.log (y : ℝ)))) := by ring
  rw [hneg, abs_neg]
  exact hDabs


/-! ### From the two-point estimate to the uniform asymptotic

The two-point estimate makes `gV` a Cauchy sequence, so it has a limit `c`, and
`V y * log y = exp (gV y)` tends to `kappa = exp c`.  The index of the limit is the cutoff
itself, so the estimate is uniform in the cutoff, and therefore uniform in the sifting
parameter `s` over any range of `s`: every cutoff of the form `ceil (D ^ (1 / s))` with `D`
large is itself large. -/

private lemma two_point :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ y y' : ℕ, 4 ≤ y → y ≤ y' →
      |gV y - gV y'| ≤ K * (1 / Real.log (y : ℝ) + 1 / Real.log (y' : ℝ)) := by
  obtain ⟨K, hK, h⟩ := log_V_two_point
  refine ⟨K, hK, ?_⟩
  intro y y' hy hyy
  have heq : gV y - gV y' = Real.log (V y) + Real.log (Real.log (y : ℝ)) -
      (Real.log (V y') + Real.log (Real.log (y' : ℝ))) := by
    unfold gV
    ring
  rw [heq]
  exact h y y' hy hyy

private lemma gV_cauchy : CauchySeq gV := by
  obtain ⟨K, hK, h⟩ := two_point
  rw [Metric.cauchySeq_iff]
  intro ε hε
  have hlog : Tendsto (fun n : ℕ => Real.log (n : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hev : ∀ᶠ n : ℕ in atTop, 2 * K / ε + 1 ≤ Real.log (n : ℝ) :=
    tendsto_atTop.mp hlog (2 * K / ε + 1)
  obtain ⟨N, hN⟩ := (hev.and (eventually_ge_atTop 4)).exists
  refine ⟨N, ?_⟩
  intro m hm n hn
  have h4N : (4 : ℕ) ≤ N := hN.2
  have h4m : 4 ≤ m := le_trans h4N hm
  have h4n : 4 ≤ n := le_trans h4N hn
  have hN0 : (0 : ℝ) < (N : ℝ) := by exact_mod_cast (by omega : 0 < N)
  have hN1 : (1 : ℝ) < (N : ℝ) := by exact_mod_cast (by omega : 1 < N)
  have hlm : Real.log (N : ℝ) ≤ Real.log (m : ℝ) :=
    Real.log_le_log hN0 (by exact_mod_cast hm)
  have hln : Real.log (N : ℝ) ≤ Real.log (n : ℝ) :=
    Real.log_le_log hN0 (by exact_mod_cast hn)
  have hlN : 0 < Real.log (N : ℝ) := Real.log_pos hN1
  have him : 1 / Real.log (m : ℝ) ≤ 1 / Real.log (N : ℝ) := by
    rw [one_div, one_div]
    exact inv_anti₀ hlN hlm
  have hin : 1 / Real.log (n : ℝ) ≤ 1 / Real.log (N : ℝ) := by
    rw [one_div, one_div]
    exact inv_anti₀ hlN hln
  have hK2 : 2 * K < ε * Real.log (N : ℝ) := by
    have h1 : 2 * K / ε < Real.log (N : ℝ) := by linarith [hN.1]
    rw [div_lt_iff₀ hε] at h1
    linarith
  have hfin : 2 * K / Real.log (N : ℝ) < ε := by
    rw [div_lt_iff₀ hlN]
    linarith
  rw [Real.dist_eq]
  rcases le_total m n with hmn | hnm
  · have hb := h m n h4m hmn
    calc |gV m - gV n| ≤ K * (1 / Real.log (m : ℝ) + 1 / Real.log (n : ℝ)) := hb
      _ ≤ K * (1 / Real.log (N : ℝ) + 1 / Real.log (N : ℝ)) :=
          mul_le_mul_of_nonneg_left (by linarith) hK
      _ = 2 * K / Real.log (N : ℝ) := by ring
      _ < ε := hfin
  · have hb := h n m h4n hnm
    rw [abs_sub_comm]
    calc |gV n - gV m| ≤ K * (1 / Real.log (n : ℝ) + 1 / Real.log (m : ℝ)) := hb
      _ ≤ K * (1 / Real.log (N : ℝ) + 1 / Real.log (N : ℝ)) :=
          mul_le_mul_of_nonneg_left (by linarith) hK
      _ = 2 * K / Real.log (N : ℝ) := by ring
      _ < ε := hfin

private lemma exists_limit : ∃ c : ℝ, Tendsto gV atTop (nhds c) :=
  cauchySeq_tendsto_of_complete gV_cauchy

private lemma log_gt_one {y : ℕ} (hy : 4 ≤ y) : 1 < Real.log (y : ℝ) := by
  have h4 : Real.log (4 : ℝ) = 2 * Real.log 2 := by
    have h4' : (4 : ℝ) = 2 * 2 := by norm_num
    rw [h4', Real.log_mul (by norm_num) (by norm_num)]
    ring
  have hle : Real.log (4 : ℝ) ≤ Real.log (y : ℝ) :=
    Real.log_le_log (by norm_num) (by exact_mod_cast hy)
  have := Real.log_two_gt_d9
  linarith

private lemma V_mul_log_eq_exp {y : ℕ} (hy : 4 ≤ y) :
    V y * Real.log (y : ℝ) = Real.exp (gV y) := by
  unfold gV
  rw [Real.exp_add, Real.exp_log (V_pos y), Real.exp_log (lt_trans zero_lt_one (log_gt_one hy))]

private lemma V_mul_log_tendsto {c : ℝ} (hc : Tendsto gV atTop (nhds c)) :
    Tendsto (fun y : ℕ => V y * Real.log (y : ℝ)) atTop (nhds (Real.exp c)) := by
  have h := (Real.continuous_exp.tendsto c).comp hc
  refine h.congr' ?_
  filter_upwards [eventually_ge_atTop 4] with y hy
  exact (V_mul_log_eq_exp hy).symm

/-- The uniform Mertens estimate for the sieve density: `V y * log y` is within a
relative `eps` of a positive constant `kappa` for every cutoff `y` past a threshold. -/
theorem V_mul_log_asymptotic :
    ∃ κ : ℝ, 0 < κ ∧ ∀ ε : ℝ, 0 < ε → ∃ Y : ℕ, ∀ y : ℕ, Y ≤ y →
      (1 - ε) * κ ≤ V y * Real.log (y : ℝ) ∧
        V y * Real.log (y : ℝ) ≤ (1 + ε) * κ := by
  obtain ⟨c, hc⟩ := exists_limit
  refine ⟨Real.exp c, Real.exp_pos c, ?_⟩
  intro ε hε
  have h := Metric.tendsto_atTop.mp (V_mul_log_tendsto hc)
    (ε * Real.exp c / 2) (by positivity)
  obtain ⟨Y, hY⟩ := h
  refine ⟨Y, fun y hy => ?_⟩
  have hd := hY y hy
  rw [Real.dist_eq, abs_lt] at hd
  have hκ : 0 < Real.exp c := Real.exp_pos c
  constructor <;> linarith

/-- The cutoff-to-cutoff ratio bound, uniform in both cutoffs: this is the V-ratio that the
per-prime upper sieve needs when the sifting cutoff is lowered from `y'` to `y`. -/
theorem V_mul_log_ratio :
    ∀ ε : ℝ, 0 < ε → ∃ Y : ℕ, ∀ y y' : ℕ, Y ≤ y → Y ≤ y' →
      V y * Real.log (y : ℝ) ≤ (1 + ε) * (V y' * Real.log (y' : ℝ)) := by
  intro ε hε
  obtain ⟨κ, hκ, h⟩ := V_mul_log_asymptotic
  have hδ : 0 < ε / (2 + ε) := by positivity
  obtain ⟨Y, hY⟩ := h (ε / (2 + ε)) hδ
  refine ⟨Y, ?_⟩
  intro y y' hy hy'
  have h1 := (hY y hy).2
  have h2 := (hY y' hy').1
  have h2ε : (2 : ℝ) + ε ≠ 0 := by linarith
  have h3 : (1 + ε) * ((1 - ε / (2 + ε)) * κ) = (1 + ε / (2 + ε)) * κ := by
    field_simp [h2ε]
    ring
  have h4 : (1 + ε) * ((1 - ε / (2 + ε)) * κ) ≤ (1 + ε) * (V y' * Real.log (y' : ℝ)) :=
    mul_le_mul_of_nonneg_left h2 (by linarith)
  linarith

/-- The same bound divided by `log y`: `V y` is at most `(1 + eps) * V y' * log y' / log y`
for every pair of cutoffs past a threshold. -/
theorem V_ratio_log :
    ∀ ε : ℝ, 0 < ε → ∃ Y : ℕ, ∀ y y' : ℕ, Y ≤ y → Y ≤ y' →
      V y ≤ (1 + ε) * V y' * Real.log (y' : ℝ) / Real.log (y : ℝ) := by
  intro ε hε
  obtain ⟨Y, hY⟩ := V_mul_log_ratio ε hε
  refine ⟨max Y 4, ?_⟩
  intro y y' hy hy'
  have hy4 : 4 ≤ y := le_trans (le_max_right Y 4) hy
  have hly : 0 < Real.log (y : ℝ) := Real.log_pos (by exact_mod_cast (by omega : 1 < y))
  have h1 := hY y y' (le_trans (le_max_left Y 4) hy) (le_trans (le_max_left Y 4) hy')
  rw [le_div_iff₀ hly]
  linarith

/-- The uniform-in-`s` form.  For every `D` past a threshold and every `s` with
`0 < s ≤ 3` (in particular every `s` in `[3/2, 3]`), the sieve density at the power cutoff
`ceil (D ^ (1 / s))` lies between `(1 - eps) * kappa * s / log D` and
`(1 + eps) * kappa * s / log D`.  The threshold does not depend on `s`. -/
theorem V_cutoff_two_sided :
    ∃ κ : ℝ, 0 < κ ∧ ∀ ε : ℝ, 0 < ε → ∃ D0 : ℝ, ∀ D : ℝ, D0 ≤ D → ∀ s : ℝ,
      0 < s → s ≤ 3 →
      (1 - ε) * κ * s / Real.log D ≤ V ⌈D ^ (1 / s)⌉₊ ∧
        V ⌈D ^ (1 / s)⌉₊ ≤ (1 + ε) * κ * s / Real.log D := by
  obtain ⟨κ, hκ, h⟩ := V_mul_log_asymptotic
  refine ⟨κ, hκ, ?_⟩
  intro ε hε
  obtain ⟨Y, hY⟩ := h (ε / 2) (by positivity)
  refine ⟨Real.exp (max (3 * Real.log ((max Y 1 : ℕ) : ℝ)) (6 / ε) + 1), ?_⟩
  intro D hD s hspos hs3
  have hlogD : max (3 * Real.log ((max Y 1 : ℕ) : ℝ)) (6 / ε) + 1 ≤ Real.log D := by
    have h1 := Real.log_le_log (by positivity) hD
    rwa [Real.log_exp] at h1
  have hlogD1 : 3 * Real.log ((max Y 1 : ℕ) : ℝ) ≤ Real.log D := by
    have h1 := le_max_left (3 * Real.log ((max Y 1 : ℕ) : ℝ)) (6 / ε)
    linarith
  have hlogD2 : 6 / ε ≤ Real.log D := by
    have h1 := le_max_right (3 * Real.log ((max Y 1 : ℕ) : ℝ)) (6 / ε)
    linarith
  have hlD : 0 < Real.log D := by
    have h1 : 0 < 6 / ε := by positivity
    linarith
  have hD1 : 1 < D := by
    have h1 : 0 < max (3 * Real.log ((max Y 1 : ℕ) : ℝ)) (6 / ε) + 1 := by
      have h2 : 0 < 6 / ε := by positivity
      have h3 := le_max_right (3 * Real.log ((max Y 1 : ℕ) : ℝ)) (6 / ε)
      linarith
    have h2 := Real.add_one_le_exp (max (3 * Real.log ((max Y 1 : ℕ) : ℝ)) (6 / ε) + 1)
    linarith
  have hDpos : 0 < D := by linarith
  set u : ℝ := D ^ (1 / s)
  have hupos : 0 < u := Real.rpow_pos_of_pos hDpos _
  have hu1 : 1 ≤ u := Real.one_le_rpow hD1.le (by positivity)
  have hlogu : Real.log u = (1 / s) * Real.log D := Real.log_rpow hDpos _
  have hu_le : u ≤ ((⌈u⌉₊ : ℕ) : ℝ) := by exact_mod_cast Nat.le_ceil u
  have hy_lt : ((⌈u⌉₊ : ℕ) : ℝ) < u + 1 := by exact_mod_cast Nat.ceil_lt_add_one hupos.le
  have hypos : (0 : ℝ) < ((⌈u⌉₊ : ℕ) : ℝ) := lt_of_lt_of_le hupos hu_le
  have hly_ge : (1 / s) * Real.log D ≤ Real.log ((⌈u⌉₊ : ℕ) : ℝ) := by
    have h1 := Real.log_le_log hupos hu_le
    linarith [hlogu]
  have hly_le : Real.log ((⌈u⌉₊ : ℕ) : ℝ) ≤ (1 / s) * Real.log D + 1 := by
    have h1 : Real.log ((⌈u⌉₊ : ℕ) : ℝ) ≤ Real.log (u + 1) :=
      Real.log_le_log hypos hy_lt.le
    have h2 : Real.log (u + 1) = Real.log u + Real.log (1 + 1 / u) := by
      rw [← Real.log_mul hupos.ne' (by positivity)]
      congr 1
      field_simp [hupos.ne']
    have h3 : Real.log (1 + 1 / u) ≤ 1 / u := by
      have h4 := Real.log_le_sub_one_of_pos (by positivity : (0 : ℝ) < 1 + 1 / u)
      linarith
    have h4 : 1 / u ≤ 1 := by
      rw [div_le_one hupos]
      exact hu1
    linarith [hlogu]
  have hkey : 1 ≤ (ε / 2) * ((1 / s) * Real.log D) := by
    have h5 : 3 ≤ (ε / 2) * Real.log D := by
      have h6 := (div_le_iff₀ hε).mp hlogD2
      linarith
    have h6 : s ≤ (ε / 2) * Real.log D := by linarith
    have h7 : 1 ≤ (ε / 2) * Real.log D / s := by
      rw [le_div_iff₀ hspos]
      linarith
    have h8 : (ε / 2) * Real.log D / s = (ε / 2) * ((1 / s) * Real.log D) := by ring
    linarith
  have hly_rel : Real.log ((⌈u⌉₊ : ℕ) : ℝ) ≤ (1 + ε / 2) * ((1 / s) * Real.log D) := by
    linarith [hly_le, hkey]
  have hYle : max Y 1 ≤ ⌈u⌉₊ := by
    have hlogY : Real.log ((max Y 1 : ℕ) : ℝ) ≤ Real.log ((⌈u⌉₊ : ℕ) : ℝ) := by
      have hA : (1 / 3 : ℝ) ≤ 1 / s := by
        rw [div_le_div_iff₀ (by norm_num) hspos]
        linarith
      have hB : (1 / 3 : ℝ) * Real.log D ≤ (1 / s) * Real.log D :=
        mul_le_mul_of_nonneg_right hA hlD.le
      linarith [hly_ge]
    have hpos1 : (0 : ℝ) < ((max Y 1 : ℕ) : ℝ) := by
      exact_mod_cast (by omega : 0 < max Y 1)
    have hcast : ((max Y 1 : ℕ) : ℝ) ≤ ((⌈u⌉₊ : ℕ) : ℝ) :=
      (Real.log_le_log_iff hpos1 hypos).mp hlogY
    exact_mod_cast hcast
  have hA := hY ⌈u⌉₊ (le_trans (le_max_left Y 1) hYle)
  have hVy : 0 < V ⌈u⌉₊ := V_pos _
  have hU : V ⌈u⌉₊ * ((1 / s) * Real.log D) ≤ (1 + ε / 2) * κ := by
    have h1 : V ⌈u⌉₊ * ((1 / s) * Real.log D) ≤ V ⌈u⌉₊ * Real.log ((⌈u⌉₊ : ℕ) : ℝ) :=
      mul_le_mul_of_nonneg_left hly_ge hVy.le
    linarith [hA.2]
  have hL : (1 - ε) * κ ≤ V ⌈u⌉₊ * ((1 / s) * Real.log D) := by
    have h1 : V ⌈u⌉₊ * Real.log ((⌈u⌉₊ : ℕ) : ℝ) ≤
        (1 + ε / 2) * (V ⌈u⌉₊ * ((1 / s) * Real.log D)) := by
      have h2 := mul_le_mul_of_nonneg_left hly_rel hVy.le
      linarith
    have h3 : (1 + ε / 2) * ((1 - ε) * κ) ≤ (1 - ε / 2) * κ := by
      have hc : (1 + ε / 2) * (1 - ε) ≤ 1 - ε / 2 := by nlinarith
      have h4 := mul_le_mul_of_nonneg_right hc hκ.le
      linarith
    have h4 : (1 + ε / 2) * ((1 - ε) * κ) ≤
        (1 + ε / 2) * (V ⌈u⌉₊ * ((1 / s) * Real.log D)) := by
      linarith [hA.1]
    exact le_of_mul_le_mul_left (by linarith) (by positivity : (0 : ℝ) < 1 + ε / 2)
  have hmul : (V ⌈u⌉₊ * ((1 / s) * Real.log D)) * s = V ⌈u⌉₊ * Real.log D := by
    field_simp [hspos.ne']
  constructor
  · rw [div_le_iff₀ hlD]
    have h5 := mul_le_mul_of_nonneg_right hL hspos.le
    linarith
  · rw [le_div_iff₀ hlD]
    have h5 := mul_le_mul_of_nonneg_right hU hspos.le
    have hκs : 0 ≤ κ * s := mul_nonneg hκ.le hspos.le
    have hκs2 : 0 ≤ ε * (κ * s) := mul_nonneg hε.le hκs
    linarith

end A2C
namespace A2B

open Finset Real Filter
open scoped BigOperators

/-- The eighth-root cutoff `z x = ⌈x^(1/8)⌉` (blueprint `…_z`). -/
noncomputable def z (x : ℕ) : ℕ := ⌈(x : ℝ) ^ (1 / 8 : ℝ)⌉₊

/-- The cube-root cutoff `root x = ⌊x^(1/3)⌋` (blueprint `…_root`). -/
noncomputable def root (x : ℕ) : ℕ := ⌊(x : ℝ) ^ (1 / 3 : ℝ)⌋₊

private noncomputable def plr (n : ℕ) : ℝ :=
  ∑ m ∈ Finset.Icc 0 n, if m.Prime then Real.log (m : ℝ) / (m : ℝ) else 0

/-! ### Discrete Abel summation -/

private lemma abel_sum (c g P : ℕ → ℝ) (hP : ∀ n, 1 ≤ n → P n - P (n - 1) = c n)
    (L U : ℕ) (hL : 1 ≤ L) (hLU : L ≤ U) :
    ∑ n ∈ Finset.Icc L U, (c n * g n + P n * (g (n + 1) - g n)) =
      P U * g (U + 1) - P (L - 1) * g L := by
  induction U, hLU using Nat.le_induction with
  | base =>
    rw [Finset.Icc_self, Finset.sum_singleton, ← hP L hL]
    ring
  | succ U hLU ih =>
    rw [Finset.sum_Icc_succ_top (by omega : L ≤ U + 1), ih]
    have h := hP (U + 1) (by omega)
    rw [show U + 1 - 1 = U by omega] at h
    linear_combination -(h * g (U + 1))

private lemma sum_Icc_sub_pred (G : ℕ → ℝ) {L U : ℕ} (_hL : 1 ≤ L) (hLU : L ≤ U) :
    ∑ n ∈ Finset.Icc L U, (G n - G (n - 1)) = G U - G (L - 1) := by
  induction U, hLU using Nat.le_induction with
  | base => rw [Finset.Icc_self, Finset.sum_singleton]
  | succ U hLU ih =>
    rw [Finset.sum_Icc_succ_top (by omega : L ≤ U + 1), ih]
    have hU : U + 1 - 1 = U := by omega
    rw [hU]
    ring

/-! ### Eventual facts -/

private lemma ev_rpow_ge (K : ℝ) {α : ℝ} (hα : 0 < α) : ∀ᶠ x : ℕ in atTop, K ≤ (x : ℝ) ^ α :=
  ((tendsto_rpow_atTop hα).comp tendsto_natCast_atTop_atTop).eventually_ge_atTop K

private lemma ev_log_ge (K : ℝ) : ∀ᶠ x : ℕ in atTop, K ≤ Real.log (x : ℝ) :=
  (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop).eventually_ge_atTop K

/-! ### The kernel `u ↦ 1/(u (b-u))` is Lipschitz on the relevant range -/

private lemma hu_lip {b t u v : ℝ} (ht : 0 < t) (hb : b ≤ t / 2)
    (hu1 : t / 10 ≤ u) (_hu2 : u ≤ t / 2) (hv1 : t / 10 ≤ v) (hv2 : v ≤ t / 2)
    (hbu : t / 9 ≤ b - u) (hbv : t / 9 ≤ b - v) :
    |1 / (u * (b - u)) - 1 / (v * (b - v))| ≤ 20000 / t ^ 3 * |u - v| := by
  have hu0 : 0 < u := by linarith
  have hv0 : 0 < v := by linarith
  have hbu0 : 0 < b - u := by linarith
  have hbv0 : 0 < b - v := by linarith
  have hdpos : 0 < u * (b - u) * (v * (b - v)) :=
    mul_pos (mul_pos hu0 hbu0) (mul_pos hv0 hbv0)
  have hid : 1 / (u * (b - u)) - 1 / (v * (b - v)) =
      (v - u) * (b - u - v) / (u * (b - u) * (v * (b - v))) := by
    field_simp [hu0.ne', hbu0.ne', hv0.ne', hbv0.ne']
    ring
  have hd : t ^ 4 / 8100 ≤ u * (b - u) * (v * (b - v)) := by
    have h1 : t / 10 * (t / 9) ≤ u * (b - u) := mul_le_mul hu1 hbu (by linarith) (by linarith)
    have h2 : t / 10 * (t / 9) ≤ v * (b - v) := mul_le_mul hv1 hbv (by linarith) (by linarith)
    have h3 := mul_le_mul h1 h2 (by positivity) (mul_pos hu0 hbu0).le
    have h4 : t / 10 * (t / 9) * (t / 10 * (t / 9)) = t ^ 4 / 8100 := by ring
    linarith
  have habs : |b - u - v| ≤ 2 * t := by
    rw [abs_le]
    constructor <;> linarith
  have hkey : |b - u - v| ≤ 20000 / t ^ 3 * (u * (b - u) * (v * (b - v))) := by
    have h5 : 20000 / t ^ 3 * (t ^ 4 / 8100) ≤ 20000 / t ^ 3 * (u * (b - u) * (v * (b - v))) :=
      mul_le_mul_of_nonneg_left hd (by positivity)
    have h6 : (20000 : ℝ) / t ^ 3 * (t ^ 4 / 8100) = (20000 / 8100) * t := by
      field_simp
    linarith
  rw [hid, abs_div, abs_of_pos hdpos, div_le_iff₀ hdpos, abs_mul, abs_sub_comm v u]
  have hstep : |u - v| * |b - u - v| ≤
      |u - v| * (20000 / t ^ 3 * (u * (b - u) * (v * (b - v)))) :=
    mul_le_mul_of_nonneg_left hkey (abs_nonneg _)
  linarith [show |u - v| * (20000 / t ^ 3 * (u * (b - u) * (v * (b - v)))) =
      20000 / t ^ 3 * |u - v| * (u * (b - u) * (v * (b - v))) by ring]

/-! ### Mean value step for the antiderivative -/

private lemma mvt_term {b t u v : ℝ} (ht : 0 < t) (hb : b ≤ t / 2) (hvu : v < u)
    (hv1 : t / 10 ≤ v) (_hv2 : v ≤ t / 2) (hu1 : t / 10 ≤ u) (hu2 : u ≤ t / 2)
    (_hbv : t / 9 ≤ b - v) (hbu : t / 9 ≤ b - u) :
    (u - v) * (1 / (u * (b - u))) ≤
      ((1 / b) * (Real.log u - Real.log (b - u)) - (1 / b) * (Real.log v - Real.log (b - v))) +
        20000 / t ^ 3 * (u - v) ^ 2 := by
  set H : ℝ → ℝ := fun w => (1 / b) * (Real.log w - Real.log (b - w))
  have hH : ∀ w, t / 10 ≤ w → w ≤ t / 2 → t / 9 ≤ b - w →
      HasDerivAt H (1 / (w * (b - w))) w := by
    intro w hw1 hw2 hw3
    have hw0 : 0 < w := by linarith
    have hbw0 : 0 < b - w := by linarith
    have hbw : 0 < b := by linarith
    have h1 : HasDerivAt (fun w : ℝ => Real.log w) (w⁻¹) w := Real.hasDerivAt_log hw0.ne'
    have h2 : HasDerivAt (fun w : ℝ => b - w) (-1) w := by
      simpa using (hasDerivAt_id w).const_sub b
    have h3 : HasDerivAt (fun w : ℝ => Real.log (b - w)) ((b - w)⁻¹ * (-1)) w :=
      (Real.hasDerivAt_log hbw0.ne').comp w h2
    have h4 : HasDerivAt (fun w : ℝ => Real.log w - Real.log (b - w))
        (w⁻¹ - (b - w)⁻¹ * (-1)) w := h1.sub h3
    have h5 : HasDerivAt H ((1 / b) * (w⁻¹ - (b - w)⁻¹ * (-1))) w := h4.const_mul (1 / b)
    convert h5 using 1
    field_simp [hw0.ne', hbw0.ne', hbw.ne']
    ring
  have hcont : ContinuousOn H (Set.Icc v u) := by
    have hc1 : ContinuousOn (fun w : ℝ => w) (Set.Icc v u) := continuousOn_id
    have hc2 : ContinuousOn (fun w : ℝ => b - w) (Set.Icc v u) :=
      continuousOn_const.sub continuousOn_id
    refine continuousOn_const.mul (ContinuousOn.sub (hc1.log ?_) (hc2.log ?_))
    · intro w hw
      rw [Set.mem_Icc] at hw
      linarith
    · intro w hw
      rw [Set.mem_Icc] at hw
      linarith
  obtain ⟨ξ, hξ, hξeq⟩ := exists_hasDerivAt_eq_slope H (fun w => 1 / (w * (b - w))) hvu hcont
    (fun w hw => hH w (by linarith [hw.1, hv1]) (by linarith [hw.2, hu2]) (by linarith [hw.2, hbu]))
  have hHdiff : H u - H v = 1 / (ξ * (b - ξ)) * (u - v) := by
    have h1 := hξeq
    rw [eq_div_iff (by linarith : u - v ≠ 0)] at h1
    linarith
  have hlip : |1 / (u * (b - u)) - 1 / (ξ * (b - ξ))| ≤ 20000 / t ^ 3 * |u - ξ| :=
    hu_lip ht hb hu1 hu2 (by linarith [hξ.1, hv1]) (by linarith [hξ.2, hu2])
      (by linarith [hξ.2, hbu]) (by linarith [hξ.2, hbu])
  have hstep : 1 / (u * (b - u)) - 1 / (ξ * (b - ξ)) ≤ 20000 / t ^ 3 * (u - v) := by
    calc 1 / (u * (b - u)) - 1 / (ξ * (b - ξ)) ≤
          |1 / (u * (b - u)) - 1 / (ξ * (b - ξ))| := le_abs_self _
      _ ≤ 20000 / t ^ 3 * |u - ξ| := hlip
      _ = 20000 / t ^ 3 * (u - ξ) := by rw [abs_of_pos (by linarith [hξ.2])]
      _ ≤ 20000 / t ^ 3 * (u - v) :=
          mul_le_mul_of_nonneg_left (by linarith [hξ.1]) (by positivity)
  have hcomb : (u - v) * (1 / (u * (b - u))) =
      1 / (ξ * (b - ξ)) * (u - v) + (u - v) * (1 / (u * (b - u)) - 1 / (ξ * (b - ξ))) := by ring
  have hmul : (u - v) * (1 / (u * (b - u)) - 1 / (ξ * (b - ξ))) ≤ 20000 / t ^ 3 * (u - v) ^ 2 := by
    have h := mul_le_mul_of_nonneg_left hstep (by linarith : 0 ≤ u - v)
    linarith [show (u - v) * (20000 / t ^ 3 * (u - v)) = 20000 / t ^ 3 * (u - v) ^ 2 by ring]
  rw [hcomb, ← hHdiff]
  linarith

/-! ### Core estimate -/

set_option maxHeartbeats 2000000 in
private lemma core {η CM : ℝ} {x : ℕ} {D : ℝ} {Z Y : ℕ}
    (hη : 0 < η) (hη1 : η ≤ 1 / 1000) (hCM : 0 ≤ CM)
    (ht : 100 ≤ Real.log (x : ℝ)) (hx1 : 1 ≤ (x : ℝ)) (hDpos : 0 < D)
    (hDlo : (9 / 20 : ℝ) * Real.log (x : ℝ) ≤ Real.log D)
    (hDhi : Real.log D ≤ Real.log (x : ℝ) / 2)
    (hZ : (x : ℝ) ^ (1 / 8 : ℝ) ≤ (Z : ℝ)) (hZu : (Z : ℝ) ≤ 2 * (x : ℝ) ^ (1 / 8 : ℝ))
    (hZY : Z ≤ Y) (hZlt : Z < Y)
    (hY : (Y : ℝ) ≤ (x : ℝ) ^ (1 / 3 : ℝ))
    (hYlo : (x : ℝ) ^ (1 / 3 : ℝ) / 2 ≤ (Y : ℝ))
    (hx18 : 4 ≤ (x : ℝ) ^ (1 / 8 : ℝ))
    (hlog2 : Real.log 2 ≤ η * Real.log (x : ℝ))
    (hK : 50000 * (CM + 1) / η ≤ Real.log (x : ℝ))
    (herr : 40 ≤ η * (x : ℝ) ^ (1 / 8 : ℝ))
    (hM : ∀ n : ℕ, 2 ≤ n → |plr n - Real.log (n : ℝ)| ≤ CM) :
    (∑ p ∈ (Finset.Icc Z Y).filter Nat.Prime, 1 / (((p : ℝ) - 1) * Real.log (D / (p : ℝ))) ≤
      (1 + η) * ((1 / Real.log D) *
        Real.log (Real.log (Y : ℝ) * (Real.log D - Real.log (Z : ℝ)) /
          (Real.log (Z : ℝ) * (Real.log D - Real.log (Y : ℝ)))))) ∧
    (0 ≤ (1 / Real.log D) *
        Real.log (Real.log (Y : ℝ) * (Real.log D - Real.log (Z : ℝ)) /
          (Real.log (Z : ℝ) * (Real.log D - Real.log (Y : ℝ))))) := by
  set t := Real.log (x : ℝ)
  set b := Real.log D
  have ht_eq : t = Real.log (x : ℝ) := rfl
  have hb_eq : b = Real.log D := rfl
  have ht' : 100 ≤ t := ht
  have hDlo' : (9 / 20 : ℝ) * t ≤ b := hDlo
  have hDhi' : b ≤ t / 2 := hDhi
  have hlog2' : Real.log 2 ≤ η * t := hlog2
  have hK' : 50000 * (CM + 1) / η ≤ t := hK
  have ht0 : 0 < t := by linarith
  have hxpos : (0 : ℝ) < (x : ℝ) := by linarith
  have hx18pos : 0 < (x : ℝ) ^ (1 / 8 : ℝ) := Real.rpow_pos_of_pos hxpos _
  have hx13pos : 0 < (x : ℝ) ^ (1 / 3 : ℝ) := Real.rpow_pos_of_pos hxpos _
  have hZ4r : (4 : ℝ) ≤ (Z : ℝ) := le_trans hx18 hZ
  have hZ4 : 4 ≤ Z := by exact_mod_cast hZ4r
  have hZ2 : 2 ≤ Z := by omega
  have hZ1 : 1 ≤ Z := by omega
  have hY2 : 2 ≤ Y := by omega
  have hb0 : 0 < b := by linarith
  have hηt : η * t ≤ (1 / 1000) * t := mul_le_mul_of_nonneg_right hη1 ht0.le
  have hηt9 : η * t ≤ (1 / 180) * t :=
    mul_le_mul_of_nonneg_right (by linarith : η ≤ 1 / 180) ht0.le
  have hx18ge1 : 1 ≤ (x : ℝ) ^ (1 / 8 : ℝ) := by linarith
  -- range of log n for n ∈ [Z-1, Y+1]
  have hr : ∀ n ∈ Finset.Icc (Z - 1) (Y + 1),
      t / 10 ≤ Real.log (n : ℝ) ∧ Real.log (n : ℝ) ≤ t / 3 + Real.log 2 ∧
        t / 9 ≤ b - Real.log (n : ℝ) := by
    intro n hn
    rw [Finset.mem_Icc] at hn
    have hn1 : 1 ≤ n := by omega
    have hnpos : (0 : ℝ) < (n : ℝ) := by positivity
    have hnlo : (x : ℝ) ^ (1 / 8 : ℝ) / 2 ≤ (n : ℝ) := by
      have h1 : ((Z - 1 : ℕ) : ℝ) = (Z : ℝ) - 1 := Nat.cast_sub hZ1
      have h2 : (Z : ℝ) / 2 ≤ ((Z - 1 : ℕ) : ℝ) := by rw [h1]; linarith
      have h3 : ((Z - 1 : ℕ) : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn.1
      linarith
    have hnhi : (n : ℝ) ≤ 2 * (x : ℝ) ^ (1 / 3 : ℝ) := by
      have h1 : (n : ℝ) ≤ (Y : ℝ) + 1 := by exact_mod_cast hn.2
      have h2 : 1 ≤ (x : ℝ) ^ (1 / 3 : ℝ) := Real.one_le_rpow hx1 (by norm_num)
      linarith
    have hloglo : t / 8 - Real.log 2 ≤ Real.log (n : ℝ) := by
      have h1 := Real.log_le_log (by positivity) hnlo
      have h2 : Real.log ((x : ℝ) ^ (1 / 8 : ℝ) / 2) = t / 8 - Real.log 2 := by
        rw [Real.log_div hx18pos.ne' (by norm_num), Real.log_rpow hxpos]
        linarith [ht_eq]
      linarith
    have hloghi : Real.log (n : ℝ) ≤ t / 3 + Real.log 2 := by
      have h1 := Real.log_le_log hnpos hnhi
      have h2 : Real.log (2 * (x : ℝ) ^ (1 / 3 : ℝ)) = Real.log 2 + t / 3 := by
        rw [Real.log_mul (by norm_num) hx13pos.ne', Real.log_rpow hxpos]
        linarith [ht_eq]
      linarith
    refine ⟨by linarith, hloghi, by linarith⟩
  have huZhi : Real.log (Z : ℝ) ≤ t / 8 + Real.log 2 := by
    have h1 := Real.log_le_log (by positivity) hZu
    have h2 : Real.log (2 * (x : ℝ) ^ (1 / 8 : ℝ)) = Real.log 2 + t / 8 := by
      rw [Real.log_mul (by norm_num) hx18pos.ne', Real.log_rpow hxpos]
      linarith [ht_eq]
    linarith
  have huYlo : t / 3 - Real.log 2 ≤ Real.log (Y : ℝ) := by
    have h1 := Real.log_le_log (by positivity) hYlo
    have h2 : Real.log ((x : ℝ) ^ (1 / 3 : ℝ) / 2) = t / 3 - Real.log 2 := by
      rw [Real.log_div hx13pos.ne' (by norm_num), Real.log_rpow hxpos]
      linarith [ht_eq]
    linarith
  -- 1/(p-1) = 1/p + 1/(p(p-1))
  have hsplit : (∑ p ∈ (Finset.Icc Z Y).filter Nat.Prime,
      1 / (((p : ℝ) - 1) * Real.log (D / (p : ℝ)))) ≤
      (∑ p ∈ (Finset.Icc Z Y).filter Nat.Prime, 1 / ((p : ℝ) * Real.log (D / (p : ℝ)))) +
        18 / (t * (x : ℝ) ^ (1 / 8 : ℝ)) := by
    have hterm : ∀ p ∈ (Finset.Icc Z Y).filter Nat.Prime,
        1 / (((p : ℝ) - 1) * Real.log (D / (p : ℝ))) ≤
          1 / ((p : ℝ) * Real.log (D / (p : ℝ))) +
            (9 / t) * (1 / ((p : ℝ) * ((p : ℝ) - 1))) := by
      intro p hp
      rw [Finset.mem_filter, Finset.mem_Icc] at hp
      have hp2 : 2 ≤ p := hp.2.two_le
      have hppos : (0 : ℝ) < (p : ℝ) := by positivity
      have hp1 : (0 : ℝ) < (p : ℝ) - 1 := by
        have h : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp2
        linarith
      have hL : Real.log (D / (p : ℝ)) = b - Real.log (p : ℝ) := by
        rw [Real.log_div hDpos.ne' hppos.ne', hb_eq]
      have hLge : t / 9 ≤ b - Real.log (p : ℝ) :=
        (hr p (by rw [Finset.mem_Icc]; omega)).2.2
      have hLp : 0 < b - Real.log (p : ℝ) := by linarith
      rw [hL]
      have hid : 1 / (((p : ℝ) - 1) * (b - Real.log (p : ℝ))) =
          1 / ((p : ℝ) * (b - Real.log (p : ℝ))) +
            (1 / (b - Real.log (p : ℝ))) * (1 / ((p : ℝ) * ((p : ℝ) - 1))) := by
        field_simp [hppos.ne', hp1.ne', hLp.ne']
        ring
      rw [hid]
      have hinv : 1 / (b - Real.log (p : ℝ)) ≤ 9 / t := by
        rw [div_le_div_iff₀ hLp ht0]
        linarith
      have hpos : 0 ≤ 1 / ((p : ℝ) * ((p : ℝ) - 1)) := by positivity
      have hmul := mul_le_mul_of_nonneg_right hinv hpos
      linarith
    have htel : (∑ n ∈ Finset.Icc Z Y, 1 / ((n : ℝ) * ((n : ℝ) - 1))) =
        1 / ((Z : ℝ) - 1) - 1 / (Y : ℝ) := by
      have h4 : ∀ n ∈ Finset.Icc Z Y, 1 / ((n : ℝ) * ((n : ℝ) - 1)) =
          -((1 / (((n + 1 : ℕ) : ℝ) - 1)) - 1 / ((n : ℝ) - 1)) := by
        intro n hn
        rw [Finset.mem_Icc] at hn
        have hn2 : 2 ≤ n := by omega
        have hnp : (0 : ℝ) < (n : ℝ) := by positivity
        have hn1p : (0 : ℝ) < (n : ℝ) - 1 := by
          have h : (2 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn2
          linarith
        have hcast : ((n + 1 : ℕ) : ℝ) - 1 = (n : ℝ) := by push_cast; ring
        rw [hcast]
        field_simp [hnp.ne', hn1p.ne']
        ring
      have h2 := Finset.sum_Icc_sub hZY (fun n : ℕ => 1 / ((n : ℝ) - 1))
      have hY1r : ((Y + 1 : ℕ) : ℝ) - 1 = (Y : ℝ) := by push_cast; ring
      rw [hY1r] at h2
