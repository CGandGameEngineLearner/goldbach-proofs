    _ ≤ κ * (2 * X2) / 200 - 2 * (2 * X2) ^ (7 / 8 : ℝ) * L ^ 2 := by linarith [hE]
    _ = (κ * (2 * X2) / (200 * L ^ 2) - 2 * (2 * X2) ^ (7 / 8 : ℝ)) * L ^ 2 := by
