        (Real.sqrt (U + 1 + (2 * R) ^ 2 * H) * Real.sqrt U) := by
    rw [Real.sqrt_mul hM0 U]
    ring
  have hfac : ∀ (X : ℝ), 1 ≤ X →
      (4 * R ^ 2 ≤ X → Real.sqrt (X + 1 + (2 * R) ^ 2 * H) * Real.sqrt X ≤ X * Real.sqrt (2 + H)) ∧
      (X ≤ 4 * R ^ 2 → Real.sqrt (X + 1 + (2 * R) ^ 2 * H) * Real.sqrt X ≤
        2 * R * Real.sqrt ((2 + H) * X)) := by
    intro X hX
    have hX0 : 0 ≤ X := by linarith
    constructor
    · intro hle
      have h1 : X + 1 + (2 * R) ^ 2 * H ≤ X * (2 + H) := by
        have h2 : (2 * R) ^ 2 * H ≤ X * H := by
          have h3 : (2 * R) ^ 2 ≤ X := by linarith
          exact mul_le_mul_of_nonneg_right h3 hH
        linarith
      calc Real.sqrt (X + 1 + (2 * R) ^ 2 * H) * Real.sqrt X
          ≤ Real.sqrt (X * (2 + H)) * Real.sqrt X := by gcongr
        _ = Real.sqrt (X * (2 + H) * X) := by rw [← Real.sqrt_mul (by positivity)]
        _ = Real.sqrt (X ^ 2 * (2 + H)) := by congr 1; ring
        _ = X * Real.sqrt (2 + H) := by
            rw [Real.sqrt_mul (by positivity), Real.sqrt_sq hX0]
    · intro hle
      have h1 : X + 1 + (2 * R) ^ 2 * H ≤ 4 * R ^ 2 * (2 + H) := by
        have h2 : (2 * R) ^ 2 * H = 4 * R ^ 2 * H := by ring
        have h3 : 1 ≤ 4 * R ^ 2 := by nlinarith
        linarith
      calc Real.sqrt (X + 1 + (2 * R) ^ 2 * H) * Real.sqrt X
          ≤ Real.sqrt (4 * R ^ 2 * (2 + H)) * Real.sqrt X := by gcongr
        _ = Real.sqrt (4 * R ^ 2 * (2 + H) * X) := by rw [← Real.sqrt_mul (by positivity)]
        _ = 2 * R * Real.sqrt ((2 + H) * X) := by
            have h4 : 4 * R ^ 2 * (2 + H) * X = (2 * R) ^ 2 * ((2 + H) * X) := by ring
            rw [h4, Real.sqrt_mul (by positivity), Real.sqrt_sq (by linarith)]
  rw [hsplit]
  have hnn : 0 ≤ M * U / R := by positivity
  have hsqU : 0 ≤ Real.sqrt U := Real.sqrt_nonneg U
  have hsqM : 0 ≤ Real.sqrt M := Real.sqrt_nonneg M
  have hsqMU : 0 ≤ Real.sqrt (M * U) := Real.sqrt_nonneg (M * U)
  have hT2 : 0 ≤ 2 * M * Real.sqrt U := by positivity
  have hT3 : 0 ≤ 2 * U * Real.sqrt M := by positivity
  have hT4 : 0 ≤ 4 * R * Real.sqrt (M * U) := by positivity
  by_cases h1 : 4 * R ^ 2 ≤ M
  · by_cases h2 : 4 * R ^ 2 ≤ U
    · have hA := (hfac M hM).1 h1
      have hB := (hfac U hU).1 h2
      have hprod : (Real.sqrt (M + 1 + (2 * R) ^ 2 * H) * Real.sqrt M) *
          (Real.sqrt (U + 1 + (2 * R) ^ 2 * H) * Real.sqrt U) ≤
          (M * Real.sqrt (2 + H)) * (U * Real.sqrt (2 + H)) :=
        mul_le_mul hA hB (by positivity) (by positivity)
      have hsq2 : (M * Real.sqrt (2 + H)) * (U * Real.sqrt (2 + H)) = (2 + H) * (M * U) := by
        calc (M * Real.sqrt (2 + H)) * (U * Real.sqrt (2 + H))
            = M * U * (Real.sqrt (2 + H) * Real.sqrt (2 + H)) := by ring
          _ = M * U * (2 + H) := by rw [← sq, Real.sq_sqrt hT]
          _ = (2 + H) * (M * U) := by ring
      calc (1 / R) * ((Real.sqrt (M + 1 + (2 * R) ^ 2 * H) * Real.sqrt M) *
            (Real.sqrt (U + 1 + (2 * R) ^ 2 * H) * Real.sqrt U))
          ≤ (1 / R) * ((M * Real.sqrt (2 + H)) * (U * Real.sqrt (2 + H))) :=
            mul_le_mul_of_nonneg_left hprod (by positivity)
        _ = (1 / R) * ((2 + H) * (M * U)) := by rw [hsq2]
        _ = (2 + H) * (M * U / R) := by ring
        _ ≤ (2 + H) * (M * U / R + 2 * M * Real.sqrt U + 2 * U * Real.sqrt M +
