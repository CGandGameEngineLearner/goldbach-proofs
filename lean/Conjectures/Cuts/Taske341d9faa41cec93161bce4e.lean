          (Finset.Ioc (x / 2) x))).card ≤
        ((Finset.filter (fun n : ℕ => (n : ℝ) ≤ (x : ℝ) / 2 * (1 + TSw_delta x))
          (Finset.Ioc (x / 2) x)).card) +
        ((Finset.filter (fun n : ℕ => (x : ℝ) / (1 + TSw_delta x) < (n : ℝ))
          (Finset.Ioc (x / 2) x)).card) := hunion
    have hle : ((Finset.Ioc (x / 2) x).filter (fun n => ¬ TSw_core x n)).card ≤
        ((Finset.filter (fun n : ℕ => (n : ℝ) ≤ (x : ℝ) / 2 * (1 + TSw_delta x))
          (Finset.Ioc (x / 2) x)).card) +
        ((Finset.filter (fun n : ℕ => (x : ℝ) / (1 + TSw_delta x) < (n : ℝ))
          (Finset.Ioc (x / 2) x)).card) := le_trans hle1 hle2
    exact_mod_cast hle
  have hdiv : ((x / 2 : ℕ) : ℝ) ≤ (x : ℝ) / 2 := by
    have h := Nat.div_add_mod x 2
    have h' : ((2 * (x / 2) + x % 2 : ℕ) : ℝ) = (x : ℝ) := by exact_mod_cast h
    push_cast at h'
    have h2' : x % 2 ≤ 1 := by omega
    have h2 : ((x % 2 : ℕ) : ℝ) ≤ 1 := by exact_mod_cast h2'
    linarith
  have hx2 : ((x / 2 : ℕ) : ℝ) ≤ (x : ℝ) / 2 * (1 + TSw_delta x) := by
    have h1 : ((x / 2 : ℕ) : ℝ) ≤ (x : ℝ) / 2 := hdiv
    have h2 : (x : ℝ) / 2 ≤ (x : ℝ) / 2 * (1 + TSw_delta x) := by
      have : (0 : ℝ) ≤ (x : ℝ) / 2 := by positivity
      nlinarith
    linarith
  have hx3 : (x : ℝ) / (1 + TSw_delta x) ≤ (x : ℝ) := by
    exact div_le_self (by positivity) (by linarith)
  have hS1 := TSw_card_le_of_le (x / 2) x ((x : ℝ) / 2 * (1 + TSw_delta x)) (by positivity) hx2
  have hS2 := TSw_card_le_of_gt (x / 2) x ((x : ℝ) / (1 + TSw_delta x)) hx3
  have hxδ : (x : ℝ) / (1 + TSw_delta x) = (x : ℝ) - (x : ℝ) * TSw_delta x /
      (1 + TSw_delta x) := by
    field_simp [h1δ.ne']
    ring
  have hS2' : (x : ℝ) - (x : ℝ) / (1 + TSw_delta x) + 1 ≤ (x : ℝ) * TSw_delta x + 1 := by
    rw [hxδ]
    have : (x : ℝ) * TSw_delta x / (1 + TSw_delta x) ≤ (x : ℝ) * TSw_delta x := by
      have hx0 : (0 : ℝ) ≤ (x : ℝ) := Nat.cast_nonneg _
      exact div_le_self (mul_nonneg hx0 hδ) (by linarith)
    linarith
  have hS1' : ((Finset.filter (fun n : ℕ => (n : ℝ) ≤ (x : ℝ) / 2 * (1 + TSw_delta x))
        (Finset.Ioc (x / 2) x)).card : ℝ) ≤
      (x : ℝ) / 2 + (x : ℝ) * TSw_delta x / 2 - ((x / 2 : ℕ) : ℝ) + 1 := by
    calc _ ≤ (x : ℝ) / 2 * (1 + TSw_delta x) - ((x / 2 : ℕ) : ℝ) + 1 := hS1
      _ = _ := by ring
  have hC : 0 ≤ (x : ℝ) * TSw_delta x := mul_nonneg (Nat.cast_nonneg _) hδ
  linarith

/-! ### The boxes are disjoint and cover the core of the raw triple set -/

lemma TSw_pairs_disjoint (x : ℕ) (h1δ : 1 < 1 + TSw_delta x)
    (hzpos : 0 < (Taske724d7d203de1af512de02c5_z x : ℝ)) {j j' : ℕ} (hne : j ≠ j') :
    Disjoint (TSw_pairs x j) (TSw_pairs x j') := by
  rw [Finset.disjoint_left]
  intro p hp hp'
  obtain ⟨hm, hk, hα, hβ⟩ := TSw_pairs_mem hp
  obtain ⟨hm', hk', hα', hβ'⟩ := TSw_pairs_mem hp'
  obtain ⟨hL, hU, hkP⟩ := TSw_beta_spec hβ
  obtain ⟨hL', hU', hkP'⟩ := TSw_beta_spec hβ'
  have hz : (Taske724d7d203de1af512de02c5_z x : ℝ) ≤ (p.2 : ℝ) := by
    exact_mod_cast le_trans (TSw_L_ge (x := x) (j := j)) hL
  have hr : (p.2 : ℝ) ≤ (Taske724d7d203de1af512de02c5_root x : ℝ) := by
    exact_mod_cast le_trans hU (TSw_U_le_root x j)
  have h1 : j = TSw_idx x p.2 := (TSw_mem_box_iff h1δ hzpos hz hr).mp ⟨hL, hU⟩
  have h2 : j' = TSw_idx x p.2 := (TSw_mem_box_iff h1δ hzpos hz hr).mp ⟨hL', hU'⟩
  exact hne (h1.trans h2.symm)

/-- The sum of the box convolutions is at most the size of the raw triple set. -/
lemma TSw_count_lower (x : ℕ) (h1δ : 1 < 1 + TSw_delta x)
    (hzpos : 0 < (Taske724d7d203de1af512de02c5_z x : ℝ)) :
    (∑ j ∈ Finset.range (TSw_J x),
        ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j), TSw_seq x j n) ≤
      ((Taske724d7d203de1af512de02c5_tripleRaw x).card : ℝ) := by
  have hdisj : (↑(Finset.range (TSw_J x)) : Set ℕ).PairwiseDisjoint (TSw_pairs x) := by
    intro j _ j' _ hne
    exact TSw_pairs_disjoint x h1δ hzpos hne
  have hB : ((Finset.range (TSw_J x)).biUnion (TSw_pairs x)).card =
      ∑ j ∈ Finset.range (TSw_J x), (TSw_pairs x j).card := Finset.card_biUnion hdisj
  have hinjB : Set.InjOn (fun p : ℕ × ℕ => p.2 * p.1)
      (↑((Finset.range (TSw_J x)).biUnion (TSw_pairs x))) := by
    intro p hp q hq heq
    obtain ⟨j, hj, hpj⟩ := Finset.mem_biUnion.mp hp
    obtain ⟨j', hj', hqj⟩ := Finset.mem_biUnion.mp hq
    obtain ⟨hm, hk, hα, hβ⟩ := TSw_pairs_mem hpj
    obtain ⟨hm', hk', hα', hβ'⟩ := TSw_pairs_mem hqj
    obtain ⟨hL, hU, hkP⟩ := TSw_beta_spec hβ
    obtain ⟨hL', hU', hkP'⟩ := TSw_beta_spec hβ'
    dsimp only at heq
    have hdiv : q.2 ∣ p.2 * p.1 := ⟨q.1, heq⟩
    rcases TSw_pair_prime_factor hpj hkP' hdiv with h | h
    · have hkq : q.2 = p.2 := h
      have hmq : p.1 = q.1 := by
        have hstep : p.2 * p.1 = p.2 * q.1 := by
          calc p.2 * p.1 = q.2 * q.1 := heq
            _ = p.2 * q.1 := by rw [hkq]
        exact mul_left_cancel₀ hkP.ne_zero hstep
      exact Prod.ext hmq hkq.symm
    · exact absurd h (by have := le_trans hU' (TSw_U_le_root x j'); omega)
  have hsubB : Set.MapsTo (fun p : ℕ × ℕ => p.2 * p.1)
      (↑((Finset.range (TSw_J x)).biUnion (TSw_pairs x)))
      (↑(Taske724d7d203de1af512de02c5_tripleRaw x)) := by
    intro p hp
    obtain ⟨j, hj, hpj⟩ := Finset.mem_biUnion.mp hp
    exact TSw_pair_prod_mem hpj
  calc (∑ j ∈ Finset.range (TSw_J x),
        ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j), TSw_seq x j n)
      = ∑ j ∈ Finset.range (TSw_J x), ((TSw_pairs x j).card : ℝ) := by
        refine Finset.sum_congr rfl fun j _ => ?_
        exact (TSw_pairs_eq_sum x j).symm
    _ = (((Finset.range (TSw_J x)).biUnion (TSw_pairs x)).card : ℝ) := by
        rw [hB, Nat.cast_sum]
    _ ≤ ((Taske724d7d203de1af512de02c5_tripleRaw x).card : ℝ) :=
        Nat.cast_le.mpr (Finset.card_le_card_of_injOn _ hsubB hinjB)

/-- Every core triple with a prime shift is a pair of exactly one box. -/
lemma TSw_core_pair (x : ℕ) (h1δ : 1 < 1 + TSw_delta x)
    (hzpos : 0 < (Taske724d7d203de1af512de02c5_z x : ℝ))
    {t : ℕ × ℕ × ℕ} (ht : t ∈ TSw_Tri x) (hcore : TSw_core x (TSw_mult t)) :
    TSw_idx x t.1 < TSw_J x ∧
      (t.2.1 * t.2.2, t.1) ∈ TSw_pairs x (TSw_idx x t.1) ∧
      t.2.1 * t.2.2 * t.1 + 2 = TSw_mult t + 2 := by
  obtain ⟨ht1, ht2, ht3, htz, htr, htro, htle, hlo, hhi⟩ := TSw_mem_Tri ht
  have hz : (Taske724d7d203de1af512de02c5_z x : ℝ) ≤ (t.1 : ℝ) := by exact_mod_cast htz
  have hr : (t.1 : ℝ) ≤ (Taske724d7d203de1af512de02c5_root x : ℝ) := by exact_mod_cast htr
  have hδ : 0 ≤ TSw_delta x := by unfold TSw_delta; positivity
  have hz1 : 1 ≤ Taske724d7d203de1af512de02c5_z x := by exact_mod_cast hzpos
  set j := TSw_idx x t.1
  have hjJ : j < TSw_J x := TSw_idx_lt_J h1δ hzpos hz hr
  have hbox : TSw_L x j ≤ t.1 ∧ t.1 ≤ TSw_U x j := (TSw_mem_box_iff h1δ hzpos hz hr).mpr rfl
  have hβ : TSw_beta x j t.1 = 1 := (TSw_beta_eq_one_iff x j t.1).mpr ⟨hbox.1, hbox.2, ht1⟩
  have hUδ : (TSw_U x j : ℝ) ≤ (TSw_L x j : ℝ) * (1 + TSw_delta x) :=
    TSw_U_le_L_mul hδ hz1
  have hLpos : (0 : ℝ) < (TSw_L x j : ℝ) := by
    have : 1 ≤ TSw_L x j := le_trans hz1 (TSw_L_ge (x := x) (j := j))
    exact_mod_cast this
  have hU1 : 1 ≤ TSw_U x j := le_trans (by omega) hbox.2
  have hUpos : (0 : ℝ) < (TSw_U x j : ℝ) := by exact_mod_cast hU1
  have h1δpos : (0 : ℝ) < 1 + TSw_delta x := by linarith
  have hLt : (TSw_L x j : ℝ) ≤ (t.1 : ℝ) := by exact_mod_cast hbox.1
  have hUt : (t.1 : ℝ) ≤ (TSw_U x j : ℝ) := by exact_mod_cast hbox.2
  have hm : (t.2.1 * t.2.2 : ℕ) = t.2.1 * t.2.2 := rfl
  have hn : ((TSw_mult t : ℕ) : ℝ) = (t.1 : ℝ) * ((t.2.1 * t.2.2 : ℕ) : ℝ) := by
    unfold TSw_mult; push_cast; ring
  have hcore1 : (x : ℝ) / 2 * (1 + TSw_delta x) < ((TSw_mult t : ℕ) : ℝ) := hcore.1
  have hcore2 : ((TSw_mult t : ℕ) : ℝ) ≤ (x : ℝ) / (1 + TSw_delta x) := hcore.2
  have hmp : (0 : ℝ) ≤ ((t.2.1 * t.2.2 : ℕ) : ℝ) := Nat.cast_nonneg _
  have hstep1 : (x : ℝ) / 2 * (1 + TSw_delta x) <
      (TSw_L x j : ℝ) * (1 + TSw_delta x) * ((t.2.1 * t.2.2 : ℕ) : ℝ) := by
    have h1 : (t.1 : ℝ) * ((t.2.1 * t.2.2 : ℕ) : ℝ) ≤
        (TSw_U x j : ℝ) * ((t.2.1 * t.2.2 : ℕ) : ℝ) :=
      mul_le_mul_of_nonneg_right hUt hmp
    have h2 : (TSw_U x j : ℝ) * ((t.2.1 * t.2.2 : ℕ) : ℝ) ≤
        (TSw_L x j : ℝ) * (1 + TSw_delta x) * ((t.2.1 * t.2.2 : ℕ) : ℝ) :=
      mul_le_mul_of_nonneg_right hUδ hmp
    linarith
  have hlo_m : (x : ℝ) / (2 * (TSw_L x j : ℝ)) < ((t.2.1 * t.2.2 : ℕ) : ℝ) := by
    have h3 : (x : ℝ) / 2 < (TSw_L x j : ℝ) * ((t.2.1 * t.2.2 : ℕ) : ℝ) := by
      have h4 : (x : ℝ) / 2 * (1 + TSw_delta x) <
          ((TSw_L x j : ℝ) * ((t.2.1 * t.2.2 : ℕ) : ℝ)) * (1 + TSw_delta x) := by
        calc _ < (TSw_L x j : ℝ) * (1 + TSw_delta x) * ((t.2.1 * t.2.2 : ℕ) : ℝ) := hstep1
          _ = _ := by ring
      exact lt_of_mul_lt_mul_right h4 h1δpos.le
    rw [div_lt_iff₀ (by positivity : (0 : ℝ) < 2 * (TSw_L x j : ℝ))]
    linarith
  have hstep2 : (TSw_U x j : ℝ) * ((t.2.1 * t.2.2 : ℕ) : ℝ) ≤ (x : ℝ) := by
    have h1 : (TSw_U x j : ℝ) ≤ (t.1 : ℝ) * (1 + TSw_delta x) := by
      have h2 : (TSw_L x j : ℝ) * (1 + TSw_delta x) ≤ (t.1 : ℝ) * (1 + TSw_delta x) :=
        mul_le_mul_of_nonneg_right hLt h1δpos.le
      linarith
    have h3 : (TSw_U x j : ℝ) * ((t.2.1 * t.2.2 : ℕ) : ℝ) ≤
        (t.1 : ℝ) * (1 + TSw_delta x) * ((t.2.1 * t.2.2 : ℕ) : ℝ) :=
      mul_le_mul_of_nonneg_right h1 hmp
    have h4 : (t.1 : ℝ) * (1 + TSw_delta x) * ((t.2.1 * t.2.2 : ℕ) : ℝ) =
        (1 + TSw_delta x) * ((TSw_mult t : ℕ) : ℝ) := by rw [hn]; ring
