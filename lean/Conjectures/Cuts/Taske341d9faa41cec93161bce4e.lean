/-! ### The divisor sum of the inverse totient -/

lemma TSw_sum_powerset_prod (Q : Finset ℕ) (g : ℕ → ℝ) :
    ∑ s ∈ Q.powerset, ∏ p ∈ s, g p = ∏ p ∈ Q, (1 + g p) := by
  induction Q using Finset.induction with
  | empty => simp
  | @insert a Q ha ih =>
    rw [Finset.powerset_insert, Finset.prod_insert ha]
    have hdisj : Disjoint Q.powerset (Q.powerset.image (insert a)) := by
      rw [Finset.disjoint_left]
      intro s hs hs'
      obtain ⟨t, ht, hst⟩ := Finset.mem_image.mp hs'
      have h1 : a ∈ s := by rw [← hst]; exact Finset.mem_insert_self a t
      exact ha (Finset.mem_powerset.mp hs h1)
    have hinj : Set.InjOn (fun s : Finset ℕ => insert a s)
        (↑(Q.powerset) : Set (Finset ℕ)) := by
      intro s hs t ht hst
      have hsa : a ∉ s := fun hmem => ha (Finset.mem_powerset.mp hs hmem)
      have hta : a ∉ t := fun hmem => ha (Finset.mem_powerset.mp ht hmem)
      dsimp only at hst
      have hta : a ∉ t := fun hmem => ha (Finset.mem_powerset.mp ht hmem)
      have her := congrArg (fun u : Finset ℕ => u.erase a) hst
      simpa [Finset.erase_insert hsa, Finset.erase_insert hta] using her
    rw [Finset.sum_union hdisj, Finset.sum_image hinj, ih]
    have hstep : ∀ s ∈ Q.powerset, ∏ p ∈ insert a s, g p = g a * ∏ p ∈ s, g p := by
      intro s hs
      have hsa : a ∉ s := fun hmem => ha (Finset.mem_powerset.mp hs hmem)
      rw [Finset.prod_insert hsa]
    rw [Finset.sum_congr rfl hstep, ← Finset.mul_sum, ih]
    ring

lemma TSw_sum_inv_totient (P : ℕ) (hP : Squarefree P) :
    ∑ d ∈ P.divisors, (1 / (d.totient : ℝ)) =
      ∏ p ∈ P.primeFactors, (1 + 1 / ((p : ℝ) - 1)) := by
  rw [Internal.sum_divisors_eq_sum_primeFactors_powerset hP]
  have hstep : ∀ s ∈ P.primeFactors.powerset,
      (1 / ((s.prod id).totient : ℝ)) = ∏ p ∈ s, (1 / ((p : ℝ) - 1)) := by
    intro s hs
    have hsub : s ⊆ P.primeFactors := Finset.mem_powerset.mp hs
    have hpr : ∀ p ∈ s, p.Prime := fun p hp => Nat.prime_of_mem_primeFactors (hsub hp)
    have h1 := progressionDensity_mult.map_prod_of_prime s hpr
    have h1'' : progressionDensity (∏ a ∈ s, a) = ∏ p ∈ s, (1 / ((p : ℝ) - 1)) := by
      rw [h1]
      exact Finset.prod_congr rfl fun p hp => progressionDensity_prime (hpr p hp)
    have h1' : progressionDensity (s.prod id) = ∏ p ∈ s, (1 / ((p : ℝ) - 1)) := h1''
    have h3 : progressionDensity (s.prod id) = ((s.prod id).totient : ℝ)⁻¹ := rfl
    rw [h3] at h1'
    have h4 : (1 / ((s.prod id).totient : ℝ)) = ((s.prod id).totient : ℝ)⁻¹ := one_div _
    rw [h4]
    exact h1'
  rw [Finset.sum_congr rfl hstep]
  exact TSw_sum_powerset_prod P.primeFactors (fun p => 1 / ((p : ℝ) - 1))

/-! ### The shift congruence -/

lemma TSw_shift_mod {d n : ℕ} (hd : 3 ≤ d) : d ∣ n + 2 ↔ n % d = (d - 2) % d := by
  have h1 : (d - 2) % d = d - 2 := Nat.mod_eq_of_lt (by omega)
  rw [h1]
  have h2 : 2 % d = 2 := Nat.mod_eq_of_lt (by omega)
  constructor
  · intro hdiv
    have hz : (n + 2) % d = 0 := Nat.dvd_iff_mod_eq_zero.mp hdiv
    have hmod : (n % d + 2) % d = 0 := by
      have hstep := Nat.add_mod n 2 d
      rw [h2] at hstep
      rw [← hstep]
      exact hz
    have hr : n % d < d := Nat.mod_lt n (by omega)
    have hge : d ≤ n % d + 2 := by
      by_contra hlt
      have hlt' : n % d + 2 < d := Nat.lt_of_not_ge hlt
      rw [Nat.mod_eq_of_lt hlt'] at hmod
      omega
    have hsub : (n % d + 2) % d = (n % d + 2 - d) % d := Nat.mod_eq_sub_mod hge
    have hlt : n % d + 2 - d < d := by omega
    rw [hsub, Nat.mod_eq_of_lt hlt] at hmod
    omega
  · intro h
    have hz : (n + 2) % d = 0 := by
      have hstep := Nat.add_mod n 2 d
      rw [h2] at hstep
      have h3 : d - 2 + 2 = d := by omega
      rw [h, h3, Nat.mod_self] at hstep
      exact hstep
    exact Nat.dvd_iff_mod_eq_zero.mpr hz

