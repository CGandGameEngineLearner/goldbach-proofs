theorem Taske724d7d203de1af512de02c5_conv_char_reduce (α β : ℕ → ℝ) (M N Q : ℕ) (hQ : 1 ≤ Q) (G : ℝ)
    (hG : ∀ s : ℕ, 1 ≤ s → s ≤ Q →
      (∑ r ∈ Finset.Ioc 1 Q, (1 / (r.totient : ℝ)) * Taske724d7d203de1af512de02c5_primMass α β M N s r) ≤ G) :
