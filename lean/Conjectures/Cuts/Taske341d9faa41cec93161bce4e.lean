/-- The prime is the term on the right of the shift; each factor of the left term is at
least the eighth root of the counting scale. -/
def Taske724d7d203de1af512de02c5_reverseRoughChenAt (X n : ℕ) : Prop :=
  (n + 2).Prime ∧
    ((n.Prime ∧ X ≤ n ^ 8) ∨
      ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p ≠ q ∧ n = p * q ∧ X ≤ p ^ 8 ∧ X ≤ q ^ 8)

noncomputable def Taske724d7d203de1af512de02c5_reverseRoughChenSet (X : ℕ) : Finset ℕ :=
  (Finset.range (X + 1)).filter (Taske724d7d203de1af512de02c5_reverseRoughChenAt X)

/-- The quantitative counting input. -/
