/-! ### The statement -/

theorem a2b (η : ℝ) (hη : 0 < η) : ∀ᶠ x : ℕ in atTop, ∀ D : ℝ,
    (x : ℝ) ^ (9 / 20 : ℝ) ≤ D → D ≤ (x : ℝ) ^ (1 / 2 : ℝ) →
    (∑ p ∈ (Finset.Icc (z x) (root x)).filter Nat.Prime,
        (1 : ℝ) / ((p - 1) * Real.log (D / (p : ℝ)))) ≤
      (1 + η) * (1 / Real.log D) *
        Real.log (Real.log (root x) * (Real.log D - Real.log (z x)) /
          (Real.log (z x) * (Real.log D - Real.log (root x)))) := by
  obtain ⟨CM, hCMpos, hCMb⟩ :=
    GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.mertensFirst
  have hM : ∀ n : ℕ, 2 ≤ n → |plr n - Real.log (n : ℝ)| ≤ CM := by
    intro n hn
    have h1 := hCMb (n : ℝ) (by exact_mod_cast hn)
    have h2 := GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeLogReciprocal_eq_sum_Icc (n : ℝ)
    rw [Nat.floor_natCast] at h2
    have h3 : plr n =
        GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeLogReciprocal
          (n : ℝ) := by
      rw [h2]
      rfl
    rw [h3]
    exact h1
  set η' := min η (1 / 1000)
  have hη' : 0 < η' := lt_min hη (by norm_num)
  have hη'1 : η' ≤ 1 / 1000 := min_le_right _ _
  have hη'η : η' ≤ η := min_le_left _ _
  filter_upwards [ev_log_ge 100, ev_log_ge (Real.log 2 / η'),
    ev_log_ge (50000 * (CM + 1) / η'), ev_rpow_ge 4 (by norm_num : (0 : ℝ) < 1 / 8),
    ev_rpow_ge 4 (by norm_num : (0 : ℝ) < 5 / 24), ev_rpow_ge 2 (by norm_num : (0 : ℝ) < 1 / 3),
    ev_rpow_ge (40 / η') (by norm_num : (0 : ℝ) < 1 / 8), eventually_ge_atTop (1 : ℕ)] with
    x ht100 hlog2 hK hx4 hx524 hx13 hx40 x1
  intro D hDlo hDhi
  have hxpos : (0 : ℝ) < (x : ℝ) := by positivity
  have hx18pos : 0 < (x : ℝ) ^ (1 / 8 : ℝ) := Real.rpow_pos_of_pos hxpos _
  have hx13pos : 0 < (x : ℝ) ^ (1 / 3 : ℝ) := Real.rpow_pos_of_pos hxpos _
  have hDpos : 0 < D := lt_of_lt_of_le (Real.rpow_pos_of_pos hxpos (9 / 20 : ℝ)) hDlo
  have hlogDlo : (9 / 20 : ℝ) * Real.log (x : ℝ) ≤ Real.log D := by
    have h := Real.log_le_log (Real.rpow_pos_of_pos hxpos (9 / 20 : ℝ)) hDlo
    rwa [Real.log_rpow hxpos] at h
  have hlogDhi : Real.log D ≤ Real.log (x : ℝ) / 2 := by
    have h := Real.log_le_log hDpos hDhi
    rw [Real.log_rpow hxpos] at h
    linarith
  have hZ : (x : ℝ) ^ (1 / 8 : ℝ) ≤ (z x : ℝ) := by
    rw [z]
    exact Nat.le_ceil _
  have hZu : (z x : ℝ) ≤ 2 * (x : ℝ) ^ (1 / 8 : ℝ) := by
    have h1 : (z x : ℝ) < (x : ℝ) ^ (1 / 8 : ℝ) + 1 := by
      rw [z]
      exact Nat.ceil_lt_add_one hx18pos.le
    linarith
  have hY : (root x : ℝ) ≤ (x : ℝ) ^ (1 / 3 : ℝ) := by
    rw [root]
    exact Nat.floor_le (Real.rpow_nonneg hxpos.le (1 / 3 : ℝ))
  have hYlo : (x : ℝ) ^ (1 / 3 : ℝ) / 2 ≤ (root x : ℝ) := by
    have h1 : (x : ℝ) ^ (1 / 3 : ℝ) < (root x : ℝ) + 1 := by
      rw [root]
      exact Nat.lt_floor_add_one _
    linarith
  have hZlt : z x < root x := by
    have hsplit : (x : ℝ) ^ (1 / 3 : ℝ) = (x : ℝ) ^ (1 / 8 : ℝ) * (x : ℝ) ^ (5 / 24 : ℝ) := by
      rw [← Real.rpow_add hxpos]
      congr 1
      norm_num
    have h1 : (z x : ℝ) < 2 * (x : ℝ) ^ (1 / 8 : ℝ) := by
      have h1' : (z x : ℝ) < (x : ℝ) ^ (1 / 8 : ℝ) + 1 := by
        rw [z]
        exact Nat.ceil_lt_add_one hx18pos.le
      linarith
    have h2 : (x : ℝ) ^ (1 / 3 : ℝ) / 2 ≤ (root x : ℝ) := hYlo
    have h3 : 4 * (x : ℝ) ^ (1 / 8 : ℝ) ≤ (x : ℝ) ^ (1 / 3 : ℝ) := by
      rw [hsplit]
      nlinarith [mul_nonneg hx18pos.le (sub_nonneg.mpr hx524)]
    have h4 : (z x : ℝ) < (root x : ℝ) := by linarith
    exact_mod_cast h4
  have hlog2' : Real.log 2 ≤ η' * Real.log (x : ℝ) := by
    calc Real.log 2 = η' * (Real.log 2 / η') := by field_simp [hη'.ne']
      _ ≤ η' * Real.log (x : ℝ) := mul_le_mul_of_nonneg_left hlog2 hη'.le
  have herr : 40 ≤ η' * (x : ℝ) ^ (1 / 8 : ℝ) := by
    calc (40 : ℝ) = η' * (40 / η') := by field_simp [hη'.ne']
      _ ≤ η' * (x : ℝ) ^ (1 / 8 : ℝ) := mul_le_mul_of_nonneg_left hx40 hη'.le
  have x1r : (1 : ℝ) ≤ (x : ℝ) := by exact_mod_cast x1
  obtain ⟨hS, hMnn⟩ := core hη' hη'1 hCMpos.le ht100 x1r hDpos hlogDlo hlogDhi hZ hZu
    hZlt.le hZlt hY hYlo hx4 hlog2' hK herr hM
  calc (∑ p ∈ (Finset.Icc (z x) (root x)).filter Nat.Prime,
        (1 : ℝ) / ((p - 1) * Real.log (D / (p : ℝ))))
      ≤ (1 + η') * ((1 / Real.log D) *
          Real.log (Real.log (root x) * (Real.log D - Real.log (z x)) /
            (Real.log (z x) * (Real.log D - Real.log (root x))))) := hS
    _ ≤ (1 + η) * ((1 / Real.log D) *
          Real.log (Real.log (root x) * (Real.log D - Real.log (z x)) /
            (Real.log (z x) * (Real.log D - Real.log (root x))))) :=
        mul_le_mul_of_nonneg_right (by linarith : 1 + η' ≤ 1 + η) hMnn
    _ = (1 + η) * (1 / Real.log D) *
          Real.log (Real.log (root x) * (Real.log D - Real.log (z x)) /
            (Real.log (z x) * (Real.log D - Real.log (root x)))) := by ring

/-- Positivity of the logarithm of the level, for the consumer. -/
theorem log_D_pos : ∀ᶠ x : ℕ in atTop, ∀ D : ℝ,
    (x : ℝ) ^ (9 / 20 : ℝ) ≤ D → D ≤ (x : ℝ) ^ (1 / 2 : ℝ) → 0 < Real.log D := by
  filter_upwards [ev_log_ge 1, eventually_ge_atTop (1 : ℕ)] with x ht x1 D hDlo _
  have hxpos : (0 : ℝ) < (x : ℝ) := by exact_mod_cast (by omega : 0 < x)
  have hDpos : 0 < D := lt_of_lt_of_le (Real.rpow_pos_of_pos hxpos (9 / 20 : ℝ)) hDlo
  have h := Real.log_le_log (Real.rpow_pos_of_pos hxpos (9 / 20 : ℝ)) hDlo
  rw [Real.log_rpow hxpos] at h
  linarith

/-- Positivity of `log D - log (root x)`, for the consumer. -/
theorem log_D_sub_root_pos : ∀ᶠ x : ℕ in atTop, ∀ D : ℝ,
    (x : ℝ) ^ (9 / 20 : ℝ) ≤ D → D ≤ (x : ℝ) ^ (1 / 2 : ℝ) →
      0 < Real.log D - Real.log (root x) := by
  filter_upwards [ev_log_ge 4, ev_rpow_ge 2 (by norm_num : (0 : ℝ) < 1 / 3),
    eventually_ge_atTop (1 : ℕ)] with x ht hx13 x1 D hDlo _
  have hxpos : (0 : ℝ) < (x : ℝ) := by exact_mod_cast (by omega : 0 < x)
  have hDpos : 0 < D := lt_of_lt_of_le (Real.rpow_pos_of_pos hxpos (9 / 20 : ℝ)) hDlo
  have h1 : (9 / 20 : ℝ) * Real.log (x : ℝ) ≤ Real.log D := by
    have h := Real.log_le_log (Real.rpow_pos_of_pos hxpos (9 / 20 : ℝ)) hDlo
    rw [Real.log_rpow hxpos] at h
    linarith
  have hY : (root x : ℝ) ≤ (x : ℝ) ^ (1 / 3 : ℝ) := by
    rw [root]
    exact Nat.floor_le (Real.rpow_nonneg hxpos.le (1 / 3 : ℝ))
  have hrootpos : (0 : ℝ) < (root x : ℝ) := by
    have h : (x : ℝ) ^ (1 / 3 : ℝ) < (root x : ℝ) + 1 := by
      rw [root]
