      _ = ∑ y ∈ S.image f, G y := (Finset.sum_image hf_inj).symm
      _ ≤ ∑ y ∈ T, G y :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.image_subset_iff.mpr hf_mem)
            (fun y _ _ => mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _))
              (inv_nonneg.mpr (Nat.cast_nonneg _)))
      _ = ∑ d ∈ Finset.Icc 1 Q, ∑ m ∈ Finset.Icc 1 Q, ((d : ℝ))⁻¹ * ((m : ℝ))⁻¹ :=
          Finset.sum_sigma (Finset.Icc 1 Q) (fun _ => Finset.Icc 1 Q)
            (fun y => ((y.1 : ℝ))⁻¹ * ((y.2 : ℝ))⁻¹)
  have hH : (∑ d ∈ Finset.Icc 1 Q, ((d : ℝ))⁻¹) ≤ 1 + Real.log (Q : ℝ) := by
    have hq : (∑ d ∈ Finset.Icc 1 Q, ((d : ℝ))⁻¹) = ((harmonic Q : ℚ) : ℝ) := by
