  ∃ c : ℝ, 0 < c ∧ ∃ X₀ : ℕ, ∀ X : ℕ, X₀ ≤ X →
    c * (X : ℝ) ≤ ((Taske724d7d203de1af512de02c5_reverseRoughChenSet X).card : ℝ) *
      (Real.log (X : ℝ)) ^ 2

noncomputable def Taske724d7d203de1af512de02c5_selbergSecond (n : ℕ) : ℝ :=
  ArithmeticFunction.vonMangoldt n * Real.log (n : ℝ) +
    ∑ d ∈ n.divisors, ArithmeticFunction.vonMangoldt d *
      ArithmeticFunction.vonMangoldt (n / d)

