open MathlibNt.SieveTheory.SwitchingPrinciple

noncomputable section

/-! ### The odd primorial of a cutoff -/

noncomputable def a2OddPrimes (y : ℕ) : Finset ℕ := (Finset.Icc 3 (y - 1)).filter Nat.Prime

noncomputable def a2OddProd (y : ℕ) : ℕ := ∏ p ∈ a2OddPrimes y, p

theorem a2OddProd_squarefree (y : ℕ) : Squarefree (a2OddProd y) := by
  apply Finset.squarefree_prod_of_pairwise_isCoprime
  · intro p hp q hq hpq
    exact Nat.coprime_iff_isRelPrime.mp
      ((Nat.coprime_primes (mem_filter.mp hp).2 (mem_filter.mp hq).2).mpr hpq)
  · intro p hp
    exact (mem_filter.mp hp).2.squarefree

theorem a2OddProd_factors (y : ℕ) : (a2OddProd y).primeFactors = a2OddPrimes y := by
  ext q
  rw [Nat.mem_primeFactors]
  constructor
  · rintro ⟨hp, hd, _⟩
    obtain ⟨p, hmem, hdiv⟩ := (hp.prime.dvd_finsetProd_iff id).mp hd
    have heq := (Nat.prime_dvd_prime_iff_eq hp (mem_filter.mp hmem).2).mp hdiv
    simpa [heq] using hmem
  · intro hq
    exact ⟨(mem_filter.mp hq).2, Finset.dvd_prod_of_mem _ hq,
      (a2OddProd_squarefree y).ne_zero⟩


theorem a2OddProd_pos (y : ℕ) : 0 < a2OddProd y := by
  unfold a2OddProd
  exact Finset.prod_pos (fun p hp => (mem_filter.mp hp).2.pos)

theorem a2_mem_oddPrimes {y q : ℕ} (hq : q ∈ a2OddPrimes y) : q.Prime ∧ 3 ≤ q ∧ q < y := by
  have h := mem_filter.mp hq
  have hI := mem_Icc.mp h.1
  exact ⟨h.2, hI.1, by omega⟩

theorem a2OddProd_coprime_two (y : ℕ) : Nat.Coprime 2 (a2OddProd y) := by
  unfold a2OddProd
  rw [Nat.coprime_prod_right_iff]
  intro q hq
  have h := a2_mem_oddPrimes hq
  rw [Nat.coprime_comm, Nat.Prime.coprime_iff_not_dvd h.1]
  intro hd
  have := Nat.le_of_dvd (by norm_num) hd
  omega

noncomputable def a2l (x : ℕ) : ℕ := x / 2 + 2
noncomputable def a2u (x : ℕ) : ℕ := x + 2

noncomputable def perPSieve (x p y : ℕ) : BoundingSieve where
  support := (Finset.Ioc (x / (2 * p)) (x / p)).filter (fun m => (p * m + 2).Prime)
  prodPrimes := a2OddProd y
  prodPrimes_squarefree := a2OddProd_squarefree y
  weights := fun m => Real.log ((p * m + 2 : ℕ) : ℝ)
  weights_nonneg := fun m => Real.log_natCast_nonneg _
  totalMass := (((a2u x : ℕ) : ℝ) - ((a2l x : ℕ) : ℝ)) / ((p : ℝ) - 1)
  nu := progressionDensity
  nu_mult := progressionDensity_mult
  nu_pos_of_prime := by
    intro q hq _
    rw [progressionDensity_prime hq]
    have hq1 : (1 : ℝ) < (q : ℝ) := by exact_mod_cast hq.one_lt
    exact div_pos one_pos (by linarith)
  nu_lt_one_of_prime := by
    intro q hq hdiv
    have hmem : q ∈ a2OddPrimes y := by
      rw [← a2OddProd_factors]
      exact Nat.mem_primeFactors.mpr ⟨hq, hdiv, (a2OddProd_squarefree y).ne_zero⟩
    have h3 : 3 ≤ q := (a2_mem_oddPrimes hmem).2.1
    rw [progressionDensity_prime hq]
    have h2 : (3 : ℝ) ≤ (q : ℝ) := by exact_mod_cast h3
    exact (div_lt_one (by linarith)).mpr (by linarith)

theorem mem_Ioc_div_iff {A B d k : ℕ} (hd : 0 < d) :
    (A / d < k ∧ k ≤ B / d) ↔ (A < d * k ∧ d * k ≤ B) := by
  rw [Nat.div_lt_iff_lt_mul hd, Nat.le_div_iff_mul_le hd, Nat.mul_comm d k]

theorem mem_Ioc_mul_iff {x p m : ℕ} (hp : 0 < p) :
    (x / (2 * p) < m ∧ m ≤ x / p) ↔ (x / 2 < p * m ∧ p * m ≤ x) := by
  have h2p : 0 < 2 * p := by omega
  rw [Nat.div_lt_iff_lt_mul h2p, Nat.le_div_iff_mul_le hp,
    Nat.div_lt_iff_lt_mul (by omega : (0 : ℕ) < 2)]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨?_, ?_⟩
    · have : m * (2 * p) = (p * m) * 2 := by ring
      omega
    · have : m * p = p * m := by ring
      omega
  · rintro ⟨h1, h2⟩
    refine ⟨?_, ?_⟩
    · have : m * (2 * p) = (p * m) * 2 := by ring
      omega
    · have : m * p = p * m := by ring
      omega

theorem perP_multSum_le {x p y d : ℕ} (hp : 2 ≤ p) (hd : d ∣ a2OddProd y) :
    (perPSieve x p y).multSum d ≤
      bvAPMass ArithmeticFunction.vonMangoldt (a2l x) (a2u x) (p * d) 2 := by
  have hd0 : 0 < d := Nat.pos_of_dvd_of_pos hd (a2OddProd_pos y)
  have hpd : 0 < p * d := Nat.mul_pos (by omega) hd0
  -- the support sum
  have hsupp : (perPSieve x p y).multSum d =
      ∑ m ∈ ((Finset.Ioc (x / (2 * p)) (x / p)).filter (fun m => (p * m + 2).Prime)).filter
        (fun m => d ∣ m), Real.log ((p * m + 2 : ℕ) : ℝ) := by
    change (∑ m ∈ (Finset.Ioc (x / (2 * p)) (x / p)).filter (fun m => (p * m + 2).Prime),
      if d ∣ m then Real.log ((p * m + 2 : ℕ) : ℝ) else 0) = _
    rw [Finset.sum_filter, Finset.filter_filter, Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro m _
    by_cases h1 : (p * m + 2).Prime <;> by_cases h2 : d ∣ m <;> simp [h1, h2]
  -- reindex m = d * k
  have himg : ((Finset.Ioc (x / (2 * p)) (x / p)).filter (fun m => (p * m + 2).Prime)).filter
        (fun m => d ∣ m) =
      ((Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d)).filter
        (fun k => (p * (d * k) + 2).Prime)).image (fun k => d * k) := by
    ext m
    constructor
    · intro hm
      obtain ⟨hm1, hdiv⟩ := Finset.mem_filter.mp hm
      obtain ⟨hm2, hpr⟩ := Finset.mem_filter.mp hm1
      obtain ⟨h1, h2⟩ := Finset.mem_Ioc.mp hm2
      have hk : (x / (2 * p)) / d < m / d ∧ m / d ≤ (x / p) / d :=
        (mem_Ioc_div_iff hd0 (A := x / (2 * p)) (B := x / p) (k := m / d)).mpr
          ⟨by rw [Nat.mul_div_cancel' hdiv]; exact h1,
          by rw [Nat.mul_div_cancel' hdiv]; exact h2⟩
      refine Finset.mem_image.mpr ⟨m / d, Finset.mem_filter.mpr ⟨Finset.mem_Ioc.mpr hk, ?_⟩,
        Nat.mul_div_cancel' hdiv⟩
      rw [Nat.mul_div_cancel' hdiv]
      exact hpr
    · intro hm
      obtain ⟨k, hk, rfl⟩ := Finset.mem_image.mp hm
      obtain ⟨hk1, hpr⟩ := Finset.mem_filter.mp hk
      obtain ⟨h1, h2⟩ := Finset.mem_Ioc.mp hk1
      have hkk := (mem_Ioc_div_iff hd0 (A := x / (2 * p)) (B := x / p) (k := k)).mp ⟨h1, h2⟩
      exact Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨Finset.mem_Ioc.mpr ⟨hkk.1, hkk.2⟩, hpr⟩,
        dvd_mul_right d k⟩
  rw [hsupp, himg, Finset.sum_image]
  · -- pointwise comparison with the von Mangoldt weight
    have hpt : (∑ k ∈ (Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d)).filter
        (fun k => (p * (d * k) + 2).Prime), Real.log ((p * (d * k) + 2 : ℕ) : ℝ)) ≤
        ∑ k ∈ Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d),
          ArithmeticFunction.vonMangoldt (p * (d * k) + 2) := by
      calc
        _ ≤ ∑ k ∈ Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d),
              (if (p * (d * k) + 2).Prime then Real.log ((p * (d * k) + 2 : ℕ) : ℝ) else 0) := by
            rw [Finset.sum_filter]
        _ ≤ _ := by
            apply Finset.sum_le_sum
            intro k _
            by_cases hpr : (p * (d * k) + 2).Prime
            · rw [if_pos hpr]
              exact (ArithmeticFunction.vonMangoldt_apply_prime hpr).symm.le
            · rw [if_neg hpr]
              exact ArithmeticFunction.vonMangoldt_nonneg
    refine hpt.trans ?_
    -- reindex n = p * d * k + 2
    have himg2 : (Finset.Ioc (a2l x) (a2u x)).filter (fun n => n % (p * d) = 2 % (p * d)) =
        (Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d)).image (fun k => p * d * k + 2) := by
      ext n
      constructor
      · intro hn
        obtain ⟨hn1, hmod⟩ := Finset.mem_filter.mp hn
        obtain ⟨h1, h2⟩ := Finset.mem_Ioc.mp hn1
        have hn2 : 2 ≤ n := by
          unfold a2l at h1
          omega
        have hdvd : p * d ∣ n - 2 := (Nat.modEq_iff_dvd' hn2).mp hmod.symm
        have hpd2 : p * d * ((n - 2) / (p * d)) = n - 2 := Nat.mul_div_cancel' hdvd
        have hk1 : x / (2 * p) < d * ((n - 2) / (p * d)) ∧
            d * ((n - 2) / (p * d)) ≤ x / p := by
          refine (mem_Ioc_mul_iff (by omega) (x := x) (p := p)
            (m := d * ((n - 2) / (p * d)))).mpr ⟨?_, ?_⟩
          · rw [← Nat.mul_assoc, hpd2]
            unfold a2l at h1
            omega
          · rw [← Nat.mul_assoc, hpd2]
            unfold a2u at h2
            omega
        have hk2 := (mem_Ioc_div_iff hd0 (A := x / (2 * p)) (B := x / p)
          (k := (n - 2) / (p * d))).mpr hk1
        refine Finset.mem_image.mpr ⟨(n - 2) / (p * d), Finset.mem_Ioc.mpr hk2, ?_⟩
        rw [hpd2]
        omega
      · intro hn
        obtain ⟨k, hk, rfl⟩ := Finset.mem_image.mp hn
        obtain ⟨h1, h2⟩ := Finset.mem_Ioc.mp hk
        have hk1 := (mem_Ioc_div_iff hd0 (A := x / (2 * p)) (B := x / p) (k := k)).mp ⟨h1, h2⟩
        have hmul := (mem_Ioc_mul_iff (by omega) (x := x) (p := p) (m := d * k)).mp
          ⟨hk1.1, hk1.2⟩
        have hmul' : x / 2 < p * d * k ∧ p * d * k ≤ x := by
          rw [Nat.mul_assoc]
          exact hmul
        refine Finset.mem_filter.mpr ⟨Finset.mem_Ioc.mpr ⟨?_, ?_⟩, ?_⟩
        · unfold a2l
          omega
        · unfold a2u
          omega
        · rw [Nat.add_comm, Nat.add_mul_mod_self_left]
    have hconv : (∑ k ∈ Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d),
        ArithmeticFunction.vonMangoldt (p * (d * k) + 2)) =
        ∑ k ∈ Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d),
          ArithmeticFunction.vonMangoldt (p * d * k + 2) := by
      apply Finset.sum_congr rfl
      intro k _
      rw [Nat.mul_assoc]
    have hfinal : (∑ k ∈ Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d),
        ArithmeticFunction.vonMangoldt (p * d * k + 2)) =
        bvAPMass ArithmeticFunction.vonMangoldt (a2l x) (a2u x) (p * d) 2 := by
      unfold bvAPMass
      rw [himg2]
      symm
      apply Finset.sum_image
      intro a _ b _ h
      dsimp only at h
      have hab : p * d * a = p * d * b := by omega
      exact Nat.mul_left_cancel (Nat.mul_pos (by omega) hd0) hab
    rw [hconv]
    exact hfinal.le
  · intros a _ b _ h
    dsimp only at h
    exact Nat.mul_left_cancel hd0 h
theorem perP_multSum_eq {x p y d : ℕ} (hp : 2 ≤ p) (hd : d ∣ a2OddProd y) :
    (perPSieve x p y).multSum d =
      bvAPMass bvPrimeWeight (a2l x) (a2u x) (p * d) 2 := by
  have hd0 : 0 < d := Nat.pos_of_dvd_of_pos hd (a2OddProd_pos y)
  have hpd : 0 < p * d := Nat.mul_pos (by omega) hd0
  -- the support sum
  have hsupp : (perPSieve x p y).multSum d =
      ∑ m ∈ ((Finset.Ioc (x / (2 * p)) (x / p)).filter (fun m => (p * m + 2).Prime)).filter
        (fun m => d ∣ m), Real.log ((p * m + 2 : ℕ) : ℝ) := by
    change (∑ m ∈ (Finset.Ioc (x / (2 * p)) (x / p)).filter (fun m => (p * m + 2).Prime),
      if d ∣ m then Real.log ((p * m + 2 : ℕ) : ℝ) else 0) = _
    rw [Finset.sum_filter, Finset.filter_filter, Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro m _
    by_cases h1 : (p * m + 2).Prime <;> by_cases h2 : d ∣ m <;> simp [h1, h2]
  -- reindex m = d * k
  have himg : ((Finset.Ioc (x / (2 * p)) (x / p)).filter (fun m => (p * m + 2).Prime)).filter
        (fun m => d ∣ m) =
      ((Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d)).filter
        (fun k => (p * (d * k) + 2).Prime)).image (fun k => d * k) := by
    ext m
    constructor
    · intro hm
      obtain ⟨hm1, hdiv⟩ := Finset.mem_filter.mp hm
      obtain ⟨hm2, hpr⟩ := Finset.mem_filter.mp hm1
      obtain ⟨h1, h2⟩ := Finset.mem_Ioc.mp hm2
      have hk : (x / (2 * p)) / d < m / d ∧ m / d ≤ (x / p) / d :=
        (mem_Ioc_div_iff hd0 (A := x / (2 * p)) (B := x / p) (k := m / d)).mpr
          ⟨by rw [Nat.mul_div_cancel' hdiv]; exact h1,
          by rw [Nat.mul_div_cancel' hdiv]; exact h2⟩
      refine Finset.mem_image.mpr ⟨m / d, Finset.mem_filter.mpr ⟨Finset.mem_Ioc.mpr hk, ?_⟩,
        Nat.mul_div_cancel' hdiv⟩
      rw [Nat.mul_div_cancel' hdiv]
      exact hpr
    · intro hm
      obtain ⟨k, hk, rfl⟩ := Finset.mem_image.mp hm
      obtain ⟨hk1, hpr⟩ := Finset.mem_filter.mp hk
      obtain ⟨h1, h2⟩ := Finset.mem_Ioc.mp hk1
      have hkk := (mem_Ioc_div_iff hd0 (A := x / (2 * p)) (B := x / p) (k := k)).mp ⟨h1, h2⟩
      exact Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨Finset.mem_Ioc.mpr ⟨hkk.1, hkk.2⟩, hpr⟩,
        dvd_mul_right d k⟩
  rw [hsupp, himg, Finset.sum_image]
  · -- the prime weight
    have hpt : (∑ k ∈ (Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d)).filter
        (fun k => (p * (d * k) + 2).Prime), Real.log ((p * (d * k) + 2 : ℕ) : ℝ)) =
        ∑ k ∈ Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d),
          bvPrimeWeight (p * (d * k) + 2) := by
      rw [Finset.sum_filter]
      rfl
    refine hpt.trans ?_
    -- reindex n = p * d * k + 2
    have himg2 : (Finset.Ioc (a2l x) (a2u x)).filter (fun n => n % (p * d) = 2 % (p * d)) =
        (Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d)).image (fun k => p * d * k + 2) := by
      ext n
      constructor
      · intro hn
        obtain ⟨hn1, hmod⟩ := Finset.mem_filter.mp hn
        obtain ⟨h1, h2⟩ := Finset.mem_Ioc.mp hn1
        have hn2 : 2 ≤ n := by
          unfold a2l at h1
          omega
        have hdvd : p * d ∣ n - 2 := (Nat.modEq_iff_dvd' hn2).mp hmod.symm
        have hpd2 : p * d * ((n - 2) / (p * d)) = n - 2 := Nat.mul_div_cancel' hdvd
        have hk1 : x / (2 * p) < d * ((n - 2) / (p * d)) ∧
            d * ((n - 2) / (p * d)) ≤ x / p := by
          refine (mem_Ioc_mul_iff (by omega) (x := x) (p := p)
            (m := d * ((n - 2) / (p * d)))).mpr ⟨?_, ?_⟩
          · rw [← Nat.mul_assoc, hpd2]
            unfold a2l at h1
            omega
          · rw [← Nat.mul_assoc, hpd2]
            unfold a2u at h2
            omega
        have hk2 := (mem_Ioc_div_iff hd0 (A := x / (2 * p)) (B := x / p)
          (k := (n - 2) / (p * d))).mpr hk1
        refine Finset.mem_image.mpr ⟨(n - 2) / (p * d), Finset.mem_Ioc.mpr hk2, ?_⟩
        rw [hpd2]
        omega
      · intro hn
        obtain ⟨k, hk, rfl⟩ := Finset.mem_image.mp hn
        obtain ⟨h1, h2⟩ := Finset.mem_Ioc.mp hk
        have hk1 := (mem_Ioc_div_iff hd0 (A := x / (2 * p)) (B := x / p) (k := k)).mp ⟨h1, h2⟩
        have hmul := (mem_Ioc_mul_iff (by omega) (x := x) (p := p) (m := d * k)).mp
          ⟨hk1.1, hk1.2⟩
        have hmul' : x / 2 < p * d * k ∧ p * d * k ≤ x := by
          rw [Nat.mul_assoc]
          exact hmul
        refine Finset.mem_filter.mpr ⟨Finset.mem_Ioc.mpr ⟨?_, ?_⟩, ?_⟩
        · unfold a2l
          omega
        · unfold a2u
          omega
        · rw [Nat.add_comm, Nat.add_mul_mod_self_left]
    have hconv : (∑ k ∈ Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d),
        bvPrimeWeight (p * (d * k) + 2)) =
        ∑ k ∈ Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d),
          bvPrimeWeight (p * d * k + 2) := by
      apply Finset.sum_congr rfl
      intro k _
      rw [Nat.mul_assoc]
    have hfinal : (∑ k ∈ Finset.Ioc ((x / (2 * p)) / d) ((x / p) / d),
        bvPrimeWeight (p * d * k + 2)) =
        bvAPMass bvPrimeWeight (a2l x) (a2u x) (p * d) 2 := by
      unfold bvAPMass
      rw [himg2]
      symm
      apply Finset.sum_image
      intro a _ b _ h
      dsimp only at h
      have hab : p * d * a = p * d * b := by omega
      exact Nat.mul_left_cancel (Nat.mul_pos (by omega) hd0) hab
    rw [hconv]
    exact hfinal
  · intros a _ b _ h
    dsimp only at h
    exact Nat.mul_left_cancel hd0 h
theorem perP_rem_le {x p y d : ℕ} (hp : p.Prime) (hp2 : 2 < p) (hpy : y ≤ p) (hd : d ∣ a2OddProd y) :
    (perPSieve x p y).rem d ≤
      (endpointError (a2u x : ℝ) (p * d) : ℝ) + (endpointError (a2l x : ℝ) (p * d) : ℝ) := by
  have hd0 : 0 < d := Nat.pos_of_dvd_of_pos hd (a2OddProd_pos y)
  have hpd0 : 0 < p * d := Nat.mul_pos hp.pos hd0
  have hcop : Nat.Coprime p d := by
    rw [Nat.Prime.coprime_iff_not_dvd hp]
    intro hdiv
    have hmem : p ∈ a2OddPrimes y := by
      rw [← a2OddProd_factors]
      exact Nat.mem_primeFactors.mpr ⟨hp, dvd_trans hdiv hd, (a2OddProd_squarefree y).ne_zero⟩
    have := (a2_mem_oddPrimes hmem).2.2
    omega
  have hphi : ((p * d).totient : ℝ) = ((p : ℝ) - 1) * (d.totient : ℝ) := by
    rw [Nat.totient_mul hcop, Nat.totient_prime hp, Nat.cast_mul, Nat.cast_sub hp.one_le]
    push_cast
    ring
  have hphid : (0 : ℝ) < (d.totient : ℝ) := by
    exact_mod_cast Nat.totient_pos.mpr hd0
  have hpm1 : (0 : ℝ) < (p : ℝ) - 1 := by
    have : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp.two_le
    linarith
  have hnu : (perPSieve x p y).nu d * (perPSieve x p y).totalMass =
      (((a2u x : ℕ) : ℝ) - ((a2l x : ℕ) : ℝ)) / ((p * d).totient : ℝ) := by
    change ((d.totient : ℝ))⁻¹ * ((((a2u x : ℕ) : ℝ) - ((a2l x : ℕ) : ℝ)) / ((p : ℝ) - 1)) = _
    rw [hphi]
    field_simp
  have hrem : (perPSieve x p y).rem d ≤
      bvAPMass ArithmeticFunction.vonMangoldt (a2l x) (a2u x) (p * d) 2 -
        (((a2u x : ℕ) : ℝ) - ((a2l x : ℕ) : ℝ)) / ((p * d).totient : ℝ) := by
    rw [BoundingSieve.rem, hnu]
    exact sub_le_sub_right (perP_multSum_le hp.two_le hd) _
  have hdiff : bvAPMass ArithmeticFunction.vonMangoldt (a2l x) (a2u x) (p * d) 2 =
      bvAPMass ArithmeticFunction.vonMangoldt 0 (a2u x) (p * d) 2 -
        bvAPMass ArithmeticFunction.vonMangoldt 0 (a2l x) (p * d) 2 :=
    bvAPMass_prefix_difference ArithmeticFunction.vonMangoldt
      (by unfold a2l a2u; omega) (p * d) 2
  have h2p : Nat.Coprime 2 p := by
    rw [Nat.coprime_comm, Nat.Prime.coprime_iff_not_dvd hp]
    intro h
    have := Nat.le_of_dvd (by omega) h
    omega
  have h2d : Nat.Coprime 2 d := (a2OddProd_coprime_two y).coprime_dvd_right hd
  have h2cop : Nat.Coprime 2 (p * d) := h2p.mul_right h2d
