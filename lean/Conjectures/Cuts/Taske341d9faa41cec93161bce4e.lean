-- @helper Taske724d7d203de1af512de02c5_conv_bv
lemma Taske724d7d203de1af512de02c5_conv_bv_aux_logpow (c d : ℝ) (hc : 0 < c) :
    ∀ᶠ x : ℕ in atTop, (Real.log (x : ℝ)) ^ d ≤ (x : ℝ) ^ c := by
  have h := isLittleO_log_rpow_rpow_atTop d hc
