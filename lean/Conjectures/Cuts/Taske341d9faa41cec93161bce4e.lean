  unfold psi OAI.LargePrimeGaps.residuePrefix OAI.LargePrimeGaps.residueSlice
  rw [Finset.sum_filter]
  refine Finset.sum_congr rfl fun n _ => ?_
  simp [Nat.mod_one]

/-- The PNT with a logarithmic error, read off the corpus Bombieri-Vinogradov at the modulus one. -/
private lemma psi_error (A : ℝ) (hA : 0 < A) :
