          (Real.log D) ^ (-Δ) < ρ := by
  have hdecay : Tendsto (fun D : ℝ => (Real.log D) ^ (-Δ)) atTop (𝓝 0) :=
    (tendsto_rpow_neg_atTop hΔ).comp Real.tendsto_log_atTop
