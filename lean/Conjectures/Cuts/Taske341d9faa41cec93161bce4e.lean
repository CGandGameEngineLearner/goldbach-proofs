theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_recip (c B : ℝ) (hc : 0 ≤ c)
    (hM : ∀ n : ℕ, 2 ≤ n →
      |GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeReciprocalSum n - (Real.log (Real.log (n : ℝ)) + B)| ≤ c / Real.log (n : ℝ)) :
    ∀ a b : ℕ, 2 ≤ a → a ≤ b → Real.log (b : ℝ) ≤ 4 * Real.log (a : ℝ) →
      (∑ p ∈ (Finset.Ioc a b).filter Nat.Prime, (1 : ℝ) / (p : ℝ)) ≤
        Real.log 4 + 2 * c / Real.log 2 := by
  intro a b ha hab hlog
  have hsplit : GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primesUpTo b = GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primesUpTo a ∪ (Finset.Ioc a b).filter Nat.Prime := by
    ext p
    simp only [GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.mem_primesUpTo, Finset.mem_union, Finset.mem_filter, Finset.mem_Ioc]
    by_cases hp : p.Prime
    · simp only [hp, true_and, and_true, iff_true]
      omega
    · simp [hp]
  have hdisj : Disjoint (GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primesUpTo a) ((Finset.Ioc a b).filter Nat.Prime) := by
    rw [Finset.disjoint_left]
    intro p hp1 hp2
    simp only [GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.mem_primesUpTo, Finset.mem_filter, Finset.mem_Ioc] at hp1 hp2
    omega
  have hsum : GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeReciprocalSum b - GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeReciprocalSum a =
      ∑ p ∈ (Finset.Ioc a b).filter Nat.Prime, (1 : ℝ) / (p : ℝ) := by
    unfold GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeReciprocalSum
    rw [hsplit, Finset.sum_union hdisj]
    ring
  have ha2 : (2 : ℝ) ≤ (a : ℝ) := by exact_mod_cast ha
  have hb2 : (2 : ℝ) ≤ (b : ℝ) := by exact_mod_cast (le_trans ha hab)
  have hla : 0 < Real.log (a : ℝ) := Real.log_pos (by linarith)
  have hlb : 0 < Real.log (b : ℝ) := Real.log_pos (by linarith)
  have hMa := hM a ha
  have hMb := hM b (le_trans ha hab)
  have h1 : GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeReciprocalSum b ≤ Real.log (Real.log (b : ℝ)) + B + c / Real.log (b : ℝ) := by
    have := (abs_le.mp hMb).2
    linarith
  have h2 : Real.log (Real.log (a : ℝ)) + B - c / Real.log (a : ℝ) ≤ GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeReciprocalSum a := by
    have := (abs_le.mp hMa).1
    linarith
  have h3 : Real.log (Real.log (b : ℝ)) - Real.log (Real.log (a : ℝ)) ≤ Real.log 4 := by
    rw [← Real.log_div hlb.ne' hla.ne']
    refine Real.log_le_log (by positivity) ?_
    rw [div_le_iff₀ hla]
    linarith
  have h4 : c / Real.log (b : ℝ) ≤ c / Real.log 2 := by
    exact div_le_div_of_nonneg_left hc (Real.log_pos (by norm_num)) (Real.log_le_log (by norm_num) hb2)
  have h5 : c / Real.log (a : ℝ) ≤ c / Real.log 2 := by
    exact div_le_div_of_nonneg_left hc (Real.log_pos (by norm_num)) (Real.log_le_log (by norm_num) ha2)
  rw [← hsum]
  have h6 : 2 * c / Real.log 2 = c / Real.log 2 + c / Real.log 2 := by ring
  rw [h6]
  linarith

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_sum_Ioc_sub (f : ℕ → ℝ) {a b : ℕ} (h : a ≤ b) :
