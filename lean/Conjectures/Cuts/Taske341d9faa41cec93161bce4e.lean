theorem TSw_count (x : ℕ) (h1δ : 1 < 1 + TSw_delta x)
    (hzpos : 0 < (Taske724d7d203de1af512de02c5_z x : ℝ)) :
    ((Taske724d7d203de1af512de02c5_triple x).card : ℝ) ≤
      (∑ j ∈ Finset.range (TSw_J x),
        ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j),
          TSw_seq x j n * (if (n + 2).Prime then 1 else 0)) +
        2 * (x : ℝ) * TSw_delta x + 3 := by
  have hδ : 0 ≤ TSw_delta x := by unfold TSw_delta; positivity
  have htri : Taske724d7d203de1af512de02c5_triple x =
      ((TSw_Tri x).filter (fun t => (TSw_mult t + 2).Prime)).image TSw_mult := by
    rw [Taske724d7d203de1af512de02c5_triple, TSw_triRaw_eq_image, Finset.filter_image]
  have hinjT : Set.InjOn TSw_mult
      (↑((TSw_Tri x).filter (fun t => (TSw_mult t + 2).Prime))) :=
    (TSw_mult_injOn x).mono
      (Finset.coe_subset.mpr (Finset.filter_subset _ _))
  have hcardT : ((Taske724d7d203de1af512de02c5_triple x).card : ℝ) =
      (((TSw_Tri x).filter (fun t => (TSw_mult t + 2).Prime)).card : ℝ) := by
    rw [htri, Finset.card_image_of_injOn hinjT]
  set Cc := (TSw_Tri x).filter (fun t => TSw_core x (TSw_mult t) ∧ (TSw_mult t + 2).Prime)
  set Cs := (TSw_Tri x).filter (fun t => ¬ TSw_core x (TSw_mult t) ∧ (TSw_mult t + 2).Prime)
  have hsubCS : (TSw_Tri x).filter (fun t => (TSw_mult t + 2).Prime) ⊆ Cc ∪ Cs := by
    intro t ht
    have h := Finset.mem_filter.mp ht
    by_cases hc : TSw_core x (TSw_mult t)
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨h.1, hc, h.2⟩)
    · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨h.1, hc, h.2⟩)
  have hdisj' : (↑(Finset.range (TSw_J x)) : Set ℕ).PairwiseDisjoint
      (fun j => (TSw_pairs x j).filter (fun p => (p.1 * p.2 + 2).Prime)) := by
    intro j _ j' _ hne
    exact ((TSw_pairs_disjoint x h1δ hzpos hne).mono_left (Finset.filter_subset _ _)).mono_right
      (Finset.filter_subset _ _)
  have hG : ((Finset.range (TSw_J x)).biUnion
        (fun j => (TSw_pairs x j).filter (fun p => (p.1 * p.2 + 2).Prime))).card =
      ∑ j ∈ Finset.range (TSw_J x),
        ((TSw_pairs x j).filter (fun p => (p.1 * p.2 + 2).Prime)).card :=
    Finset.card_biUnion hdisj'
  have hinjC : Set.InjOn (fun t : ℕ × ℕ × ℕ => (t.2.1 * t.2.2, t.1)) (↑Cc) := by
    intro t ht s hs heq
    have ht' := Finset.mem_filter.mp ht
    have hs' := Finset.mem_filter.mp hs
    obtain ⟨ht1, ht2, ht3, htz, htr, htro, htle, hlo, hhi⟩ := TSw_mem_Tri ht'.1
    obtain ⟨hs1, hs2, hs3, hsz, hsr, hsro, hsle, hlo', hhi'⟩ := TSw_mem_Tri hs'.1
    have h1 : t.1 = s.1 := congrArg Prod.snd heq
    have h2 : t.2.1 * t.2.2 = s.2.1 * s.2.2 := congrArg Prod.fst heq
    obtain ⟨ha, hb⟩ := TSw_pair23_inj ht2 ht3 hs2 hs3 htle hsle h2
    exact Prod.ext h1 (Prod.ext ha hb)
  have hsubC : Set.MapsTo (fun t : ℕ × ℕ × ℕ => (t.2.1 * t.2.2, t.1)) (↑Cc)
      (↑((Finset.range (TSw_J x)).biUnion
        (fun j => (TSw_pairs x j).filter (fun p => (p.1 * p.2 + 2).Prime)))) := by
    intro t ht
    have ht' := Finset.mem_filter.mp ht
    obtain ⟨hjJ, hpairs, hmul⟩ := TSw_core_pair x h1δ hzpos ht'.1 ht'.2.1
    refine Finset.mem_biUnion.mpr ⟨TSw_idx x t.1, Finset.mem_range.mpr hjJ, ?_⟩
    exact Finset.mem_filter.mpr ⟨hpairs, by rw [hmul]; exact ht'.2.2⟩
  have hCc : Cc.card ≤ ((Finset.range (TSw_J x)).biUnion
      (fun j => (TSw_pairs x j).filter (fun p => (p.1 * p.2 + 2).Prime))).card :=
    Finset.card_le_card_of_injOn _ hsubC hinjC
  have hsubS : Set.MapsTo TSw_mult (↑Cs)
      (↑((Finset.Ioc (x / 2) x).filter (fun n => ¬ TSw_core x n))) := by
    intro t ht
    have ht' := Finset.mem_filter.mp ht
    obtain ⟨ht1, ht2, ht3, htz, htr, htro, htle, hlo, hhi⟩ := TSw_mem_Tri ht'.1
    exact Finset.mem_filter.mpr ⟨Finset.mem_Ioc.mpr ⟨hlo, hhi⟩, ht'.2.1⟩
  have hinjS : Set.InjOn TSw_mult (↑Cs) :=
    (TSw_mult_injOn x).mono (Finset.coe_subset.mpr (Finset.filter_subset _ _))
  have hCs : Cs.card ≤ ((Finset.Ioc (x / 2) x).filter (fun n => ¬ TSw_core x n)).card :=
    Finset.card_le_card_of_injOn _ hsubS hinjS
  have hshell := TSw_shell_card x hδ
  have hsum : (∑ j ∈ Finset.range (TSw_J x),
