/-- The dyadic decomposition of the interval Ioc 1 Q. -/
lemma Taske724d7d203de1af512de02c5_conv_bv_aux_dyadic_id (f : ℕ → ℝ) (K : ℕ) :
    (∑ r ∈ Finset.Ioc 1 (2 ^ K), f r) =
      ∑ j ∈ Finset.range K, ∑ r ∈ Finset.Ioc (2 ^ j) (2 ^ (j + 1)), f r := by
  induction K with
  | zero => simp
  | succ K ih =>
    rw [Finset.sum_range_succ, ← ih]
    rw [← Finset.sum_Ioc_consecutive f (m := 1) (n := 2 ^ K) (k := 2 ^ (K + 1))
      Nat.one_le_two_pow (Nat.pow_le_pow_right (by norm_num) (Nat.le_succ K))]

lemma Taske724d7d203de1af512de02c5_conv_bv_aux_dyadic (f : ℕ → ℝ) (hf : ∀ r, 0 ≤ f r) (Q : ℕ) :
    (∑ r ∈ Finset.Ioc 1 Q, f r) ≤
      ∑ j ∈ Finset.range (Nat.log 2 Q + 1), ∑ r ∈ Finset.Ioc (2 ^ j) (2 ^ (j + 1)), f r := by
  have hK : Q < 2 ^ (Nat.log 2 Q + 1) := Nat.lt_pow_succ_log_self (by norm_num) Q
  calc (∑ r ∈ Finset.Ioc 1 Q, f r)
      ≤ ∑ r ∈ Finset.Ioc 1 (2 ^ (Nat.log 2 Q + 1)), f r :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.Ioc_subset_Ioc_right (le_of_lt hK))
          (fun r _ _ => hf r)
    _ = ∑ j ∈ Finset.range (Nat.log 2 Q + 1),
          ∑ r ∈ Finset.Ioc (2 ^ j) (2 ^ (j + 1)), f r :=
        Taske724d7d203de1af512de02c5_conv_bv_aux_dyadic_id f (Nat.log 2 Q + 1)

/-- The small block: the two square roots of the block bound, evaluated. -/
lemma Taske724d7d203de1af512de02c5_conv_bv_aux_small_inner (ℓ M Rr H Sα E : ℝ) (hℓ : 2 ≤ ℓ)
    (hM1 : 1 ≤ M) (hRr1 : 1 ≤ Rr) (hH0 : 0 ≤ H) (hH : H ≤ 3 * ℓ) (hSα0 : 0 ≤ Sα)
    (hSα : Sα ≤ M) (hE0 : 0 ≤ E) :
    Real.sqrt ((M + 1 + (2 * Rr) ^ 2 * H) * Sα / Rr) * Real.sqrt (2 * Rr * E ^ 2) ≤
      (2 * M + 5 * Rr * Real.sqrt M * ℓ) * E := by
  have hM0 : 0 ≤ M := by linarith
  have hRr0 : 0 < Rr := by linarith
  have hinner : (M + 1 + (2 * Rr) ^ 2 * H) * Sα / Rr ≤ (2 * M + 12 * Rr ^ 2 * ℓ) * M / Rr := by
    refine div_le_div_of_nonneg_right ?_ hRr0.le
    have h1 : M + 1 ≤ 2 * M := by linarith
    have h2 : (2 * Rr) ^ 2 * H ≤ 12 * Rr ^ 2 * ℓ := by
      calc (2 * Rr) ^ 2 * H = 4 * Rr ^ 2 * H := by ring
        _ ≤ 4 * Rr ^ 2 * (3 * ℓ) := mul_le_mul_of_nonneg_left hH (by positivity)
        _ = 12 * Rr ^ 2 * ℓ := by ring
    exact mul_le_mul (by linarith) hSα hSα0 (by positivity)
  have hE2 : Real.sqrt (2 * Rr * E ^ 2) = Real.sqrt (2 * Rr) * E := by
