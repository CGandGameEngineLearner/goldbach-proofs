/-- The von Mangoldt summatory function. -/
private noncomputable def psi (N : ℕ) : ℝ :=
  ∑ n ∈ Finset.Ioc 0 N, ArithmeticFunction.vonMangoldt n

private lemma psi_eq_chebyshev (N : ℕ) : psi N = Chebyshev.psi (N : ℝ) := by
  unfold psi Chebyshev.psi
  rw [Nat.floor_natCast]

private lemma psi_eq_residuePrefix (N : ℕ) :
