      _ = X2 * (8 * (1 - s) * κ) / L ^ 2 := by ring
  have hC2 : Br * M ≥ κ * (2 * X2) / (200 * L ^ 2) := by
    calc Br * M ≥ M / (800 * (1 - s) ^ 2) := hBrM
      _ ≥ X2 * (8 * (1 - s) * κ) / L ^ 2 / (800 * (1 - s) ^ 2) :=
        div_le_div_of_nonneg_right hMlow (by positivity)
      _ = κ * (2 * X2) / (200 * (1 - s) * L ^ 2) := by field_simp <;> ring
