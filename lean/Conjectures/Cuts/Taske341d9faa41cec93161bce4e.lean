theorem eventually_all_odd_depth_suzuki_error_upper_window
    (H : Section13HatLayers) (hH : Section13HatContract H 2)
    {C K d Δ ρ : ℝ} (hC : 0 ≤ C) (hd : 0 ≤ d) (hΔ : 0 < Δ)
    (hρ : 0 < ρ) :
