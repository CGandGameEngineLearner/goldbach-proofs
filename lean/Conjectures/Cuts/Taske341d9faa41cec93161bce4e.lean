  have hcard2 : (Cc.card : ℝ) ≤ ∑ j ∈ Finset.range (TSw_J x),
        ∑ n ∈ Finset.Icc 1 (TSw_M x j * TSw_U x j),
          TSw_seq x j n * (if (n + 2).Prime then 1 else 0) := by
    rw [← hsum]
    have h1 : (Cc.card : ℝ) ≤ (((Finset.range (TSw_J x)).biUnion
