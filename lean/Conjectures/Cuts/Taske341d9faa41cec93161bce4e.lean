      have hB := (hr Z (by rw [Finset.mem_Icc]; omega)).1
      linarith [hlog2', hηt]
    have h6 : (20000 / t ^ 3) * (∑ n ∈ Finset.Icc Z Y,
        (Real.log ((n + 1 : ℕ) : ℝ) - Real.log (n : ℝ))) ≤ 20000 / t ^ 2 := by
      have h := mul_le_mul_of_nonneg_left h5 (by positivity : (0 : ℝ) ≤ 20000 / t ^ 3)
      have hring : (20000 : ℝ) / t ^ 3 * t = 20000 / t ^ 2 := by field_simp
      linarith
    have h7 : CM * ((20000 / t ^ 3) * ∑ n ∈ Finset.Icc Z Y,
        (Real.log ((n + 1 : ℕ) : ℝ) - Real.log (n : ℝ))) ≤ CM * (20000 / t ^ 2) :=
      mul_le_mul_of_nonneg_left h6 hCM
    have h1 : |∑ n ∈ Finset.Icc Z Y, E n * (f (n + 1) - f n)| ≤
        ∑ n ∈ Finset.Icc Z Y, |E n * (f (n + 1) - f n)| := Finset.abs_sum_le_sum_abs _ _
    linarith
  -- final assembly
  have hmain2 : (∑ p ∈ (Finset.Icc Z Y).filter Nat.Prime,
      1 / ((p : ℝ) * Real.log (D / (p : ℝ)))) ≤
      (1 / b) * Real.log (Real.log (Y : ℝ) * (b - Real.log (Z : ℝ)) /
        (Real.log (Z : ℝ) * (b - Real.log (Y : ℝ)))) + 20200 * (CM + 1) / t ^ 2 := by
    rw [hmain, hT']
    have hA1 : E Y * f (Y + 1) ≤ CM * (100 / t ^ 2) := le_trans (le_abs_self _) hEY
    have hA2 : -(E (Z - 1) * f Z) ≤ CM * (100 / t ^ 2) := by
      linarith [neg_abs_le (E (Z - 1) * f Z), hEZ]
    have hA3 : -(∑ n ∈ Finset.Icc Z Y, E n * (f (n + 1) - f n)) ≤ CM * (20000 / t ^ 2) := by
