    have hM2 : (1 + s) * cA2 * X2 * Vz / L = (1 + s) * cA2 * M := by dsimp [M]; ring
    have h1 : P ≥ (1 - s) * cA1 * M := by linarith [hA1, hM1]
    have h2 : S ≤ (1 + s) * cA2 * M := by linarith [hA2, hM2]
    have h3 : T3 ≤ K3 * M := hT3
    have h4 : Br * M = (1 - s) * cA1 * M - (1 + s) * cA2 * M / 2 - K3 * M / 2 := by
      dsimp [Br]; ring
    linarith [hW, h1, h2, h3, h4]
