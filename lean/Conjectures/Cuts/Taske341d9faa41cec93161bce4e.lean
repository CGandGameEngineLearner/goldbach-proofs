private def P1 (z : ℕ) : Finset ℕ := (Finset.Ioc z (2 * z)).filter Nat.Prime

private def P2 (rt : ℕ) : Finset ℕ := (Finset.Ioc rt (2 * rt)).filter Nat.Prime

private def P3 (x p1 p2 : ℕ) : Finset ℕ :=
  (Finset.Ioc (x / (2 * p1 * p2)) (x / (p1 * p2))).filter Nat.Prime

private def T (x z rt : ℕ) : Finset (Σ _ : ℕ × ℕ, ℕ) :=
  (P1 z ×ˢ P2 rt).sigma (fun q => P3 x q.1 q.2)

private theorem mem_T {x z rt p1 p2 p3 : ℕ}
    (h : (⟨(p1, p2), p3⟩ : Σ _ : ℕ × ℕ, ℕ) ∈ T x z rt) :
    p1.Prime ∧ p2.Prime ∧ p3.Prime ∧ z < p1 ∧ p1 ≤ 2 * z ∧ rt < p2 ∧ p2 ≤ 2 * rt ∧
      x / (2 * p1 * p2) < p3 ∧ p3 ≤ x / (p1 * p2) := by
  unfold T at h
  obtain ⟨hq, hp3⟩ := Finset.mem_sigma.mp h
  obtain ⟨h1, h2⟩ := Finset.mem_product.mp hq
  obtain ⟨h1', hp1⟩ := Finset.mem_filter.mp h1
  obtain ⟨h2', hp2⟩ := Finset.mem_filter.mp h2
  obtain ⟨hp3', hp3p⟩ := Finset.mem_filter.mp hp3
  exact ⟨hp1, hp2, hp3p, (Finset.mem_Ioc.mp h1').1, (Finset.mem_Ioc.mp h1').2,
    (Finset.mem_Ioc.mp h2').1, (Finset.mem_Ioc.mp h2').2,
    (Finset.mem_Ioc.mp hp3').1, (Finset.mem_Ioc.mp hp3').2⟩



