      have h3 : (0 : ℝ) ≤ 100 / t ^ 2 := by positivity
      linarith
    linarith [hR, hA1, hA2, hA3, hcomb, hA4]
  have herr1 : 20200 * (CM + 1) / t ^ 2 ≤ (η / 2) * (1 / t) := by
    have hηK : 50000 * (CM + 1) ≤ η * t := by
