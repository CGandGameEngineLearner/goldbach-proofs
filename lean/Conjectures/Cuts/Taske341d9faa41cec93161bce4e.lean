/-- A small constant is absorbed by a power of the logarithm. -/
lemma Taske724d7d203de1af512de02c5_conv_bv_aux_smallfac (ℓ c t : ℝ) (hℓ : 2 ≤ ℓ) (hc : 0 ≤ c)
    (hc64 : c ≤ 64) (ht : 6 ≤ t) : c * ℓ ^ (-t) ≤ 1 := by
  have h1 : c ≤ ℓ ^ t := by
    calc c ≤ 64 := hc64
      _ = (2 : ℝ) ^ (6 : ℝ) := by norm_num
      _ ≤ ℓ ^ (6 : ℝ) := Real.rpow_le_rpow (by norm_num) hℓ (by norm_num)
      _ ≤ ℓ ^ t := Real.rpow_le_rpow_of_exponent_le (by linarith) ht
  have h2 : 0 < ℓ ^ t := Real.rpow_pos_of_pos (by linarith) t
  rw [Real.rpow_neg (by linarith : (0 : ℝ) ≤ ℓ), ← div_eq_mul_inv, div_le_one h2]
  exact h1

/-- A bounded multiple of a small power of the logarithm times a large power of x is at most x. -/
lemma Taske724d7d203de1af512de02c5_conv_bv_aux_absorb (ℓ x c t : ℝ) (hx : 0 < x) (hy1 : 1 ≤ x)
    (hℓ : 1 ≤ ℓ) (hc : 0 ≤ c) (hc100 : c ≤ 100)
    (hkey : 100 * ℓ ^ t ≤ x ^ (1 / 16 : ℝ)) :
    c * x ^ (15 / 16 : ℝ) * ℓ ^ t ≤ x ∧ c * x ^ (2 / 3 : ℝ) * ℓ ^ t ≤ x := by
  have h1 : c * ℓ ^ t ≤ x ^ (1 / 16 : ℝ) :=
    le_trans (mul_le_mul_of_nonneg_right hc100 (Real.rpow_nonneg (by linarith) t)) hkey
  have hx116 : x ^ (1 / 16 : ℝ) ≤ x ^ (1 / 3 : ℝ) :=
    Real.rpow_le_rpow_of_exponent_le hy1 (by norm_num)
  constructor
  · calc c * x ^ (15 / 16 : ℝ) * ℓ ^ t = (c * ℓ ^ t) * x ^ (15 / 16 : ℝ) := by ring
      _ ≤ x ^ (1 / 16 : ℝ) * x ^ (15 / 16 : ℝ) :=
          mul_le_mul_of_nonneg_right h1 (by positivity)
      _ = x := by rw [← Real.rpow_add hx]; norm_num
  · calc c * x ^ (2 / 3 : ℝ) * ℓ ^ t = (c * ℓ ^ t) * x ^ (2 / 3 : ℝ) := by ring
      _ ≤ x ^ (1 / 16 : ℝ) * x ^ (2 / 3 : ℝ) :=
          mul_le_mul_of_nonneg_right h1 (by positivity)
      _ ≤ x ^ (1 / 3 : ℝ) * x ^ (2 / 3 : ℝ) :=
          mul_le_mul_of_nonneg_right hx116 (by positivity)
      _ = x := by rw [← Real.rpow_add hx]; norm_num

/-- The size of the alpha factor times the size of the beta factor. -/
lemma Taske724d7d203de1af512de02c5_conv_bv_aux_alpha_beta (ℓ M U Sα Sβ : ℝ) (hℓ : 1 ≤ ℓ)
    (hM0 : 0 ≤ M) (hU0 : 0 ≤ U) (hSα : Sα ≤ M) (hSβ : Sβ ≤ 2 * U * ℓ ^ (-(20 : ℝ))) :
    Real.sqrt Sα * Real.sqrt Sβ ≤ Real.sqrt 2 * ℓ ^ (-(10 : ℝ)) * Real.sqrt (M * U) := by
  have h1 : Real.sqrt Sα ≤ Real.sqrt M := Real.sqrt_le_sqrt hSα
  have h2 : Real.sqrt Sβ ≤ Real.sqrt (2 * U * ℓ ^ (-(20 : ℝ))) := Real.sqrt_le_sqrt hSβ
  have h3 : Real.sqrt (2 * U * ℓ ^ (-(20 : ℝ))) =
      Real.sqrt 2 * Real.sqrt U * ℓ ^ (-(10 : ℝ)) := by
    have h3a : Real.sqrt (2 * U * ℓ ^ (-(20 : ℝ))) =
        Real.sqrt (2 * U) * Real.sqrt (ℓ ^ (-(20 : ℝ))) := Real.sqrt_mul (by positivity) _
    have h3b : Real.sqrt (2 * U) = Real.sqrt 2 * Real.sqrt U := Real.sqrt_mul (by norm_num) _
    have h3c : Real.sqrt (ℓ ^ (-(20 : ℝ))) = ℓ ^ (-(10 : ℝ)) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul (by linarith)]
      norm_num
    rw [h3a, h3b, h3c]
  have h4 : Real.sqrt M * Real.sqrt U = Real.sqrt (M * U) := (Real.sqrt_mul hM0 U).symm
  calc Real.sqrt Sα * Real.sqrt Sβ
      ≤ Real.sqrt M * (Real.sqrt 2 * Real.sqrt U * ℓ ^ (-(10 : ℝ))) :=
        mul_le_mul h1 (h2.trans (le_of_eq h3)) (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
    _ = Real.sqrt 2 * ℓ ^ (-(10 : ℝ)) * (Real.sqrt M * Real.sqrt U) := by ring
    _ = Real.sqrt 2 * ℓ ^ (-(10 : ℝ)) * Real.sqrt (M * U) := by rw [h4]

/-- The bilinear block bound, in the split form. -/
lemma Taske724d7d203de1af512de02c5_conv_bv_aux_block (M U R H : ℝ) (hM : 1 ≤ M) (hU : 1 ≤ U)
    (hR : 1 ≤ R) (hH : 0 ≤ H) :
    (1 / R) * ((Real.sqrt (M + 1 + (2 * R) ^ 2 * H) *
        Real.sqrt (U + 1 + (2 * R) ^ 2 * H)) * Real.sqrt (M * U)) ≤
      (2 + H) * (M * U / R + 2 * M * Real.sqrt U + 2 * U * Real.sqrt M +
        4 * R * Real.sqrt (M * U)) := by
  have hR0 : 0 < R := by linarith
  have hM0 : 0 ≤ M := by linarith
  have hU0 : 0 ≤ U := by linarith
  have hT : 0 ≤ 2 + H := by linarith
  have hsplit : (Real.sqrt (M + 1 + (2 * R) ^ 2 * H) * Real.sqrt (U + 1 + (2 * R) ^ 2 * H)) *
      Real.sqrt (M * U) =
