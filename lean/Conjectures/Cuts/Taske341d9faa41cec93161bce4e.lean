    linarith [Nat.le_ceil x₀]
  have hcutN : 1 ≤ ⌊(N : ℝ) ^ (1 / 2 : ℝ) * (Real.log (N : ℝ)) ^ (-b)⌋₊ := hN₁ N hN1
  have hsingle : (OAI.LargePrimeGaps.endpointError (N : ℝ) 1 : ℝ) ≤
      ∑ q ∈ Finset.Icc 1 ⌊(N : ℝ) ^ (1 / 2 : ℝ) * (Real.log (N : ℝ)) ^ (-b)⌋₊,
