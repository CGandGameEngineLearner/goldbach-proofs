/-- Auxiliary: the reciprocal totient of `n` is at most the number of divisors of `n` divided by `n`,
from the divisor sum of the totient and the divisibility of the totient under divisibility. -/
lemma Taske724d7d203de1af512de02c5_conv_char_reduce_aux_inv_totient (n : ℕ) (hn : 1 ≤ n) :
    (1 / (n.totient : ℝ)) ≤ (n.divisors.card : ℝ) / (n : ℝ) := by
  have hphi : 0 < n.totient := Nat.totient_pos.mpr (by omega)
  have hnat : n ≤ n.divisors.card * n.totient := by
    calc n = ∑ d ∈ n.divisors, d.totient := (Nat.sum_totient n).symm
      _ ≤ ∑ _d ∈ n.divisors, n.totient := Finset.sum_le_sum fun d hd =>
          Nat.le_of_dvd hphi (Nat.totient_dvd_of_dvd (Nat.mem_divisors.mp hd).1)
      _ = n.divisors.card * n.totient := by simp [Finset.sum_const]
  have hphiR : (0 : ℝ) < n.totient := by exact_mod_cast hphi
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hR : (n : ℝ) ≤ (n.divisors.card : ℝ) * (n.totient : ℝ) := by exact_mod_cast hnat
  rw [div_le_div_iff₀ hphiR hnR]
  simpa using hR

/-- Auxiliary: the double sum over divisors reindexes into a sum over pairs. -/
lemma Taske724d7d203de1af512de02c5_conv_char_reduce_aux_reindex (Q : ℕ) (F : ℕ → ℕ → ℝ)
    (hF : ∀ s r, 0 ≤ F s r) :
    (∑ q ∈ Finset.Icc 1 Q, ∑ r ∈ (q.divisors).filter (fun r => 1 < r), F (q / r) r) ≤
      ∑ s ∈ Finset.Icc 1 Q, ∑ r ∈ Finset.Ioc 1 Q, F s r := by
  let S : Finset (Σ q : ℕ, ℕ) :=
    (Finset.Icc 1 Q).sigma (fun q => (q.divisors).filter (fun r => 1 < r))
  let T : Finset (Σ s : ℕ, ℕ) := (Finset.Icc 1 Q).sigma (fun _ => Finset.Ioc 1 Q)
  let f : (Σ q : ℕ, ℕ) → (Σ s : ℕ, ℕ) := fun p => ⟨p.1 / p.2, p.2⟩
  let G : (Σ s : ℕ, ℕ) → ℝ := fun y => F y.1 y.2
  have hf_mem : ∀ p ∈ S, f p ∈ T := by
    intro p hp
    have hq : p.1 ∈ Finset.Icc 1 Q := (Finset.mem_sigma.mp hp).1
    have hr : p.2 ∈ (p.1.divisors).filter (fun r => 1 < r) := (Finset.mem_sigma.mp hp).2
    have hq1 : 1 ≤ p.1 := (Finset.mem_Icc.mp hq).1
    have hqQ : p.1 ≤ Q := (Finset.mem_Icc.mp hq).2
    have hrdiv : p.2 ∣ p.1 := (Nat.mem_divisors.mp (Finset.mem_filter.mp hr).1).1
    have hr1 : 1 < p.2 := (Finset.mem_filter.mp hr).2
    have hrQ : p.2 ≤ Q := (Nat.le_of_dvd (by omega) hrdiv).trans hqQ
    have hd1 : 1 ≤ p.1 / p.2 := Nat.div_pos (Nat.le_of_dvd (by omega) hrdiv) (by omega)
    have hdQ : p.1 / p.2 ≤ Q := (Nat.div_le_self p.1 p.2).trans hqQ
    exact Finset.mem_sigma.mpr ⟨Finset.mem_Icc.mpr ⟨hd1, hdQ⟩, Finset.mem_Ioc.mpr ⟨hr1, hrQ⟩⟩
  have hf_inj : Set.InjOn f S := by
    intro p hp p' hp' hfeq
    have hd : p.1 / p.2 = p'.1 / p'.2 := (Sigma.mk.inj_iff.mp hfeq).1
    have hr : p.2 = p'.2 := eq_of_heq (Sigma.mk.inj_iff.mp hfeq).2
    have hrdiv : p.2 ∣ p.1 :=
      (Nat.mem_divisors.mp (Finset.mem_filter.mp (Finset.mem_sigma.mp hp).2).1).1
    have hrdiv' : p'.2 ∣ p'.1 :=
      (Nat.mem_divisors.mp (Finset.mem_filter.mp (Finset.mem_sigma.mp hp').2).1).1
    have e : p.1 = p'.1 :=
      calc p.1 = p.2 * (p.1 / p.2) := (Nat.mul_div_cancel' hrdiv).symm
        _ = p'.2 * (p'.1 / p'.2) := by rw [hd, hr]
        _ = p'.1 := Nat.mul_div_cancel' hrdiv'
    exact Sigma.ext e (heq_of_eq hr)
  calc (∑ q ∈ Finset.Icc 1 Q, ∑ r ∈ (q.divisors).filter (fun r => 1 < r), F (q / r) r)
      = ∑ p ∈ S, G (f p) :=
        Finset.sum_sigma' (Finset.Icc 1 Q) (fun q => (q.divisors).filter (fun r => 1 < r))
