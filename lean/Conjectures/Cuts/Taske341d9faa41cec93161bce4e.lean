      have h2 : η * (50000 * (CM + 1) / η) = 50000 * (CM + 1) := by field_simp [hη.ne']
      linarith
    have hkey : 20200 * (CM + 1) ≤ (η / 2) * t := by linarith
    rw [div_le_iff₀ (by positivity : (0 : ℝ) < t ^ 2)]
    have h2 : (η / 2) * (1 / t) * t ^ 2 = (η / 2) * t := by field_simp [ht0.ne']
    linarith
  have herr2 : 18 / (t * (x : ℝ) ^ (1 / 8 : ℝ)) ≤ (η / 2) * (1 / t) := by
    rw [div_le_iff₀ (mul_pos ht0 hx18pos)]
