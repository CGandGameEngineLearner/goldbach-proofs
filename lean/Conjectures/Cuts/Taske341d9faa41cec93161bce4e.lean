  ring

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_dyadic_core (M Y0 : ℝ) (hM : 0 < M) (hY0 : 4 ≤ Y0)
    (hP : ∀ y : ℝ, Y0 ≤ y →
      |(∑ n ∈ Finset.Ioc 0 ⌊y⌋₊, (ArithmeticFunction.vonMangoldt n : ℝ)) - y| ≤
        M * y * (Real.log y) ^ (-(2 : ℝ)))
    (A : ℝ) (hA : max (2 * Y0) 4 ≤ A) :
    (((Finset.Ioc ⌊A / 2⌋₊ ⌊A⌋₊).filter Nat.Prime).card : ℝ) * Real.log (A / 2) ≤
      A / 2 + 3 * (M * A / (Real.log A) ^ 2) := by
  have h2Y : 2 * Y0 ≤ max (2 * Y0) 4 := le_max_left _ _
  have hA4 : 4 ≤ A := le_trans (le_max_right _ _) hA
  have hAY : Y0 ≤ A := by linarith
  have hA2 : Y0 ≤ A / 2 := by linarith
  have hlog4 : Real.log 4 = 2 * Real.log 2 := by
    have h : (4 : ℝ) = (2 : ℝ) ^ (2 : ℕ) := by norm_num
    rw [h, Real.log_pow]
    push_cast
    ring
  have hlogA : 1 ≤ Real.log A := by
    have h1 : (1 : ℝ) ≤ Real.log 4 := by
      rw [← Real.log_exp 1]
      exact Real.log_le_log (Real.exp_pos 1) (by linarith [Real.exp_one_lt_d9])
    linarith [Real.log_le_log (by norm_num : (0 : ℝ) < 4) hA4]
  have hlogA0 : 0 < Real.log A := by linarith
  have hlogh : 0 < Real.log (A / 2) := Real.log_pos (by linarith)
  have hlogh2 : Real.log A / 2 ≤ Real.log (A / 2) := by
    have h1 : Real.log (A / 2) = Real.log A - Real.log 2 := by
      rw [Real.log_div (by linarith) (by norm_num)]
    have h2 : Real.log 4 ≤ Real.log A := Real.log_le_log (by norm_num) hA4
    linarith
  set n1 := ⌊A / 2⌋₊
  set n2 := ⌊A⌋₊
  have hn1 : (n1 : ℝ) ≤ A / 2 := Nat.floor_le (by linarith)
  have hn2 : (n2 : ℝ) ≤ A := Nat.floor_le (by linarith)
  have hcard : (((Finset.Ioc n1 n2).filter Nat.Prime).card : ℝ) * Real.log (A / 2) ≤
      ∑ p ∈ (Finset.Ioc n1 n2).filter Nat.Prime, Real.log (p : ℝ) := by
    have h1 : (((Finset.Ioc n1 n2).filter Nat.Prime).card : ℝ) * Real.log (A / 2) =
        ∑ p ∈ (Finset.Ioc n1 n2).filter Nat.Prime, Real.log (A / 2) := by
      simp [Finset.sum_const, nsmul_eq_mul]
    rw [h1]
    refine Finset.sum_le_sum fun p hp => ?_
    simp only [Finset.mem_filter, Finset.mem_Ioc] at hp
    have hp2 : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp.2.two_le
    refine Real.log_le_log (by linarith) ?_
    have h1 : (n1 : ℝ) + 1 ≤ (p : ℝ) := by exact_mod_cast hp.1.1
    have h2 : A / 2 < (n1 : ℝ) + 1 := by
      have := Nat.lt_floor_add_one (A / 2)
      simpa [n1] using this
    linarith
  have hpsi : (∑ p ∈ (Finset.Ioc n1 n2).filter Nat.Prime, Real.log (p : ℝ)) ≤
      ∑ n ∈ Finset.Ioc n1 n2, (ArithmeticFunction.vonMangoldt n : ℝ) := by
    rw [Finset.sum_filter]
    refine Finset.sum_le_sum fun n hn => ?_
    by_cases hpr : n.Prime
    · rw [if_pos hpr, ArithmeticFunction.vonMangoldt_apply_prime hpr]
    · rw [if_neg hpr]
      exact ArithmeticFunction.vonMangoldt_nonneg
  have hdiff : (∑ n ∈ Finset.Ioc n1 n2, (ArithmeticFunction.vonMangoldt n : ℝ)) =
      (∑ n ∈ Finset.Ioc 0 n2, (ArithmeticFunction.vonMangoldt n : ℝ)) -
        (∑ n ∈ Finset.Ioc 0 n1, (ArithmeticFunction.vonMangoldt n : ℝ)) :=
    Taske724d7d203de1af512de02c5_chen_triple_size_aux_sum_Ioc_sub _ (Nat.floor_mono (by linarith))
  have hP2 := hP A hAY
  have hP1 := hP (A / 2) hA2
  have hrw : (Real.log A) ^ (-(2 : ℝ)) = 1 / (Real.log A) ^ 2 := by
    rw [Real.rpow_neg (le_of_lt hlogA0), Real.rpow_two, one_div]
  have hrw2 : (Real.log (A / 2)) ^ (-(2 : ℝ)) = 1 / (Real.log (A / 2)) ^ 2 := by
    rw [Real.rpow_neg (le_of_lt hlogh), Real.rpow_two, one_div]
  have hup : (∑ n ∈ Finset.Ioc 0 n2, (ArithmeticFunction.vonMangoldt n : ℝ)) ≤
      A + M * A / (Real.log A) ^ 2 := by
    have h1 := (abs_le.mp hP2).2
    rw [hrw] at h1
    linarith [show M * A * (1 / (Real.log A) ^ 2) = M * A / (Real.log A) ^ 2 by ring]
  have hlo : A / 2 - M * (A / 2) / (Real.log (A / 2)) ^ 2 ≤
      ∑ n ∈ Finset.Ioc 0 n1, (ArithmeticFunction.vonMangoldt n : ℝ) := by
    have h1 := (abs_le.mp hP1).1
    rw [hrw2] at h1
    linarith [show M * (A / 2) * (1 / (Real.log (A / 2)) ^ 2) =
      M * (A / 2) / (Real.log (A / 2)) ^ 2 by ring]
  have hinv1 : 1 / (Real.log (A / 2)) ^ 2 ≤ 4 / (Real.log A) ^ 2 := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  have hstep : M * (A / 2) / (Real.log (A / 2)) ^ 2 ≤ 2 * (M * A / (Real.log A) ^ 2) := by
    have : M * (A / 2) * (1 / (Real.log (A / 2)) ^ 2) ≤ M * (A / 2) * (4 / (Real.log A) ^ 2) :=
      mul_le_mul_of_nonneg_left hinv1 (by positivity)
    linarith [show M * (A / 2) * (1 / (Real.log (A / 2)) ^ 2) =
        M * (A / 2) / (Real.log (A / 2)) ^ 2 by ring,
      show M * (A / 2) * (4 / (Real.log A) ^ 2) = 2 * (M * A / (Real.log A) ^ 2) by ring]
  linarith only [hcard, hpsi, hdiff, hup, hlo, hstep]

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_dyadic_calc (M A : ℝ) (hM : 0 ≤ M) (hA4 : 4 ≤ A)
    (hlogA : 1 ≤ Real.log A) (hlogh : 0 < Real.log (A / 2))
    (hlogh2 : Real.log A / 2 ≤ Real.log (A / 2)) :
    (A / 2 + 3 * M * A / (Real.log A) ^ 2) / Real.log (A / 2) ≤
      (A / 2) / Real.log A + (Real.log 2 + 3 * M + 6 * M * Real.log 2) * A / (Real.log A) ^ 2 := by
  have hlogA0 : 0 < Real.log A := by linarith
  have hL2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hA0 : 0 ≤ A := by linarith
  have hinv2 : 1 / Real.log (A / 2) ≤ 1 / Real.log A + 2 * Real.log 2 / (Real.log A) ^ 2 := by
    have key : 1 / Real.log (A / 2) = 1 / Real.log A + Real.log 2 / (Real.log (A / 2) * Real.log A) := by
      have h1 : Real.log (A / 2) = Real.log A - Real.log 2 := by
        rw [Real.log_div (by linarith) (by norm_num)]
      rw [h1]
      have hne1 : Real.log A - Real.log 2 ≠ 0 := by linarith
      have hne2 : Real.log A ≠ 0 := by linarith
      field_simp
      ring
    rw [key]
    have hkey : Real.log 2 * (Real.log A) ^ 2 ≤
        2 * Real.log 2 * (Real.log (A / 2) * Real.log A) := by
      have hpos : 0 ≤ 2 * Real.log 2 := by positivity
      have h1 : 2 * Real.log 2 * (Real.log A / 2 * Real.log A) ≤
          2 * Real.log 2 * (Real.log (A / 2) * Real.log A) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hlogh2 hlogA0.le) hpos
      linarith [show 2 * Real.log 2 * (Real.log A / 2 * Real.log A) =
        Real.log 2 * (Real.log A) ^ 2 by ring]
    have : Real.log 2 / (Real.log (A / 2) * Real.log A) ≤ 2 * Real.log 2 / (Real.log A) ^ 2 := by
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      exact hkey
    linarith
  have h1 : (A / 2) / Real.log (A / 2) ≤
      (A / 2) / Real.log A + (A / 2) * (2 * Real.log 2 / (Real.log A) ^ 2) := by
    have h1' : (A / 2) * (1 / Real.log (A / 2)) ≤
        (A / 2) * (1 / Real.log A + 2 * Real.log 2 / (Real.log A) ^ 2) :=
      mul_le_mul_of_nonneg_left hinv2 (by linarith)
    have e1 : (A / 2) / Real.log (A / 2) = (A / 2) * (1 / Real.log (A / 2)) := by ring
    have e2 : (A / 2) * (1 / Real.log A + 2 * Real.log 2 / (Real.log A) ^ 2) =
        (A / 2) / Real.log A + (A / 2) * (2 * Real.log 2 / (Real.log A) ^ 2) := by ring
    linarith
  have h2 : (A / 2) * (2 * Real.log 2 / (Real.log A) ^ 2) = Real.log 2 * A / (Real.log A) ^ 2 := by ring
  have hX : 0 ≤ 3 * M * A / (Real.log A) ^ 2 := by positivity
  have h3 : 3 * M * A / (Real.log A) ^ 2 / Real.log (A / 2) ≤
      3 * M * A / (Real.log A) ^ 2 * (1 / Real.log A + 2 * Real.log 2 / (Real.log A) ^ 2) := by
    rw [div_eq_mul_inv, ← one_div]
    exact mul_le_mul_of_nonneg_left hinv2 hX
  have hexp : 3 * M * A / (Real.log A) ^ 2 * (1 / Real.log A + 2 * Real.log 2 / (Real.log A) ^ 2) =
      3 * M * A / (Real.log A) ^ 3 + 6 * M * Real.log 2 * A / (Real.log A) ^ 4 := by ring
  have hp23 : (Real.log A) ^ 2 ≤ (Real.log A) ^ 3 := by
    have e : (Real.log A) ^ 3 = (Real.log A) ^ 2 * Real.log A := by ring
    rw [e]
    nlinarith
  have hp24 : (Real.log A) ^ 2 ≤ (Real.log A) ^ 4 := by
    have e : (Real.log A) ^ 4 = (Real.log A) ^ 2 * (Real.log A) ^ 2 := by ring
    rw [e]
    nlinarith
  have h4 : 3 * M * A / (Real.log A) ^ 3 ≤ 3 * M * A / (Real.log A) ^ 2 := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    exact mul_le_mul_of_nonneg_left hp23 (by positivity)
  have h5 : 6 * M * Real.log 2 * A / (Real.log A) ^ 4 ≤
      6 * M * Real.log 2 * A / (Real.log A) ^ 2 := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    exact mul_le_mul_of_nonneg_left hp24 (by positivity)
  have hsplit : (A / 2 + 3 * M * A / (Real.log A) ^ 2) / Real.log (A / 2) =
      (A / 2) / Real.log (A / 2) + 3 * M * A / (Real.log A) ^ 2 / Real.log (A / 2) := by ring
  have hexpand : (Real.log 2 + 3 * M + 6 * M * Real.log 2) * A / (Real.log A) ^ 2 =
      Real.log 2 * A / (Real.log A) ^ 2 + 3 * M * A / (Real.log A) ^ 2 +
        6 * M * Real.log 2 * A / (Real.log A) ^ 2 := by ring
  linarith only [h1, h2, h3, hexp, h4, h5, hsplit, hexpand]

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_dyadic :
    ∃ K A0 : ℝ, 0 < K ∧ 4 ≤ A0 ∧ ∀ A : ℝ, A0 ≤ A →
      (((Finset.Ioc ⌊A / 2⌋₊ ⌊A⌋₊).filter Nat.Prime).card : ℝ) ≤
        (A / 2) / Real.log A + K * A / (Real.log A) ^ 2 := by
  obtain ⟨M, Y0, hM, hY0, hP⟩ := Taske724d7d203de1af512de02c5_chen_triple_size_aux_pnt
  refine ⟨Real.log 2 + 3 * M + 6 * M * Real.log 2, max (2 * Y0) 4, by positivity, le_max_right _ _, ?_⟩
  intro A hA
  have hA4 : 4 ≤ A := le_trans (le_max_right _ _) hA
  have hlogA : 1 ≤ Real.log A := by
    have h1 : (1 : ℝ) ≤ Real.log 4 := by
      rw [← Real.log_exp 1]
      exact Real.log_le_log (Real.exp_pos 1) (by linarith [Real.exp_one_lt_d9])
    linarith [Real.log_le_log (by norm_num : (0 : ℝ) < 4) hA4]
  have hlogh : 0 < Real.log (A / 2) := Real.log_pos (by linarith)
  have hlogh2 : Real.log A / 2 ≤ Real.log (A / 2) := by
    have h1 : Real.log (A / 2) = Real.log A - Real.log 2 := by
      rw [Real.log_div (by linarith) (by norm_num)]
    have hlog4 : Real.log 4 = 2 * Real.log 2 := by
      have h : (4 : ℝ) = (2 : ℝ) ^ (2 : ℕ) := by norm_num
      rw [h, Real.log_pow]
      push_cast
      ring
    have h2 : Real.log 4 ≤ Real.log A := Real.log_le_log (by norm_num) hA4
    linarith
  have hcore := Taske724d7d203de1af512de02c5_chen_triple_size_aux_dyadic_core M Y0 hM hY0 hP A hA
  have hcalc := Taske724d7d203de1af512de02c5_chen_triple_size_aux_dyadic_calc M A (le_of_lt hM) hA4 hlogA hlogh hlogh2
  have hmain : (((Finset.Ioc ⌊A / 2⌋₊ ⌊A⌋₊).filter Nat.Prime).card : ℝ) ≤
      (A / 2 + 3 * M * A / (Real.log A) ^ 2) / Real.log (A / 2) := by
    refine (le_div_iff₀ hlogh).mpr ?_
    linarith [show A / 2 + 3 * (M * A / (Real.log A) ^ 2) =
      A / 2 + 3 * M * A / (Real.log A) ^ 2 by ring]
  linarith only [hmain, hcalc]
/-! ### Discrete Abel summation over primes -/

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_tel (F : ℕ → ℝ) : ∀ (A B : ℕ), A ≤ B →
    (∑ i ∈ Finset.Icc A B, (F (i + 1) - F i)) = F (B + 1) - F A
  | 0, 0, _ => by simp
  | A + 1, 0, h => by omega
  | A, B + 1, hAB => by
    rcases Nat.of_le_succ hAB with h' | rfl
    · rw [Finset.sum_Icc_succ_top (Nat.le_succ_of_le h'), Taske724d7d203de1af512de02c5_chen_triple_size_aux_tel F A B h']
      ring
    · rw [show Finset.Icc (B + 1) (B + 1) = {B + 1} by
        ext i; simp [Finset.mem_Icc]]
      simp

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_tel_int (F : ℝ → ℝ) (A : ℕ) : ∀ (B : ℕ), A ≤ B →
    ContinuousOn F (Set.Icc (A : ℝ) ((B : ℝ) + 1)) →
    (∑ j ∈ Finset.Icc A B, ∫ t in (j : ℝ)..((j : ℝ) + 1), F t) =
      ∫ t in (A : ℝ)..((B : ℝ) + 1), F t
  | 0, hAB, _ => by
    have : A = 0 := Nat.eq_zero_of_le_zero hAB
    subst this
    simp
  | B + 1, hAB, hcont => by
    have hcast : ((B + 1 : ℕ) : ℝ) + 1 = (B : ℝ) + 2 := by push_cast; ring
    rw [hcast] at hcont
    rcases Nat.of_le_succ hAB with h' | rfl
    · have hA : (A : ℝ) ≤ (B : ℝ) + 1 := by exact_mod_cast (le_trans h' (Nat.le_succ B))
      have hB : (B : ℝ) + 1 ≤ (B : ℝ) + 2 := by linarith
      have hstep : ((B + 1 : ℕ) : ℝ) = (B : ℝ) + 1 := by push_cast; ring
      have hsub1 : Set.Icc (A : ℝ) ((B : ℝ) + 1) ⊆ Set.Icc (A : ℝ) ((B : ℝ) + 2) :=
        fun t ht => ⟨ht.1, le_trans ht.2 hB⟩
      have hsub2 : Set.Icc ((B : ℝ) + 1) ((B : ℝ) + 2) ⊆ Set.Icc (A : ℝ) ((B : ℝ) + 2) :=
        fun t ht => ⟨le_trans hA ht.1, ht.2⟩
      rw [Finset.sum_Icc_succ_top (Nat.le_succ_of_le h'),
        Taske724d7d203de1af512de02c5_chen_triple_size_aux_tel_int F A B h' (hcont.mono hsub1)]
      have hIA : IntervalIntegrable F MeasureTheory.volume (A : ℝ) ((B : ℝ) + 1) := by
        apply ContinuousOn.intervalIntegrable
        rw [Set.uIcc_of_le hA]
        exact hcont.mono hsub1
      have hIB : IntervalIntegrable F MeasureTheory.volume ((B : ℝ) + 1) ((B : ℝ) + 2) := by
        apply ContinuousOn.intervalIntegrable
        rw [Set.uIcc_of_le hB]
        exact hcont.mono hsub2
      rw [hstep]
      have hadj := intervalIntegral.integral_add_adjacent_intervals hIA hIB
      have hcongr : (∫ t in ((B : ℝ) + 1)..((B : ℝ) + 1 + 1), F t) =
          ∫ t in ((B : ℝ) + 1)..((B : ℝ) + 2), F t := by
        congr 1
        ring
      have htwo : (B : ℝ) + 1 + 1 = (B : ℝ) + 2 := by ring
      rw [hcongr, htwo]
      exact hadj
    · rw [show Finset.Icc (B + 1) (B + 1) = {B + 1} by
        ext i; simp [Finset.mem_Icc]]
      simp

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_Icc_insert (f : ℕ → ℝ) {a b : ℕ} (h : a ≤ b) :
    (∑ i ∈ Finset.Icc a b, f i) = f a + ∑ i ∈ Finset.Ioc a b, f i := by
  have h1 : Finset.Icc a b = insert a (Finset.Ioc a b) := by
    ext i
    simp only [Finset.mem_Icc, Finset.mem_insert, Finset.mem_Ioc]
    omega
  rw [h1, Finset.sum_insert (by simp)]

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_phi_int (i : ℕ) (hi : 2 ≤ i) :
    Real.log (Real.log ((i : ℝ) + 1)) - Real.log (Real.log (i : ℝ)) =
      ∫ t in (i : ℝ)..((i : ℝ) + 1), 1 / (t * Real.log t) := by
  have hi2 : (2 : ℝ) ≤ (i : ℝ) := by exact_mod_cast hi
  have hcont : ContinuousOn (fun t : ℝ => 1 / (t * Real.log t))
      (Set.uIcc (i : ℝ) ((i : ℝ) + 1)) := by
    rw [Set.uIcc_of_le (by linarith : (i : ℝ) ≤ (i : ℝ) + 1)]
    intro t ht
    have h1 : 1 < t := by linarith [ht.1]
    have hpos : 0 < t * Real.log t := mul_pos (by linarith) (Real.log_pos h1)
    exact (continuousAt_const.div (continuousAt_id.mul (Real.continuousAt_log (by linarith)))
      hpos.ne').continuousWithinAt
  symm
  refine intervalIntegral.integral_eq_sub_of_hasDerivAt
    (f := fun t : ℝ => Real.log (Real.log t)) (f' := fun t : ℝ => 1 / (t * Real.log t)) ?_ ?_
  · intro t ht
    rw [Set.uIcc_of_le (by linarith : (i : ℝ) ≤ (i : ℝ) + 1)] at ht
    have h1 : 1 < t := by linarith [ht.1]
    have h2 : 0 < Real.log t := Real.log_pos h1
    have hd := (Real.hasDerivAt_log (by linarith : t ≠ 0)).log h2.ne'
    convert hd using 1
    field_simp
  · exact hcont.intervalIntegrable

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_abel_id (h : ℝ → ℝ) (a N : ℕ) (hN : a < N) :
    (∑ p ∈ (Finset.Ioc a N).filter Nat.Prime, h (p : ℝ) / (p : ℝ)) =
      h (N : ℝ) * GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeReciprocalSum N - h ((a + 1 : ℕ) : ℝ) * GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeReciprocalSum a -
        ∑ i ∈ Finset.Ioc a (N - 1),
          (h ((i + 1 : ℕ) : ℝ) - h (i : ℝ)) * GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeReciprocalSum i := by
  set g : ℕ → ℝ := fun i => if i.Prime then 1 / (i : ℝ) else 0
  have hL : (∑ p ∈ (Finset.Ioc a N).filter Nat.Prime, h (p : ℝ) / (p : ℝ)) =
      ∑ i ∈ Finset.Ioc a N, h (i : ℝ) * g i := by
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun i _ => ?_
    by_cases hp : i.Prime
    · simp [g, hp, div_eq_mul_inv]
    · simp [g, hp]
  rw [hL]
  have hB := Finset.sum_Ioc_by_parts (fun i : ℕ => h (i : ℝ)) g hN
  simp only [smul_eq_mul] at hB
  rw [hB]
  have hG : ∀ k : ℕ, (∑ i ∈ Finset.range (k + 1), g i) = GoldbachRoughFifth.AnalyticInput.ErdosStraus.PrimeEstimates.Mertens.primeReciprocalSum k := by
    intro k
    have hk := Taske724d7d203de1af512de02c5_chen_triple_size_aux_sum_range (k + 1)
    simpa [g] using hk
  simp_rw [hG]

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_psi_cont {s t : ℝ} (hs : 4 ≤ s) :
    ContinuousOn (fun u : ℝ => 1 / (u * Real.log u)) (Set.Icc s t) := by
  intro u hu
  have h1 : 1 < u := by linarith [hu.1]
  have hpos : 0 < u * Real.log u := mul_pos (by linarith) (Real.log_pos h1)
  exact (continuousAt_const.div (continuousAt_id.mul (Real.continuousAt_log (by linarith)))
    hpos.ne').continuousWithinAt

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_int_of_cont {f : ℝ → ℝ} {s t : ℝ} (hst : s ≤ t)
    (hc : ContinuousOn f (Set.Icc s t)) : IntervalIntegrable f MeasureTheory.volume s t := by
  apply ContinuousOn.intervalIntegrable
  rwa [Set.uIcc_of_le hst]

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_step (h : ℝ → ℝ) (a j : ℕ) (ha : 4 ≤ a) (hj : a ≤ j)
    (hcont : ContinuousOn h (Set.Icc (a : ℝ) ((j : ℝ) + 1)))
    (hmono : MonotoneOn h (Set.Icc (a : ℝ) ((j : ℝ) + 1)) ∨
      AntitoneOn h (Set.Icc (a : ℝ) ((j : ℝ) + 1))) :
    (∫ t in (j : ℝ)..((j : ℝ) + 1), h ((j : ℝ) + 1) * (1 / (t * Real.log t))) ≤
      (∫ t in (j : ℝ)..((j : ℝ) + 1), h t * (1 / (t * Real.log t))) +
        max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) / ((a : ℝ) * Real.log (a : ℝ)) := by
  have ha4 : (4 : ℝ) ≤ (a : ℝ) := by exact_mod_cast ha
  have hj4 : (4 : ℝ) ≤ (j : ℝ) := by exact_mod_cast (le_trans ha hj)
  have hcast : ((j + 1 : ℕ) : ℝ) = (j : ℝ) + 1 := by push_cast; ring
  have hcont' : ContinuousOn h (Set.Icc (a : ℝ) ((j : ℝ) + 1)) := hcont
  have hpsi : ContinuousOn (fun u : ℝ => 1 / (u * Real.log u))
      (Set.Icc (j : ℝ) ((j : ℝ) + 1)) := Taske724d7d203de1af512de02c5_chen_triple_size_aux_psi_cont (s := (j : ℝ)) hj4
  have hfi : IntervalIntegrable (fun t : ℝ => h ((j : ℝ) + 1) * (1 / (t * Real.log t)))
      MeasureTheory.volume (j : ℝ) ((j : ℝ) + 1) :=
    Taske724d7d203de1af512de02c5_chen_triple_size_aux_int_of_cont (by linarith) (continuousOn_const.mul hpsi)
  have hja : (a : ℝ) ≤ (j : ℝ) := by exact_mod_cast hj
  have hcontj : ContinuousOn h (Set.Icc (j : ℝ) ((j : ℝ) + 1)) :=
    hcont'.mono (Set.Icc_subset_Icc_left hja)
  have hgi : IntervalIntegrable (fun t : ℝ => (h t + max 0 (h ((j : ℝ) + 1) - h (j : ℝ))) *
      (1 / (t * Real.log t))) MeasureTheory.volume (j : ℝ) ((j : ℝ) + 1) :=
    Taske724d7d203de1af512de02c5_chen_triple_size_aux_int_of_cont (by linarith) ((hcontj.add continuousOn_const).mul hpsi)
  have hpt : ∀ t ∈ Set.Icc (j : ℝ) ((j : ℝ) + 1),
      h ((j : ℝ) + 1) * (1 / (t * Real.log t)) ≤
        (h t + max 0 (h ((j : ℝ) + 1) - h (j : ℝ))) * (1 / (t * Real.log t)) := by
    intro t ht
    have hpos : 0 ≤ 1 / (t * Real.log t) := by
      have h1 : 1 < t := by linarith [ht.1]
      have h2 : 0 < t * Real.log t := mul_pos (by linarith) (Real.log_pos h1)
      positivity
    refine mul_le_mul_of_nonneg_right ?_ hpos
    have hmem : ∀ u : ℝ, (j : ℝ) ≤ u → u ≤ (j : ℝ) + 1 → u ∈ Set.Icc (a : ℝ) ((j : ℝ) + 1) :=
      fun u h1 h2 => ⟨by linarith, h2⟩
    rcases hmono with hm | hm
    · have h1 : h (j : ℝ) ≤ h t := hm (hmem _ (le_refl _) (by linarith)) (hmem _ ht.1 ht.2) ht.1
      have h2 : h (j : ℝ) ≤ h ((j : ℝ) + 1) :=
        hm (hmem _ (le_refl _) (by linarith)) (hmem _ (by linarith) (le_refl _)) (by linarith)
      have h3 : max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) = h ((j : ℝ) + 1) - h (j : ℝ) :=
        max_eq_right (by linarith)
      linarith
    · have h1 : h ((j : ℝ) + 1) ≤ h t :=
        hm (hmem _ ht.1 ht.2) (hmem _ (by linarith) (le_refl _)) ht.2
      have h3 : 0 ≤ max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) := le_max_left _ _
      linarith
  have hmono_int : (∫ t in (j : ℝ)..((j : ℝ) + 1), h ((j : ℝ) + 1) * (1 / (t * Real.log t))) ≤
      ∫ t in (j : ℝ)..((j : ℝ) + 1),
        (h t + max 0 (h ((j : ℝ) + 1) - h (j : ℝ))) * (1 / (t * Real.log t)) :=
    intervalIntegral.integral_mono_on (by linarith) hfi hgi hpt
  have hadd : (∫ t in (j : ℝ)..((j : ℝ) + 1),
        (h t + max 0 (h ((j : ℝ) + 1) - h (j : ℝ))) * (1 / (t * Real.log t))) =
      (∫ t in (j : ℝ)..((j : ℝ) + 1), h t * (1 / (t * Real.log t))) +
        (∫ t in (j : ℝ)..((j : ℝ) + 1),
          max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) * (1 / (t * Real.log t))) := by
    have heq : (fun t : ℝ => (h t + max 0 (h ((j : ℝ) + 1) - h (j : ℝ))) * (1 / (t * Real.log t))) =
        (fun t : ℝ => h t * (1 / (t * Real.log t)) +
          max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) * (1 / (t * Real.log t))) := by
      ext t; ring
    rw [heq]
    exact intervalIntegral.integral_add
      (f := fun t : ℝ => h t * (1 / (t * Real.log t)))
      (g := fun t : ℝ => max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) * (1 / (t * Real.log t)))
      (a := (j : ℝ)) (b := (j : ℝ) + 1)
      (Taske724d7d203de1af512de02c5_chen_triple_size_aux_int_of_cont (by linarith) (hcontj.mul hpsi))
      (Taske724d7d203de1af512de02c5_chen_triple_size_aux_int_of_cont (by linarith) (continuousOn_const.mul hpsi))
  have hconst : (∫ t in (j : ℝ)..((j : ℝ) + 1),
        max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) * (1 / (t * Real.log t))) =
      max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) * ∫ t in (j : ℝ)..((j : ℝ) + 1), 1 / (t * Real.log t) :=
    intervalIntegral.integral_const_mul _ _
  have hsmall : (∫ t in (j : ℝ)..((j : ℝ) + 1), 1 / (t * Real.log t)) ≤ 1 / ((a : ℝ) * Real.log (a : ℝ)) := by
    have hci : IntervalIntegrable (fun _ : ℝ => 1 / ((a : ℝ) * Real.log (a : ℝ)))
        MeasureTheory.volume (j : ℝ) ((j : ℝ) + 1) :=
      Taske724d7d203de1af512de02c5_chen_triple_size_aux_int_of_cont (by linarith) continuousOn_const
    have hpt2 : ∀ t ∈ Set.Icc (j : ℝ) ((j : ℝ) + 1),
        1 / (t * Real.log t) ≤ 1 / ((a : ℝ) * Real.log (a : ℝ)) := by
      intro t ht
      have h1 : (a : ℝ) ≤ t := by linarith [ht.1, hja]
      have h2 : Real.log (a : ℝ) ≤ Real.log t := Real.log_le_log (by linarith) h1
      have hpos1 : 0 < (a : ℝ) * Real.log (a : ℝ) := by
        have : (1 : ℝ) < (a : ℝ) := by linarith
        exact mul_pos (by linarith) (Real.log_pos this)
      have hpos2 : 0 < t * Real.log t := by
        have : (1 : ℝ) < t := by linarith
        exact mul_pos (by linarith) (Real.log_pos this)
      exact one_div_le_one_div_of_le hpos1 (mul_le_mul h1 h2 (Real.log_nonneg (by linarith)) (by linarith))
    have hm := intervalIntegral.integral_mono_on (by linarith)
      (Taske724d7d203de1af512de02c5_chen_triple_size_aux_int_of_cont (by linarith) hpsi) hci hpt2
    rw [intervalIntegral.integral_const] at hm
    simpa using hm
  have hm0 : 0 ≤ max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) := le_max_left _ _
  have hfin : max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) * ∫ t in (j : ℝ)..((j : ℝ) + 1), 1 / (t * Real.log t) ≤
      max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) / ((a : ℝ) * Real.log (a : ℝ)) := by
    have h1 := mul_le_mul_of_nonneg_left hsmall hm0
    linarith [show max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) * (1 / ((a : ℝ) * Real.log (a : ℝ))) =
      max 0 (h ((j : ℝ) + 1) - h (j : ℝ)) / ((a : ℝ) * Real.log (a : ℝ)) by ring]
  linarith

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_tel_Icc (h : ℝ → ℝ) (a N : ℕ) (hN : a < N) :
    (∑ i ∈ Finset.Icc a (N - 1), (h ((i + 1 : ℕ) : ℝ) - h (i : ℝ))) = h (N : ℝ) - h (a : ℝ) := by
  have h2 := Taske724d7d203de1af512de02c5_chen_triple_size_aux_tel (fun k : ℕ => h (k : ℝ)) a (N - 1) (by omega)
  have h3 : N - 1 + 1 = N := Nat.sub_add_cancel (by omega)
  rw [h3] at h2
  exact h2

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_sum_Ioc_tel (h : ℝ → ℝ) (a N : ℕ) (hN : a < N) :
    (∑ i ∈ Finset.Ioc a (N - 1), (h ((i + 1 : ℕ) : ℝ) - h (i : ℝ))) =
      h (N : ℝ) - h ((a + 1 : ℕ) : ℝ) := by
  have h1 := Taske724d7d203de1af512de02c5_chen_triple_size_aux_tel_Icc h a N hN
  have h2 := Taske724d7d203de1af512de02c5_chen_triple_size_aux_Icc_insert
    (fun i : ℕ => h ((i + 1 : ℕ) : ℝ) - h (i : ℝ)) (by omega : a ≤ N - 1)
  rw [h2] at h1
  have hcast : ((a + 1 : ℕ) : ℝ) = (a : ℝ) + 1 := by push_cast; ring
  linarith

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_sum_abs (h : ℝ → ℝ) (a N : ℕ) (hN : a < N)
    (hmono : MonotoneOn h (Set.Icc (a : ℝ) (N : ℝ)) ∨ AntitoneOn h (Set.Icc (a : ℝ) (N : ℝ))) :
    (∑ i ∈ Finset.Ioc a (N - 1), |h ((i + 1 : ℕ) : ℝ) - h (i : ℝ)|) ≤
      |h (N : ℝ) - h ((a + 1 : ℕ) : ℝ)| := by
  have hmem : ∀ i : ℕ, a ≤ i → i ≤ N - 1 → (i : ℝ) ∈ Set.Icc (a : ℝ) (N : ℝ) := by
    intro i h1 h2
    exact ⟨by exact_mod_cast h1, by exact_mod_cast (le_trans h2 (by omega))⟩
  have hmem2 : ∀ i : ℕ, a ≤ i → i ≤ N - 1 → ((i + 1 : ℕ) : ℝ) ∈ Set.Icc (a : ℝ) (N : ℝ) := by
    intro i h1 h2
    exact ⟨by exact_mod_cast (by omega), by exact_mod_cast (by omega)⟩
  have htel := Taske724d7d203de1af512de02c5_chen_triple_size_aux_sum_Ioc_tel h a N hN
  rcases hmono with hm | hm
  · have hpos : ∀ i ∈ Finset.Ioc a (N - 1), 0 ≤ h ((i + 1 : ℕ) : ℝ) - h (i : ℝ) := by
      intro i hi
      have hi' := Finset.mem_Ioc.mp hi
      have h1 := hm (hmem i (by omega) hi'.2) (hmem2 i (by omega) hi'.2) (by exact_mod_cast (by omega))
      linarith
    have hsum : (∑ i ∈ Finset.Ioc a (N - 1), |h ((i + 1 : ℕ) : ℝ) - h (i : ℝ)|) =
        ∑ i ∈ Finset.Ioc a (N - 1), (h ((i + 1 : ℕ) : ℝ) - h (i : ℝ)) :=
      Finset.sum_congr rfl fun i hi => abs_of_nonneg (hpos i hi)
    rw [hsum, htel]
    exact le_abs_self _
  · have hneg : ∀ i ∈ Finset.Ioc a (N - 1), h ((i + 1 : ℕ) : ℝ) - h (i : ℝ) ≤ 0 := by
      intro i hi
      have hi' := Finset.mem_Ioc.mp hi
      have h1 := hm (hmem i (by omega) hi'.2) (hmem2 i (by omega) hi'.2) (by exact_mod_cast (by omega))
      linarith
    have hsum : (∑ i ∈ Finset.Ioc a (N - 1), |h ((i + 1 : ℕ) : ℝ) - h (i : ℝ)|) =
        ∑ i ∈ Finset.Ioc a (N - 1), (h (i : ℝ) - h ((i + 1 : ℕ) : ℝ)) := by
      refine Finset.sum_congr rfl fun i hi => ?_
      rw [abs_of_nonpos (hneg i hi)]
      ring
    have htel2 : (∑ i ∈ Finset.Ioc a (N - 1), (h (i : ℝ) - h ((i + 1 : ℕ) : ℝ))) =
        h ((a + 1 : ℕ) : ℝ) - h (N : ℝ) := by
      have h1 : (∑ i ∈ Finset.Ioc a (N - 1), (h (i : ℝ) - h ((i + 1 : ℕ) : ℝ))) =
          -(∑ i ∈ Finset.Ioc a (N - 1), (h ((i + 1 : ℕ) : ℝ) - h (i : ℝ))) := by
        rw [← Finset.sum_neg_distrib]
        exact Finset.sum_congr rfl fun i _ => by ring
      rw [h1, htel]
      ring
    rw [hsum, htel2]
    rw [abs_sub_comm]
    exact le_abs_self _

theorem Taske724d7d203de1af512de02c5_chen_triple_size_aux_sum_max (h : ℝ → ℝ) (a N : ℕ) (hN : a < N)
