      OAI.LargePrimeGaps.eventually_log_rpow_le_rpow b (by norm_num)
    have hall := (tendsto_natCast_atTop_atTop (R := ℝ)).eventually hlog
    filter_upwards [hall, eventually_ge_atTop 2] with N hNlog hN2
    have hN2r : (2 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN2
    have hNpos : (0 : ℝ) < (N : ℝ) := by linarith
    have hlogpos : 0 < (Real.log (N : ℝ)) ^ b :=
      Real.rpow_pos_of_pos (Real.log_pos (by linarith)) _
    have hquarter : (1 : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) :=
      Real.one_le_rpow (by linarith) (by norm_num)
    have hmul : (N : ℝ) ^ (1 / 4 : ℝ) * (N : ℝ) ^ (1 / 4 : ℝ) = (N : ℝ) ^ (1 / 2 : ℝ) := by
      rw [← Real.rpow_add hNpos]; norm_num
