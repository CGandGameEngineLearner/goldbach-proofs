        ∑ d ∈ (Finset.Icc 1 D).filter (fun d => d ∣ a2OddProd y),
          ((endpointError (a2u x : ℝ) (p * d) : ℝ) + (endpointError (a2l x : ℝ) (p * d) : ℝ) +
            (Chebyshev.psi (a2u x) - Chebyshev.theta (a2u x))) := by
        have hmass' : (perPSieve x p y).totalMass =
            (((a2u x : ℕ) : ℝ) - ((a2l x : ℕ) : ℝ)) / ((p : ℝ) - 1) := rfl
        rw [hmass']
        ring


end
