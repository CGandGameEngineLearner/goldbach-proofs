import Mathlib
namespace FiniteBackup
set_option maxRecDepth 20000

def Hit (k : ℕ) : Prop := ∃ p q : ℕ, Nat.Prime p ∧ Odd p ∧ Nat.Prime q ∧ Odd q ∧ p+q=16*(k+1)

def Block (l u : ℕ) : Prop := ∀ k : ℕ, l≤k → k<u → Hit k

private theorem join {l m u : ℕ} (a : Block l m) (b : Block m u) : Block l u := by
  intro k lo hi
  by_cases mid : k < m
  · exact a k lo mid
  · exact b k (by omega) hi

private theorem at_one (k : ℕ) (h : Hit k) : Block k (k+1) := by
  intro z lo hi
  have eq : z=k := by omega
  exact eq ▸ h

