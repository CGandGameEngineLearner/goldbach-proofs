theorem covers_moduli : rows.map Row.q = List.range' 3 103 := by decide

theorem upper_bounds : ∀ r ∈ rows,
    r.scaledCoefficient ≤ 9730 ∧ r.threshold ≤ 7932309757 := by decide

theorem analytic_bounds : ∀ r ∈ rows,
    r.analyticCutoff ≤ 4 * 10^13 ∧ r.scaledPsiCoefficient ≤ 9591 := by decide

theorem peak_coefficients :
    ((rows.filter fun r => r.scaledCoefficient == 9730).map Row.q) = [104] := by decide

theorem peak_thresholds :
    ((rows.filter fun r => r.threshold == 7932309757).map Row.q) = [3, 6] := by decide

theorem within_published_bounds {r : Row} (hr : r ∈ rows) :
    (r.scaledCoefficient : ℝ) / 10^7 < 1/840 ∧ r.threshold < 8*10^9 := by
  obtain ⟨hc, hx⟩ := upper_bounds r hr
  constructor
  · have hc' : (r.scaledCoefficient : ℝ) ≤ 9730 := by exact_mod_cast hc
    linarith
  · omega

