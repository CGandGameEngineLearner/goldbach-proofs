  calc DeltaT t / 6 ≤ (1 - DeltaT t / 3) - (1 - DeltaT ρ.im) := by linarith
    _ ≤ z.re - ρ.re := by linarith [hzRe.1, hρRe]
    _ = (z - ρ).re := by rw [Complex.sub_re]
    _ ≤ ‖z - ρ‖ := Complex.re_le_norm _
















































