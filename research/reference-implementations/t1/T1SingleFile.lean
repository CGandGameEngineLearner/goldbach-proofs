    have moveTwo : Real.log (2 * |t|) ≤ 2 * Real.log |t| := by
      rw [← Real.log_rpow (by linarith)]
      have := mul_le_mul_of_nonneg_right ht (abs_nonneg t); rw [← sq, ← Real.rpow_two] at this
      exact Real.log_le_log (by linarith) (by linarith)
