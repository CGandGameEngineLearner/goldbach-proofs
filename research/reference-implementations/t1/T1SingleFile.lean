lemma GapSize (t : ℝ) (ht : |t| ≥ 3)
    (z : ℂ) (hzRe : z.re ∈ Icc (1 - DeltaT t / 3) (3 / 2))
    (ρ : ℂ) (hρ : ρ ∈ ZeroWindow t) :
    ‖z - ρ‖ ≥ DeltaT t / 6 := by
