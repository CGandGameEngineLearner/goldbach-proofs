              t = ρ.im →
    -(ζ' (1 + δ + I * t) / ζ (1 + δ + I * t)).re ≤ C * Real.log |t| - 1 / (1 + δ - ρ.re) := by
  obtain ⟨C, hC, SumBound⟩ := SumBoundI
