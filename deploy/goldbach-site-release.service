[Unit]
Description=Publish reviewed Goldbach website updates
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -w 90 /opt/goldbach-catalogues/site-release.lock /usr/bin/python3 /usr/local/libexec/goldbach/publish_site.py
TimeoutStartSec=5min
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/goldbach-catalogues /opt/goldbach-site-releases /opt/goldbach-web
