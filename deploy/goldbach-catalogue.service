[Unit]
Description=Activate reviewed Goldbach research catalogues
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/goldbach-web/publish_catalogue.py
TimeoutStartSec=5min
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/goldbach-catalogues
